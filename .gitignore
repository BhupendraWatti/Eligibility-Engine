# ==============================================================================
# NIRNAY Eligibility Engine - Production .gitignore
# Project Manager Standard: Comprehensive Zero-Leak & Repository Hygiene Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build & Compiled Artifacts
# ------------------------------------------------------------------------------

dist/
build/
out/
.astro/
.vite/
.output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 2. Cloudflare Wrangler & Local Edge Runtime State (NEVER COMMIT LOCAL STATE)
# ------------------------------------------------------------------------------
.wrangler/
.mf/
wrangler.log*
.cloudflare/
.dev-server/

# ------------------------------------------------------------------------------
# 3. Node Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.pid
*.pid.lock

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets (CRITICAL FOR ZERO TRUST SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 5. Local Databases & SQLite Dumps
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
local.db*

# ------------------------------------------------------------------------------
# 6. IDE, Editors & Development Tools
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.orig
*.patch
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 8. Testing, Playwright & QA Test Artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.playwright-mcp/
playwright/.auth/
*.har
*.trace.zip
blob-report/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 9. Caches, Temporary Files & Verification Tooling
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.tmp.*
.tmp/
.cache/
.parcel-cache/
.vinext/
.vercel/
.netlify/
tmp/
temp/

# Python tooling used by local verification scripts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.py

# Drizzle local meta folder (migrations/ and drizzle.config.ts remain tracked)
drizzle/

# ------------------------------------------------------------------------------
# 10. AI Working Sessions, Scratchpads, Tests & Local Documentation
# ------------------------------------------------------------------------------
active/
scratch/
.agent/
.agents/
.gemini/
.system_generated/
.gstack/
testsprite_tests/

# Consolidated local markdown specifications, architecture notes & audits
markdown/

# Office documents
*.docx


# ------------------------------------------------------------------------------
# 11. Graphify knowledge graph output (local only - visual project map)
# ------------------------------------------------------------------------------
graphify-out/

# Tests are local-only, not part of the deployed code
*.test.ts
*.spec.ts
