# ==============================================================================
# RozgarSetu MP - Production .gitignore (Project Manager Standard)
# ==============================================================================

# Build & Compiled Output
dist/
build/
out/
.astro/

# Cloudflare Wrangler & Local Edge State (NEVER COMMIT LOCAL D1 STATE)
.wrangler/
.mf/
wrangler.log*
.cloudflare/

# Node Dependencies & Package Manager Artifacts
node_modules/
.pnp/
.pnp.js
.npm/
.yarn/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment Variables & Secrets (CRITICAL FOR ZERO TRUST)
.env
.env.*
!.env.example
.dev.vars

# Local Databases & SQLite Dumps
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# Temporary files & Caches
*.tmp
*.temp
.cache/
.parcel-cache/
