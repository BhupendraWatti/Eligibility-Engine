{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eligibility-engine",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "govtrecruitments.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.govtrecruitments.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "EligibilityEngine-db",
      "database_id": "a6e065fb-e899-498b-a4e6-e0cb7b1c1e2e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}