---
// src/pages/net-exams.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ugcNet,
  csirNet,
  stateExams,
  otherExams,
  otherExamsScopeNote,
  setValidityNote,
  type EligibilityExam,
} from '../data/net-exams';

const SEE_NOTICE = 'See official notice';

const categories = [
  { id: 'ugc-net', label: 'UGC NET', count: 1 },
  { id: 'csir-ugc-net', label: 'CSIR UGC NET', count: 1 },
  { id: 'set-slet', label: 'SET / SLET', count: stateExams.length },
  { id: 'other', label: 'Other eligibility exams', count: otherExams.length },
];

const badge: Record<string, { label: string; cls: string }> = {
  verified: { label: 'Checked on official site', cls: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-900' },
  partial: { label: 'Partly checked', cls: 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900' },
  pending: { label: 'Not yet checked', cls: 'bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700' },
};

const rows = (e: EligibilityExam) => [
  ['Conducting authority', e.authority],
  ['Cycle', e.cycle],
  ['Notification', e.notification],
  ['Application dates', e.applicationStart && e.applicationEnd ? `${e.applicationStart} to ${e.applicationEnd}` : e.applicationStart ?? e.applicationEnd],
  ['Exam date', e.examDate],
  ['Where it is valid', e.validity],
] as const;
---

<BaseLayout
  title="NET, SET and SLET Eligibility Exams for Assistant Professor and Research"
  description="UGC NET, CSIR UGC NET and state SET/SLET eligibility tests, kept in separate lists with the conducting authority, dates and official links."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">NET Exams</span>
    </nav>

    <div class="pb-6 border-b border-border mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">NET &amp; Eligibility Exams</h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-3xl">
        Eligibility tests for Assistant Professor posts, research fellowships and PhD admission. Each category below is separate, and every entry links to the official site. These tests are not job vacancies: passing one makes you eligible, and the posts themselves are advertised separately.
      </p>
    </div>

    <nav class="flex flex-wrap gap-2 pb-6 mb-8 border-b border-border/60" aria-label="Exam categories">
      {categories.map((c) => (
        <a href={`#${c.id}`} class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-card border border-border text-foreground hover:bg-muted transition-colors">
          {c.label} <span class="text-muted-foreground">({c.count})</span>
        </a>
      ))}
    </nav>

    <div class="space-y-14">
      {[
        { id: 'ugc-net', num: 1, exam: ugcNet },
        { id: 'csir-ugc-net', num: 2, exam: csirNet },
      ].map(({ id, num, exam }) => (
        <section id={id} class="scroll-mt-24">
          <h2 class="text-sm font-bold uppercase tracking-wider text-foreground mb-1">{num}. {exam.name}</h2>
          <p class="text-xs text-muted-foreground mb-4">{exam.fullName}</p>

          <article class="rounded-2xl bg-card border border-border p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <p class="text-sm text-foreground leading-relaxed max-w-3xl">{exam.purpose}</p>
              <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${badge[exam.verification].cls}`}>
                {badge[exam.verification].label}
              </span>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-xs mb-5">
              {rows(exam).map(([k, v]) => (
                <div>
                  <dt class="text-muted-foreground font-medium">{k}</dt>
                  <dd class="text-foreground mt-0.5">{v ?? SEE_NOTICE}</dd>
                </div>
              ))}
            </dl>

            {exam.subjects && (
              <div class="mb-5">
                <h3 class="text-xs font-bold text-foreground mb-2">Subjects</h3>
                <ul class="flex flex-wrap gap-2">
                  {exam.subjects.map((s) => (
                    <li class="px-2.5 py-1 rounded-md bg-muted text-xs text-foreground">{s}</li>
                  ))}
                </ul>
                {exam.subjectNote && <p class="text-[11px] text-muted-foreground mt-2">{exam.subjectNote}</p>}
              </div>
            )}

            {exam.eligibility.length > 0 && (
              <div class="mb-5">
                <h3 class="text-xs font-bold text-foreground mb-2">Eligibility</h3>
                <ul class="list-disc pl-5 space-y-1 text-xs text-muted-foreground leading-relaxed">
                  {exam.eligibility.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            )}

            {exam.notes && exam.notes.map((n) => (
              <p class="text-[11px] text-muted-foreground mb-2">Note: {n}</p>
            ))}

            <div class="pt-3 mt-3 border-t border-border flex flex-wrap items-center gap-x-5 gap-y-2">
              {exam.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary hover:underline">{l.label}</a>
              ))}
              {exam.checkedOn && <span class="text-[11px] text-muted-foreground ml-auto">Checked {exam.checkedOn}</span>}
            </div>
          </article>
        </section>
      ))}

      <section id="set-slet" class="scroll-mt-24">
        <h2 class="text-sm font-bold uppercase tracking-wider text-foreground mb-1">3. SET / SLET (State Eligibility Test)</h2>
        <p class="text-xs text-muted-foreground mb-2 max-w-3xl">
          State-level eligibility tests for Assistant Professor posts, conducted by authorised state agencies. Each state is listed separately.
        </p>
        <p class="text-xs text-muted-foreground mb-5 max-w-3xl rounded-lg border border-border bg-muted/40 px-3 py-2">{setValidityNote}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {stateExams.map((e) => (
            <article id={e.id} class="rounded-2xl bg-card border border-border p-5 scroll-mt-24">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div>
                  <p class="text-[11px] font-mono font-bold text-muted-foreground uppercase">{e.state}</p>
                  <h3 class="text-base font-bold text-foreground leading-snug">{e.name}</h3>
                  <p class="text-xs text-muted-foreground">{e.fullName}</p>
                </div>
                <span class={`shrink-0 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${badge[e.verification].cls}`}>
                  {badge[e.verification].label}
                </span>
              </div>

              <dl class="grid grid-cols-1 gap-y-2 text-xs my-4">
                {rows(e).map(([k, v]) => (
                  <div>
                    <dt class="text-muted-foreground font-medium">{k}</dt>
                    <dd class="text-foreground mt-0.5">{v ?? SEE_NOTICE}</dd>
                  </div>
                ))}
                <div>
                  <dt class="text-muted-foreground font-medium">Eligible subjects</dt>
                  <dd class="text-foreground mt-0.5">{e.subjects ? e.subjects.join(', ') : (e.subjectNote ?? SEE_NOTICE)}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground font-medium">Eligibility conditions</dt>
                  <dd class="text-foreground mt-0.5">
                    {e.eligibility.length > 0 ? e.eligibility.join(' ') : SEE_NOTICE}
                  </dd>
                </div>
              </dl>

              {e.notes && e.notes.map((n) => <p class="text-[11px] text-muted-foreground mb-2">Note: {n}</p>)}

              {e.links.length > 0 && (
                <div class="pt-3 mt-3 border-t border-border flex flex-wrap items-center gap-x-4 gap-y-1.5">
                  {e.links.map((l) => (
                    <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary hover:underline">{l.label}</a>
                  ))}
                  {e.checkedOn && <span class="text-[11px] text-muted-foreground ml-auto">Checked {e.checkedOn}</span>}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <section id="other" class="scroll-mt-24">
        <h2 class="text-sm font-bold uppercase tracking-wider text-foreground mb-1">4. Other NET / Eligibility Examinations</h2>
        <p class="text-xs text-muted-foreground mb-5 max-w-3xl">{otherExamsScopeNote}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {otherExams.map((e) => (
            <article class="rounded-2xl bg-card border border-border p-5">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div>
                  <h3 class="text-base font-bold text-foreground leading-snug">{e.name}</h3>
                  <p class="text-xs text-muted-foreground">{e.fullName}</p>
                </div>
                <span class={`shrink-0 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${badge[e.verification].cls}`}>
                  {badge[e.verification].label}
                </span>
              </div>
              <p class="text-xs text-foreground my-3 leading-relaxed">{e.purpose}</p>
              <dl class="grid grid-cols-1 gap-y-2 text-xs mb-3">
                {rows(e).map(([k, v]) => (
                  <div>
                    <dt class="text-muted-foreground font-medium">{k}</dt>
                    <dd class="text-foreground mt-0.5">{v ?? SEE_NOTICE}</dd>
                  </div>
                ))}
              </dl>
              {e.notes && e.notes.map((n) => <p class="text-[11px] text-muted-foreground mb-2">Note: {n}</p>)}
              <div class="pt-3 mt-3 border-t border-border flex flex-wrap items-center gap-x-4">
                {e.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary hover:underline">{l.label}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <p class="text-[11px] text-muted-foreground mt-12 pt-4 border-t border-border max-w-3xl">
      This page is an independent guide, not an official source. Dates change and corrigenda are issued, so confirm everything in the official notice before you apply.
      Read our <a href="/source-policy" class="underline hover:text-foreground">verification standards</a>.
    </p>
  </div>
</BaseLayout>
