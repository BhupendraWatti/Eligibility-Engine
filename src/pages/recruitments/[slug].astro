---
import { advtLabel } from '../../services/advt-number';
// src/pages/recruitments/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRecruitmentWithRelations } from '../../db/queries';

const { slug } = Astro.params;

const recruitment = await getRecruitmentWithRelations(slug || '');
if (!recruitment) Astro.response.status = 404;

// Default dates formatter
function formatDate(dateStr?: string): string {
  if (!dateStr) return 'Refer Notification';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Data Quality & Verification Guard
const isUnderVerification = recruitment && (recruitment.status !== 'PUBLISHED' || recruitment.validationStatus === 'NEEDS_REVIEW');
const isInvalid = recruitment && recruitment.validationStatus === 'INVALID';

// Database-driven Vacancies (Strictly NO synthetic fallback formulas)
const vacancies = recruitment?.vacanciesList || [];

// The notice's dates only. applicationStart/End/examDate come from these same events, so there is nothing to fall back to.
const importantDates = recruitment?.importantDatesList ?? [];

// Only what this notice stated (same rules as src/services/cadre-guide.ts). Never shown: master-post
// defaults (stages, pay), nor the eligibility table's defaulted min age (18) and relaxations (5/3/5),
// which cannot be told apart from values the notice actually gave. Relaxations appear only as the notice's text.
const selectionStages = recruitment?.selectionStages ?? [];
// age_cutoff_date is NOT NULL, so there is always a date to show.
const ageCutoffDate = formatDate(recruitment?.criteria.ageCutoffDate);
const relaxationNotes = recruitment?.criteria.relaxationNotesMarkdown?.trim() || null;
// The mapper's payScale falls back to the unverified master default; only the override is the notice's pay.
const noticePay = recruitment?.payScaleOverride?.trim() || null;

const recordLastVerified = (() => {
  const times = (recruitment?.sourcesList ?? []).map((src: any) => (src.lastVerifiedAt ? new Date(src.lastVerifiedAt).getTime() : 0)).filter((t: number) => t > 0);
  return times.length ? new Date(Math.max(...times)) : null;
})();
const lastChecked = recordLastVerified?.toLocaleDateString('en-GB', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' });
// No made-up document: without a linked source the card says so and points to the organisation's own site.
const officialSource = recruitment?.sourcesList?.[0] ?? null;
const sourceVerified = !!officialSource && recruitment?.validationStatus === 'VALID';
// Every organisation has a validated website_url (NOT NULL, checked by every writer).
const organisationDomain = recruitment && new URL(recruitment.organisationUrl).hostname;

// Apply goes to the notice's own link, otherwise to the organisation's site, labelled as such.
const noticeLinkUrl = recruitment?.officialLinksList?.[0]?.url;
const applyLink = noticeLinkUrl
  ? { url: noticeLinkUrl, label: `Apply on ${recruitment!.organisationShortName} portal`, shortLabel: 'Apply Officially' }
  : { url: recruitment?.organisationUrl, label: `Visit ${recruitment?.organisationShortName} website`, shortLabel: 'Official Website' };
---

{!recruitment ? (
  <BaseLayout title="Recruitment Not Found">
    <div class="max-w-3xl mx-auto px-4 py-20 text-center" data-recruitment-not-found>
      <div class="size-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-600 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-foreground mb-2">Recruitment Notice Not Found</h1>
      <p class="text-sm text-muted-foreground mb-6">
        The requested recruitment record does not exist or has not yet been approved for public release.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="/" class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-blue-700 transition-colors">
          Browse Opportunities
        </a>
        <a href="/calendar" class="px-4 py-2 rounded-lg border border-border bg-card text-foreground text-xs font-semibold hover:bg-muted transition-colors">
          Exam Calendar
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={recruitment.seoTitle || recruitment.title}
    description={recruitment.seoDescription || `Official details, verified eligibility criteria, category vacancies, dates, and direct authority links for ${recruitment.title}.`}
    robotsIndex={recruitment.robotsIndex !== 0}
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16 lg:mb-0">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-foreground">Home</a>
        <span>/</span>
        <a href="/#closing-soon" class="hover:text-foreground">Jobs</a>
        <span>/</span>
        <span class="text-foreground font-medium truncate max-w-xs sm:max-w-md">{recruitment.title}</span>
      </nav>

      {/* Public Data Quality Guard / Verification Alert */}
      {isUnderVerification && (
        <div class="mb-8 p-5 sm:p-6 rounded-2xl bg-amber-50 border-2 border-amber-300 text-amber-950 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
          <div class="flex items-start gap-3.5">
            <div class="size-10 rounded-xl bg-amber-200/80 flex items-center justify-center text-amber-900 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-amber-200 text-amber-900 border border-amber-300">
                  PROVISIONAL RECORD · UNDER VERIFICATION
                </span>
                <span class="text-xs text-amber-800 font-mono">Pending Official Gazette</span>
              </div>
              <h4 class="font-bold text-sm sm:text-base text-amber-950">
                Official Rulebook Verification in Progress
              </h4>
              <p class="text-xs text-amber-900 leading-relaxed mt-1 max-w-2xl">
                This recruitment listing has been compiled from advance departmental releases and is undergoing verification against the formal state gazette rulebook. Dates, vacancies, and criteria are strictly provisional.
              </p>
            </div>
          </div>
          <div class="shrink-0">
            <span class="text-xs font-semibold text-amber-900 block">Status: Review Required</span>
            <span class="text-[11px] text-amber-800">Do not pay applicant fees to third parties</span>
          </div>
        </div>
      )}

      <!-- Top Grid: Hero Card + Source Provenance Card -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Left Hero Card (2 Cols) -->
        <div class="lg:col-span-2 bg-card rounded-2xl p-6 sm:p-8 border border-border shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-muted text-muted-foreground border border-border">
                {recruitment.departmentName || 'Government Department'}
              </span>
              <span class={`px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider ${
                recruitment.presentation?.badgeClass || 'bg-blue-50 text-blue-700 border border-blue-200'
              }`}>
                {recruitment.presentation?.label || recruitment.lifecycleStatus}
              </span>
              <span class="text-xs font-mono text-muted-foreground">
                {advtLabel(recruitment.advtNumber)}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-bold text-foreground mb-3 leading-tight">
              {recruitment.title}
            </h1>

            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mb-6">
              {recruitment.shortSummary}
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-xl bg-muted/50 border border-border mb-6">
              <div>
                <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider block">Vacancies</span>
                <span class="text-lg font-bold text-foreground font-mono">{recruitment.totalVacancies?.toLocaleString() || 'Announced'}</span>
              </div>
              <div>
                <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider block">Qualification</span>
                <span class="text-lg font-bold text-primary">{recruitment.criteria.minQualificationLevel}</span>
              </div>
              <div>
                <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider block">Max Age (General)</span>
                <span class="text-lg font-bold text-foreground font-mono">{recruitment.criteria.maxAgeGeneral} yrs</span>
                <span class="text-[10px] text-muted-foreground block">as on <span class="font-mono">{ageCutoffDate}</span></span>
              </div>
              <div>
                <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider block">Last Date</span>
                <span class="text-lg font-bold text-foreground font-mono">
                  {formatDate(recruitment.applicationEnd)}
                </span>
              </div>
            </div>
          </div>

          <!-- Strict Candidate Action Hierarchy -->
          <div class="pt-4 border-t border-border flex flex-wrap items-center gap-3">
            {isUnderVerification ? (
              <button
                disabled
                class="font-semibold rounded-lg bg-muted text-muted-foreground text-xs sm:text-sm px-5 py-2.5 border border-border cursor-not-allowed inline-flex items-center gap-2"
              >
                <span>Application Link Pending Official Gazette</span>
              </button>
            ) : (
              <a
                href={applyLink.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold rounded-lg bg-primary text-primary-foreground text-xs sm:text-sm px-5 py-2.5 shadow-sm hover:bg-blue-700 transition-colors inline-flex items-center gap-2"
              >
                <span>{applyLink.label}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            )}

            <a
              href={`/eligibility-checker`}
              class="font-medium rounded-lg bg-muted hover:bg-muted/80 text-foreground text-xs sm:text-sm px-4 py-2.5 border border-border transition-colors inline-flex items-center gap-2"
            >
              <span>Check My Eligibility Match</span>
            </a>

            <a
              href="#documents"
              class="font-medium rounded-lg text-muted-foreground hover:text-foreground text-xs sm:text-sm px-3.5 py-2.5 border border-border hover:bg-muted transition-colors inline-flex items-center gap-1.5 ml-auto"
            >
              <span>Official Rulebook PDF</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </a>
          </div>
        </div>

        <!-- Right Source Provenance Card (1 Col) -->
        <div class="bg-card rounded-2xl p-6 border border-border shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-border mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Official source</span>
              <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold border ${
                sourceVerified ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'
              }`}>
                {sourceVerified && <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>}
                {sourceVerified ? 'Verified Source' : officialSource ? 'Review Required' : 'No document linked'}
              </span>
            </div>

            <h3 class="font-bold text-sm text-foreground mb-1">
              {officialSource ? officialSource.sourceTitle || 'Official notification' : 'Official document not linked yet'}
            </h3>
            <p class="text-xs text-muted-foreground mb-4">
              {officialSource
                ? `Official notification published by ${recruitment.organisationName}.`
                : `Read the notice on the ${recruitment.organisationName} website before applying.`}
            </p>

            <div class="space-y-2 text-xs text-muted-foreground mb-6">
              <div class="flex justify-between">
                <span>Authority:</span>
                <span class="font-medium text-foreground">{recruitment.organisationShortName}</span>
              </div>
              <div class="flex justify-between">
                <span>Department:</span>
                <span class="font-medium text-foreground truncate max-w-[170px] text-right">{recruitment.departmentName}</span>
              </div>
              {officialSource?.publicationDate && (
                <div class="flex justify-between">
                  <span>Published:</span>
                  <span class="font-mono text-foreground font-medium">{formatDate(officialSource.publicationDate)}</span>
                </div>
              )}
              {lastChecked && (
                <div class="flex justify-between">
                  <span>Last checked:</span>
                  <span class="font-mono text-foreground font-medium">{lastChecked}</span>
                </div>
              )}
              <div class="flex justify-between">
                <span>Official Domain:</span>
                <span class="font-mono text-primary truncate max-w-[150px]">{organisationDomain}</span>
              </div>
            </div>
          </div>

          <div>
            <a
              href={officialSource?.sourceUrl ?? recruitment.organisationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full font-medium rounded-lg text-primary bg-primary/5 hover:bg-primary/10 border border-primary/20 text-xs py-2.5 px-4 transition-colors flex items-center justify-center gap-1.5"
            >
              <span>{officialSource ? 'View official notification' : `Visit ${recruitment.organisationShortName} website`}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <p class="text-[10px] text-muted-foreground text-center mt-2.5">
              NIRNAY rule evaluation is independent; cross-check official gazette before submitting fees.
            </p>
          </div>
        </div>
      </div>

      <!-- Sticky Horizontal Section Navigation -->
      <div class="sticky top-[91px] z-30 bg-card/95 backdrop-blur-md border-y border-border mb-8 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 overflow-x-auto no-scrollbar">
        <nav id="recruitment-subnav" role="tablist" aria-label="Recruitment details" class="relative flex items-center gap-1 text-xs font-semibold text-muted-foreground whitespace-nowrap py-2">
          {[
            ['overview', 'Overview'],
            ['eligibility', 'Eligibility'],
            ['vacancy', 'Vacancy'],
            ['dates', 'Important dates'],
            ['selection', 'Selection process'],
            ['salary', 'Salary & Cadre'],
            ['documents', 'Documents'],
          ].map(([id, label], i) => (
            <a
              href={`#${id}`}
              id={`tab-${id}`}
              role="tab"
              aria-controls={id}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={id}
              class="rec-tab relative px-3 py-2 rounded-lg transition-colors duration-150 hover:text-foreground hover:bg-muted/60 active:scale-[0.98] aria-selected:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
            >{label}</a>
          ))}
          <span id="rec-tab-indicator" aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-0.5 rounded-full bg-primary origin-left transition-transform duration-250 ease-out" style="width:1px;transform:translateX(0) scaleX(0)"></span>
        </nav>
      </div>

      <!-- Two-Column Content Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Detailed Sections (2 Cols) -->
        <div id="rec-panels" class="lg:col-span-2 min-w-0">
          <!-- Overview -->
          <section id="overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Overview</h2>
            <div class="prose prose-slate dark:prose-invert max-w-none text-xs sm:text-sm text-muted-foreground leading-relaxed space-y-3">
              {recruitment.overviewMarkdown ? (
                <p class="whitespace-pre-line text-foreground/90">{recruitment.overviewMarkdown}</p>
              ) : (
                <>
                  <p>
                    The <strong>{recruitment.organisationName} ({recruitment.organisationShortName})</strong> has published this recruitment for <strong>{recruitment.totalVacancies?.toLocaleString()}</strong> vacancies for <strong>{recruitment.postTitle}</strong> under <strong>{recruitment.departmentName || 'the relevant government cadre'}</strong>{recruitment.stateName ? ` in ${recruitment.stateName}` : ''}.
                  </p>
                  <p>
                    Candidates holding the required qualification ({recruitment.criteria.minQualificationLevel}) and meeting the age limit as on {ageCutoffDate} may apply online through the official portal.
                  </p>
                </>
              )}
            </div>
          </section>

          <!-- Eligibility Section -->
          <section id="eligibility" role="tabpanel" aria-labelledby="tab-eligibility" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Eligibility Requirements</h2>
            
            <div class="bg-card rounded-xl border border-border overflow-hidden mb-4">
              <table class="w-full text-xs text-left">
                <tbody class="divide-y divide-border">
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3 px-4 font-semibold text-muted-foreground w-1/3">Education Standard</td>
                    <td class="py-3 px-4 font-medium text-foreground flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>
                        {recruitment.criteria?.minQualificationLevel} Pass from recognized institution / University.
                        {recruitment.criteria?.allowedStreams && recruitment.criteria.allowedStreams.length > 0 && (
                          <span class="block text-[11px] text-muted-foreground mt-0.5">
                            Permitted Streams: {recruitment.criteria.allowedStreams.join(', ')}
                          </span>
                        )}
                      </span>
                    </td>
                  </tr>
                  {recruitment.criteria?.qualificationDetailsMarkdown && (
                    <tr class="hover:bg-muted/40 transition-colors">
                      <td class="py-3 px-4 font-semibold text-muted-foreground">Qualification Details</td>
                      <td class="py-3 px-4 font-medium text-foreground">
                        <p class="text-xs leading-relaxed text-foreground/90 whitespace-pre-line">{recruitment.criteria.qualificationDetailsMarkdown}</p>
                      </td>
                    </tr>
                  )}
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3 px-4 font-semibold text-muted-foreground">Age Limit</td>
                    <td class="py-3 px-4 font-medium text-foreground">
                      <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>
                          Up to <span class="font-mono">{recruitment.criteria.maxAgeGeneral}</span> years (General category) as on <span class="font-mono">{ageCutoffDate}</span>
                        </span>
                      </div>
                    </td>
                  </tr>
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3 px-4 font-semibold text-muted-foreground">Age Relaxations</td>
                    <td class="py-3 px-4 font-medium text-foreground">
                      {relaxationNotes ? (
                        <p class="text-xs leading-relaxed text-foreground/90 whitespace-pre-line">{relaxationNotes}</p>
                      ) : (
                        <p class="text-xs leading-relaxed text-muted-foreground">Not summarised for this notice. See the official document in the Documents tab for your category.</p>
                      )}
                    </td>
                  </tr>
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3 px-4 font-semibold text-muted-foreground">State Domicile</td>
                    <td class="py-3 px-4 font-medium text-foreground flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>
                        {recruitment.criteria?.requiresMpDomicile
                          ? `${recruitment.stateName || recruitment.criteria.domicileStateCode || 'Specified state'} domicile mandatory under this notification`
                          : 'All India open (reservation treatment follows the official notification)'}
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3 px-4 font-semibold text-muted-foreground">Physical Standards</td>
                    <td class="py-3 px-4 font-medium text-foreground flex items-center gap-2">
                      {recruitment.criteria?.minHeightMaleCm ? (
                        <>
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                          <span>
                            Male: Height {recruitment.criteria.minHeightMaleCm} cm{recruitment.criteria.minChestMaleCm ? `, Chest ${recruitment.criteria.minChestMaleCm} cm` : ''}
                            {recruitment.criteria.minHeightFemaleCm && <>; Female: Height {recruitment.criteria.minHeightFemaleCm} cm</>}
                          </span>
                        </>
                      ) : (
                        <span class="text-xs text-muted-foreground">Not summarised for this notice. See the official document in the Documents tab.</span>
                      )}
                    </td>
                  </tr>
                  {recruitment.criteria?.requiresCpct && (
                    <tr class="hover:bg-muted/40 transition-colors">
                      <td class="py-3 px-4 font-semibold text-muted-foreground">CPCT Scorecard</td>
                      <td class="py-3 px-4 font-medium text-foreground flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Mandatory valid MAP_IT CPCT Scorecard with Hindi typing qualifying certification.</span>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            <p class="text-[11px] text-muted-foreground">
              {lastChecked ? `Taken from the official notice, last checked ${lastChecked}.` : 'Not yet checked against an official document.'} Confirm every condition in the official notice before applying.
            </p>
          </section>

          <!-- Vacancy Breakdown -->
          <section id="vacancy" role="tabpanel" aria-labelledby="tab-vacancy" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-foreground">Category-wise Vacancy Breakdown</h2>
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                Total: {recruitment.totalVacancies?.toLocaleString()} Posts
              </span>
            </div>

            {vacancies && vacancies.length > 0 ? (
              <div class="bg-card rounded-xl border border-border overflow-hidden">
                <table class="w-full text-xs text-left">
                  <thead class="bg-muted text-muted-foreground uppercase text-[10px] tracking-wider font-semibold border-b border-border">
                    <tr>
                      <th class="py-2.5 px-4">Category / Post</th>
                      <th class="py-2.5 px-4">Quota (%)</th>
                      <th class="py-2.5 px-4 text-right">Vacancies</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {vacancies.map((v: any) => (
                      <tr class="hover:bg-muted/30 transition-colors">
                        <td class="py-2.5 px-4 font-medium text-foreground">
                          {v.category}
                          {v.subPostName && (
                            <span class="block text-[11px] text-muted-foreground">{v.subPostName}</span>
                          )}
                        </td>
                        <td class="py-2.5 px-4 text-muted-foreground">{v.quotaPct || v.pct || 'Statutory'}</td>
                        <td class="py-2.5 px-4 text-right font-mono font-bold text-foreground">{v.count?.toLocaleString()}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="p-6 rounded-xl bg-card border border-border text-center space-y-2">
                <div class="size-10 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <h4 class="text-sm font-semibold text-foreground">Category-wise Quota Breakdown Pending</h4>
                <p class="text-xs text-muted-foreground max-w-md mx-auto">
                  Total {recruitment.totalVacancies?.toLocaleString()} vacancies announced. Detailed community category quotas (UR, SC, ST, OBC, EWS, Ex-Servicemen, Women) will be gazetted in the final notification rulebook.
                </p>
              </div>
            )}
          </section>

          <!-- Important Dates -->
          <section id="dates" role="tabpanel" aria-labelledby="tab-dates" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Important Dates</h2>
            {importantDates && importantDates.length > 0 ? (
              <ol class="relative bg-card rounded-xl border border-border divide-y divide-border overflow-hidden">
                {importantDates.map((d: any, index: number) => (
                  <li class="grid grid-cols-[auto_1fr_auto] items-start gap-4 py-4 px-4 sm:px-5 hover:bg-muted/30 transition-colors">
                    <span class="mt-0.5 size-6 rounded-full bg-primary/10 text-primary border border-primary/20 flex items-center justify-center text-[10px] font-mono font-bold">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="min-w-0">
                      <span class="text-sm font-semibold text-foreground block">{d.event}</span>
                      <span class="text-xs text-muted-foreground">{d.desc}</span>
                    </div>
                    <span class="text-xs sm:text-sm font-mono font-bold text-foreground whitespace-nowrap tabular-nums">{d.date}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="p-5 rounded-xl bg-card border border-border text-xs text-muted-foreground">
                Schedule dates will be listed once {recruitment.organisationShortName} publishes them in the official notification.
              </div>
            )}
          </section>

          <!-- Selection Process -->
          <section id="selection" role="tabpanel" aria-labelledby="tab-selection" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Selection Process</h2>
            {selectionStages.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {selectionStages.map((stage: any, index: number) => (
                  <div class="p-4 rounded-xl bg-card border border-border flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between mb-1.5">
                        <span class="text-xs font-bold text-primary">Stage 0{index + 1}</span>
                        {stage.isQualifying && (
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 font-semibold border border-amber-500/20">Qualifying</span>
                        )}
                      </div>
                      <h4 class="font-bold text-sm text-foreground mb-1">{stage.name}</h4>
                      <p class="text-xs text-muted-foreground leading-relaxed">{stage.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="p-5 rounded-xl bg-card border border-border text-xs text-muted-foreground">
                Selection stages are not summarised for this notice. See the official document in the Documents tab.
              </div>
            )}
          </section>

          <!-- Salary & Cadre -->
          <section id="salary" role="tabpanel" aria-labelledby="tab-salary" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Salary & Cadre</h2>
            <div class="p-5 rounded-xl bg-card border border-border space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <span class="text-xs text-muted-foreground block">Appointed Cadre / Post</span>
                  <span class="text-base font-bold text-foreground font-heading">{recruitment.postTitle}</span>
                  <span class="text-xs text-muted-foreground block mt-0.5">{recruitment.cadreClassification || recruitment.departmentName}</span>
                </div>
                <div class="sm:text-right">
                  <span class="text-xs text-muted-foreground block">Official Pay Scale</span>
                  {noticePay ? (
                    <span class="text-base font-bold text-primary font-mono">{noticePay}</span>
                  ) : (
                    <span class="text-xs text-muted-foreground">See the official document in the Documents tab</span>
                  )}
                </div>
              </div>
              {recruitment.salaryDetailsMarkdown && (
                <div class="pt-3 border-t border-border/60 text-xs text-muted-foreground leading-relaxed">
                  <span class="font-semibold text-foreground block mb-1">Allowances & Service Terms:</span>
                  <p class="whitespace-pre-line text-foreground/90">{recruitment.salaryDetailsMarkdown}</p>
                </div>
              )}
            </div>
          </section>

          <!-- Documents & Official Sources (NEW Section: Fixes Anchor #documents) -->
          <section id="documents" role="tabpanel" aria-labelledby="tab-documents" tabindex="0" class="rec-panel scroll-mt-36 focus:outline-none">
            <h2 class="text-xl font-bold text-foreground mb-4">Official Documents & Verification Sources</h2>
            {recordLastVerified && <p class="text-[11px] text-muted-foreground -mt-2 mb-4">Last verified: <time datetime={recordLastVerified.toISOString()}>{recordLastVerified.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric' })}</time> against the official source.</p>}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {/* Gazette / Notification Sources */}
              {recruitment.sourcesList && recruitment.sourcesList.length > 0 ? (
                recruitment.sourcesList.map((src: any) => (
                  <a
                    href={src.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-4 rounded-xl bg-card border border-border hover:border-primary/50 hover:bg-muted/30 transition-all flex items-start gap-3.5 group"
                  >
                    <div class="size-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    </div>
                    <div class="min-w-0">
                      <span class="text-xs font-bold text-foreground group-hover:text-primary transition-colors block truncate">
                        {src.sourceTitle || 'Official Gazette Notification'}
                      </span>
                      <span class="text-[11px] text-muted-foreground block mt-0.5">
                        Type: {src.sourceType?.replace(/_/g, ' ') || 'Notification Document'}
                        {src.publicationDate && ` · ${formatDate(src.publicationDate)}`}
                      </span>
                    </div>
                  </a>
                ))
              ) : (
                <div class="p-4 rounded-xl bg-card border border-border text-xs text-muted-foreground col-span-full">
                  Official gazette document link will be made available upon formal notification release.
                </div>
              )}

              {/* Official External Links */}
              {recruitment.officialLinksList && recruitment.officialLinksList.map((lnk: any) => (
                <a
                  href={lnk.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-4 rounded-xl bg-card border border-border hover:border-primary/50 hover:bg-muted/30 transition-all flex items-start gap-3.5 group"
                >
                  <div class="size-9 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </div>
                  <div class="min-w-0">
                    <span class="text-xs font-bold text-foreground group-hover:text-primary transition-colors block truncate">
                      {lnk.title || 'Official Portal Link'}
                    </span>
                    <span class="text-[11px] text-muted-foreground block mt-0.5 truncate">
                      {lnk.url}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        </div>

        <!-- Right Column Rail: Important Dates & Explanation (1 Col) -->
        <div class="space-y-6">
          <!-- Important Dates Summary Card -->
          <div id="dates-rail" class="bg-card rounded-2xl p-6 border border-border shadow-sm">
            <h3 class="font-bold text-sm text-foreground uppercase tracking-wider mb-4 pb-3 border-b border-border">
              Important dates
            </h3>

            {importantDates.length > 0 ? (
              <div class="space-y-4">
                {importantDates.map((d: any) => (
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="text-xs font-bold text-foreground block">{d.event}</span>
                      <span class="text-[11px] text-muted-foreground">{d.desc}</span>
                    </div>
                    <span class="text-xs font-mono font-bold text-foreground whitespace-nowrap">{d.date}</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-xs text-muted-foreground">No dates published in the official notice yet.</p>
            )}
          </div>

          <!-- Our Explanation Card -->
          <div class="bg-muted/60 rounded-2xl p-6 border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-2">
              Our explanation
            </h4>
            <p class="text-xs text-muted-foreground leading-relaxed mb-3">
              NIRNAY compiles statutory gazettes into verified deterministic rule logic. We do not charge applicant fees, lock profiles, or act as an application broker.
            </p>
            <a href="/disclaimer" class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1">
              <span>Read our source and verification policy</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Sticky Bottom Action Bar (docked above MobileBottomNav on < lg viewports) -->
    <div class="lg:hidden fixed bottom-16 left-0 right-0 z-40 bg-card/95 backdrop-blur-md border-t border-border p-2.5 px-4 shadow-lg no-print">
      <div class="flex items-center gap-2.5 max-w-md mx-auto">
        {isUnderVerification ? (
          <button
            disabled
            class="flex-1 py-2.5 px-3 rounded-xl bg-muted text-muted-foreground font-semibold text-xs text-center cursor-not-allowed border border-border"
          >
            Pending Official Gazette
          </button>
        ) : (
          <a
            href={applyLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-2.5 px-3 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs sm:text-sm text-center shadow-sm transition-colors flex items-center justify-center gap-1.5"
          >
            <span>{applyLink.shortLabel}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        )}
        <a
          href="/eligibility-checker"
          class="flex-1 py-2.5 px-3 rounded-xl bg-card hover:bg-muted text-foreground font-semibold text-xs sm:text-sm text-center border border-border transition-colors flex items-center justify-center gap-1.5"
        >
          <span>Check Eligibility</span>
        </a>
      </div>
    </div>

    <style is:global>
      @keyframes rec-panel-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
      .rec-panel.is-entering { animation: rec-panel-in 200ms cubic-bezier(0.16, 1, 0.3, 1); }
      @media (prefers-reduced-motion: reduce) {
        .rec-panel.is-entering { animation: none; }
        #rec-tab-indicator { transition: none; }
      }
    </style>
    <script is:inline>
      // Tabbed sub-nav: shows one panel at a time instead of scrolling to anchors.
      (() => {
        const nav = document.getElementById('recruitment-subnav');
        if (!nav) return;
        const bar = nav.parentElement;
        const tabs = Array.from(nav.querySelectorAll('.rec-tab'));
        const ids = tabs.map(t => t.dataset.tab);
        const panels = ids.map(id => document.getElementById(id)).filter(Boolean);
        const indicator = document.getElementById('rec-tab-indicator');
        const datesRail = document.getElementById('dates-rail');

        const moveIndicator = (tab) => {
          if (!indicator || !tab) return;
          indicator.style.width = tab.offsetWidth + 'px';
          indicator.style.transform = `translateX(${tab.offsetLeft}px) scaleX(1)`;
        };

        const activate = (id, { focus = false, animate = true, updateHash = true } = {}) => {
          if (!ids.includes(id)) id = ids[0];
          tabs.forEach(tab => {
            const on = tab.dataset.tab === id;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            if (on) {
              moveIndicator(tab);
              // The strip scrolls sideways on phones; keep the active tab in view.
              bar.scrollTo({ left: tab.offsetLeft - (bar.clientWidth - tab.offsetWidth) / 2, behavior: animate ? 'smooth' : 'auto' });
              if (focus) tab.focus({ preventScroll: true });
            }
          });
          panels.forEach(panel => {
            const on = panel.id === id;
            panel.hidden = !on;
            panel.classList.remove('is-entering');
            if (on && animate) { void panel.offsetWidth; panel.classList.add('is-entering'); }
          });
          // The dates panel already shows the schedule; don't duplicate it in the rail.
          if (datesRail) datesRail.hidden = id === 'dates';
          if (updateHash) history.replaceState(null, '', id === ids[0] ? location.pathname + location.search : '#' + id);

          // If the bar is stuck (user scrolled down), bring the new panel's top back under it.
          const stickyTop = parseFloat(getComputedStyle(bar).top) || 0;
          if (bar.getBoundingClientRect().top <= stickyTop + 1) {
            const panelsTop = document.getElementById('rec-panels').getBoundingClientRect().top + window.scrollY;
            window.scrollTo({ top: Math.max(0, panelsTop - stickyTop - bar.offsetHeight - 24) });
          }
        };

        nav.addEventListener('click', (e) => {
          const tab = e.target.closest('.rec-tab');
          if (!tab) return;
          e.preventDefault();
          activate(tab.dataset.tab);
        });

        nav.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(document.activeElement);
          if (i < 0) return;
          const next = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i - 1 + tabs.length) % tabs.length, Home: 0, End: tabs.length - 1 }[e.key];
          if (next === undefined) return;
          e.preventDefault();
          activate(tabs[next].dataset.tab, { focus: true });
        });

        window.addEventListener('hashchange', () => activate(location.hash.slice(1), { updateHash: false }));
        window.addEventListener('resize', () => moveIndicator(nav.querySelector('[aria-selected="true"]')));

        // Deep links (#vacancy etc.) open that tab.
        const initial = location.hash.slice(1);
        activate(initial, { animate: false, updateHash: false });
      })();
    </script>
  </BaseLayout>
)}
