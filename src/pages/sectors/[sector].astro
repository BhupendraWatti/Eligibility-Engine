---
import { advtLabel } from '../../services/advt-number';
// src/pages/sectors/[sector].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectorIcon from '../../components/common/SectorIcon.astro';
import { getAllSectors, getSectorBySlug, getPostsBySectorId, getAllActiveRecruitments } from '../../db/queries';
import { calculateRecruitmentMetrics, formatSectorVacancySummary, isActiveDrive } from '../../services/lifecycle';
import { getSectorThemeDef } from '../../services/sector-theme';

const sectorParam = Astro.params.sector ?? '';

const [rawSector, allSectors, allRecruitments] = await Promise.all([
  getSectorBySlug(sectorParam),
  getAllSectors(),
  getAllActiveRecruitments(),
]);

const sector = rawSector && rawSector.isActive !== 0 ? rawSector : undefined;
if (!sector) Astro.response.status = 404;

const themeDef = sector ? getSectorThemeDef(sector.theme) : getSectorThemeDef('blue');

const posts = sector ? await getPostsBySectorId(sector.id) : [];
const postIds = new Set(posts.map(p => p.id));

// Find recruitments matching this sector
const sectorRecruitments = sector ? allRecruitments.filter(r => 
  (r.postId && postIds.has(r.postId)) ||
  r.postTitle?.toLowerCase().includes(sector.name.toLowerCase().split(' ')[0]) ||
  r.title?.toLowerCase().includes(sector.name.toLowerCase().split(' ')[0])
) : [];

const metrics = calculateRecruitmentMetrics(sectorRecruitments);

// Sector guidelines helper
const isUniformService = sector ? (sector.slug.includes('police') || sector.slug.includes('forest')) : false;
const isEducation = sector ? sector.slug.includes('teaching') : false;
const isJudiciary = sector ? sector.slug.includes('judiciary') : false;
const isMedical = sector ? sector.slug.includes('health') : false;
---

{!sector ? (
  <BaseLayout
    title="Sector Not Found"
    description="The requested public sector or department profile could not be found."
  >
    <div class="max-w-3xl mx-auto px-4 py-20 text-center" data-sector-not-found>
      <div class="size-14 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-foreground mb-2">Sector Not Found</h1>
      <p class="text-sm text-muted-foreground mb-6">
        No state government sector matches the identifier <code class="font-mono bg-muted px-1.5 py-0.5 rounded text-xs">{sectorParam}</code>.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="/jobs" class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-blue-700 transition-colors">
          Browse All Opportunities
        </a>
        <a href="/" class="px-4 py-2 rounded-lg border border-border bg-card text-foreground text-xs font-semibold hover:bg-muted transition-colors">
          Home
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`${sector.name} Government Jobs - NIRNAY`}
    description={`Explore open and upcoming ${sector.name} opportunities across India, eligibility rules, vacancies, and official recruitment notifications.`}
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-sector-profile={sector.slug} data-sector-title={sector.name}>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <a href="/jobs" class="hover:text-foreground">Sectors</a>
      <span>/</span>
      <span class="text-foreground font-medium">{sector.name}</span>
    </nav>

    <!-- Header & Hero Strip -->
    <div class="bg-card rounded-2xl border border-border p-6 sm:p-8 shadow-sm mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-2xl flex items-start gap-4">
        <div class={`size-12 rounded-xl border flex items-center justify-center shrink-0 mt-1 shadow-2xs ${themeDef.badgeClass}`}>
          <SectorIcon name={sector.icon} class="size-6" />
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-1 font-mono">
            Sector Discovery Hub
          </span>
          <h1 class="text-2xl sm:text-3xl font-bold text-foreground mb-1.5 font-heading">
            {sector.name} Government Jobs
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            {sector.description || 'Explore open and upcoming opportunities, statutory qualifications, age relaxations, and official government gazette notices.'}
          </p>

          <div class="flex flex-wrap items-center gap-4 mt-3 text-xs font-mono">
            <span class="text-foreground font-bold">{formatSectorVacancySummary(metrics)}</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">{posts.length} Recognized Cadres</span>
          </div>
        </div>
      </div>

      <div class="shrink-0 flex items-center gap-3">
        <a
          href="/eligibility-checker"
          class="px-5 py-3 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs sm:text-sm shadow-sm transition-colors inline-flex items-center gap-2"
        >
          <span>Check {sector.name.split(' ')[0]} Eligibility</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Layout: Main Content (2 Cols) + Sidebar (1 Col) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content (2 Cols) -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Live Recruitment Drives -->
        <div>
          <h2 class="text-base font-bold text-foreground uppercase tracking-wider mb-4 flex items-center justify-between">
            <span>Active & Upcoming Recruitment Drives ({sectorRecruitments.length})</span>
            <a href="/jobs" class="text-xs text-primary font-medium hover:underline inline-flex items-center gap-1">
              <span>View all jobs</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </h2>

          {sectorRecruitments.length === 0 ? (
            <div class="p-8 rounded-2xl bg-card border border-border text-center">
              <p class="text-xs text-muted-foreground">No active recruitment drives at this exact moment for this sector.</p>
              <p class="text-xs text-muted-foreground mt-1">Review the permanent canonical cadres below or run an eligibility check.</p>
            </div>
          ) : (
            <div class="space-y-4">
              {sectorRecruitments.map((r) => {
                return (
                  <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${r.presentation?.badgeClass || 'bg-muted text-muted-foreground border-border'}`}>
                        {r.presentation?.label || r.lifecycleStatus}
                      </span>
                      <span class="text-xs text-muted-foreground font-mono font-bold">
                        {r.totalVacancies.toLocaleString()} Vacancies
                      </span>
                    </div>

                    <h3 class="text-base font-bold text-foreground mb-1">
                      <a href={`/recruitments/${r.slug}`} class="hover:text-primary transition-colors">
                        {r.title}
                      </a>
                    </h3>

                    <p class="text-xs text-muted-foreground mb-3 line-clamp-2">{r.shortSummary}</p>

                    <div class="flex flex-wrap items-center gap-4 text-xs text-muted-foreground mb-4">
                      <span>Agency: <strong class="text-foreground">{r.organisationShortName}</strong></span>
                      <span>·</span>
                      <span>Min Qualification: <strong class="text-foreground">{r.criteria.minQualificationLevel}</strong></span>
                      <span>·</span>
                      <span>Age: <strong class="text-foreground">{r.criteria.minAge} to {r.criteria.maxAgeGeneral} yrs</strong></span>
                    </div>

                    <div class="pt-3 border-t border-border flex items-center justify-between">
                      <span class="text-[11px] text-muted-foreground font-mono">{advtLabel(r.advtNumber)}</span>
                      <a
                        href={`/recruitments/${r.slug}`}
                        class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
                      >
                        <span>View jobs & criteria</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        <!-- Canonical Post Profiles for this Sector -->
        <div>
          <h2 class="text-base font-bold text-foreground uppercase tracking-wider mb-4">
            Established Cadres & Posts ({posts.length})
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {posts.map((post) => (
              <a
                href={`/posts/${post.slug}`}
                class="block p-5 rounded-2xl bg-card border border-border hover:border-primary hover:shadow-xs transition-all group"
              >
                <h4 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors mb-1">
                  {post.title}
                </h4>
                <p class="text-xs text-muted-foreground line-clamp-2 mb-3">
                  {post.summary}
                </p>
                <div class="text-[11px] font-mono text-muted-foreground space-y-0.5">
                  <div>Min Qualification: <strong class="text-foreground">{post.defaultQualification}</strong></div>
                  <div>Pay Matrix: <strong class="text-foreground">{post.payScale || 'State Cadre Rules'}</strong></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Source Policy Card -->
      <aside class="space-y-6">
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-3 pb-2 border-b border-border">
            Source & Statutory Policy
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed mb-3">
            Every recruitment is evaluated using the service rules and official notification stored for that specific authority and jurisdiction.
          </p>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Category, gender, domicile, and age-relaxation rules are calculated per recruitment; values are never copied from one state to another.
          </p>
        </div>

        {isUniformService && (
          <div class="p-6 rounded-2xl bg-muted/60 border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
              Physical Measurement Standards
            </h4>
            <ul class="text-xs text-muted-foreground space-y-1.5">
              <li>• Male Height: 168 cm (General/OBC/SC)</li>
              <li>• Male Height: 160 cm (ST Candidates)</li>
              <li>• Female Height: 155 to 158 cm (All categories)</li>
              <li>• Chest: 81 cm unexpanded, 86 cm expanded</li>
            </ul>
          </div>
        )}

        {isEducation && (
          <div class="p-6 rounded-2xl bg-muted/60 border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
              Teaching Credentials Standard
            </h4>
            <ul class="text-xs text-muted-foreground space-y-1.5">
              <li>• Primary (Varg-3): 12th Pass + D.El.Ed / B.Ed</li>
              <li>• Middle (Varg-2): Graduation + B.Ed / TET</li>
              <li>• High School (Varg-1): Post Graduation + B.Ed</li>
            </ul>
          </div>
        )}

        {isJudiciary && (
          <div class="p-6 rounded-2xl bg-muted/60 border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
              Judicial & Clerical Standard
            </h4>
            <ul class="text-xs text-muted-foreground space-y-1.5">
              <li>• Degree in any discipline from recognized university</li>
              <li>• CPCT Scorecard with English & Hindi typing</li>
              <li>• Computer application diploma (DCA/PGDCA)</li>
            </ul>
          </div>
        )}

        {isMedical && (
          <div class="p-6 rounded-2xl bg-muted/60 border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
              Healthcare Council Mandate
            </h4>
            <ul class="text-xs text-muted-foreground space-y-1.5">
              <li>• B.Sc Nursing / GNM / DMLT recognized course</li>
              <li>• Active registration with MP Nursing / Paramedical Council</li>
              <li>• Active MP Rojgar Portal panjiyan</li>
            </ul>
          </div>
        )}

        <div class="p-5 rounded-2xl bg-card border border-border">
          <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
            Explore Other Sectors
          </h4>
          <div class="flex flex-wrap gap-1.5">
            {allSectors.map(s => (
              <a
                href={`/sectors/${s.slug}`}
                class={`px-2.5 py-1 rounded text-xs font-medium transition-colors ${
                  s.id === sector.id
                    ? 'bg-primary text-primary-foreground font-bold'
                    : 'bg-muted hover:bg-muted/80 text-foreground'
                }`}
              >
                {s.name.split(' ')[0]}
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>

    <!-- Bottom Editorial Section -->
    <div class="mt-12 pt-8 border-t border-border">
      <h3 class="text-lg font-bold text-foreground mb-2">
        About {sector.name} Recruitments
      </h3>
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-4xl">
        Recruitment in this sector is conducted by central, state, and union-territory authorities. Domicile and employment-registration requirements are shown only when the official notification requires them.
      </p>
    </div>
  </div>
</BaseLayout>
)}
