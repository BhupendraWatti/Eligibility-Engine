---
// src/pages/sectors/[sector].astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const { sector = 'police' } = Astro.params;

const formattedSector = sector.charAt(0).toUpperCase() + sector.slice(1);

const posts = [
  {
    title: 'Police Constable (General Duty / Radio)',
    slug: 'mp-police-constable-recruitment-2026',
    vacancies: 7500,
    qualification: '10th Pass (Higher Secondary for special cadres)',
    status: 'Applications Open',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  },
  {
    title: 'Sub Inspector (MP Police SI)',
    slug: 'mp-police-sub-inspector-recruitment-2026',
    vacancies: 850,
    qualification: 'Graduation in any discipline',
    status: 'Upcoming (Oct 2026)',
    statusColor: 'bg-blue-50 text-blue-700 border-blue-200',
  },
  {
    title: 'Subedar & Platoon Commander',
    slug: 'mp-subedar-recruitment-2026',
    vacancies: 210,
    qualification: 'Graduation + Physical Standard Met',
    status: 'Upcoming',
    statusColor: 'bg-blue-50 text-blue-700 border-blue-200',
  },
  {
    title: 'Assistant Sub Inspector (Stenographer / Clerk)',
    slug: 'mp-police-asi-steno-2026',
    vacancies: 180,
    qualification: '12th Pass + CPCT Certificate + Hindi Typing',
    status: 'Rulebook Gazetted',
    statusColor: 'bg-amber-50 text-amber-700 border-amber-200',
  },
];
---

<BaseLayout
  title={`${formattedSector} Jobs in Madhya Pradesh — NIRNAY MP`}
  description={`Explore open and upcoming ${formattedSector} opportunities in Madhya Pradesh, eligibility rules, vacancies, and official recruitment notifications.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <a href="/jobs" class="hover:text-foreground">Sectors</a>
      <span>/</span>
      <span class="text-foreground font-medium">{formattedSector}</span>
    </nav>

    <!-- Header & Hero Strip -->
    <div class="bg-card rounded-2xl border border-border p-6 sm:p-8 shadow-sm mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-1">
          Sector Discovery Hub
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground mb-2">
          {formattedSector} Jobs in Madhya Pradesh
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
          Explore open and upcoming {formattedSector.toLowerCase()} opportunities, eligibility, statutory relaxations, and official recruitment links.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-4 text-xs font-mono">
          <span class="text-foreground"><strong>12</strong> Open Positions</span>
          <span class="text-muted-foreground">·</span>
          <span class="text-foreground"><strong>4</strong> Upcoming Drives</span>
          <span class="text-muted-foreground">·</span>
          <span class="text-muted-foreground">Updated 21 Sep 2026</span>
        </div>
      </div>

      <div class="shrink-0">
        <a
          href="/eligibility-checker"
          class="px-5 py-3 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs sm:text-sm shadow-sm transition-colors inline-flex items-center gap-2"
        >
          <span>Check {formattedSector} Eligibility</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Tabs Strip -->
    <div class="flex items-center gap-6 border-b border-border mb-8 text-xs font-semibold text-muted-foreground">
      <span class="text-primary border-b-2 border-primary pb-3 font-bold -mb-px">Open Positions (4)</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Upcoming Recruitments</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Completed Recruitments</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Related Posts</span>
    </div>

    <!-- Posts Grid (2 Cols) + Sector Info Sidebar (1 Col) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Posts List (2 Cols) -->
      <div class="lg:col-span-2 space-y-4">
        {posts.map((p) => (
          <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${p.statusColor}`}>
                {p.status}
              </span>
              <span class="text-xs text-muted-foreground font-mono font-bold">
                {p.vacancies.toLocaleString()} Vacancies
              </span>
            </div>

            <h2 class="text-base font-bold text-foreground mb-1">
              <a href={`/recruitments/${p.slug}`} class="hover:text-primary transition-colors">
                {p.title}
              </a>
            </h2>

            <p class="text-xs text-muted-foreground mb-4">
              Qualification: <strong class="text-foreground">{p.qualification}</strong>
            </p>

            <div class="pt-3 border-t border-border flex items-center justify-between">
              <span class="text-[11px] text-muted-foreground">Conducting Agency: MPESB</span>
              <a
                href={`/recruitments/${p.slug}`}
                class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
              >
                <span>View jobs & criteria</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Source Policy Card -->
      <aside class="space-y-6">
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-3 pb-2 border-b border-border">
            Source & Statutory Policy
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed mb-3">
            All police recruitment standards in Madhya Pradesh adhere to the MP Police Executive Force (Amended) Rules.
          </p>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Relaxations for women and domiciled SC/ST/OBC applicants are statutory and calculated automatically in our engine.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-muted/60 border border-border">
          <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-2">
            Physical Measurement Standards
          </h4>
          <ul class="text-xs text-muted-foreground space-y-1.5">
            <li>• Male Height: 168 cm (General/OBC/SC)</li>
            <li>• Male Height: 160 cm (ST Candidates)</li>
            <li>• Female Height: 155 cm (All categories)</li>
            <li>• Chest: 81 cm unexpanded, 86 cm expanded</li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Bottom Editorial Section -->
    <div class="mt-12 pt-8 border-t border-border">
      <h3 class="text-lg font-bold text-foreground mb-2">
        About {formattedSector} Jobs in Madhya Pradesh
      </h3>
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-4xl">
        The Madhya Pradesh State Police Department recruits through examinations conducted primarily by the Employees Selection Board (MPESB) and Public Service Commission (MPPSC for DSP rank). Candidates are required to maintain active registration with the Madhya Pradesh Rojgar Portal before submitting application forms.
      </p>
    </div>
  </div>
</BaseLayout>
