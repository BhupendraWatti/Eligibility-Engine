---
// src/pages/jobs/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

// @ts-ignore
const dbRecruitments = await getAllActiveRecruitments();

const sampleOpportunities = [
  {
    title: 'MP Police Constable Recruitment 2026',
    slug: 'mp-police-constable-recruitment-2026',
    status: 'Open',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    vacancies: 7500,
    qualification: '10th Pass',
    age: '18–33 yrs',
    lastDate: '06 Oct 2026',
    org: 'MPESB',
    dept: 'Police Department',
  },
  {
    title: 'Forest Guard Recruitment 2026',
    slug: 'mp-forest-guard-recruitment-2026',
    status: 'Closing soon',
    statusColor: 'bg-amber-50 text-amber-700 border-amber-200',
    vacancies: 1420,
    qualification: '12th Pass',
    age: '18–33 yrs',
    lastDate: '29 Sep 2026',
    org: 'MPESB',
    dept: 'Forest Department',
  },
  {
    title: 'Assistant Grade III Recruitment 2026',
    slug: 'mp-assistant-grade-3-recruitment-2026',
    status: 'Open',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    vacancies: 980,
    qualification: 'Graduation + CPCT',
    age: '18–40 yrs',
    lastDate: '18 Oct 2026',
    org: 'MP High Court',
    dept: 'Judiciary',
  },
  {
    title: 'Lab Technician Recruitment 2026',
    slug: 'mp-lab-technician-recruitment-2026',
    status: 'Upcoming',
    statusColor: 'bg-blue-50 text-blue-700 border-blue-200',
    vacancies: 240,
    qualification: 'Diploma (DMLT)',
    age: '21–40 yrs',
    lastDate: '02 Nov 2026',
    org: 'Department of Health',
    dept: 'Public Health Department',
  },
];
---

<BaseLayout
  title="Government Jobs in Madhya Pradesh — NIRNAY"
  description="Browse open, upcoming and recently closed Madhya Pradesh government opportunities with deterministic criteria filters."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Jobs</span>
    </nav>

    <!-- Page Title & Search Header -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Government Jobs in Madhya Pradesh
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Browse open, upcoming and recently closed opportunities.
      </p>

      <div class="mt-5 max-w-2xl">
        <label class="rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 shadow-2xs focus-within:border-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            type="search"
            defaultValue="Police"
            placeholder="Search by job title, department or exam..."
            class="bg-transparent text-foreground text-sm outline-none flex-1"
          />
        </label>
      </div>
    </div>

    <!-- Layout: Left Filters (1 Col) + Right Listings (3 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Filter Panel -->
      <aside class="space-y-5 bg-card p-5 rounded-2xl border border-border h-fit">
        <div class="flex items-center justify-between pb-3 border-b border-border">
          <span class="text-xs font-bold text-foreground uppercase tracking-wider">Filters</span>
          <button type="button" class="text-[11px] text-primary hover:underline font-medium">Reset all</button>
        </div>

        <!-- Active Filter Chips -->
        <div>
          <span class="text-[11px] text-muted-foreground font-semibold block mb-2">Active filters:</span>
          <div class="flex flex-wrap gap-1.5">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium">
              10th Pass <span class="cursor-pointer">&times;</span>
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 text-xs font-medium border border-emerald-200">
              Open <span class="cursor-pointer">&times;</span>
            </span>
          </div>
        </div>

        <!-- Filter Selects -->
        <div class="space-y-4 text-xs">
          <div>
            <label class="font-bold text-foreground block mb-1.5">Qualification</label>
            <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none">
              <option>10th Pass (Selected)</option>
              <option>12th Pass</option>
              <option>Graduate</option>
              <option>Diploma</option>
              <option>Post Graduate</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Sector</label>
            <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none">
              <option>Police (Selected)</option>
              <option>Forest</option>
              <option>Education</option>
              <option>Health</option>
              <option>Judiciary</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Organisation</label>
            <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none">
              <option>All Organisations</option>
              <option>MPESB (Vyapam)</option>
              <option>MPPSC</option>
              <option>MP High Court</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Age Bracket</label>
            <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none">
              <option>18–33 years</option>
              <option>18–40 years</option>
              <option>Up to 45 years (Reserved)</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Application Status</label>
            <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none">
              <option>Open (Applications Active)</option>
              <option>Closing Soon (&lt; 7 Days)</option>
              <option>Upcoming</option>
            </select>
          </div>
        </div>
      </aside>

      <!-- Right Content Area -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Content Header -->
        <div class="flex items-center justify-between pb-3 border-b border-border">
          <span class="text-xs font-semibold text-foreground">
            Showing <strong class="text-primary font-bold">128 opportunities</strong>
          </span>
          <div class="flex items-center gap-2 text-xs">
            <span class="text-muted-foreground">Sort by:</span>
            <select class="p-1.5 rounded-md bg-background border border-border text-foreground text-xs font-medium">
              <option>Closing date (Earliest first)</option>
              <option>Vacancies (High to Low)</option>
              <option>Recently Added</option>
            </select>
          </div>
        </div>

        <!-- Cards List -->
        <div class="space-y-4">
          {sampleOpportunities.map((job) => (
            <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-sm hover:border-border/80 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class={`px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider border ${job.statusColor}`}>
                    {job.status}
                  </span>
                  <span class="text-xs text-muted-foreground font-medium">
                    {job.org} · {job.dept}
                  </span>
                </div>
                <span class="text-xs font-mono font-bold text-foreground">
                  Last date: {job.lastDate}
                </span>
              </div>

              <h2 class="text-lg font-bold text-foreground mb-2">
                <a href={`/recruitments/${job.slug}`} class="hover:text-primary transition-colors">
                  {job.title}
                </a>
              </h2>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-3 px-4 rounded-xl bg-muted/40 border border-border mb-4 text-xs">
                <div>
                  <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Vacancies</span>
                  <span class="font-bold text-foreground font-mono">{job.vacancies.toLocaleString()}</span>
                </div>
                <div>
                  <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Qualification</span>
                  <span class="font-medium text-foreground">{job.qualification}</span>
                </div>
                <div>
                  <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Age Bracket</span>
                  <span class="font-medium text-foreground">{job.age}</span>
                </div>
                <div>
                  <span class="text-muted-foreground block text-[10px] uppercase font-semibold">State Domicile</span>
                  <span class="font-medium text-foreground">MP Resident</span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-2">
                <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Official source verified
                </span>
                <a
                  href={`/recruitments/${job.slug}`}
                  class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold transition-colors flex items-center gap-1.5"
                >
                  <span>View details</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Note & Pagination -->
        <div class="pt-4 border-t border-border flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground gap-4">
          <p>Dates and eligibility are summarised from official notifications.</p>
          <div class="flex items-center gap-2">
            <button class="px-3 py-1.5 rounded border border-border hover:bg-muted disabled:opacity-40" disabled>Previous</button>
            <span class="px-3 py-1.5 rounded bg-primary text-primary-foreground font-bold">1</span>
            <button class="px-3 py-1.5 rounded border border-border hover:bg-muted">2</button>
            <button class="px-3 py-1.5 rounded border border-border hover:bg-muted">3</button>
            <button class="px-3 py-1.5 rounded border border-border hover:bg-muted">Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
