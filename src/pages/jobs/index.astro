---
// src/pages/jobs/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments, getAllSectors } from '../../db/queries';

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim();
const qualification = url.searchParams.get('qualification') || '';
const sector = url.searchParams.get('sector') || '';
const org = url.searchParams.get('org') || '';
const status = url.searchParams.get('status') || '';
const sort = url.searchParams.get('sort') || 'closing_asc';

const [allRecruitments, allSectors] = await Promise.all([
  getAllActiveRecruitments(),
  getAllSectors(),
]);

// Filter recruitments dynamically
let filteredRecruitments = allRecruitments.filter((job) => {
  if (q) {
    const query = q.toLowerCase();
    const matchTitle = job.title.toLowerCase().includes(query);
    const matchPost = job.postTitle?.toLowerCase().includes(query);
    const matchOrg = job.organisationShortName?.toLowerCase().includes(query) || job.organisationName?.toLowerCase().includes(query);
    const matchAdvt = job.advtNumber?.toLowerCase().includes(query);
    const matchSummary = job.shortSummary?.toLowerCase().includes(query);
    if (!matchTitle && !matchPost && !matchOrg && !matchAdvt && !matchSummary) {
      return false;
    }
  }

  if (qualification && job.criteria.minQualificationLevel !== qualification) {
    return false;
  }

  if (org && job.organisationShortName !== org) {
    return false;
  }

  if (status) {
    if (status === 'OPEN') {
      if (job.resolvedLifecycle !== 'APPLICATION_OPEN' && job.resolvedLifecycle !== 'APPLICATION_CLOSING' && job.lifecycleStatus !== 'OPEN') {
        return false;
      }
    } else if (status === 'CLOSING_SOON') {
      if (job.resolvedLifecycle !== 'APPLICATION_CLOSING') {
        return false;
      }
    } else if (status === 'UPCOMING') {
      if (job.resolvedLifecycle !== 'NOT_STARTED' && job.lifecycleStatus !== 'UPCOMING') {
        return false;
      }
    } else if (status === 'CLOSED' || status === 'CONCLUDED') {
      if (
        job.resolvedLifecycle === 'APPLICATION_OPEN' ||
        job.resolvedLifecycle === 'APPLICATION_CLOSING' ||
        job.resolvedLifecycle === 'NOT_STARTED'
      ) {
        return false;
      }
    } else if (job.resolvedLifecycle !== status && job.lifecycleStatus !== status) {
      return false;
    }
  }

  return true;
});

// Sort recruitments
if (sort === 'vacancies_desc') {
  filteredRecruitments.sort((a, b) => (b.totalVacancies || 0) - (a.totalVacancies || 0));
} else if (sort === 'closing_asc') {
  filteredRecruitments.sort((a, b) => {
    const dateA = a.applicationEnd || '9999-12-31';
    const dateB = b.applicationEnd || '9999-12-31';
    return dateA.localeCompare(dateB);
  });
} else if (sort === 'recent') {
  filteredRecruitments.sort((a, b) => b.cycleYear - a.cycleYear);
}

// Format date helper
function formatDate(dateStr?: string): string {
  if (!dateStr) return 'Refer Notice';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Active filters count
const hasActiveFilters = Boolean(q || qualification || org || status);
---

<BaseLayout
  title="Government Jobs Across India — NIRNAY"
  description="Browse open, upcoming, and recently closed central and state government opportunities with verified official links."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Jobs</span>
    </nav>

    <!-- Page Title & Search Header -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Government Jobs Across India
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Browse open, upcoming and verified state opportunities from official gazettes.
      </p>

      <div class="mt-5 max-w-2xl">
        <form method="GET" action="/jobs" class="flex gap-2">
          {qualification && <input type="hidden" name="qualification" value={qualification} />}
          {org && <input type="hidden" name="org" value={org} />}
          {status && <input type="hidden" name="status" value={status} />}
          {sort && <input type="hidden" name="sort" value={sort} />}
          <label class="flex-1 rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 shadow-2xs focus-within:border-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Search by job title, department or exam..."
              class="bg-transparent text-foreground text-sm outline-none flex-1"
            />
          </label>
          <button
            type="submit"
            class="px-5 h-11 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:bg-blue-700 transition-colors shrink-0"
          >
            Search
          </button>
        </form>
      </div>
    </div>

    <!-- Layout: Left Filters (1 Col) + Right Listings (3 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Filter Panel -->
      <aside class="space-y-5 bg-card p-5 rounded-2xl border border-border h-fit">
        <div class="flex items-center justify-between pb-3 border-b border-border">
          <span class="text-xs font-bold text-foreground uppercase tracking-wider">Filters</span>
          {hasActiveFilters && (
            <a href="/jobs" class="text-[11px] text-primary hover:underline font-medium">Reset all</a>
          )}
        </div>

        <!-- Active Filter Chips -->
        {hasActiveFilters && (
          <div>
            <span class="text-[11px] text-muted-foreground font-semibold block mb-2">Active filters:</span>
            <div class="flex flex-wrap gap-1.5">
              {q && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(qualification ? { qualification } : {}), ...(org ? { org } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium hover:bg-primary/20 transition-colors"
                >
                  "{q}" <span class="text-xs">&times;</span>
                </a>
              )}
              {qualification && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(org ? { org } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium hover:bg-primary/20 transition-colors"
                >
                  {qualification} <span class="text-xs">&times;</span>
                </a>
              )}
              {org && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(qualification ? { qualification } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium hover:bg-primary/20 transition-colors"
                >
                  {org} <span class="text-xs">&times;</span>
                </a>
              )}
              {status && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(qualification ? { qualification } : {}), ...(org ? { org } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 text-xs font-medium border border-emerald-200 hover:bg-emerald-100 transition-colors"
                >
                  {status} <span class="text-xs">&times;</span>
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Filter Selects Form -->
        <form method="GET" action="/jobs" class="space-y-4 text-xs">
          {q && <input type="hidden" name="q" value={q} />}
          {sort && <input type="hidden" name="sort" value={sort} />}

          <div>
            <label class="font-bold text-foreground block mb-1.5">Qualification</label>
            <select
              name="qualification"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none cursor-pointer"
            >
              <option value="">All Qualifications</option>
              <option value="10TH" selected={qualification === '10TH'}>10th Pass (Matriculation)</option>
              <option value="12TH" selected={qualification === '12TH'}>12th Pass (Higher Secondary)</option>
              <option value="DIPLOMA" selected={qualification === 'DIPLOMA'}>Diploma (Polytechnic / DMLT)</option>
              <option value="GRADUATION" selected={qualification === 'GRADUATION'}>Graduation (Degree)</option>
              <option value="POST_GRADUATION" selected={qualification === 'POST_GRADUATION'}>Post Graduation</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Organisation</label>
            <select
              name="org"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none cursor-pointer"
            >
              <option value="">All Organisations</option>
              <option value="MPESB" selected={org === 'MPESB'}>MPESB (Bhopal)</option>
              <option value="MPPSC" selected={org === 'MPPSC'}>MPPSC (Indore)</option>
              <option value="MPHC" selected={org === 'MPHC'}>MP High Court (Jabalpur)</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Application Status</label>
            <select
              name="status"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none cursor-pointer"
            >
              <option value="">All Statuses</option>
              <option value="OPEN" selected={status === 'OPEN'}>Open (Applications Active)</option>
              <option value="CLOSING_SOON" selected={status === 'CLOSING_SOON'}>Closing Soon (&le; 7 Days)</option>
              <option value="UPCOMING" selected={status === 'UPCOMING'}>Upcoming Drives</option>
              <option value="CONCLUDED" selected={status === 'CONCLUDED' || status === 'CLOSED'}>Concluded (Exams / Results)</option>
            </select>
          </div>
        </form>

        <div class="pt-4 border-t border-border">
          <a
            href="/eligibility-checker"
            class="w-full py-2 px-3 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary font-semibold text-xs text-center block transition-colors"
          >
            Instant Eligibility Check &rarr;
          </a>
        </div>
      </aside>

      <!-- Right Content Area -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Content Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-border">
          <span class="text-xs font-semibold text-foreground">
            Showing <strong class="text-primary font-bold">{filteredRecruitments.length} opportunities</strong>
          </span>
          <div class="flex items-center gap-2 text-xs">
            <span class="text-muted-foreground">Sort by:</span>
            <form method="GET" action="/jobs" class="inline">
              {q && <input type="hidden" name="q" value={q} />}
              {qualification && <input type="hidden" name="qualification" value={qualification} />}
              {org && <input type="hidden" name="org" value={org} />}
              {status && <input type="hidden" name="status" value={status} />}
              <select
                name="sort"
                onchange="this.form.submit()"
                class="p-1.5 rounded-md bg-background border border-border text-foreground text-xs font-medium cursor-pointer"
              >
                <option value="closing_asc" selected={sort === 'closing_asc'}>Closing date (Earliest first)</option>
                <option value="vacancies_desc" selected={sort === 'vacancies_desc'}>Vacancies (High to Low)</option>
                <option value="recent" selected={sort === 'recent'}>Recently Added</option>
              </select>
            </form>
          </div>
        </div>

        <!-- Cards List -->
        {filteredRecruitments.length === 0 ? (
          <div class="bg-card rounded-2xl border border-border p-12 text-center">
            <h3 class="text-base font-bold text-foreground mb-1">No opportunities match your search</h3>
            <p class="text-xs text-muted-foreground mb-4">Try clearing filters or searching with a different term.</p>
            <a
              href="/jobs"
              class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold inline-block hover:bg-blue-700 transition-colors"
            >
              Clear all filters
            </a>
          </div>
        ) : (
          <div class="space-y-4">
            {filteredRecruitments.map((job) => {
              const statusColor = job.lifecycleStatus === 'OPEN'
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                : job.lifecycleStatus === 'UPCOMING'
                ? 'bg-blue-50 text-blue-700 border-blue-200'
                : 'bg-muted text-muted-foreground border-border';

              return (
                <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-sm hover:border-border/80 transition-all">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div class="flex items-center gap-2">
                      <span class={`px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider border ${job.presentation?.badgeClass || 'bg-muted text-muted-foreground border-border'}`}>
                        {job.presentation?.label || job.lifecycleStatus}
                      </span>
                      <span class="text-xs text-muted-foreground font-medium">
                        {job.organisationShortName} · {job.postTitle}
                      </span>
                    </div>
                    <span class="text-xs font-mono font-bold text-foreground">
                      Last date: {formatDate(job.applicationEnd)}
                    </span>
                  </div>

                  <h2 class="text-lg font-bold text-foreground mb-2">
                    <a href={`/recruitments/${job.slug}`} class="hover:text-primary transition-colors">
                      {job.title}
                    </a>
                  </h2>

                  <p class="text-xs text-muted-foreground mb-4 line-clamp-2">
                    {job.shortSummary}
                  </p>

                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-3 px-4 rounded-xl bg-muted/40 border border-border mb-4 text-xs">
                    <div>
                      <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Vacancies</span>
                      <span class="font-bold text-foreground font-mono">{job.totalVacancies?.toLocaleString() || 'N/A'}</span>
                    </div>
                    <div>
                      <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Min Qualification</span>
                      <span class="font-medium text-foreground">{job.criteria.minQualificationLevel}</span>
                    </div>
                    <div>
                      <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Age Bracket</span>
                      <span class="font-medium text-foreground">{job.criteria.minAge}–{job.criteria.maxAgeGeneral} yrs</span>
                    </div>
                    <div>
                      <span class="text-muted-foreground block text-[10px] uppercase font-semibold">State Domicile</span>
                      <span class="font-medium text-foreground">{job.criteria.requiresMpDomicile ? `${job.stateCode || 'State'} domicile` : 'All India'}</span>
                    </div>
                  </div>

                  <div class="flex items-center justify-between pt-2">
                    <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      Official source verified ({job.advtNumber})
                    </span>
                    <a
                      href={`/recruitments/${job.slug}`}
                      class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold transition-colors flex items-center gap-1.5"
                    >
                      <span>View details & criteria</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <!-- Note footer -->
        <div class="pt-4 border-t border-border flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground gap-4">
          <p>Dates and eligibility are summarised strictly from verified state gazettes.</p>
          <a href="/disclaimer" class="hover:underline">Legal Disclaimer & Source Policy &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
