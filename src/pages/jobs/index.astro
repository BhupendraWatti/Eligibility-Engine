---
import { advtLabel } from '../../services/advt-number';
// src/pages/jobs/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments, getAllSectors } from '../../db/queries';

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim();
const qualification = url.searchParams.get('qualification') || '';
const sector = url.searchParams.get('sector') || '';
const org = url.searchParams.get('org') || '';
const status = url.searchParams.get('status') || '';
const sort = url.searchParams.get('sort') || 'closing_asc';

const [allRecruitments, allSectors] = await Promise.all([
  getAllActiveRecruitments(),
  getAllSectors(),
]);

// Filter recruitments dynamically
let filteredRecruitments = allRecruitments.filter((job) => {
  if (q) {
    const query = q.toLowerCase();
    const matchTitle = job.title.toLowerCase().includes(query);
    const matchPost = job.postTitle?.toLowerCase().includes(query);
    const matchOrg = job.organisationShortName?.toLowerCase().includes(query) || job.organisationName?.toLowerCase().includes(query);
    const matchAdvt = job.advtNumber?.toLowerCase().includes(query);
    const matchSummary = job.shortSummary?.toLowerCase().includes(query);
    if (!matchTitle && !matchPost && !matchOrg && !matchAdvt && !matchSummary) {
      return false;
    }
  }

  if (qualification && job.criteria.minQualificationLevel !== qualification) {
    return false;
  }

  if (org && job.organisationShortName !== org) {
    return false;
  }

  if (status) {
    if (status === 'OPEN') {
      if (job.resolvedLifecycle !== 'APPLICATION_OPEN' && job.resolvedLifecycle !== 'APPLICATION_CLOSING' && job.lifecycleStatus !== 'OPEN') {
        return false;
      }
    } else if (status === 'CLOSING_SOON') {
      if (job.resolvedLifecycle !== 'APPLICATION_CLOSING') {
        return false;
      }
    } else if (status === 'UPCOMING') {
      if (job.resolvedLifecycle !== 'NOT_STARTED' && job.lifecycleStatus !== 'UPCOMING') {
        return false;
      }
    } else if (status === 'CLOSED' || status === 'CONCLUDED') {
      if (
        job.resolvedLifecycle === 'APPLICATION_OPEN' ||
        job.resolvedLifecycle === 'APPLICATION_CLOSING' ||
        job.resolvedLifecycle === 'NOT_STARTED'
      ) {
        return false;
      }
    } else if (job.resolvedLifecycle !== status && job.lifecycleStatus !== status) {
      return false;
    }
  }

  return true;
});

// Sort recruitments
if (sort === 'vacancies_desc') {
  filteredRecruitments.sort((a, b) => (b.totalVacancies || 0) - (a.totalVacancies || 0));
} else if (sort === 'closing_asc') {
  filteredRecruitments.sort((a, b) => {
    const dateA = a.applicationEnd || '9999-12-31';
    const dateB = b.applicationEnd || '9999-12-31';
    return dateA.localeCompare(dateB);
  });
} else if (sort === 'recent') {
  filteredRecruitments.sort((a, b) => b.cycleYear - a.cycleYear);
}

// Format date helper
function formatDate(dateStr?: string): string {
  if (!dateStr) return 'Refer Notice';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Active filters count
const hasActiveFilters = Boolean(q || qualification || org || status);
---

<BaseLayout
  title="Government Jobs & Active Recruitment Drives - NIRNAY"
  description="Browse open, upcoming, and verified central and state government recruitment opportunities from official gazettes."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-semibold">Jobs Directory</span>
    </nav>

    <!-- Page Title & Search Header -->
    <div class="mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-primary font-mono block mb-1">
            Central & State Gazetted Notices
          </span>
          <h1 class="text-2xl sm:text-4xl font-black text-foreground tracking-tight font-heading">
            Government Recruitment Directory
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1.5 max-w-2xl leading-relaxed">
            Browse verified opportunities across all 28 states, 8 union territories, and central commissions with direct application links.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2">
          <a
            href="/eligibility-checker"
            class="px-4 py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-xs inline-flex items-center gap-2 transition-colors shadow-2xs"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Match Your Profile</span>
          </a>
        </div>
      </div>

      <!-- Search Input Bar -->
      <div class="mt-6 max-w-3xl">
        <form method="GET" action="/jobs" class="flex gap-2">
          {qualification && <input type="hidden" name="qualification" value={qualification} />}
          {org && <input type="hidden" name="org" value={org} />}
          {status && <input type="hidden" name="status" value={status} />}
          {sort && <input type="hidden" name="sort" value={sort} />}
          <label class="flex-1 rounded-2xl bg-card border border-input flex px-4 items-center gap-3 h-12 shadow-2xs focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Search by job title, commission, or cadre (e.g. Constable, Patwari, Sub Inspector)..."
              class="bg-transparent text-foreground text-sm outline-none flex-1 min-w-0 placeholder:text-muted-foreground/70"
            />
          </label>
          <button
            type="submit"
            class="px-5 sm:px-6 h-12 rounded-2xl bg-primary hover:bg-primary-hover text-primary-foreground text-xs sm:text-sm font-bold transition-colors shrink-0 shadow-sm"
          >
            Search
          </button>
        </form>
      </div>
    </div>

    <!-- Layout: Left Filters + Right Listings -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8 items-start">
      <!-- Left Filter Panel (Collapsible Accordion on Mobile, Sticky on Desktop) -->
      <aside class="bg-card p-5 rounded-2xl border border-border lg:sticky lg:top-20 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-border">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
            <span class="text-xs font-bold text-foreground uppercase tracking-wider">Filters</span>
          </div>
          {hasActiveFilters && (
            <a href="/jobs" class="text-[11px] text-primary hover:underline font-bold">Reset all</a>
          )}
        </div>

        <!-- Active Filter Chips -->
        {hasActiveFilters && (
          <div>
            <span class="text-[11px] text-muted-foreground font-semibold block mb-2">Active filters:</span>
            <div class="flex flex-wrap gap-1.5">
              {q && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(qualification ? { qualification } : {}), ...(org ? { org } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors"
                >
                  <span>"{q}"</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </a>
              )}
              {qualification && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(org ? { org } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors"
                >
                  <span>{qualification}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </a>
              )}
              {org && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(qualification ? { qualification } : {}), ...(status ? { status } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors"
                >
                  <span>{org}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </a>
              )}
              {status && (
                <a
                  href={`/jobs?${new URLSearchParams({ ...(q ? { q } : {}), ...(qualification ? { qualification } : {}), ...(org ? { org } : {}), ...(sort ? { sort } : {}) })}`}
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200 hover:bg-emerald-100 transition-colors"
                >
                  <span>{status}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Filter Selects Form -->
        <form method="GET" action="/jobs" class="space-y-4 text-xs">
          {q && <input type="hidden" name="q" value={q} />}
          {sort && <input type="hidden" name="sort" value={sort} />}

          <div>
            <label class="font-bold text-foreground block mb-1.5">Educational Qualification</label>
            <select
              name="qualification"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-xl bg-background border border-input text-foreground outline-none cursor-pointer focus:border-primary transition-colors text-xs font-medium"
            >
              <option value="">All Qualifications</option>
              <option value="10TH" selected={qualification === '10TH'}>10th Pass (Matriculation)</option>
              <option value="12TH" selected={qualification === '12TH'}>12th Pass (Intermediate / 10+2)</option>
              <option value="DIPLOMA" selected={qualification === 'DIPLOMA'}>Diploma (Polytechnic / Technical)</option>
              <option value="GRADUATION" selected={qualification === 'GRADUATION'}>Graduation (Bachelor Degree)</option>
              <option value="POST_GRADUATION" selected={qualification === 'POST_GRADUATION'}>Post Graduation (Master Degree)</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Recruiting Organisation</label>
            <select
              name="org"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-xl bg-background border border-input text-foreground outline-none cursor-pointer focus:border-primary transition-colors text-xs font-medium"
            >
              <option value="">All Authorities</option>
              <option value="MPESB" selected={org === 'MPESB'}>MPESB (Bhopal)</option>
              <option value="MPPSC" selected={org === 'MPPSC'}>MPPSC (Indore)</option>
              <option value="MPHC" selected={org === 'MPHC'}>MP High Court (Jabalpur)</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-foreground block mb-1.5">Application Lifecycle State</label>
            <select
              name="status"
              onchange="this.form.submit()"
              class="w-full p-2.5 rounded-xl bg-background border border-input text-foreground outline-none cursor-pointer focus:border-primary transition-colors text-xs font-medium"
            >
              <option value="">All Lifecycle States</option>
              <option value="OPEN" selected={status === 'OPEN'}>Open (Registration Active)</option>
              <option value="CLOSING_SOON" selected={status === 'CLOSING_SOON'}>Closing Soon (Within 7 Days)</option>
              <option value="UPCOMING" selected={status === 'UPCOMING'}>Upcoming Recruitment Notices</option>
              <option value="CONCLUDED" selected={status === 'CONCLUDED' || status === 'CLOSED'}>Concluded (Exams / Results)</option>
            </select>
          </div>
        </form>

        <div class="pt-3 border-t border-border">
            <a
              href="/eligibility-checker"
              class="w-full py-2.5 px-3 rounded-xl bg-primary/10 hover:bg-primary/20 text-primary font-bold text-xs text-center transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>Check Your Eligibility Now</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>
      </aside>

      <!-- Right Content Area: Opportunities List -->
      <div class="lg:col-span-3 space-y-5">
        <!-- Content Header & Sort -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-border">
          <span class="text-xs font-bold text-foreground">
            Showing <strong class="text-primary font-black font-mono">{filteredRecruitments.length}</strong> opportunities
          </span>
          <div class="flex items-center gap-2 text-xs">
            <span class="text-muted-foreground font-medium">Sort by:</span>
            <form method="GET" action="/jobs" class="inline">
              {q && <input type="hidden" name="q" value={q} />}
              {qualification && <input type="hidden" name="qualification" value={qualification} />}
              {org && <input type="hidden" name="org" value={org} />}
              {status && <input type="hidden" name="status" value={status} />}
              <select
                name="sort"
                onchange="this.form.submit()"
                class="p-1.5 px-2 rounded-lg bg-background border border-input text-foreground text-xs font-semibold cursor-pointer focus:border-primary outline-none"
              >
                <option value="closing_asc" selected={sort === 'closing_asc'}>Closing date (Earliest first)</option>
                <option value="vacancies_desc" selected={sort === 'vacancies_desc'}>Vacancies (Highest first)</option>
                <option value="recent" selected={sort === 'recent'}>Recently Added</option>
              </select>
            </form>
          </div>
        </div>

        <!-- Cards List -->
        {filteredRecruitments.length === 0 ? (
          <div class="bg-card rounded-2xl border border-border p-10 sm:p-14 text-center">
            <div class="size-12 rounded-2xl bg-muted border border-border flex items-center justify-center mx-auto mb-3 text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-base font-bold text-foreground mb-1">No opportunities match current criteria</h3>
            <p class="text-xs text-muted-foreground mb-4">Try clearing filters or adjusting your search keywords.</p>
            <a
              href="/jobs"
              class="px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-bold inline-block hover:bg-primary-hover transition-colors shadow-sm"
            >
              Clear all filters
            </a>
          </div>
        ) : (
          <div class="space-y-4">
            {filteredRecruitments.map((job) => {
              return (
                <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 hover:shadow-md hover:border-border/80 transition-all flex flex-col justify-between">
                  <div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${job.presentation?.badgeClass || 'bg-muted text-muted-foreground border-border'}`}>
                          {job.presentation?.label || job.lifecycleStatus}
                        </span>
                        <span class="text-xs font-semibold text-muted-foreground">
                          {job.organisationShortName} · {job.postTitle}
                        </span>
                      </div>
                      <span class="text-xs font-mono font-bold text-slate-700">
                        Deadline: {formatDate(job.applicationEnd)}
                      </span>
                    </div>

                    <h2 class="text-base sm:text-xl font-bold text-foreground mb-2 font-heading">
                      <a href={`/recruitments/${job.slug}`} class="hover:text-primary transition-colors">
                        {job.title}
                      </a>
                    </h2>

                    <p class="text-xs text-muted-foreground mb-4 line-clamp-2 leading-relaxed">
                      {job.shortSummary || 'Official public recruitment drive with verified statutory quotas and examination syllabus.'}
                    </p>

                    <!-- Key Metadata Row -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 py-3 px-3.5 sm:px-4 rounded-xl bg-muted/40 border border-border/70 mb-4 text-xs">
                      <div>
                        <span class="text-muted-foreground block text-[10px] uppercase font-bold">Total Vacancies</span>
                        <span class="font-bold text-foreground font-mono text-sm">{job.totalVacancies?.toLocaleString() || 'N/A'} Posts</span>
                      </div>
                      <div>
                        <span class="text-muted-foreground block text-[10px] uppercase font-bold">Min Education</span>
                        <span class="font-semibold text-foreground">{job.criteria.minQualificationLevel ? job.criteria.minQualificationLevel.replace(/_/g, ' ') : 'Refer Notice'}</span>
                      </div>
                      <div>
                        <span class="text-muted-foreground block text-[10px] uppercase font-bold">Age Bracket</span>
                        <span class="font-semibold text-foreground font-mono">{job.criteria.minAge}-{job.criteria.maxAgeGeneral} Yrs</span>
                      </div>
                      <div>
                        <span class="text-muted-foreground block text-[10px] uppercase font-bold">Domicile Scope</span>
                        <span class="font-semibold text-foreground">{job.criteria.requiresMpDomicile ? `${job.stateCode || 'State'} Domicile` : 'Open All-India'}</span>
                      </div>
                    </div>
                  </div>

                  <div class="pt-3 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <span class="inline-flex items-center gap-1.5 text-[11px] text-muted-foreground font-medium">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      Verified Notice ({advtLabel(job.advtNumber)})
                    </span>
                    <div class="flex items-center gap-2">
                      <a
                        href={`/recruitments/${job.slug}`}
                        class="px-4 py-2 rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground text-xs font-bold transition-colors inline-flex items-center gap-1.5 shadow-2xs"
                      >
                        <span>View Details</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <!-- Bottom Note -->
        <div class="pt-4 border-t border-border flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground gap-3">
          <p>All dates and quota criteria are derived directly from verified official gazettes.</p>
          <a href="/disclaimer" class="hover:underline font-medium text-primary inline-flex items-center gap-1">
            <span>Non-affiliation notice</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
