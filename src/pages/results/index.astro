---
// src/pages/results/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const results = [
  {
    title: 'MP Police Constable Result 2026 (Physical Test Shortlist)',
    exam: 'MP Police Constable Exam 2026',
    org: 'MPESB (Bhopal)',
    releaseDate: '18 Sep 2026',
    status: 'Released',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    sourceUrl: 'https://esb.mp.gov.in',
  },
  {
    title: 'MPPSC State Service Preliminary Exam Result 2026',
    exam: 'State Service Prelims 2026',
    org: 'MPPSC (Indore)',
    releaseDate: '12 Sep 2026',
    status: 'Released',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    sourceUrl: 'https://mppsc.mp.gov.in',
  },
  {
    title: 'Assistant Grade III Written Examination Result 2026',
    exam: 'District Judiciary AG-III Exam 2026',
    org: 'MP High Court',
    releaseDate: 'Expected Oct 2026',
    status: 'Upcoming',
    statusColor: 'bg-blue-50 text-blue-700 border-blue-200',
    sourceUrl: 'https://mphc.gov.in',
  },
];
---

<BaseLayout
  title="Government Examination Results — NIRNAY MP"
  description="Find verified Madhya Pradesh government recruitment exam results, cutoffs, merit lists and direct official scorecard links."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Results</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Recruitment Results
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Access verified result scorecards, merit lists, and cutoff marks.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        <div class="sm:col-span-2">
          <label class="rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              placeholder="Search results by exam, organisation or post..."
              class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1"
            />
          </label>
        </div>

        <div>
          <select class="w-full h-11 px-3 rounded-xl bg-card border border-border text-foreground text-xs font-medium">
            <option>All Organisations (MPESB, MPPSC, MPHC)</option>
            <option>MPESB</option>
            <option>MPPSC</option>
            <option>High Court</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Tabs Strip -->
    <div class="flex items-center gap-6 border-b border-border mb-8 text-xs font-semibold text-muted-foreground">
      <span class="text-primary border-b-2 border-primary pb-3 font-bold -mb-px">Recently Released</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Upcoming Results</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Archived Results (2025)</span>
    </div>

    <!-- Results Cards List -->
    <div class="space-y-4 mb-10">
      {results.map((r) => (
        <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${r.statusColor}`}>
                {r.status}
              </span>
              <span class="text-xs text-muted-foreground font-medium">
                {r.org}
              </span>
            </div>
            <span class="text-xs font-mono font-bold text-foreground">
              {r.releaseDate}
            </span>
          </div>

          <h2 class="text-base font-bold text-foreground mb-1">
            {r.title}
          </h2>
          <p class="text-xs text-muted-foreground mb-4">
            Exam: <strong class="text-foreground">{r.exam}</strong>
          </p>

          <div class="pt-3 border-t border-border flex items-center justify-between">
            <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Official gazette verified
            </span>
            <a
              href={r.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
            >
              <span>View result</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
