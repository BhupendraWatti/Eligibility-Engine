---
// src/pages/results/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

const q = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();
const selectedOrg = (Astro.url.searchParams.get('org') || '').trim();
const selectedExam = (Astro.url.searchParams.get('exam') || '').trim();
const selectedYear = (Astro.url.searchParams.get('year') || '').trim();

const allRecruitments = await getAllActiveRecruitments();

const RESULT_TYPES = ['RESULT', 'SCORECARD', 'MERIT_LIST'];
const KEY_TYPES = ['ANSWER_KEY', 'PROVISIONAL_ANSWER_KEY', 'FINAL_ANSWER_KEY'];
// SSC and UPSC results must point at the commission's own site; any other host is not shown as a result link.
const OFFICIAL_HOST: Record<string, RegExp> = { SSC: /(^|\.)ssc\.gov\.in$/i, UPSC: /(^|\.)upsc\.gov\.in$/i };
const hostOk = (org: string, url: string) => {
  const rule = OFFICIAL_HOST[org];
  if (!rule) return true;
  try { return rule.test(new URL(url).hostname); } catch { return false; }
};

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA';
  const d = new Date(dateStr);
  return Number.isNaN(d.getTime()) ? dateStr : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

// Results are derived from recruitment milestones: a declared status, a RESULT link or a RESULT date.
const all = allRecruitments.filter(r =>
  r.resultStatus === 'DECLARED' ||
  r.officialLinksList?.some(l => RESULT_TYPES.includes(l.linkType) && l.isActive === 1) ||
  r.importantDatesList?.some(d => d.eventType === 'RESULT')
).map((r) => {
  const org = r.organisationShortName || '';
  const resultLinks = (r.officialLinksList ?? []).filter(l => RESULT_TYPES.includes(l.linkType) && l.isActive === 1 && hostOk(org, l.url));
  const keyLink = (r.officialLinksList ?? []).find(l => KEY_TYPES.includes(l.linkType) && l.isActive === 1 && hostOk(org, l.url));
  const resultDates = (r.importantDatesList ?? []).filter(d => d.eventType === 'RESULT').sort((a, b) => (b.date || '').localeCompare(a.date || ''));
  const latest = resultDates[0];
  const isDeclared = r.resolvedLifecycle === 'RESULT_DECLARED' || r.resultStatus === 'DECLARED' || r.lifecycleStatus === 'RESULT_DECLARED';
  return {
    title: r.title,
    exam: r.postTitle || r.title,
    org: `${r.organisationName} (${org})`,
    orgShort: org,
    year: r.cycleYear ? String(r.cycleYear) : '',
    sortDate: latest?.date || '',
    dateText: latest?.date ? formatDate(latest.date) : 'Date not stated',
    details: latest?.notes || '',
    declared: isDeclared,
    links: resultLinks,
    keyUrl: keyLink?.url,
    slug: r.slug,
    vacancies: r.totalVacancies,
  };
}).filter(r => r.declared || r.links.length || r.sortDate);

const orgOptions = [...new Set(all.map(r => r.orgShort).filter(Boolean))].sort();
const examOptions = [...new Set(all.map(r => r.exam))].sort();
const yearOptions = [...new Set(all.map(r => r.year).filter(Boolean))].sort().reverse();

const results = all.filter((r) => {
  if (selectedOrg && r.orgShort !== selectedOrg) return false;
  if (selectedExam && r.exam !== selectedExam) return false;
  if (selectedYear && r.year !== selectedYear) return false;
  if (q) return `${r.title} ${r.exam} ${r.org}`.toLowerCase().includes(q);
  return true;
}).sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---

<BaseLayout
  title="Government Examination Results & Merit Lists"
  description="Find verified central and state government recruitment results, cutoffs, merit lists, and direct official scorecard links."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-semibold">Results & Scorecards</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-primary font-mono block mb-1">
        Official Selection Rosters
      </span>
      <h1 class="text-2xl sm:text-3xl font-black text-foreground tracking-tight font-heading">
        Recruitment Results & Merit Lists
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-2xl">
        Access verified government examination scorecards, selection cutoffs, and provisional selection rosters with direct portal links.
      </p>

      <form method="GET" action="/results" class="grid grid-cols-1 sm:grid-cols-4 gap-3 mt-6">
        <div class="sm:col-span-4">
          <label class="rounded-xl bg-card border border-input flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
            <input type="search" name="q" value={q} placeholder="Search results by exam, authority, or post..." class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1 min-w-0" />
          </label>
        </div>
        <select name="org" onchange="this.form.submit()" class="w-full h-11 px-3 rounded-xl bg-card border border-input text-foreground text-xs font-semibold cursor-pointer focus:border-primary outline-none">
          <option value="">All bodies</option>
          {orgOptions.map((o) => (<option value={o} selected={selectedOrg === o}>{o}</option>))}
        </select>
        <select name="exam" onchange="this.form.submit()" class="sm:col-span-2 w-full h-11 px-3 rounded-xl bg-card border border-input text-foreground text-xs font-semibold cursor-pointer focus:border-primary outline-none">
          <option value="">All exams</option>
          {examOptions.map((e) => (<option value={e} selected={selectedExam === e}>{e}</option>))}
        </select>
        <select name="year" onchange="this.form.submit()" class="w-full h-11 px-3 rounded-xl bg-card border border-input text-foreground text-xs font-semibold cursor-pointer focus:border-primary outline-none">
          <option value="">All years</option>
          {yearOptions.map((y) => (<option value={y} selected={selectedYear === y}>{y}</option>))}
        </select>
      </form>
    </div>

    <!-- Results Cards List -->
    <div class="space-y-4 mb-10">
      {results.length === 0 ? (
        <div class="p-10 rounded-2xl bg-card border border-border text-center">
          <p class="text-xs text-muted-foreground">No result declarations match your criteria.</p>
          <a href="/results" class="text-xs text-primary font-bold hover:underline mt-2 inline-block">Reset filters</a>
        </div>
      ) : (
        results.map((r) => (
          <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 hover:shadow-md transition-all">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border bg-emerald-50 text-emerald-700 border-emerald-200">Declared</span>
                <span class="text-xs text-muted-foreground font-semibold">{r.org}</span>
              </div>
              <span class="text-xs font-mono font-bold text-foreground">{r.dateText}</span>
            </div>
            <h2 class="text-base sm:text-lg font-bold text-foreground mb-1 font-heading">
              <a href={`/recruitments/${r.slug}?from=results`} class="hover:text-primary transition-colors">{r.title}</a>
            </h2>
            <p class="text-xs text-muted-foreground mb-2">Posts: <strong class="text-foreground">{r.vacancies?.toLocaleString() || 'N/A'}</strong></p>
            {r.details && <p class="text-xs text-foreground/80 mb-3">{r.details}</p>}
            <div class="pt-3 border-t border-border flex flex-wrap items-center gap-3">
              <a href={`/recruitments/${r.slug}?from=results`} class="text-xs font-bold text-primary hover:underline">Exam details</a>
              {r.keyUrl && <a href={r.keyUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-primary hover:underline">Answer key</a>}
              {r.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground text-xs font-bold">{l.title}</a>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</BaseLayout>
