---
// src/pages/results/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

const q = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();
const selectedOrg = (Astro.url.searchParams.get('org') || '').trim();

const allRecruitments = await getAllActiveRecruitments();

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Derive results dynamically from all recruitments
const results = allRecruitments.map((r) => {
  const isReleased = r.lifecycleStatus === 'CLOSED';
  return {
    title: `${r.title} — Official Examination Result & Merit List`,
    exam: `${r.postTitle} (${r.advtNumber})`,
    org: `${r.organisationName} (${r.organisationShortName})`,
    orgShort: r.organisationShortName,
    releaseDate: isReleased ? 'Declared' : 'Expected Post Examination',
    status: isReleased ? 'Declared' : 'Pending',
    statusColor: isReleased 
      ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
      : 'bg-blue-50 text-blue-700 border-blue-200',
    sourceUrl: r.organisationUrl || 'https://esb.mp.gov.in',
    slug: r.slug,
    vacancies: r.totalVacancies,
  };
}).filter((r) => {
  if (selectedOrg && r.orgShort !== selectedOrg) return false;
  if (q) {
    return r.title.toLowerCase().includes(q) || r.exam.toLowerCase().includes(q) || r.org.toLowerCase().includes(q);
  }
  return true;
});
---

<BaseLayout
  title="Government Examination Results — NIRNAY MP"
  description="Find verified Madhya Pradesh government recruitment exam results, cutoffs, merit lists and direct official scorecard links."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Results</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Recruitment Results & Merit Lists
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Access official examination scorecards, selection cutoffs, and provisional merit rosters.
      </p>

      <form method="GET" action="/results" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        <div class="sm:col-span-2">
          <label class="rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Search results by exam, organisation or post..."
              class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1"
            />
          </label>
        </div>

        <div>
          <select
            name="org"
            onchange="this.form.submit()"
            class="w-full h-11 px-3 rounded-xl bg-card border border-border text-foreground text-xs font-medium cursor-pointer"
          >
            <option value="">All Authorities (MPESB, MPPSC, MPHC)</option>
            <option value="MPESB" selected={selectedOrg === 'MPESB'}>MPESB (Bhopal)</option>
            <option value="MPPSC" selected={selectedOrg === 'MPPSC'}>MPPSC (Indore)</option>
            <option value="MPHC" selected={selectedOrg === 'MPHC'}>High Court (Jabalpur)</option>
          </select>
        </div>
      </form>
    </div>

    <!-- Results Cards List -->
    <div class="space-y-4 mb-10">
      {results.length === 0 ? (
        <div class="p-8 rounded-2xl bg-card border border-border text-center">
          <p class="text-xs text-muted-foreground">No result declarations match your criteria.</p>
          <a href="/results" class="text-xs text-primary font-semibold hover:underline mt-2 inline-block">Reset filters</a>
        </div>
      ) : (
        results.map((r) => (
          <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${r.statusColor}`}>
                  {r.status}
                </span>
                <span class="text-xs text-muted-foreground font-medium">
                  {r.org}
                </span>
              </div>
              <span class="text-xs font-mono font-bold text-foreground">
                Total Posts: {r.vacancies?.toLocaleString() || 'N/A'}
              </span>
            </div>

            <h2 class="text-base font-bold text-foreground mb-1">
              <a href={`/recruitments/${r.slug}`} class="hover:text-primary transition-colors">
                {r.title}
              </a>
            </h2>
            <p class="text-xs text-muted-foreground mb-4">
              Cadre Examination: <strong class="text-foreground">{r.exam}</strong>
            </p>

            <div class="pt-3 border-t border-border flex flex-wrap items-center justify-between gap-3">
              <a
                href={`/recruitments/${r.slug}`}
                class="text-xs text-primary hover:underline"
              >
                &larr; View recruitment details
              </a>
              <a
                href={r.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
              >
                <span>Access official scorecard</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</BaseLayout>
