---
import { advtLabel } from '../../services/advt-number';
// src/pages/results/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

const q = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();
const selectedOrg = (Astro.url.searchParams.get('org') || '').trim();

const allRecruitments = await getAllActiveRecruitments();

// Recruiting authorities come from the data (all states + centre), not a fixed list.
const orgOptions = [...new Map(
  allRecruitments
    .filter((r) => r.organisationShortName)
    .map((r) => [r.organisationShortName, r.organisationName || r.organisationShortName] as const),
).entries()].sort((a, b) => a[0].localeCompare(b[0]));

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// One card per published result link (Final / Provisional / Merit List / Cut-off / Scorecard).
// Links an admin marked as superseded (a newer result replaced them) are not listed.
const RESULT_LINK_TYPES = ['RESULT', 'SCORECARD', 'MERIT_LIST'];
const RESULT_TYPE_LABELS: Record<string, string> = {
  FINAL: 'Final Result',
  PROVISIONAL: 'Provisional Result',
  MERIT_LIST: 'Merit List',
  CUT_OFF: 'Cut-off',
  SCORECARD: 'Scorecard',
};
const RESULT_TYPE_COLORS: Record<string, string> = {
  FINAL: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  PROVISIONAL: 'bg-amber-50 text-amber-700 border-amber-200',
  MERIT_LIST: 'bg-blue-50 text-blue-700 border-blue-200',
  CUT_OFF: 'bg-blue-50 text-blue-700 border-blue-200',
  SCORECARD: 'bg-blue-50 text-blue-700 border-blue-200',
};

const results = allRecruitments
  .flatMap((r) => {
    const fallbackDate = r.importantDatesList?.find((d) => d.eventType === 'RESULT')?.date;
    return (r.officialLinksList ?? [])
      .filter((l) => RESULT_LINK_TYPES.includes(l.linkType) && l.isActive === 1 && !l.superseded)
      .map((l) => {
        const typeKey = l.resultType || (l.linkType === 'MERIT_LIST' ? 'MERIT_LIST' : l.linkType === 'SCORECARD' ? 'SCORECARD' : '');
        const resultDate = l.declaredOn || fallbackDate || '';
        return {
          title: r.title,
          post: r.postTitle,
          advt: advtLabel(r.advtNumber),
          org: `${r.organisationName} (${r.organisationShortName})`,
          orgShort: r.organisationShortName,
          examDate: r.examDate || '',
          resultDate,
          resultDateText: resultDate ? formatDate(resultDate) : 'Date not stated',
          typeLabel: RESULT_TYPE_LABELS[typeKey] || 'Result',
          statusColor: RESULT_TYPE_COLORS[typeKey] || 'bg-blue-50 text-blue-700 border-blue-200',
          sourceUrl: l.url,
          slug: r.slug,
          vacancies: r.totalVacancies,
        };
      });
  })
  .filter((r) => {
    if (selectedOrg && r.orgShort !== selectedOrg) return false;
    if (q) {
      return [r.title, r.post, r.org, r.typeLabel, r.advt].some((v) => String(v).toLowerCase().includes(q));
    }
    return true;
  })
  // Newest result first; undated results go last.
  .sort((a, b) => (b.resultDate || '').localeCompare(a.resultDate || '') || a.title.localeCompare(b.title));
---

<BaseLayout
  title="Government Examination Results & Merit Lists"
  description="Find verified central and state government recruitment results, cutoffs, merit lists, and direct official scorecard links."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-semibold">Results & Scorecards</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-primary font-mono block mb-1">
        Official Selection Rosters
      </span>
      <h1 class="text-2xl sm:text-3xl font-black text-foreground tracking-tight font-heading">
        Recruitment Results & Merit Lists
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-2xl">
        Access verified government examination scorecards, selection cutoffs, and provisional selection rosters with direct portal links.
      </p>

      <form method="GET" action="/results" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        <div class="sm:col-span-2">
          <label class="rounded-xl bg-card border border-input flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Search results by exam, authority, or post..."
              class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1 min-w-0"
            />
          </label>
        </div>

        <div>
          <select
            name="org"
            onchange="this.form.submit()"
            class="w-full h-11 px-3 rounded-xl bg-card border border-input text-foreground text-xs font-semibold cursor-pointer focus:border-primary outline-none"
          >
            <option value="">All Central & State Authorities</option>
            {orgOptions.map(([short, name]) => (
              <option value={short} selected={selectedOrg === short}>{short} - {name}</option>
            ))}
          </select>
        </div>
      </form>
    </div>

    <!-- Results Cards List -->
    <div class="space-y-4 mb-10">
      {results.length === 0 ? (
        <div class="p-10 rounded-2xl bg-card border border-border text-center">
          <p class="text-xs text-muted-foreground">No result declarations match your criteria.</p>
          <a href="/results" class="text-xs text-primary font-bold hover:underline mt-2 inline-block">Reset filters</a>
        </div>
      ) : (
        results.map((r) => (
          <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 hover:shadow-md hover:border-border/80 transition-all flex flex-col justify-between">
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${r.statusColor}`}>
                    {r.typeLabel}
                  </span>
                  <span class="text-xs text-muted-foreground font-semibold">
                    {r.org}
                  </span>
                </div>
                <span class="text-xs font-mono font-bold text-foreground">
                  Total Posts: {r.vacancies?.toLocaleString() || 'N/A'}
                </span>
              </div>

              <h2 class="text-base sm:text-lg font-bold text-foreground mb-1 font-heading">
                <a href={`/recruitments/${r.slug}`} class="hover:text-primary transition-colors">
                  {r.title}
                </a>
              </h2>
              <p class="text-xs text-muted-foreground mb-4">
                Post: <strong class="text-foreground">{r.post}</strong> ({r.advt}) · Exam: <span class="font-mono">{r.examDate ? formatDate(r.examDate) : 'Date not stated'}</span> · Result: <span class="font-mono">{r.resultDateText}</span>
              </p>
            </div>

            <div class="pt-3 border-t border-border flex flex-wrap items-center justify-between gap-3">
              <a
                href={`/recruitments/${r.slug}`}
                class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1.5"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                <span>View Notice Details</span>
              </a>
              {r.sourceUrl && (
                <a
                  href={r.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2 rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground text-xs font-bold inline-flex items-center gap-1.5 transition-colors shadow-2xs"
                >
                  <span>Official Scorecard Portal</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</BaseLayout>
