---
// src/pages/admit-cards/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

const q = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();

const allRecruitments = await getAllActiveRecruitments();

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA (Refer Portal)';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Derive admit card entries from recruitments with verified exam events
const admitCards = allRecruitments
  .filter(r => Boolean(r.examDate) || r.lifecycleStatus === 'APPLICATION_OPEN' || r.lifecycleStatus === 'OPEN')
  .map(r => {
    const isReleased = r.lifecycleStatus === 'ADMIT_CARD_RELEASED';
    const isExamConcluded = r.lifecycleStatus === 'EXAM_COMPLETED' || r.lifecycleStatus === 'RESULT_DECLARED' || r.lifecycleStatus === 'FINAL_RESULT';
    
    let statusText = 'Not Released';
    let statusColor = 'bg-blue-50 text-blue-700 border-blue-200';
    let availableDateText = r.examDate ? `Expected prior to CBT (${formatDate(r.examDate)})` : 'Not Announced';

    if (isReleased) {
      statusText = 'Released';
      statusColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
      availableDateText = 'Download Active on Official Portal';
    } else if (isExamConcluded) {
      statusText = 'Concluded';
      statusColor = 'bg-muted text-muted-foreground border-border';
      availableDateText = 'Examination Concluded';
    }

    return {
      title: `${r.title} — Admit Card`,
      exam: `${r.postTitle} Written / CBT Examination`,
      org: `${r.organisationName} (${r.organisationShortName})`,
      examDate: formatDate(r.examDate),
      availableDate: availableDateText,
      status: statusText,
      statusColor,
      sourceUrl: r.organisationUrl || 'https://esb.mp.gov.in',
      slug: r.slug,
      advt: r.advtNumber,
    };
  })
  .filter(card => {
    if (!q) return true;
    return card.title.toLowerCase().includes(q) || card.exam.toLowerCase().includes(q) || card.org.toLowerCase().includes(q);
  });
---

<BaseLayout
  title="Admit Cards & Hall Tickets — NIRNAY MP"
  description="Find exam hall tickets and official direct download links for MPESB, MPPSC, and MPHC examinations."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Admit Cards</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Admit Cards & Hall Tickets
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Official hall ticket release schedules and verified authority portal links.
      </p>

      <div class="mt-6 max-w-xl">
        <form method="GET" action="/admit-cards">
          <label class="rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Search by exam or post..."
              class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1"
            />
            {q && (
              <a href="/admit-cards" class="text-xs text-muted-foreground hover:text-foreground">&times;</a>
            )}
          </label>
        </form>
      </div>
    </div>

    <!-- Cards List -->
    <div class="space-y-4 mb-8">
      {admitCards.length === 0 ? (
        <div class="p-8 rounded-2xl bg-card border border-border text-center">
          <p class="text-xs text-muted-foreground">No admit card notices match your search criteria.</p>
        </div>
      ) : (
        admitCards.map((card) => (
          <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${card.statusColor}`}>
                  {card.status}
                </span>
                <span class="text-xs text-muted-foreground font-medium">
                  {card.org}
                </span>
              </div>
              <div class="text-xs font-mono font-medium text-muted-foreground">
                Scheduled Exam: <strong class="text-foreground">{card.examDate}</strong>
              </div>
            </div>

            <h2 class="text-base font-bold text-foreground mb-1">
              <a href={`/recruitments/${card.slug}`} class="hover:text-primary transition-colors">
                {card.title}
              </a>
            </h2>
            <p class="text-xs text-muted-foreground mb-4">
              Hall Ticket Window: <strong class="text-foreground font-mono">{card.availableDate}</strong> · Advt: {card.advt}
            </p>

            <div class="pt-3 border-t border-border flex flex-wrap items-center justify-between gap-3">
              <a
                href={`/recruitments/${card.slug}`}
                class="text-xs font-medium text-primary hover:underline"
              >
                &larr; View recruitment syllabus & pattern
              </a>
              <div class="flex items-center gap-2">
                <a
                  href={card.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
                >
                  <span>Official Download Portal</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Candidate Notice Banner -->
    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>Admit cards must be downloaded strictly from the authorized agency portal. Ensure you carry your original Aadhaar / Voter ID and passport photographs to the test center.</span>
    </div>
  </div>
</BaseLayout>
