---
// src/pages/admit-cards/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const admitCards = [
  {
    title: 'MP Police Constable Admit Card 2026',
    exam: 'Police Constable Written CBT Examination',
    org: 'MPESB (Bhopal)',
    availableDate: '10 Nov 2026',
    examDate: '22 Nov 2026',
    status: 'Upcoming',
    statusColor: 'bg-blue-50 text-blue-700 border-blue-200',
    sourceUrl: 'https://esb.mp.gov.in',
  },
  {
    title: 'MPPSC State Service Prelims Admit Card 2026',
    exam: 'State Service Preliminary Examination',
    org: 'MPPSC (Indore)',
    availableDate: '05 Sep 2026',
    examDate: '15 Sep 2026',
    status: 'Released',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    sourceUrl: 'https://mppsc.mp.gov.in',
  },
  {
    title: 'Forest Guard & Kshetrapal Admit Card 2026',
    exam: 'Forest Guard Recruitment Written Test',
    org: 'MPESB',
    availableDate: 'Expected Oct 2026',
    examDate: 'Nov 2026',
    status: 'Upcoming',
    statusColor: 'bg-amber-50 text-amber-700 border-amber-200',
    sourceUrl: 'https://esb.mp.gov.in',
  },
];
---

<BaseLayout
  title="Admit Cards & Hall Tickets — NIRNAY MP"
  description="Find exam hall tickets and official direct download links for MPESB and MPPSC examinations."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Admit Cards</span>
    </nav>

    <!-- Page Header & Search -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Admit cards
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Find exam hall tickets and official download links.
      </p>

      <div class="mt-6 max-w-xl">
        <label class="rounded-xl bg-card border border-border flex px-3.5 items-center gap-2.5 h-11 focus-within:border-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            type="search"
            placeholder="Search by exam or post..."
            class="bg-transparent text-foreground text-xs sm:text-sm outline-none flex-1"
          />
        </label>
      </div>
    </div>

    <!-- Tabs Strip -->
    <div class="flex items-center gap-6 border-b border-border mb-8 text-xs font-semibold text-muted-foreground">
      <span class="text-primary border-b-2 border-primary pb-3 font-bold -mb-px">Recently Released</span>
      <span class="hover:text-foreground cursor-pointer pb-3">Upcoming</span>
    </div>

    <!-- Cards List -->
    <div class="space-y-4 mb-8">
      {admitCards.map((card) => (
        <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${card.statusColor}`}>
                {card.status}
              </span>
              <span class="text-xs text-muted-foreground font-medium">
                {card.org}
              </span>
            </div>
            <div class="text-xs font-mono font-medium text-muted-foreground">
              Exam: <strong class="text-foreground">{card.examDate}</strong>
            </div>
          </div>

          <h2 class="text-base font-bold text-foreground mb-1">
            {card.title}
          </h2>
          <p class="text-xs text-muted-foreground mb-4">
            Download Available: <strong class="text-foreground font-mono">{card.availableDate}</strong>
          </p>

          <div class="pt-3 border-t border-border flex flex-wrap items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Official portal link
            </span>
            <div class="flex items-center gap-2">
              <a
                href={card.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
              >
                <span>Download admit card</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Candidate Notice Banner -->
    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>Carry the original photo identification and documents listed in the official instructions to the examination venue.</span>
    </div>
  </div>
</BaseLayout>
