---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorCard from '../components/common/SectorCard.astro';
import StatePicker from '../components/common/StatePicker.astro';
import { getAllSectors, getAllCanonicalPosts, calculateSectorActiveDrives } from '../db/queries';
import { calculateRecruitmentMetrics, isActiveDrive, resolveApplicationWindow, resolveMilestonePresentation } from '../services/lifecycle';
import { inRelevanceOrder, loadPublicRecruitments, queryListing } from '../services/public-listing';
import { INDIA_JURISDICTIONS, jurisdictionName } from '../data/india-jurisdictions';
import { homeSeo, currentYear } from '../services/seo';

// Ordering depends on the visitor's state, so this page must never be shared from an edge cache.
Astro.response.headers.set('Cache-Control', 'private, no-store');
const viewerState = Astro.locals.viewerState;
const homeCode = viewerState?.code ?? null;

const [recruitments, dbSectors, allPosts] = await Promise.all([
  loadPublicRecruitments(homeCode),
  getAllSectors(),
  getAllCanonicalPosts(),
]);

// Stats count every loaded recruitment once, independent of the visitor's state.
const activeDrivesBySector = calculateSectorActiveDrives(dbSectors, recruitments, allPosts);

const metrics = calculateRecruitmentMetrics(recruitments);

// Active drives by urgency (soonest closing date), the visitor's state first.
const closingSoonListing = queryListing(recruitments.filter(r => isActiveDrive(r)), { sort: 'closing_asc' }, homeCode);
const closingSoon = inRelevanceOrder(closingSoonListing).slice(0, 3);
const homeHasNoActiveDrives = Boolean(homeCode) && closingSoonListing.tiers?.home.length === 0;
const recentlyReleased = inRelevanceOrder(queryListing(recruitments, {}, homeCode)).slice(0, 3);


function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
  } catch {
    return dateStr;
  }
}

// Derive calendar milestones dynamically using canonical status resolution
const milestones: Array<{ date: string; title: string; desc: string; status: string; statusClass: string; slug: string }> = [];

recruitments.forEach((r) => {
  if ((r.applicationStart || r.applicationEnd) && milestones.length < 3) {
    // Use the whole window: a drive that has not opened yet is "Upcoming", never "Applications Open".
    const presentation = resolveApplicationWindow(r.applicationStart, r.applicationEnd);
    if (!presentation.isPast) {
      const opensLater = presentation.category === 'UPCOMING' && r.applicationStart;
      milestones.push({
        date: formatDate(opensLater ? r.applicationStart : (r.applicationEnd || r.applicationStart)),
        title: r.title,
        desc: presentation.summary,
        status: presentation.label,
        statusClass: presentation.badgeClass,
        slug: r.slug,
      });
    }
  }
  if (r.examDate && milestones.length < 5) {
    const examPresentation = resolveMilestonePresentation(r.examDate, 'EXAM_DATE');
    if (!examPresentation.isPast) {
      milestones.push({
        date: formatDate(r.examDate),
        title: `${r.postTitle} CBT`,
        desc: 'Written examination date',
        status: examPresentation.label,
        statusClass: examPresentation.badgeClass,
        slug: r.slug,
      });
    }
  }
});

const year = currentYear();
const seo = homeSeo(year);
const stateLinks = INDIA_JURISDICTIONS.filter(j => j.code !== 'IN');

// Shown on the page and sent as FAQPage data, so the two never differ.
const faqs = [
  {
    q: 'Is this an official government website?',
    a: 'No. GovtRecruitments is an independent website. We are not part of any government body. We collect jobs only from official sources and link you back to them.',
  },
  {
    q: 'Is it free to use?',
    a: 'Yes. Searching jobs and using the eligibility checker are free, and you do not need to sign up.',
  },
  {
    q: 'How do I find govt jobs in my state?',
    a: "Choose your state at the top of this page, or open your state from the list above. Your state's jobs will then show first.",
  },
  {
    q: `Which government jobs ${year} are open right now?`,
    a: 'The "Open right now" box at the top shows how many recruitments are taking forms today. The Closing Soon list shows the ones with the nearest last date.',
  },
  {
    q: 'Can I apply for a job on this website?',
    a: 'No. Use the "Apply Officially" button on the job page. It takes you to the official form on the government website.',
  },
];

const siteUrl = new URL('/', Astro.url.origin).href;
const jsonLd = [
  {
    '@type': 'WebSite',
    name: 'GovtRecruitments',
    url: siteUrl,
    potentialAction: { '@type': 'SearchAction', target: `${siteUrl}search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalUrl={siteUrl}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="bg-background border-b border-border">
    <div class="grid mx-auto py-10 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 items-center gap-8 lg:gap-12 lg:grid-cols-[1.2fr_0.8fr] max-w-7xl">
      <!-- Left Hero Content -->
      <div class="flex flex-col items-start gap-4 sm:gap-6">
        
        <h1 class="font-black text-foreground text-3xl sm:text-5xl lg:text-6xl leading-[1.1] tracking-normal max-w-2xl font-heading">
          Find government jobs across India <br class="hidden sm:inline" />
          <span class="text-primary">you are eligible to apply for.</span>
        </h1>

        <p class="text-sm sm:text-base lg:text-lg text-muted-foreground leading-relaxed max-w-xl">
          Verified official gazette notifications, statutory age relaxations, and direct application links for all central and state recruitment drives.
        </p>

        <StatePicker viewerState={viewerState} action="/" id="home-state-picker" />

        <!-- CTA Buttons: 3 Core Tasks -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1 w-full sm:w-auto">
          <a
            href="/eligibility-checker"
            class="font-bold rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground text-sm px-6 py-3.5 shadow-sm transition-all flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Check My Eligibility</span>
          </a>
          <a
            href="#closing-soon"
            class="font-semibold rounded-xl text-foreground bg-card hover:bg-muted text-sm px-5 py-3.5 border border-border transition-colors flex items-center justify-center gap-2 shadow-2xs"
          >
            <span>Browse Active Jobs ({metrics.activeDriveCount})</span>
          </a>
          <a
            href="/calendar"
            class="font-semibold rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted text-sm px-4 py-3.5 transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Exam Calendar</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Live ledger -->
      <div class="w-full border-t-2 border-primary bg-card pt-5 sm:pt-6 pb-5 sm:pb-6 px-5 sm:px-6">
        <div class="flex items-baseline justify-between gap-3 mb-1">
          <h2 class="text-base font-bold text-foreground font-heading">Open right now</h2>
          <span class="text-xs text-muted-foreground">Updated as drives are published</span>
        </div>
        <p class="font-heading font-black text-5xl sm:text-6xl text-primary leading-none mt-5">
          {metrics.activeDriveCount}
          <span class="text-base font-bold text-foreground ml-1">{metrics.activeDriveCount === 1 ? 'drive' : 'drives'} accepting applications</span>
        </p>

        <dl class="mt-7 divide-y divide-border border-y border-border text-sm">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Vacancies open to apply</dt>
            <dd class="font-bold text-foreground tabular-nums">{metrics.activeVacancyCount.toLocaleString()}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Announced, not yet open</dt>
            <dd class="font-bold text-foreground tabular-nums">{metrics.upcomingVacancyCount.toLocaleString()} <span class="font-normal text-muted-foreground">in {metrics.upcomingDriveCount} {metrics.upcomingDriveCount === 1 ? 'drive' : 'drives'}</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Coverage</dt>
            <dd class="font-semibold text-foreground">Central, 28 states, 8 UTs</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Rules applied</dt>
            <dd class="font-semibold text-foreground">Each gazette's own criteria</dd>
          </div>
        </dl>

        <a href="/eligibility-checker" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">
          <span>Check which of these you qualify for</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Search Bar & Shortcut Chips -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 sm:pb-14">
      <form action="/search" method="get" class="relative max-w-4xl mx-auto mb-4">
        <div class="flex items-center rounded-2xl bg-card border border-input shadow-sm p-1.5 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
          <div class="pl-3.5 pr-2 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input
            type="search"
            name="q"
            placeholder="Search by exam, department, state, or post (e.g. Police, Patwari, SSC, Teaching)"
            class="w-full bg-transparent text-foreground text-sm sm:text-base outline-none py-2 pr-3 placeholder:text-muted-foreground/70"
          />
          <button
            type="submit"
            class="shrink-0 px-4 sm:px-5 py-2.5 bg-primary hover:bg-primary-hover text-primary-foreground font-bold rounded-xl text-xs sm:text-sm transition-colors"
          >
            Search
          </button>
        </div>
      </form>

      <!-- Shortcut chips: wrap on phones so none hide off-screen -->
      <div class="flex flex-wrap items-center gap-x-1.5 max-w-4xl mx-auto py-1">
        <span class="text-xs text-muted-foreground font-semibold shrink-0 mr-1">Popular:</span>
        {['10th Pass', '12th Pass', 'ITI', 'Diploma', 'Graduate', 'Police', 'Civil Services', 'Teaching', 'Judiciary', 'Health'].map((chip) => (
          <a
            href={`/search?q=${encodeURIComponent(chip)}`}
            class="px-1.5 py-2.5 text-xs font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-primary hover:text-primary transition-colors shrink-0"
          >
            {chip}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Closing Soon -->
  <section id="closing-soon" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-foreground tracking-normal font-heading">
          Closing Soon Applications
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">
          Government recruitments with official application deadlines in the coming days.
        </p>
      </div>

      <a href="/calendar" class="text-xs sm:text-sm font-bold text-primary hover:underline flex items-center gap-1">
        <span>View all in Exam Calendar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {homeHasNoActiveDrives && closingSoon.length > 0 && (
      <p class="mb-4 text-xs text-muted-foreground">
        No current recruitments from <strong class="text-foreground">{jurisdictionName(homeCode)}</strong>. Central and open-to-all posts below.
      </p>
    )}

    {closingSoon.length === 0 && (
      <div class="rounded-2xl border border-dashed border-border bg-card px-6 py-10 text-center">
        <p class="font-bold text-foreground font-heading">No applications are closing soon</p>
        <p class="text-sm text-muted-foreground mt-1 max-w-md mx-auto">Drives with an open application window appear here, soonest deadline first. Browse the full directory or check your eligibility in the meantime.</p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a href="/jobs" class="text-xs font-bold px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted transition-colors">Browse all recruitments</a>
          <a href="/eligibility-checker" class="text-xs font-bold px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary-hover transition-colors">Check my eligibility</a>
        </div>
      </div>
    )}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {closingSoon.map((item: any) => (
        <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 flex flex-col justify-between hover:border-border/80 hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${item.presentation?.badgeClass || 'bg-slate-100 text-slate-800 border border-slate-200'}`}>
                {item.presentation?.label || 'Closing Soon'}
              </span>
              <span class="text-xs text-muted-foreground font-semibold">
                {item.organisationShortName || item.authorityCode || 'Government Board'}
              </span>
            </div>

            <h3 class="font-bold text-base sm:text-lg text-foreground mb-3 line-clamp-2 leading-snug">
              <a href={`/recruitments/${item.slug}`} class="hover:text-primary transition-colors">
                {item.title}
              </a>
            </h3>

            <div class="space-y-2 text-xs text-muted-foreground mb-5 bg-muted/40 p-3 rounded-xl border border-border/60">
              <div class="flex items-center justify-between">
                <span>Total Vacancies:</span>
                <span class="font-bold text-foreground font-mono">{item.totalVacancies?.toLocaleString() || 'N/A'} Posts</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Min Qualification:</span>
                <span class="font-semibold text-foreground">
                  {item.criteria?.minQualificationLevel ? item.criteria.minQualificationLevel.replace(/_/g, ' ') : 'Refer Notice'}
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span>Application Deadline:</span>
                <span class="font-bold text-foreground font-mono">
                  {item.applicationEnd ? formatDate(item.applicationEnd) : 'Refer Notice'}
                </span>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-border flex items-center justify-between gap-2">
            <span class="text-[11px] text-muted-foreground inline-flex items-center gap-1 font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Official Gazette Verified
            </span>
            <a
              href={`/recruitments/${item.slug}`}
              class="font-bold text-xs text-primary hover:text-primary-hover inline-flex items-center gap-1"
            >
              <span>View Notice</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section: Explore by Sector -->
  <section id="sectors" class="scroll-mt-24 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-muted/40 border-y border-border">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl font-black text-foreground tracking-normal font-heading">
          Browse by Public Sector
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-2">
          Find openings across civil services, police and defence, judiciary, teaching, health, railways, and technical departments.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 border-t border-border">
        {dbSectors.map((sec) => (
          <SectorCard
            sector={sec}
            activeDrivesCount={activeDrivesBySector.get(sec.id) || 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Exam Calendar Milestone Timeline -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-foreground tracking-normal font-heading">
          Upcoming Examination & Application Milestones
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">
          Chronological milestone timeline of notifications, closing dates, and written examination days.
        </p>
      </div>
      <a href="/calendar" class="text-xs sm:text-sm font-bold text-primary hover:underline flex items-center gap-1">
        <span>Open interactive calendar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Timeline Grid -->
    {milestones.length === 0 && (
      <div class="rounded-2xl border border-dashed border-border bg-card px-6 py-10 text-center">
        <p class="font-bold text-foreground font-heading">No upcoming milestones yet</p>
        <p class="text-sm text-muted-foreground mt-1 max-w-md mx-auto">Application deadlines and exam dates show up here as soon as they are published.</p>
      </div>
    )}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {milestones.map((m) => (
        <a
          href={m.slug ? `/recruitments/${m.slug}` : '/calendar'}
          class="p-4 sm:p-5 rounded-2xl bg-card border border-border hover:border-primary/40 hover:shadow-sm transition-all relative flex flex-col justify-between group"
        >
          <div>
            <span class="text-xs font-mono font-bold text-primary block mb-1.5">
              {m.date}
            </span>
            <h4 class="font-bold text-sm text-foreground mb-1 leading-snug group-hover:text-primary transition-colors">
              {m.title}
            </h4>
            <p class="text-xs text-muted-foreground">
              {m.desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border">
            <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${m.statusClass || 'bg-muted text-muted-foreground border-border'}`}>
              {m.status}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- About the site: written for people searching "government jobs", kept plain and factual -->
  <section id="about-government-jobs" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-t border-border">
    <div class="max-w-3xl mx-auto text-sm sm:text-base text-muted-foreground leading-relaxed space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-foreground tracking-normal font-heading">
        Government Jobs {year}: Central and All State Govt Jobs in One Place
      </h2>
      <p>
        GovtRecruitments is a free website that lists government jobs from across India. You will find central government jobs and govt jobs from all 28 states and 8 union territories in one place. Every job here comes from the official notice published by the recruiting body. We do not copy jobs from other job portals.
      </p>
      <p>
        Most job websites show you a long list and leave the rest to you. You open a notice, read 30 pages, and only then find out that the age limit is 27 and you are 28. Our main tool, the <a href="/eligibility-checker" class="font-semibold text-primary hover:underline">eligibility checker</a>, does that reading for you. You enter your details once, and it tells you which govt job vacancy you can apply for and which ones you can't, with the reason.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">How the eligibility checker works</h3>
      <p>
        The checker asks a few short questions: your date of birth and gender, your education, your home state and your category. Then it checks each recruitment against the rules written in that recruitment's own notice:
      </p>
      <ul class="list-disc pl-5 space-y-1.5">
        <li>The age limit, and the cut-off date the notice uses to count your age</li>
        <li>Age relaxation for SC, ST, OBC, EWS and women, where the notice gives it</li>
        <li>The minimum qualification, and the subject or stream if the notice asks for one</li>
        <li>Domicile: whether the job is only for people of that state, or open to all of India</li>
        <li>Other conditions such as height, employment office registration or a computer certificate</li>
      </ul>
      <p>
        The result shows the jobs you can apply for, the jobs you can't, and the jobs where something needs a second look. Your details stay in your browser, and you do not need an account.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">Latest govt jobs recruitment, added as notices come out</h3>
      <p>
        When a new notice is released, we add it with its dates, number of posts, eligibility rules and official links. This page shows the applications closing soon, so you do not miss a last date. The <a href="/calendar" class="font-semibold text-primary hover:underline">exam calendar</a> lists form dates and exam dates. There are also separate pages for <a href="/admit-cards" class="font-semibold text-primary hover:underline">admit cards</a>, <a href="/answer-keys" class="font-semibold text-primary hover:underline">answer keys</a> and <a href="/results" class="font-semibold text-primary hover:underline">results</a>.
      </p>
      <p>
        Each job page has a direct link to the official apply page. You fill the form on the government website, never on ours. We never ask for any fee. If a person or a website asks you for money to get you a government job, do not pay.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">Central government jobs</h3>
      <p>
        Central government jobs come from national bodies such as commissions, ministries, railways, defence and public sector units. Most of them are open to candidates from every state, so they show up for everyone. See the full list of <a href="/jobs?state=IN" class="font-semibold text-primary hover:underline">central government jobs</a>.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">All state government jobs</h3>
      <p>
        Each state hires through its own commissions and boards, such as the state public service commission, the staff selection board and the police recruitment board. Many state jobs are only for people who are domiciles of that state. Some are open to everyone, but the reserved seats go only to local candidates. Every job page says clearly which of these applies.
      </p>
      <p>
        When you open the site, we show your own state's jobs first, then central jobs, then other states. You can change your state at any time. To see the jobs of one state only, pick it here:
      </p>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1.5 text-xs sm:text-sm">
        {stateLinks.map(j => (
          <li><a href={`/jobs?state=${j.code}`} class="text-foreground hover:text-primary hover:underline">{j.name} govt jobs</a></li>
        ))}
      </ul>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">Government jobs after 12th</h3>
      <p>
        Many people search for government jobs after 12th, and there are a lot of them: police constable, clerk, data entry operator, forest guard, and many posts in the railways and defence. In the eligibility checker, choose 12th pass as your education and you will see only the jobs that accept it. From the search box you can also look for 10th pass, ITI, diploma and graduate jobs.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">High package government jobs</h3>
      <p>
        Pay in a government job depends on the pay level of the post, plus allowances such as DA and HRA. Posts filled through civil services and judiciary exams, and officer posts in banks and public sector units, usually pay the most. On each job page we show the pay exactly as the notice gives it, so you can compare posts before you apply. We do not show a salary figure that the notice does not give.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">Why you can trust this list</h3>
      <ul class="list-disc pl-5 space-y-1.5">
        <li>Every job comes from an official government website or notice.</li>
        <li>We check that the official links open before a job goes live.</li>
        <li>When a notice is changed by a corrigendum, we update the job.</li>
        <li>If we are not sure of a detail, we leave it out and point you to the notice.</li>
      </ul>
      <p>
        Even so, please read the official notice before you apply. The notice is always the final word.
      </p>

      <h3 class="pt-4 text-lg sm:text-xl font-bold text-foreground font-heading">Common questions</h3>
      <div class="divide-y divide-border border-y border-border">
        {faqs.map(f => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-semibold text-foreground">
              <span>{f.q}</span>
              <span class="text-muted-foreground transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-2">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Conversion Panel: Check what you can apply for -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16">
    <div class="rounded-3xl bg-primary text-white p-6 sm:p-10 lg:p-12 flex flex-col md:flex-row items-center justify-between gap-6 sm:gap-8 shadow-md relative overflow-hidden">
      
      

      <div class="max-w-xl text-center md:text-left">
        <h3 class="text-2xl sm:text-3xl font-black mb-2 font-heading tracking-normal">
          Find Every Government Exam You Are Eligible For
        </h3>
        <p class="text-xs sm:text-sm text-blue-100 leading-relaxed">
          Enter your qualification, age, and state once. The engine evaluates each recruitment against its own stored statutory criteria rather than applying broad assumptions.
        </p>
      </div>

      <div class="shrink-0 w-full sm:w-auto">
        <a
          href="/eligibility-checker"
          class="font-bold rounded-xl bg-white hover:bg-blue-50 text-primary text-sm px-7 py-4 shadow-md transition-all flex items-center justify-center gap-2.5 w-full sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Check My Eligibility Now</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
