---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllActiveRecruitments, getAllSectors } from '../db/queries';

const [recruitments, dbSectors] = await Promise.all([
  getAllActiveRecruitments(),
  getAllSectors(),
]);

const totalVacancies = recruitments.reduce((sum: number, r: any) => sum + (r.totalVacancies || 0), 0);

// Categorize recruitments
const closingSoon = recruitments.filter(r => r.lifecycleStatus === 'OPEN').slice(0, 3);
const recentlyReleased = recruitments.slice(0, 3);

// Sectors grid data
const sectors = dbSectors.slice(0, 8).map((s) => ({
  name: s.name.split(',')[0].split('&')[0].trim(),
  fullName: s.name,
  slug: s.slug,
  count: 'State Cadre',
}));

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Derive calendar milestones dynamically
const milestones: Array<{ date: string; title: string; desc: string; status: string; slug: string }> = [];

recruitments.forEach((r) => {
  if (r.applicationEnd && milestones.length < 3) {
    milestones.push({
      date: formatDate(r.applicationEnd),
      title: r.title,
      desc: 'Applications close',
      status: 'Closing Soon',
      slug: r.slug,
    });
  }
  if (r.examDate && milestones.length < 5) {
    milestones.push({
      date: formatDate(r.examDate),
      title: `${r.postTitle} CBT`,
      desc: 'Written examination date',
      status: 'Exam Date',
      slug: r.slug,
    });
  }
});
---

<BaseLayout
  title="NIRNAY — Madhya Pradesh Government Opportunities Discovery Platform"
  description="Explore Madhya Pradesh government opportunities, check eligibility, track important dates and access official recruitment links. Free, deterministic eligibility calculator."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/60 via-slate-50/40 to-background border-b border-border">
    <div class="grid mx-auto py-16 sm:py-20 px-4 sm:px-6 lg:px-8 items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] max-w-7xl">
      <!-- Left Hero Content -->
      <div class="flex flex-col items-start gap-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 border border-blue-200/80 text-primary text-xs font-semibold tracking-wide">
          <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
          <span>Find what fits</span>
        </div>

        <h1 class="font-bold text-foreground text-4xl sm:text-5xl lg:text-6xl leading-[1.08] tracking-tight max-w-2xl">
          Find government jobs <br class="hidden sm:inline" />
          <span class="text-primary">you can apply for.</span>
        </h1>

        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-xl">
          Explore Madhya Pradesh government opportunities, check eligibility deterministically, track important dates, and access official recruitment links directly from state notifications.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="/eligibility-checker"
            class="font-semibold rounded-lg bg-primary text-primary-foreground text-sm px-6 py-3.5 shadow-sm hover:bg-blue-700 transition-all flex items-center gap-2"
          >
            <span>Check My Eligibility</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="#closing-soon"
            class="font-medium rounded-lg text-foreground bg-card hover:bg-muted text-sm px-5 py-3.5 border border-border transition-colors flex items-center gap-2"
          >
            <span>Explore Jobs ({recruitments.length})</span>
          </a>
        </div>
      </div>

      <!-- Right Eligibility Preview Card -->
      <div class="w-full bg-card rounded-2xl p-6 sm:p-7 border border-border shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-border mb-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            Your next opportunity
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
            <span class="size-1.5 rounded-full bg-emerald-600"></span>
            24 matches ready
          </span>
        </div>

        <div class="space-y-3.5 mb-6">
          <div class="p-3 rounded-lg bg-muted/60 border border-border flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Active MP Vacancies</span>
            <span class="text-sm font-bold text-foreground font-mono">{totalVacancies.toLocaleString()} Posts</span>
          </div>

          <div class="p-3 rounded-lg bg-muted/60 border border-border flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Recruitment Boards</span>
            <span class="text-sm font-medium text-foreground">MPESB, MPPSC, MPHC</span>
          </div>

          <div class="p-3 rounded-lg bg-muted/60 border border-border flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Evaluation Method</span>
            <span class="text-sm font-medium text-primary">100% Deterministic Code</span>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="/eligibility-checker"
            class="w-full font-semibold rounded-lg bg-primary/10 hover:bg-primary/15 text-primary text-xs sm:text-sm py-3 px-4 border border-primary/20 transition-colors flex items-center justify-center gap-2"
          >
            <span>Start Quick 3-Minute Check</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
          <p class="text-[11px] text-muted-foreground text-center mt-3">
            No account required · Zero ads · Verified against official gazettes
          </p>
        </div>
      </div>
    </div>

    <!-- Search Bar & Shortcut Chips -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <form action="/search" method="get" class="relative max-w-4xl mx-auto mb-5">
        <div class="flex items-center rounded-xl bg-card border border-border shadow-sm p-1.5 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
          <div class="pl-3.5 pr-2 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input
            type="search"
            name="q"
            placeholder="Search jobs, exams, departments or organisations (e.g. Police, Forest, MPESB)"
            class="w-full bg-transparent text-foreground text-sm sm:text-base outline-none py-2 pr-3"
          />
          <button
            type="submit"
            class="shrink-0 px-4 py-2 bg-primary hover:bg-blue-700 text-primary-foreground font-semibold rounded-lg text-xs sm:text-sm transition-colors"
          >
            Search
          </button>
        </div>
      </form>

      <!-- Shortcut Chips -->
      <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto">
        <span class="text-xs text-muted-foreground font-medium mr-1">Popular:</span>
        {['10th Pass', '12th Pass', 'ITI', 'Diploma', 'Graduate', 'Post Graduate', 'Police', 'Forest', 'Education', 'Health'].map((chip) => (
          <a
            href={`/search?q=${encodeURIComponent(chip)}`}
            class="px-3 py-1 rounded-full text-xs font-medium bg-card border border-border text-foreground hover:bg-muted hover:border-primary/40 transition-colors shadow-2xs"
          >
            {chip}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Closing Soon -->
  <section id="closing-soon" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-800 text-xs font-semibold mb-2 border border-amber-200">
          <span class="size-1.5 rounded-full bg-amber-500 animate-ping"></span>
          <span>Immediate Deadlines</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
          Closing soon
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">
          Government recruitments with application deadlines in the coming days.
        </p>
      </div>

      <a href="/calendar" class="text-xs sm:text-sm font-semibold text-primary hover:underline flex items-center gap-1">
        <span>View all in Exam Calendar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {closingSoon.map((item: any) => (
        <div class="bg-card rounded-xl border border-border p-5 flex flex-col justify-between hover:border-border/80 hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200">
                Closing Soon
              </span>
              <span class="text-[11px] text-muted-foreground font-medium">
                {item.authorityCode || 'MPESB'}
              </span>
            </div>

            <h3 class="font-bold text-base text-foreground mb-2 line-clamp-2">
              <a href={`/recruitments/${item.slug}`} class="hover:text-primary transition-colors">
                {item.title}
              </a>
            </h3>

            <div class="space-y-1.5 text-xs text-muted-foreground mb-4">
              <div class="flex items-center justify-between">
                <span>Total Vacancies:</span>
                <span class="font-bold text-foreground font-mono">{item.totalVacancies?.toLocaleString() || 'N/A'}</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Qualification:</span>
                <span class="font-medium text-foreground">10th / 12th / Grad</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Last Date:</span>
                <span class="font-bold text-amber-600 font-mono">{item.applicationEnd ? new Date(item.applicationEnd).toLocaleDateString('en-IN') : 'Upcoming'}</span>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-border flex items-center justify-between gap-2">
            <span class="text-[10px] text-muted-foreground inline-flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Verified Source
            </span>
            <a
              href={`/recruitments/${item.slug}`}
              class="font-semibold text-xs text-primary hover:text-blue-700 inline-flex items-center gap-1"
            >
              <span>View details</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section: Explore by Sector -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-muted/40 border-y border-border">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
          Explore by sector
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-2">
          Navigate Madhya Pradesh departments, uniformed forces, administrative wings, and health posts.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {sectors.map((sec) => (
          <a
            href={`/sectors/${sec.slug}`}
            class="bg-card rounded-xl border border-border p-4 hover:border-primary/40 hover:shadow-sm transition-all group"
          >
            <div class="size-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-sm mb-3 group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
              {sec.name[0]}
            </div>
            <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">
              {sec.name}
            </h3>
            <p class="text-xs text-muted-foreground mt-0.5">
              {sec.count}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Exam Calendar Milestone Timeline -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
          Government exam calendar
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">
          Chronological milestone timeline of notifications, closing dates, and examination days.
        </p>
      </div>
      <a href="/calendar" class="text-xs sm:text-sm font-semibold text-primary hover:underline">
        Open full interactive calendar &rarr;
      </a>
    </div>

    <!-- Timeline Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {milestones.map((m) => (
        <a
          href={m.slug ? `/recruitments/${m.slug}` : '/calendar'}
          class="p-4 rounded-xl bg-card border border-border hover:border-border/80 hover:shadow-2xs transition-all relative flex flex-col justify-between group"
        >
          <div>
            <span class="text-[11px] font-mono font-bold text-primary block mb-1">
              {m.date}
            </span>
            <h4 class="font-bold text-xs text-foreground mb-1 leading-snug group-hover:text-primary transition-colors">
              {m.title}
            </h4>
            <p class="text-[11px] text-muted-foreground">
              {m.desc}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-border">
            <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
              m.status === 'Closing Soon' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
              m.status === 'Exam Date' ? 'bg-blue-50 text-blue-700 border border-blue-200' :
              'bg-emerald-50 text-emerald-700 border border-emerald-200'
            }`}>
              {m.status}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Conversion Panel: Not sure what you can apply for? -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl bg-gradient-to-r from-blue-50 via-indigo-50/50 to-slate-50 border border-blue-100 p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-xl text-center md:text-left">
        <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-2">
          Not sure what you can apply for?
        </h3>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Enter your age, highest qualification, and domicile details once. Our deterministic engine computes your legal eligibility across all 128+ MP recruitments in milliseconds.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/eligibility-checker"
          class="font-semibold rounded-lg bg-primary text-primary-foreground text-sm px-6 py-3.5 shadow-sm hover:bg-blue-700 transition-colors inline-flex items-center gap-2"
        >
          <span>Check Eligibility</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
