---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorCard from '../components/common/SectorCard.astro';
import StatePicker from '../components/common/StatePicker.astro';
import { getAllSectors, getAllCanonicalPosts, calculateSectorActiveDrives } from '../db/queries';
import { calculateRecruitmentMetrics, isActiveDrive, isUpcomingDrive, normalizeDateString, todayIST } from '../services/lifecycle';
import { inRelevanceOrder, loadPublicRecruitments, queryListing } from '../services/public-listing';
import { INDIA_JURISDICTIONS, jurisdictionName } from '../data/india-jurisdictions';
import { homeSeo, currentYear } from '../services/seo';

// Ordering depends on the visitor's state, so this page must never be shared from an edge cache.
Astro.response.headers.set('Cache-Control', 'private, no-store');
const viewerState = Astro.locals.viewerState;
const homeCode = viewerState?.code ?? null;

const [recruitments, dbSectors, allPosts] = await Promise.all([
  loadPublicRecruitments(homeCode),
  getAllSectors(),
  getAllCanonicalPosts(),
]);

// Stats count every loaded recruitment once, independent of the visitor's state.
const activeDrivesBySector = calculateSectorActiveDrives(dbSectors, recruitments, allPosts);

const metrics = calculateRecruitmentMetrics(recruitments);

function formatDate(dateStr?: string | null): string {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
  } catch {
    return dateStr;
  }
}

// Exam board: every published drive sorted into one stage, the visitor's state first in each.
// gstack-shortcut(dec-ddc9fa57): bucket rules are inline and untested, upgrade to a tested src/services helper when a second page needs them.
type Rec = (typeof recruitments)[number];
const today = todayIST();
const BOARD_LIMIT = 4;
const RESULT_LINKS = ['RESULT', 'SCORECARD', 'MERIT_LIST'];
const ANSWER_KEY_LINKS = ['ANSWER_KEY', 'PROVISIONAL_ANSWER_KEY', 'FINAL_ANSWER_KEY'];
// A closed drive with no exam date stays "on-going" only this long, so drives nobody updated drop off.
const ONGOING_UNDATED_DAYS = 120;

const day = (d?: string | null) => normalizeDateString(d);
const daysFromToday = (iso: string) => {
  const [y1, m1, d1] = today.split('-').map(Number);
  const [y2, m2, d2] = iso.split('-').map(Number);
  return Math.round((Date.UTC(y2, m2 - 1, d2) - Date.UTC(y1, m1 - 1, d1)) / 86_400_000);
};
const inDays = (verb: string, n: number) => (n === 0 ? `${verb} today` : n === 1 ? `${verb} tomorrow` : `${verb} in ${n} days`);
const activeLink = (r: Rec, types: string[]) => r.officialLinksList?.find(l => types.includes(l.linkType) && l.isActive === 1);
const resultDate = (r: Rec) => day(r.importantDatesList?.find(d => d.eventType === 'RESULT')?.date);
const soonestFirst = (get: (r: Rec) => string | null) => (a: Rec, b: Rec) => (get(a) || '9999-12-31').localeCompare(get(b) || '9999-12-31');
const tiered = (rows: Rec[]) => inRelevanceOrder(queryListing(rows, {}, homeCode));

// Same rule as /results: declared, or an active result link. Results win over every other stage.
const isResult = (r: Rec) => r.resolvedLifecycle === 'RESULT_DECLARED' || r.resultStatus === 'DECLARED' || Boolean(activeLink(r, RESULT_LINKS));
const isOngoingExam = (r: Rec) => {
  if (isResult(r)) return false;
  if (r.resolvedLifecycle !== 'APPLICATION_CLOSED' && r.resolvedLifecycle !== 'EXAM_SCHEDULED') return false;
  const exam = day(r.examDate);
  if (exam) return exam >= today;
  const end = day(r.applicationEnd);
  return Boolean(end) && -daysFromToday(end!) <= ONGOING_UNDATED_DAYS;
};

const upcomingAll = tiered(recruitments.filter(r => isUpcomingDrive(r)).sort(soonestFirst(r => day(r.applicationStart))));
const closingAll = tiered(recruitments.filter(r => isActiveDrive(r)).sort(soonestFirst(r => day(r.applicationEnd))));
const ongoingAll = tiered(recruitments.filter(isOngoingExam).sort(soonestFirst(r => day(r.examDate))));
const resultsAll = tiered(recruitments.filter(isResult).sort((a, b) => (resultDate(b) || '').localeCompare(resultDate(a) || '')));
const boardDriveCount = upcomingAll.length + closingAll.length + ongoingAll.length;
const homeHasNoBoardDrives = Boolean(homeCode) && boardDriveCount > 0
  && ![...upcomingAll, ...closingAll, ...ongoingAll].some(r => r.stateCode?.toUpperCase() === homeCode);

type Tone = 'urgent' | 'soon' | 'calm' | 'muted';
interface BoardRow {
  slug: string;
  title: string;
  org: string;
  place: string;
  when: string;
  tone: Tone;
  date: string | null;
  posts: string | null;
  flags: string[];
  noticeUrl: string | null;
}

function toRow(r: Rec, when: string, tone: Tone, date: string | null, flags: string[] = []): BoardRow {
  const notice = activeLink(r, ['NOTIFICATION_PDF', 'RULEBOOK']) ?? r.officialLinksList?.find(l => l.isActive === 1);
  const code = r.stateCode?.toUpperCase();
  return {
    slug: r.slug,
    title: r.title,
    org: r.organisationShortName || r.authorityCode || 'Govt body',
    place: code === 'IN' ? 'Central' : code ? jurisdictionName(code) : 'India',
    when,
    tone,
    date: date ? formatDate(date) : null,
    posts: r.totalVacancies ? `${r.totalVacancies.toLocaleString('en-IN')} ${r.totalVacancies === 1 ? 'post' : 'posts'}` : null,
    flags,
    noticeUrl: notice?.url ?? null,
  };
}

const upcomingRows = upcomingAll.slice(0, BOARD_LIMIT).map(r => {
  const start = day(r.applicationStart);
  return toRow(r, start ? inDays('Opens', daysFromToday(start)) : 'Opening date not announced', 'calm', start);
});
const closingRows = closingAll.slice(0, BOARD_LIMIT).map(r => {
  const end = day(r.applicationEnd);
  const n = end ? daysFromToday(end) : null;
  return toRow(r, n === null ? 'Last date in notice' : inDays('Closes', n), n !== null && n <= 2 ? 'urgent' : n !== null && n <= 7 ? 'soon' : 'calm', end);
});
const ongoingRows = ongoingAll.slice(0, BOARD_LIMIT).map(r => {
  const exam = day(r.examDate);
  const flags = [activeLink(r, ['ADMIT_CARD']) && 'Admit card out', activeLink(r, ANSWER_KEY_LINKS) && 'Answer key out'].filter(Boolean) as string[];
  return toRow(r, exam ? inDays('Exam', daysFromToday(exam)) : 'Exam date not announced', exam ? 'calm' : 'muted', exam, flags);
});
const resultRows = resultsAll.slice(0, BOARD_LIMIT).map(r => {
  const row = toRow(r, 'Result declared', 'calm', resultDate(r));
  return { ...row, resultUrl: activeLink(r, RESULT_LINKS)?.url ?? null };
});

const boardColumns = [
  {
    id: 'upcoming', label: 'Upcoming', rows: upcomingRows, total: upcomingAll.length, href: '/jobs?status=UPCOMING',
    rule: 'border-t-sky-600 dark:border-t-sky-400',
    empty: 'No announced drives are waiting to open. New notices appear here as soon as they are published.',
  },
  {
    id: 'closing-soon', label: 'Closing soon', rows: closingRows, total: closingAll.length, href: '/jobs?status=OPEN',
    rule: 'border-t-amber-500 dark:border-t-amber-400',
    empty: 'No applications are open right now. Drives taking forms appear here, nearest last date first.',
  },
  {
    id: 'ongoing-exams', label: 'On-going exams', rows: ongoingRows, total: ongoingAll.length, href: '/jobs?status=CONCLUDED',
    rule: 'border-t-primary',
    empty: 'No exams are pending right now. Drives move here once their forms close.',
  },
];
const toneClass: Record<Tone, string> = {
  urgent: 'text-red-700 dark:text-red-400',
  soon: 'text-amber-700 dark:text-amber-400',
  calm: 'text-foreground',
  muted: 'text-muted-foreground',
};

const year = currentYear();
const seo = homeSeo(year);
const stateLinks = INDIA_JURISDICTIONS.filter(j => j.code !== 'IN');

// Shown on the page and sent as FAQPage data, so the two never differ.
const faqs = [
  {
    q: 'Is this an official government website?',
    a: 'No. GovtRecruitments is an independent website. We are not part of any government body. We collect jobs only from official sources and link you back to them.',
  },
  {
    q: 'Is it free to use?',
    a: 'Yes. Searching jobs and using the eligibility checker are free, and you do not need to sign up.',
  },
  {
    q: 'How do I find govt jobs in my state?',
    a: "Choose your state at the top of this page, or open your state from the list above. Your state's jobs will then show first.",
  },
  {
    q: `Which government jobs ${year} are open right now?`,
    a: 'The "Open right now" box at the top shows how many recruitments are taking forms today. In the exam board below it, the Closing soon column lists them with the nearest last date first.',
  },
  {
    q: 'Can I apply for a job on this website?',
    a: 'No. Use the "Apply Officially" button on the job page. It takes you to the official form on the government website.',
  },
];

const siteUrl = new URL('/', Astro.url.origin).href;
const jsonLd = [
  {
    '@type': 'WebSite',
    name: 'GovtRecruitments',
    url: siteUrl,
    potentialAction: { '@type': 'SearchAction', target: `${siteUrl}search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalUrl={siteUrl}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="bg-background border-b border-border">
    <div class="grid mx-auto py-10 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 items-center gap-8 lg:gap-12 lg:grid-cols-[1.2fr_0.8fr] max-w-7xl">
      <!-- Left Hero Content -->
      <div class="flex flex-col items-start gap-4 sm:gap-6">
        
        <h1 class="font-black text-foreground text-3xl sm:text-5xl lg:text-6xl leading-[1.1] tracking-normal max-w-2xl font-heading">
          Find government jobs across India <br class="hidden sm:inline" />
          <span class="text-primary">you are eligible to apply for.</span>
        </h1>

        <p class="text-sm sm:text-base lg:text-lg text-muted-foreground leading-relaxed max-w-xl">
          Verified official gazette notifications, statutory age relaxations, and direct application links for all central and state recruitment drives.
        </p>

        <StatePicker viewerState={viewerState} action="/" id="home-state-picker" />

        <!-- CTA Buttons: 3 Core Tasks -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1 w-full sm:w-auto">
          <a
            href="/eligibility-checker"
            class="font-bold rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground text-sm px-6 py-3.5 shadow-sm transition-all flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Check My Eligibility</span>
          </a>
          <a
            href="#exam-board"
            class="font-semibold rounded-xl text-foreground bg-card hover:bg-muted active:scale-[0.98] text-sm px-5 py-3.5 border border-border transition-[background-color,transform] flex items-center justify-center gap-2 shadow-2xs"
          >
            <span>Browse Exams ({boardDriveCount})</span>
          </a>
          <a
            href="/calendar"
            class="font-semibold rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted text-sm px-4 py-3.5 transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Exam Calendar</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Live ledger -->
      <div class="w-full border-t-2 border-primary bg-card pt-5 sm:pt-6 pb-5 sm:pb-6 px-5 sm:px-6">
        <div class="flex items-baseline justify-between gap-3 mb-1">
          <h2 class="text-base font-bold text-foreground font-heading">Open right now</h2>
          <span class="text-xs text-muted-foreground">Updated as drives are published</span>
        </div>
        <p class="font-heading font-black text-5xl sm:text-6xl text-primary leading-none mt-5">
          {metrics.activeDriveCount}
          <span class="text-base font-bold text-foreground ml-1">{metrics.activeDriveCount === 1 ? 'drive' : 'drives'} accepting applications</span>
        </p>

        <dl class="mt-7 divide-y divide-border border-y border-border text-sm">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Vacancies open to apply</dt>
            <dd class="font-bold text-foreground tabular-nums">{metrics.activeVacancyCount.toLocaleString()}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Announced, not yet open</dt>
            <dd class="font-bold text-foreground tabular-nums">{metrics.upcomingVacancyCount.toLocaleString()} <span class="font-normal text-muted-foreground">in {metrics.upcomingDriveCount} {metrics.upcomingDriveCount === 1 ? 'drive' : 'drives'}</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Coverage</dt>
            <dd class="font-semibold text-foreground">Central, 28 states, 8 UTs</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Rules applied</dt>
            <dd class="font-semibold text-foreground">Each gazette's own criteria</dd>
          </div>
        </dl>

        <a href="/eligibility-checker" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">
          <span>Check which of these you qualify for</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 sm:pb-14">
      <form action="/search" method="get" class="relative max-w-4xl mx-auto">
        <div class="flex items-center rounded-2xl bg-card border border-input shadow-sm p-1.5 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
          <div class="pl-3.5 pr-2 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input
            type="search"
            name="q"
            placeholder="Search by exam, department, state, or post (e.g. Police, Patwari, SSC, Teaching)"
            class="w-full bg-transparent text-foreground text-sm sm:text-base outline-none py-2 pr-3 placeholder:text-muted-foreground/70"
          />
          <button
            type="submit"
            class="shrink-0 px-4 sm:px-5 py-2.5 bg-primary hover:bg-primary-hover text-primary-foreground font-bold rounded-xl text-xs sm:text-sm transition-colors"
          >
            Search
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Section: Exam board. Three stage columns plus a Results strip; phones get tabs (see script below). -->
  <section id="exam-board" class="scroll-mt-24 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 sm:mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-foreground tracking-normal font-heading">
          Exams at every stage
        </h2>
        <p class="mt-1.5 flex items-start gap-1.5 text-xs sm:text-sm text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 mt-px text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Every drive links to its official notice.{homeCode && ` ${jurisdictionName(homeCode)} drives are shown first.`}</span>
        </p>
      </div>
      <a href="/calendar" class="text-xs sm:text-sm font-bold text-primary hover:underline inline-flex items-center gap-1">
        <span>Exam calendar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    {homeHasNoBoardDrives && (
      <p class="mb-4 text-xs text-muted-foreground">
        No current drives from <strong class="text-foreground">{jurisdictionName(homeCode)}</strong>. Central and open-to-all drives are shown.
      </p>
    )}

    <!-- Phone tabs: hidden until the script runs, so without JS all three lists show stacked. -->
    <div role="tablist" aria-label="Exam stage" data-exam-tabs class="hidden md:hidden grid-cols-3 gap-1 mb-3 rounded-xl border border-border bg-muted p-1">
      {boardColumns.map((col) => (
        <button
          type="button"
          role="tab"
          id={`tab-${col.id}`}
          aria-controls={col.id}
          aria-selected={col.id === 'closing-soon' ? 'true' : 'false'}
          data-tab={col.id}
          class="min-h-11 rounded-lg px-1.5 text-xs font-bold leading-tight text-muted-foreground transition-colors aria-selected:bg-card aria-selected:text-foreground aria-selected:shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          {col.label} <span class="font-mono font-semibold">{col.total}</span>
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6 items-start">
      {boardColumns.map((col) => (
        <div id={col.id} data-panel={col.id} role="tabpanel" aria-labelledby={`tab-${col.id}`} class={`scroll-mt-24 bg-card border border-border border-t-2 ${col.rule} rounded-b-xl`}>
          <div class="flex items-baseline justify-between gap-3 px-4 pt-3.5 pb-3 border-b border-border">
            <h3 class="text-[11px] font-bold uppercase tracking-wider text-foreground">
              {col.label}<span class="ml-1.5 font-mono font-semibold text-muted-foreground">{col.total}</span>
            </h3>
            {col.total > 0 && (
              <a href={col.href} class="text-xs font-bold text-primary hover:underline">All</a>
            )}
          </div>

          {col.rows.length === 0 ? (
            <div class="m-4 rounded-lg border border-dashed border-border px-4 py-6 text-center">
              <p class="text-xs text-muted-foreground leading-relaxed">{col.empty}</p>
              <a href="/jobs" class="mt-2 inline-block py-1 text-xs font-bold text-primary hover:underline">Browse all recruitments</a>
            </div>
          ) : (
            <ul class="divide-y divide-border">
              {col.rows.map((row, i) => (
                <li class="board-row px-4 py-3.5" style={`--i:${i}`}>
                  <div class="flex items-center justify-between gap-3 font-mono text-[11px] text-muted-foreground">
                    <span class="truncate">{row.org}</span>
                    <span class="shrink-0 max-w-[50%] truncate">{row.place}</span>
                  </div>
                  <h4 class="mt-1 text-sm font-semibold leading-snug text-foreground line-clamp-2">
                    <a href={`/recruitments/${row.slug}`} class="hover:text-primary transition-colors">{row.title}</a>
                  </h4>
                  <p class={`mt-1.5 text-sm font-bold ${toneClass[row.tone]}`}>{row.when}</p>
                  {(row.date || row.posts) && (
                    <p class="mt-0.5 font-mono tabular-nums text-xs text-muted-foreground">{[row.date, row.posts].filter(Boolean).join(' · ')}</p>
                  )}
                  {row.flags.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {row.flags.map((flag) => (
                        <span class="px-2 py-0.5 rounded border border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 text-[10px] font-bold uppercase tracking-wider">{flag}</span>
                      ))}
                    </div>
                  )}
                  {row.noticeUrl ? (
                    <a href={row.noticeUrl} target="_blank" rel="noopener noreferrer" class="mt-1.5 inline-flex items-center gap-1 py-1 text-[11px] font-medium text-muted-foreground hover:text-primary transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>Official notice</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                    </a>
                  ) : (
                    <span class="mt-1.5 inline-flex items-center gap-1 py-1 text-[11px] font-medium text-muted-foreground">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>From the official notice</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}

          {col.total > col.rows.length && (
            <a href={col.href} class="flex items-center justify-between gap-2 px-4 py-3 border-t border-border text-xs font-bold text-primary hover:bg-muted/60 active:scale-[0.99] transition-[background-color,transform] rounded-b-xl">
              <span>See all {col.total}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>

    <!-- Results strip -->
    <div id="results-declared" class="scroll-mt-24 mt-4 lg:mt-6 bg-card border border-border border-t-2 border-t-emerald-600 dark:border-t-emerald-400 rounded-b-xl">
      <div class="flex items-baseline justify-between gap-3 px-4 pt-3.5 pb-3 border-b border-border">
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-foreground">
          Results declared<span class="ml-1.5 font-mono font-semibold text-muted-foreground">{resultsAll.length}</span>
        </h3>
        <a href="/results" class="text-xs font-bold text-primary hover:underline">All results</a>
      </div>
      {resultRows.length === 0 ? (
        <div class="m-4 rounded-lg border border-dashed border-border px-4 py-6 text-center">
          <p class="text-xs text-muted-foreground leading-relaxed">No results have been declared for current drives yet. Results show up here with a link to the official result page.</p>
          <a href="/results" class="mt-2 inline-block py-1 text-xs font-bold text-primary hover:underline">Open the results page</a>
        </div>
      ) : (
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {resultRows.map((row, i) => (
            <li class="board-row px-4 py-3.5 border-t border-border first:border-t-0 sm:[&:nth-child(-n+2)]:border-t-0 lg:[&:nth-child(-n+4)]:border-t-0 sm:[&:nth-child(2n)]:border-l lg:border-l lg:[&:nth-child(4n+1)]:border-l-0" style={`--i:${i}`}>
              <div class="flex items-center justify-between gap-3 font-mono text-[11px] text-muted-foreground">
                <span class="truncate">{row.org}</span>
                <span class="shrink-0 max-w-[50%] truncate">{row.place}</span>
              </div>
              <h4 class="mt-1 text-sm font-semibold leading-snug text-foreground line-clamp-2">
                <a href={`/recruitments/${row.slug}`} class="hover:text-primary transition-colors">{row.title}</a>
              </h4>
              <p class="mt-1.5 text-sm font-bold text-emerald-700 dark:text-emerald-400">{row.when}</p>
              {row.date && <p class="mt-0.5 font-mono tabular-nums text-xs text-muted-foreground">{row.date}</p>}
              {row.resultUrl ? (
                <a href={row.resultUrl} target="_blank" rel="noopener noreferrer" class="mt-1.5 inline-flex items-center gap-1 py-1 text-[11px] font-bold text-primary hover:underline">
                  <span>Official result</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                </a>
              ) : (
                <a href={`/recruitments/${row.slug}`} class="mt-1.5 inline-flex items-center gap-1 py-1 text-[11px] font-bold text-primary hover:underline">View details</a>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .board-row {
        animation: board-row-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: calc(var(--i, 0) * 40ms);
      }
    }
    @keyframes board-row-in {
      from { opacity: 0; transform: translateY(4px); }
    }
  </style>

  <script>
    // Phone tabs for the exam board. At md and up the tablist is hidden and every panel shows.
    const tablist = document.querySelector<HTMLElement>('[data-exam-tabs]');
    if (tablist) {
      const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
      const select = (id: string, focus = false) => {
        for (const tab of tabs) {
          const on = tab.dataset.tab === id;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        }
        for (const panel of panels) panel.classList.toggle('max-md:hidden', panel.dataset.panel !== id);
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab.dataset.tab!));
        tab.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          select(tabs[(i + step + tabs.length) % tabs.length].dataset.tab!, true);
        });
      });
      tablist.classList.remove('hidden');
      tablist.classList.add('grid');
      const fromHash = panels.find((p) => `#${p.id}` === location.hash)?.id;
      select(fromHash ?? 'closing-soon');
    }
  </script>

