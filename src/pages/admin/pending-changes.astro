---
// src/pages/admin/pending-changes.astro
// Human approval queue for changes proposed by the private MCP. Nothing here is live until an admin approves it.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminD1, getAllCanonicalPosts, getAllDepartments, getAllOrganisations, getAllStates, getRecruitmentById } from '../../db/queries';
import { readAdminSubmission } from '../../services/admin-integrity';
import { MASTER_PROPOSAL_KINDS, buildDiff, createdMasterId, defaultProposalDeps, listProposalRows, parentRefs, staleFields, type ProposalRow, type ProposalStatus } from '../../services/change-proposals';
import { approveProposal, editProposal, rejectProposal } from '../../services/change-proposal-decision';
import { checkFacts, type FieldCheck } from '../../services/fact-checks';

const adminEmail = Astro.locals.adminEmail;
const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
const d1 = getAdminD1('reviewing change proposals');

let message = '';
let messageType: 'success' | 'error' = 'success';

if (Astro.request.method === 'POST') {
  try {
    if (!adminEmail) throw new Error('Admin identity is required for mutations.');
    if (!d1) throw new Error('Database is unavailable.');
    const input = await readAdminSubmission(Astro.request);
    const action = input.text('_action', 'action');
    const id = input.text('proposalId', 'proposal_id', 'id');
    if (!id) throw new Error('proposalId is required.');
    const checked = (key: string) => ['on', 'true', '1'].includes(input.text(key).toLowerCase());

    const outcome = action === 'reject'
      ? await rejectProposal(d1, id, adminEmail, input.text('note'))
      : action === 'edit'
        ? await editProposal(d1, id, adminEmail, (() => { try { return JSON.parse(input.text('payload')); } catch { throw new Error('The edited values are not valid JSON.'); } })())
      : action === 'approve'
        ? await approveProposal(d1, id, adminEmail, { publish: checked('publish'), confirmStale: checked('confirmStale') })
        : (() => { throw new Error('Unknown action.'); })();

    message = outcome.message;
    messageType = outcome.ok ? 'success' : 'error';
    if (!outcome.ok) Astro.response.status = outcome.code === 'NOT_FOUND' ? 404 : 409;
    if (!acceptsHtml) {
      return new Response(JSON.stringify({ success: outcome.ok, ...outcome }), {
        status: outcome.ok ? 200 : Astro.response.status,
        headers: { 'Content-Type': 'application/json' },
      });
    }
  } catch (error: any) {
    console.error('[admin/pending-changes]', error);
    message = error?.message || 'Action failed.';
    messageType = 'error';
    Astro.response.status = 400;
    if (!acceptsHtml) {
      return new Response(JSON.stringify({ error: message }), { status: 400, headers: { 'Content-Type': 'application/json' } });
    }
  }
}

const BY_FILTERS = [['', 'Everyone'], ['pipeline', 'Pipeline'], ['mcp-client', 'MCP']] as const;
const requestedBy = Astro.url.searchParams.get('by') ?? '';
const by = BY_FILTERS.some(([v]) => v === requestedBy) ? requestedBy : '';
// SKIPPED is not a proposal status: it lists notices the MCP was refused for having no selection exam (audit action SKIPPED).
const FILTERS: Array<ProposalStatus | 'ALL' | 'SKIPPED'> = ['PENDING', 'APPROVED', 'REJECTED', 'FAILED', 'WITHDRAWN', 'ALL', 'SKIPPED'];
const requested = Astro.url.searchParams.get('status')?.toUpperCase() as ProposalStatus | 'ALL' | 'SKIPPED' | undefined;
const filter = requested && FILTERS.includes(requested) ? requested : 'PENDING';

let loadError = '';
let proposals: ProposalRow[] = [];
type Skipped = { id: string; title: string; sourceUrl: string | null; reason: string | null; by: string; at: number };
let skipped: Skipped[] = [];
if (d1 && filter === 'SKIPPED') {
  // One row per notice (a retried or previewed notice is logged again); SQLite takes the bare columns from the MAX row.
  skipped = await d1.prepare("SELECT id, entity_id AS title, field AS sourceUrl, reason, admin_email AS by, MAX(created_at) AS at FROM audit_logs WHERE action = 'SKIPPED' AND (? = '' OR admin_email = ?) GROUP BY entity_id, field ORDER BY at DESC LIMIT 100")
    .bind(by, by).all<Skipped>().then(r => r.results ?? []).catch(error => {
      console.error('[admin/pending-changes] skipped load failed', error);
      loadError = 'The skipped list is temporarily unavailable.';
      return [];
    });
} else if (d1) {
  proposals = await listProposalRows(d1, { status: filter === 'ALL' ? undefined : filter, proposedBy: by || undefined, limit: 50 }).catch(error => {
    console.error('[admin/pending-changes] load failed', error);
    loadError = 'Proposals are temporarily unavailable. Have migrations 0010 and 0013 been applied?';
    return [];
  });
}

type Evidence = { field: string; sourceUrl: string; page?: number; section?: string; snippet?: string; method: string; handwritten?: boolean };
type Pipeline = { documentUrl?: string; documentType?: string; model?: string; warnings?: string[] };
type DuplicateWarning = { summary: string; matches: Array<{ matchedRecruitmentId: string; matchedTitle: string; matchedAdvtNumber: string | null; reasons: string[] }> };
const evidenceOf = (p: ProposalRow) => (Array.isArray(p.meta?.evidence) ? (p.meta!.evidence as Evidence[]) : []);
const pipelineOf = (p: ProposalRow) => (p.meta?.pipeline ? (p.meta.pipeline as Pipeline) : null);
const evidenceFor = (list: Evidence[], field: string) => list.filter(e => e.field === field);
const duplicateOf = (p: ProposalRow) => (p.meta?.duplicate ? (p.meta.duplicate as DuplicateWarning) : null);
const safeHref = (u: string) => (u.startsWith('https://') || u.startsWith('http://') ? u : undefined);
/** Open a PDF at the cited page (browsers' PDF viewers honour #page=N). */
const pageHref = (e: Evidence) => { const h = safeHref(e.sourceUrl); return h && e.page && /\.pdf($|[?#])|fileDownload/i.test(h) && !h.includes('#') ? `${h}#page=${e.page}` : h; };
const CHECK_LABEL: Record<FieldCheck['status'], [string, string]> = {
  MATCHES_QUOTE: ['in quote', 'bg-emerald-50 text-emerald-800 border-emerald-200'],
  NOT_IN_QUOTE: ['not in quote', 'bg-rose-50 text-rose-700 border-rose-200'],
  NO_QUOTE: ['no quote', 'bg-rose-50 text-rose-700 border-rose-200'],
  NEEDS_READING: ['read it', 'bg-amber-50 text-amber-800 border-amber-200'],
};

// A proposal may be built on a master that is itself waiting here (queued in the same MCP run): list parents first.
const byId = new Map(proposals.map(p => [p.id, p]));
const depth = (p: ProposalRow, hops = 0): number =>
  hops > 3 ? 0 : Math.max(0, ...parentRefs(p.payload).map(r => byId.get(r.id)).filter((x): x is ProposalRow => !!x).map(x => 1 + depth(x, hops + 1)));
proposals.sort((a, b) => depth(a) - depth(b));
const parentCache = new Map<string, Promise<ProposalRow | undefined>>();
const parentOf = (id: string) => {
  if (!parentCache.has(id)) parentCache.set(id, byId.has(id) ? Promise.resolve(byId.get(id)) : d1 ? defaultProposalDeps.get(d1, id).catch(() => undefined) : Promise.resolve(undefined));
  return parentCache.get(id)!;
};

const items = await Promise.all(proposals.map(async (p) => {
  const current = p.recruitmentId && p.status === 'PENDING' ? await getRecruitmentById(p.recruitmentId, d1).catch(() => undefined) : undefined;
  const missingTarget = p.kind === 'UPDATE_RECRUITMENT' && p.status === 'PENDING' && !current;
  const parents = await Promise.all(parentRefs(p.payload).map(async r => ({ ...r, parent: await parentOf(r.id) })));
  const waiting = p.status === 'PENDING' ? parents.filter(r => r.parent?.status !== 'APPROVED') : [];
  return {
    waiting,
    parents,
    // Masters carry names and ids, not notice facts: only recruitment proposals are checked value-by-value.
    checks: checkFacts(p.kind === 'CREATE_RECRUITMENT' || p.kind === 'UPDATE_RECRUITMENT' ? p.payload : {}, evidenceOf(p), Array.isArray(p.meta?.quoteInDocument) ? (p.meta!.quoteInDocument as string[]) : []),
    p,
    diff: buildDiff(p.payload, current),
    stale: staleFields(p.baseSnapshot, current),
    currentTitle: current?.title,
    missingTarget,
    evidence: evidenceOf(p),
    duplicate: duplicateOf(p),
  };
}));

// Parent ids are shown as their full chain (state › organisation › department › post), so a same-named master in
// another state is not mistaken for a duplicate. Pending parents (prop_…) are named from their own payload.
type MasterNode = { name: string; up?: string };
const PARENT_FIELDS = new Set(['stateId', 'organisationId', 'departmentId', 'postId']);
const masterNodes = new Map<string, MasterNode>();
if (d1 && proposals.some(p => Object.keys(p.payload).some(k => PARENT_FIELDS.has(k)))) {
  const [states, orgs, depts, posts] = await Promise.all([
    getAllStates(d1, { includeInactive: true }), getAllOrganisations(d1, { includeInactive: true }),
    getAllDepartments(d1, { includeInactive: true }), getAllCanonicalPosts(d1),
  ]).catch(error => {
    console.error('[admin/pending-changes] master names unavailable', error);
    return [[], [], [], []] as const;
  });
  for (const s of states) masterNodes.set(s.id, { name: s.name });
  for (const o of orgs) masterNodes.set(o.id, { name: o.name, up: o.stateId });
  for (const d of depts) masterNodes.set(d.id, { name: d.name, up: d.organisationId });
  for (const p of posts) masterNodes.set(p.id, { name: p.title, up: p.departmentId });
}
for (const parent of [...proposals, ...items.flatMap(i => i.parents.map(r => r.parent))]) {
  if (!parent || !(MASTER_PROPOSAL_KINDS as readonly string[]).includes(parent.kind)) continue;
  // An approved master is named by the record it created; a pending one by its own payload.
  const created = createdMasterId(parent);
  const name = parent.payload.name ?? parent.payload.title;
  if (created && masterNodes.has(created)) masterNodes.set(parent.id, masterNodes.get(created)!);
  else if (typeof name === 'string') masterNodes.set(parent.id, { name, up: (parent.payload.stateId ?? parent.payload.organisationId ?? parent.payload.departmentId) as string | undefined });
}
const chainOf = (id: unknown): string | null => {
  const names: string[] = [];
  for (let cur = typeof id === 'string' ? masterNodes.get(id) : undefined, hops = 0; cur && hops < 5; cur = cur.up ? masterNodes.get(cur.up) : undefined, hops++) names.unshift(cur.name);
  return names.length ? names.join(' › ') : null;
};

const fmt = (v: unknown): string => {
  if (v === null || v === undefined || v === '') return '—';
  if (typeof v === 'string') return v;
  if (typeof v === 'number' || typeof v === 'boolean') return String(v);
  return JSON.stringify(v, null, 2);
};
const when = (d: Date | null) => d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—';
const badge: Record<string, string> = {
  PENDING: 'bg-amber-50 text-amber-800 border-amber-200',
  APPLYING: 'bg-sky-50 text-sky-800 border-sky-200',
  APPROVED: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  REJECTED: 'bg-slate-100 text-slate-700 border-slate-200',
  FAILED: 'bg-rose-50 text-rose-800 border-rose-200',
  WITHDRAWN: 'bg-slate-100 text-slate-500 border-slate-200',
};

---

<AdminLayout
  title="Pending changes"
  currentSection="pending-changes"
  breadcrumbs={[{ label: 'Pending changes' }]}
>
  <div class="mx-auto max-w-5xl space-y-6">
    {message && (
      <div class={`p-3 rounded-lg border text-xs ${messageType === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-rose-50 border-rose-200 text-rose-900'}`} role="status">
        {message}
      </div>
    )}
    {loadError && <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs font-medium text-amber-900">{loadError}</div>}
    {!d1 && <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs font-medium text-amber-900">No database binding in this environment, so the proposals queue is unavailable.</div>}

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 font-heading">Review queue</h1>
        <p class="text-xs text-slate-500 mt-0.5">Changes proposed by the data pipeline and the private MCP. Evidence sits beside each field. Nothing goes live until you approve it here.</p>
      </div>
      <nav class="flex flex-wrap gap-1.5" aria-label="Filter by status">
        {BY_FILTERS.map(([v, l]) => (
          <a href={`/admin/pending-changes?status=${filter}${v ? `&by=${v}` : ''}`} class={`px-2.5 py-1 rounded-md border text-[11px] font-semibold transition-colors ${v === by ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-500 border-slate-200 hover:bg-slate-100'}`}>{l}</a>
        ))}
        <span class="w-px bg-slate-200 mx-1" aria-hidden="true"></span>
        {FILTERS.map(f => (
          <a href={`/admin/pending-changes?status=${f}${by ? `&by=${by}` : ''}`} class={`px-2.5 py-1 rounded-md border text-[11px] font-semibold transition-colors ${f === filter ? 'bg-blue-50 text-primary border-blue-200' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'}`}>
            {f.charAt(0) + f.slice(1).toLowerCase()}
          </a>
        ))}
      </nav>
    </div>

    {filter === 'SKIPPED' && (
      <div class="rounded-xl border border-slate-200 bg-white shadow-2xs overflow-hidden">
        <p class="p-4 text-xs text-slate-500 border-b border-slate-100">Notices the MCP was not allowed to propose because selection has no written or computer-based exam. Nothing was queued for them.</p>
        {skipped.length === 0 && !loadError && <p class="p-10 text-center text-slate-400 text-xs">No skipped notices.</p>}
        <ul class="divide-y divide-slate-100">
          {skipped.map(s => (
            <li class="p-4 text-xs space-y-0.5">
              <p class="font-semibold text-slate-950">{s.title}</p>
              <p class="text-rose-700 font-mono text-[11px]">{s.reason}</p>
              {s.sourceUrl && safeHref(s.sourceUrl) && <a href={safeHref(s.sourceUrl)} rel="noopener noreferrer" target="_blank" class="text-primary underline break-all text-[11px]">{s.sourceUrl}</a>}
              <p class="text-[11px] text-slate-500 font-mono">{s.by} · {when(new Date(s.at * 1000))}</p>
            </li>
          ))}
        </ul>
      </div>
    )}

    {filter !== 'SKIPPED' && items.length === 0 && !loadError && (
      <div class="rounded-xl border border-slate-200 bg-white p-10 text-center text-slate-400 text-xs">
        No {filter === 'ALL' ? '' : filter.toLowerCase()} proposals.
      </div>
    )}

    {items.map(({ p, diff, stale, currentTitle, missingTarget, evidence, duplicate, waiting, checks }) => (
      <article class="rounded-xl border border-slate-200 bg-white shadow-2xs overflow-hidden">
        <header class="flex flex-wrap items-start justify-between gap-3 p-4 border-b border-slate-100">
          <div class="min-w-0 space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${badge[p.status] ?? badge.PENDING}`}>{p.status}</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 font-mono">{p.kind === 'CREATE_RECRUITMENT' ? 'New recruitment' : p.kind === 'UPDATE_RECRUITMENT' ? 'Update' : p.kind === 'CREATE_ORGANISATION' ? 'New organisation (master)' : p.kind === 'CREATE_DEPARTMENT' ? 'New department (master)' : 'New post (master)'}</span>
              {checks.total > 0 && (
                <span title="Counted by machine: a field passes only when its number, date or advertisement number appears in the quoted text. It does not prove the quote is in the document." class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border ${checks.notInQuote.length ? 'bg-rose-50 text-rose-700 border-rose-200' : checks.matched === checks.total ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>machine-checked {checks.matched} of {checks.total}</span>
              )}
              {p.meta?.edited && <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border bg-sky-50 text-sky-800 border-sky-200">edited by reviewer</span>}
            </div>
            <h2 class="text-sm font-bold text-slate-950">{p.summary}</h2>
            {pipelineOf(p)?.documentUrl && safeHref(pipelineOf(p)!.documentUrl!) && (
              <p class="text-[11px] text-slate-600">Original document: <a href={safeHref(pipelineOf(p)!.documentUrl!)} rel="noopener noreferrer" target="_blank" class="text-primary underline break-all">{pipelineOf(p)!.documentUrl}</a>{pipelineOf(p)!.documentType ? ` (${pipelineOf(p)!.documentType!.toLowerCase().replace(/_/g, ' ')})` : ''}</p>
            )}
            {(pipelineOf(p)?.warnings?.length ?? 0) > 0 && <p class="text-[11px] text-amber-800">Checks: {pipelineOf(p)!.warnings!.join(' ')}</p>}
            <p class="text-[11px] text-slate-500 font-mono">
              {p.kind === 'UPDATE_RECRUITMENT' && <span>{currentTitle ?? p.recruitmentId} · </span>}
              {p.id} · proposed by {p.proposedBy} · {when(p.createdAt)}{p.supersedesId && <> · replaces <span>{p.supersedesId}</span></>}
            </p>
          </div>
        </header>

        {stale.length > 0 && (
          <div class="mx-4 mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">
            <strong>The live record changed since this was proposed</strong> ({stale.join(', ')}). Review the “Live now” column before approving.
          </div>
        )}
        {duplicate && (
          <div class="mx-4 mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">
            <strong>Possible duplicate.</strong> {duplicate.summary}
            <ul class="mt-1 list-disc pl-4">
              {duplicate.matches.map(m => <li>{m.matchedTitle} ({m.matchedAdvtNumber ?? 'no advt number'}) <span class="font-mono">{m.matchedRecruitmentId}</span>: {m.reasons.join(' ')}</li>)}
            </ul>
          </div>
        )}
        {waiting.map(w => (
          <div class={`mx-4 mt-4 rounded-lg border p-3 text-xs ${w.parent?.status === 'PENDING' || w.parent?.status === 'APPLYING' ? 'border-sky-200 bg-sky-50 text-sky-800' : 'border-rose-200 bg-rose-50 text-rose-900'}`}>
            {w.parent?.status === 'PENDING' || w.parent?.status === 'APPLYING'
              ? <><strong>Also created on approval:</strong> {w.parent.summary} <span class="font-mono">({w.id})</span>, the master this proposal's <span class="font-mono">{w.field}</span> needs. Rejecting this proposal rejects it too unless another proposal uses it.</>
              : <><strong>Cannot be applied.</strong> Its <span class="font-mono">{w.field}</span> is <span class="font-mono">{w.id}</span>, which is {w.parent?.status?.toLowerCase() ?? 'missing'}. Reject this proposal.</>}
          </div>
        ))}
        {(checks.notInQuote.length > 0 || checks.handwritten.length > 0 || checks.fromImage.length > 0 || checks.needsReading.length > 0) && (
          <div class="mx-4 mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800 space-y-0.5">
            <p class="font-semibold">Check these against the official page before approving:</p>
            {checks.notInQuote.length > 0 && <p class="text-rose-700">Value not found in its quote: <span class="font-mono">{checks.notInQuote.join(', ')}</span></p>}
            {checks.handwritten.length > 0 && <p class="text-rose-700">Handwritten on the notice: <span class="font-mono">{checks.handwritten.join(', ')}</span></p>}
            {checks.fromImage.length > 0 && <p class="text-amber-800">Read from a scanned image, so the quote itself may be misread: <span class="font-mono">{checks.fromImage.join(', ')}</span></p>}
            {checks.needsReading.length > 0 && <p class="text-amber-800">Cannot be compared by machine, read them: <span class="font-mono">{checks.needsReading.join(', ')}</span></p>}
          </div>
        )}
        {missingTarget && (
          <div class="mx-4 mt-4 rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-900">The target recruitment no longer exists. Reject this proposal.</div>
        )}

        <div class="p-4 overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead>
              <tr class="text-[10px] uppercase tracking-wider text-slate-500 border-b border-slate-200">
                <th class="py-1.5 pr-3 font-bold">Field</th>
                <th class="py-1.5 pr-3 font-bold">{p.kind !== 'UPDATE_RECRUITMENT' ? '—' : 'Live now'}</th>
                <th class="py-1.5 font-bold">Proposed</th>
              </tr>
            </thead>
            <tbody>
              {diff.map(row => (
                <tr class="border-b border-slate-100 align-top">
                  <td class="py-2 pr-3 font-mono font-semibold text-slate-800 whitespace-nowrap">{row.field}
                    {checks.fields.filter(c => c.field === row.field).map(c => (
                      <div class="mt-1 flex flex-wrap gap-1 font-sans font-bold text-[9px] uppercase tracking-wider" title={c.detail}>
                        <span class={`px-1.5 py-0.5 rounded border ${CHECK_LABEL[c.status][1]}`}>{CHECK_LABEL[c.status][0]}</span>
                        {c.handwritten && <span class="px-1.5 py-0.5 rounded border bg-rose-50 text-rose-700 border-rose-200">handwritten</span>}
                        {c.fromImage && <span class="px-1.5 py-0.5 rounded border bg-amber-50 text-amber-800 border-amber-200">scanned</span>}
                        {c.quoteInDocument && <span class="px-1.5 py-0.5 rounded border bg-emerald-50 text-emerald-800 border-emerald-200">quote in page</span>}
                      </div>
                    ))}
                  </td>
                  <td class="py-2 pr-3 text-slate-500"><pre class="whitespace-pre-wrap break-words font-mono text-[11px]">{p.kind !== 'UPDATE_RECRUITMENT' ? '' : fmt(row.before)}</pre></td>
                  <td class={`py-2 ${row.changed ? 'text-slate-950' : 'text-slate-400'}`}><pre class="whitespace-pre-wrap break-words font-mono text-[11px]">{fmt(row.after)}{p.kind === 'UPDATE_RECRUITMENT' && !row.changed ? '  (unchanged)' : ''}</pre>
                    {PARENT_FIELDS.has(row.field) && chainOf(row.after) && <p class="mt-1 text-[11px] font-sans font-semibold text-slate-700" data-parent-chain>{chainOf(row.after)}</p>}
                    {checks.fields.filter(c => c.field === row.field && c.status !== 'MATCHES_QUOTE').map(c => <p class="mt-1 text-[10px] font-sans text-slate-600">{c.detail}</p>)}
                    {evidenceFor(evidence, row.field).map(e => (
                      <div class="mt-1.5 rounded border border-slate-100 bg-slate-50 p-1.5 text-[10px] text-slate-600 font-sans">
                        <span class="font-semibold">Evidence</span> · {e.method === 'NATIVE' ? 'text' : e.method === 'VISION' ? 'read from image' : 'OCR'}{e.handwritten ? ' · handwritten' : ''}{e.page ? ` · page ${e.page}` : ''}{e.section ? ` · ${e.section}` : ''}
                        {pageHref(e) ? <> · <a href={pageHref(e)} class="text-primary underline" rel="noopener noreferrer" target="_blank">{e.page ? `open page ${e.page}` : 'source'}</a></> : null}
                        {e.snippet && <blockquote class="mt-0.5 whitespace-pre-wrap break-words">“{e.snippet}”</blockquote>}
                      </div>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {p.status === 'PENDING' ? (
          <footer class="flex flex-wrap items-end justify-between gap-3 p-4 border-t border-slate-100 bg-slate-50/60">
            <form
              method="POST"
              class="flex flex-wrap items-center gap-3"
              onsubmit={`return confirm(${JSON.stringify(`Approve proposal ${p.id}${currentTitle ? ` (${currentTitle})` : ''}?\n\nThis writes the proposed changes to LIVE data.`)})`}
            >
              <input type="hidden" name="_action" value="approve" />
              <input type="hidden" name="proposalId" value={p.id} />
              {p.kind === 'CREATE_RECRUITMENT' && (
                <label class="flex items-center gap-1.5 text-[11px] text-slate-700">
                  <input type="checkbox" name="publish" class="size-3.5 rounded border-slate-300" />
                  Publish now (otherwise saved as draft)
                </label>
              )}
              {stale.length > 0 && (
                <label class="flex items-center gap-1.5 text-[11px] text-amber-900">
                  <input type="checkbox" name="confirmStale" class="size-3.5 rounded border-slate-300" required />
                  Apply anyway
                </label>
              )}
              <button type="submit" disabled={missingTarget || waiting.some(w => w.parent?.status !== 'PENDING')} class="px-3.5 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                Approve
              </button>
            </form>
            <form
              method="POST"
              class="flex items-center gap-2"
              onsubmit={`return confirm(${JSON.stringify(`Reject proposal ${p.id}? It will be closed and nothing will change in live data.`)})`}
            >
              <input type="hidden" name="_action" value="reject" />
              <input type="hidden" name="proposalId" value={p.id} />
              <input type="text" name="note" maxlength="500" placeholder="Reason (optional)" class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs w-48 outline-none focus:ring-2 focus:ring-primary" />
              <button type="submit" class="px-3.5 py-1.5 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold transition-colors cursor-pointer">
                Reject
              </button>
            </form>
          </footer>
          <details class="px-4 pb-4 bg-slate-50/60 border-t border-slate-100">
            <summary class="cursor-pointer py-2 text-[11px] font-semibold text-slate-600">Edit proposed values</summary>
            <form method="POST" class="space-y-2">
              <input type="hidden" name="_action" value="edit" />
              <input type="hidden" name="proposalId" value={p.id} />
              <textarea name="payload" rows="10" spellcheck="false" class="w-full px-2.5 py-2 rounded-lg border border-slate-200 bg-white text-[11px] font-mono outline-none focus:ring-2 focus:ring-primary">{JSON.stringify(p.payload, null, 2)}</textarea>
              <p class="text-[10px] text-slate-500">Values are validated like any proposal. Array fields (dates, links, vacancies) replace the whole list. After saving, check the diff above, then approve.</p>
              <button type="submit" class="px-3.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-xs font-semibold cursor-pointer">Save edits</button>
            </form>
          </details>
        ) : (
          <footer class="p-4 border-t border-slate-100 bg-slate-50/60 text-[11px] text-slate-600">
            {p.status === 'APPLYING'
              ? 'Being applied. If this stays here, the write was interrupted; check the audit log before retrying.'
              : <>Decided by <span class="font-mono">{p.decidedBy ?? '—'}</span> on {when(p.decidedAt)}{p.decisionNote ? ` · ${p.decisionNote}` : ''}</>}
          </footer>
        )}
      </article>
    ))}
  </div>
</AdminLayout>
