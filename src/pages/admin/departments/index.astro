---
// src/pages/admin/departments/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminSidebar from '../../../components/admin/AdminSidebar.astro';

const departments = [
  {
    name: 'Police Department',
    sector: 'Police',
    openRecruitments: 12,
    published: 'Yes',
    status: 'Active',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    updated: 'Today',
  },
  {
    name: 'Forest Department',
    sector: 'Forest',
    openRecruitments: 7,
    published: 'Yes',
    status: 'Active',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    updated: 'Yesterday',
  },
  {
    name: 'Women & Child Development',
    sector: 'Social development',
    openRecruitments: 3,
    published: 'Draft',
    status: 'Draft',
    statusColor: 'bg-muted text-muted-foreground border-border',
    updated: '12 Sep 2026',
  },
];
---

<BaseLayout title="Departments Directory — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="departments" />

    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <h1 class="text-2xl font-bold text-foreground">Departments</h1>
          <p class="text-xs text-muted-foreground mt-0.5">Government department registry categorized by state sector.</p>
        </div>

        <button type="button" class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm inline-flex items-center gap-1.5 transition-colors">
          <span>+ Add department</span>
        </button>
      </div>

      <!-- Table Card -->
      <div class="bg-card rounded-2xl border border-border overflow-hidden shadow-sm">
        <table class="w-full text-xs text-left">
          <thead class="bg-muted text-muted-foreground font-semibold uppercase text-[10px] tracking-wider border-b border-border">
            <tr>
              <th class="py-3 px-4">Department</th>
              <th class="py-3 px-4">Sector</th>
              <th class="py-3 px-4">Open Recruitments</th>
              <th class="py-3 px-4">Published Pages</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4">Updated</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {departments.map((d) => (
              <tr class="hover:bg-muted/40 transition-colors">
                <td class="py-3.5 px-4 font-bold text-foreground">{d.name}</td>
                <td class="py-3.5 px-4 text-muted-foreground">{d.sector}</td>
                <td class="py-3.5 px-4 font-mono font-bold text-foreground">{d.openRecruitments}</td>
                <td class="py-3.5 px-4 text-muted-foreground">{d.published}</td>
                <td class="py-3.5 px-4">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${d.statusColor}`}>
                    {d.status}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-muted-foreground">{d.updated}</td>
                <td class="py-3.5 px-4 text-right">
                  <button class="text-primary hover:underline font-semibold">Edit</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <!-- Empty State Reference Footer -->
        <div class="p-4 border-t border-border flex items-center justify-between text-xs text-muted-foreground">
          <span>Showing 3 departments across 8 sectors</span>
          <div class="flex items-center gap-2">
            <button class="px-2.5 py-1 rounded border border-border disabled:opacity-40" disabled>Previous</button>
            <button class="px-2.5 py-1 rounded border border-border hover:bg-muted">Next</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
