---
// src/pages/admin/organisations/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminSidebar from '../../../components/admin/AdminSidebar.astro';

const orgs = [
  {
    name: 'Madhya Pradesh Employees Selection Board (MPESB)',
    slug: 'mpesb',
    recruitments: 32,
    domain: 'esb.mp.gov.in',
    status: 'Active',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    updated: 'Today',
  },
  {
    name: 'High Court of Madhya Pradesh (MPHC)',
    slug: 'mp-high-court',
    recruitments: 8,
    domain: 'mphc.gov.in',
    status: 'Active',
    statusColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    updated: 'Yesterday',
  },
  {
    name: 'Department of Public Health & Family Welfare',
    slug: 'health-dept',
    recruitments: 14,
    domain: 'health.mp.gov.in',
    status: 'Needs review',
    statusColor: 'bg-amber-50 text-amber-700 border-amber-200',
    updated: '14 Sep 2026',
  },
];
---

<BaseLayout title="Organisations Management — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="organisations" />

    <!-- Main Content & Drawer Grid -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <h1 class="text-2xl font-bold text-foreground">
            Organisations
          </h1>
          <p class="text-xs text-muted-foreground mt-0.5">
            Maintain canonical organisation records used across discovery pages.
          </p>
        </div>

        <button
          type="button"
          class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm inline-flex items-center gap-1.5 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span>Add organisation</span>
        </button>
      </div>

      <!-- Main Layout: Table (2 Cols) + Add Drawer State (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Table Area (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-card rounded-2xl border border-border overflow-hidden shadow-sm">
            <table class="w-full text-xs text-left">
              <thead class="bg-muted text-muted-foreground font-semibold uppercase text-[10px] tracking-wider border-b border-border">
                <tr>
                  <th class="py-3 px-4">Organisation</th>
                  <th class="py-3 px-4">Slug</th>
                  <th class="py-3 px-4">Drives</th>
                  <th class="py-3 px-4">Official Domain</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {orgs.map((o) => (
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-foreground">{o.name}</td>
                    <td class="py-3.5 px-4 font-mono text-muted-foreground">{o.slug}</td>
                    <td class="py-3.5 px-4 font-mono font-bold text-foreground">{o.recruitments}</td>
                    <td class="py-3.5 px-4 font-mono text-primary">{o.domain}</td>
                    <td class="py-3.5 px-4">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${o.statusColor}`}>
                        {o.status}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end gap-2 text-xs">
                        <button class="text-primary hover:underline font-semibold">Edit</button>
                        <span>·</span>
                        <a href={`/organisations/${o.slug}`} class="text-muted-foreground hover:underline">View</a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right Side Drawer: Add Organisation -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm space-y-4">
          <h2 class="text-xs font-bold text-muted-foreground uppercase tracking-wider pb-2 border-b border-border">
            Add Organisation Drawer
          </h2>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block font-semibold text-foreground mb-1">Organisation Name</label>
              <input type="text" placeholder="e.g. MP Pollution Control Board" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs" />
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Slug</label>
              <input type="text" placeholder="mp-pcb" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs font-mono" />
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Official Website</label>
              <input type="url" placeholder="https://mppcb.mp.gov.in" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs font-mono" />
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Short Description</label>
              <textarea placeholder="Authority mandate summary..." rows="3" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs"></textarea>
            </div>

            <div class="pt-2">
              <button class="w-full py-2.5 px-4 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs transition-colors">
                Save organisation
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
