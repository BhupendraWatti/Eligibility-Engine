  <script is:inline define:vars={{ iconsData: SECTOR_ICONS, themesData: SECTOR_THEMES }}>
    // Add Post Drawer controls
    const drawer = document.getElementById('addPostDrawer');
    document.getElementById('openAddPostDrawerBtn')?.addEventListener('click', () => drawer?.classList.remove('hidden'));
    document.getElementById('addPostBtnInPane')?.addEventListener('click', () => drawer?.classList.remove('hidden'));
    document.getElementById('closeAddPostDrawerBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));
    document.getElementById('cancelAddPostDrawerBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));

    // Add Sector Drawer controls
    const sectorDrawer = document.getElementById('addSectorDrawer');
    document.getElementById('openAddSectorDrawerBtn')?.addEventListener('click', () => sectorDrawer?.classList.remove('hidden'));
    document.getElementById('closeAddSectorDrawerBtn')?.addEventListener('click', () => sectorDrawer?.classList.add('hidden'));
    document.getElementById('cancelAddSectorDrawerBtn')?.addEventListener('click', () => sectorDrawer?.classList.add('hidden'));
    document.getElementById('switchToAddSectorBtn')?.addEventListener('click', () => {
      drawer?.classList.add('hidden');
      sectorDrawer?.classList.remove('hidden');
    });

    // Edit Sector Drawer controls
    const editSectorDrawer = document.getElementById('editSectorDrawer');
    document.getElementById('openEditSectorDrawerBtn')?.addEventListener('click', () => editSectorDrawer?.classList.remove('hidden'));
    document.getElementById('closeEditSectorDrawerBtn')?.addEventListener('click', () => editSectorDrawer?.classList.add('hidden'));
    document.getElementById('cancelEditSectorDrawerBtn')?.addEventListener('click', () => editSectorDrawer?.classList.add('hidden'));

    // Auto-slug generator for new sector
    const sectorNameInput = document.getElementById('addSectorName');
    const sectorSlugInput = document.getElementById('addSectorSlug');
    sectorNameInput?.addEventListener('input', () => {
      if (sectorSlugInput && !sectorSlugInput.dataset.touched) {
        sectorSlugInput.value = sectorNameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }
    });
    sectorSlugInput?.addEventListener('input', () => {
      if (sectorSlugInput) sectorSlugInput.dataset.touched = 'true';
    });

    // Sector Filter for left sidebar
    const sectorFilterInput = document.getElementById('sectorFilterInput');
    const sectorItems = document.querySelectorAll('.sector-item');
    sectorFilterInput?.addEventListener('input', () => {
      const q = sectorFilterInput.value.toLowerCase().trim();
      sectorItems.forEach((item) => {
        const name = item.getAttribute('data-sector-name') || '';
        if (!q || name.includes(q)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });

    // Real-Time Live Preview Synchronization Engine
    function setupLivePreview(prefix, fieldIds) {
      const titleEl = document.getElementById(prefix + 'Title');
      const descEl = document.getElementById(prefix + 'Desc');
      const badgeEl = document.getElementById(prefix + 'Badge');
      const cardEl = document.getElementById(prefix + 'Card');

      const nameInput = document.getElementById(fieldIds.name);
      const descInput = document.getElementById(fieldIds.desc);
      const iconInput = document.getElementById(fieldIds.icon);
      const themeInput = document.getElementById(fieldIds.theme);

      function refreshPreview() {
        if (titleEl && nameInput) {
          titleEl.textContent = nameInput.value.trim() || 'Sector Name';
        }
        if (descEl && descInput) {
          descEl.textContent = descInput.value.trim() || 'Public service domain covering canonical recruitment roles across India.';
        }
        if (badgeEl && iconInput) {
          const iconKey = iconInput.value.trim().toLowerCase();
          const iconDef = iconsData[iconKey] || iconsData.briefcase;
          if (iconDef) {
            const svg = badgeEl.querySelector('svg');
            if (svg) svg.innerHTML = iconDef.svgInner;
          }
        }
        if (badgeEl && themeInput) {
          const themeKey = themeInput.value.trim().toLowerCase();
          const themeDef = themesData[themeKey] || themesData.blue;
          if (themeDef) {
            badgeEl.className = 'size-10 rounded-lg border flex items-center justify-center mb-3.5 transition-colors ' + themeDef.badgeClass;
          }
        }
      }

      nameInput?.addEventListener('input', refreshPreview);
      descInput?.addEventListener('input', refreshPreview);
      iconInput?.addEventListener('change', refreshPreview);
      themeInput?.addEventListener('change', refreshPreview);
    }

    setupLivePreview('addSectorPreview', {
      name: 'addSectorName',
      desc: 'addSectorDesc',
      icon: 'addSectorIcon',
      theme: 'addSectorTheme',
    });

    setupLivePreview('editSectorPreview', {
      name: 'editSectorName',
      desc: 'editSectorDesc',
      icon: 'editSectorIcon',
      theme: 'editSectorTheme',
    });
  </script>

