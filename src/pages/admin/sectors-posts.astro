---
// src/pages/admin/sectors-posts.astro (NIRNAY OPS - Sectors & Posts Taxonomy Console)
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDataTable from '../../components/admin/AdminDataTable.astro';
import MasterSubNav from '../../components/admin/MasterSubNav.astro';
import SectorIcon from '../../components/common/SectorIcon.astro';
import SectorCard from '../../components/common/SectorCard.astro';
import {
  SECTOR_ICON_LIST,
  SECTOR_THEME_LIST,
  SECTOR_ICONS,
  SECTOR_THEMES,
  getSectorThemeDef,
  normalizeSectorIcon,
  normalizeSectorTheme,
} from '../../services/sector-theme';
import {
  getAllCanonicalPosts,
  getAllSectors,
  getAllDepartments,
  createCanonicalPost,
  createSector,
  updateSector,
} from '../../db/queries';
import { resolveSectorRoute } from '../../services/sector-routing';
import {
  parseBooleanInput,
  parseIntegerInput,
  readAdminSubmission,
  resolveRequiredReference,
} from '../../services/admin-integrity';

let statusMessage: { type: 'success' | 'error'; text: string } | null = Astro.url.searchParams.has('saved')
  ? { type: 'success', text: 'Sector master data saved successfully.' }
  : null;

const [posts, sectors, departments] = await Promise.all([
  getAllCanonicalPosts(),
  getAllSectors(undefined, { includeInactive: true }),
  getAllDepartments(),
]);

let createdPostId = '';
const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;

if (Astro.request.method === 'POST') {
  try {
    const input = await readAdminSubmission(Astro.request);
    const action = input.text('_action', 'action') || 'create_post';
    const adminEmail = Astro.locals.adminEmail;
    if (!adminEmail) throw new Error('Admin identity is required for mutations.');

    if (action === 'create_sector') {
      const sectorName = input.text('name', 'title');
      let sectorSlug = input.text('slug');
      const description = input.text('description');
      const icon = input.text('icon') || 'briefcase';
      const theme = input.text('theme') || 'blue';
      const displayOrder = parseIntegerInput(input.value('displayOrder', 'display_order'), sectors.length + 1);
      const isActive = parseBooleanInput(input.value('isActive', 'is_active'), true) ? 1 : 0;

      if (!sectorName) throw new Error('Sector name is required.');
      if (!sectorSlug) {
        sectorSlug = sectorName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }

      const createdSectorId = await createSector({
        name: sectorName,
        slug: sectorSlug,
        description,
        icon,
        theme,
        displayOrder,
        isActive,
        adminEmail,
      });

      statusMessage = {
        type: 'success',
        text: `New Government Sector "${sectorName}" created successfully!`,
      };
      Astro.response.headers.set('X-Sector-Id', createdSectorId);
      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          sector_id: createdSectorId,
          id: createdSectorId,
          success: true,
          message: statusMessage.text,
        }), {
          status: 201,
          headers: { 'Content-Type': 'application/json', 'X-Sector-Id': createdSectorId },
        });
      }
    } else if (action === 'update_sector') {
      const sectorId = input.text('id', 'sector_id');
      const sectorName = input.text('name', 'title');
      const sectorSlug = input.text('slug');
      const description = input.text('description');
      const icon = input.text('icon');
      const theme = input.text('theme');
      const displayOrder = parseIntegerInput(input.value('displayOrder', 'display_order'), 0);
      const isActive = parseBooleanInput(input.value('isActive', 'is_active'), true) ? 1 : 0;

      if (!sectorId || !sectorName) {
        throw new Error('Sector ID and Sector Name are required for updating.');
      }

      const updated = await updateSector({
        id: sectorId,
        name: sectorName,
        slug: sectorSlug || undefined,
        description,
        icon,
        theme,
        displayOrder,
        isActive,
        adminEmail,
      });
      if (!updated) throw new Error(`Unknown sector ID: ${sectorId}`);

      statusMessage = {
        type: 'success',
        text: `Government Sector "${sectorName}" updated successfully!`,
      };
      Astro.response.headers.set('X-Sector-Id', sectorId);
      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          sector_id: sectorId,
          id: sectorId,
          success: true,
          message: statusMessage.text,
        }), {
          status: 200,
          headers: { 'Content-Type': 'application/json', 'X-Sector-Id': sectorId },
        });
      }
    } else if (action === 'toggle_sector_status') {
      const sectorId = input.text('id', 'sector_id');
      const targetStatus = parseBooleanInput(input.value('isActive', 'is_active'), false) ? 1 : 0;
      const targetSector = sectors.find(s => s.id === sectorId);
      if (!targetSector) throw new Error(`Unknown sector ID: ${sectorId}`);

      const updated = await updateSector({
        id: sectorId,
        isActive: targetStatus,
        adminEmail,
      });
      if (!updated) throw new Error(`Unknown sector ID: ${sectorId}`);

      statusMessage = {
        type: 'success',
        text: `Sector "${targetSector.name}" status changed to ${targetStatus ? 'Active' : 'Inactive'}.`,
      };
      Astro.response.headers.set('X-Sector-Id', sectorId);
      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          sector_id: sectorId,
          id: sectorId,
          success: true,
          message: statusMessage.text,
        }), {
          status: 200,
          headers: { 'Content-Type': 'application/json', 'X-Sector-Id': sectorId },
        });
      }
    } else {
      // action === 'create_post'
      const title = input.text('title', 'name');
      let sectorId = input.text('sectorId', 'sector_id', 'sector');
      let departmentId = input.text('departmentId', 'department_id', 'department');
      const payScale = input.text('payScale', 'pay_scale');
      const defaultMinAge = parseIntegerInput(input.value('defaultMinAge', 'default_min_age', 'minAge'), 18);
      const defaultMaxAge = parseIntegerInput(input.value('defaultMaxAge', 'default_max_age', 'maxAge'), 33);
      const defaultQualification = input.text('defaultQualification', 'default_qualification', 'qualification') || '10TH';
      const summary = input.text('summary', 'description');

      sectorId = resolveRequiredReference(sectorId, sectors, 'sector').id;
      departmentId = resolveRequiredReference(departmentId, departments, 'department').id;

      if (!title || !sectorId || !departmentId) {
        throw new Error('Title, Sector, and Department are required to create a canonical post.');
      }

      createdPostId = await createCanonicalPost({
        title,
        sectorId,
        departmentId,
        payScale: payScale || null,
        defaultMinAge,
        defaultMaxAge,
        defaultQualification,
        summary,
        isActive: 1,
      });

      statusMessage = {
        type: 'success',
        text: `Canonical post "${title}" created successfully!`,
      };
      Astro.response.headers.set('X-Post-Id', createdPostId);

      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          post_id: createdPostId,
          id: createdPostId,
          success: true,
          message: statusMessage.text,
        }), {
          status: 201,
          headers: {
            'Content-Type': 'application/json',
            'X-Post-Id': createdPostId,
          },
        });
      }
    }
    const selectedSector = Astro.url.searchParams.get('sector');
    const redirectQuery = new URLSearchParams({ saved: '1' });
    if (selectedSector) redirectQuery.set('sector', selectedSector);
    return Astro.redirect(`/admin/sectors-posts?${redirectQuery}`, 303);
  } catch (error: any) {
    statusMessage = { type: 'error', text: error.message };
    Astro.response.status = 400;
    if (!acceptsHtml) {
      return new Response(JSON.stringify({ error: error.message }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' },
      });
    }
  }
}

const selectedSectorSlug = Astro.url.searchParams.get('sector') || sectors[0]?.slug || 'police-defence-prisons';
const activeSector = resolveSectorRoute(selectedSectorSlug, sectors) || sectors[0] || {
  id: 'sec_police',
  name: 'Police, Defence & Prisons',
  slug: 'police-defence-prisons',
  description: 'Law enforcement, armed constabulary, state investigation agencies, and prison wardens.',
  icon: 'shield',
  theme: 'indigo',
  displayOrder: 1,
  isActive: 1,
};

const activeThemeDef = getSectorThemeDef(activeSector?.theme);
const linkedPosts = posts.filter(p => p.sectorId === activeSector?.id);

// Dynamic Standard Master Qualification Levels
const qualificationOptions = [
  { value: '7TH', label: '7th Class Pass (Middle School)', level: 'Primary' },
  { value: '8TH', label: '8th Class Pass (Primary Cadre)', level: 'Primary' },
  { value: '10TH', label: '10th Class Pass (Matriculation / Secondary)', level: 'Secondary' },
  { value: '12TH', label: '12th Class Pass (Higher Secondary / 10+2)', level: 'Higher Secondary' },
  { value: 'ITI', label: 'ITI Trade Certificate (Vocational / Technical)', level: 'Vocational' },
  { value: 'DIPLOMA', label: 'Polytechnic Engineering / Technical Diploma', level: 'Technical' },
  { value: 'GRADUATION', label: "Bachelor's Degree (Graduate - Any Discipline)", level: 'Undergraduate' },
  { value: 'POST_GRADUATION', label: "Master's Degree (Post Graduate - Any Discipline)", level: 'Postgraduate' },
];

// Standard Dynamic 7th CPC State Pay Matrix Bands
const standardPayBands = [
  { level: 'Level 1', band: 'Rs. 15,500 - 49,000/- (Pay Matrix Level 1)' },
  { level: 'Level 2', band: 'Rs. 19,500 - 62,000/- (Pay Matrix Level 2)' },
  { level: 'Level 4', band: 'Rs. 25,300 - 80,500/- (Pay Matrix Level 4)' },
  { level: 'Level 6', band: 'Rs. 28,700 - 91,300/- (Pay Matrix Level 6)' },
  { level: 'Level 7', band: 'Rs. 32,800 - 1,03,600/- (Pay Matrix Level 7)' },
  { level: 'Level 8', band: 'Rs. 36,200 - 1,14,800/- (Pay Matrix Level 8)' },
  { level: 'Level 9', band: 'Rs. 42,700 - 1,35,100/- (Pay Matrix Level 9)' },
  { level: 'Level 10', band: 'Rs. 56,100 - 1,77,500/- (Pay Matrix Level 10)' },
  { level: 'Level 12', band: 'Rs. 56,100 - 1,77,500/- (Pay Matrix Level 12)' },
  { level: 'Level J-1', band: 'Rs. 77,840 - 1,36,520/- (Pay Matrix Level J-1)' },
];
---

<AdminLayout
  title="Sectors & Posts | Master Records"
  currentSection="sectors-posts"
  breadcrumbs={[
    { label: 'Master records', href: '/admin/masters' },
    { label: 'Sectors & posts' },
  ]}
>
  <div class="mx-auto max-w-6xl space-y-4 sm:space-y-6">
    <!-- Master Records Section Sub-Types Navigation Bar -->
    <MasterSubNav currentTab="sectors-posts" />

    {statusMessage && (
      <div class={`p-3.5 rounded-xl border text-xs flex items-center justify-between shadow-2xs ${
        statusMessage.type === 'success'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
          : 'bg-rose-50 border-rose-200 text-rose-900'
      }`}>
        <div class="flex items-center gap-2 font-medium">
          {statusMessage.type === 'success' ? (
            <svg class="size-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          ) : (
            <svg class="size-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          )}
          <span>{statusMessage.text}</span>
        </div>
      </div>
    )}
    {createdPostId && <input type="hidden" name="post_id" value={createdPostId} />}

    <!-- Shared Dynamic Datalist for Pay Matrix Autocomplete -->
    <datalist id="dynamicSectorPayBandsList">
      {standardPayBands.map((pb) => (
        <option value={pb.band}>{pb.level} - {pb.band}</option>
      ))}
    </datalist>

    <!-- Header with Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Sectors & Post Taxonomy
        </h1>
        <p class="text-xs text-zinc-500 mt-0.5">
          Standardized state classification taxonomy for recruitments, service cadres, and eligibility rules
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="openAddSectorDrawerBtn"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-300 bg-white hover:bg-zinc-100 text-zinc-800 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Add Sector</span>
        </button>
        <a
          href="/admin/masters"
          class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors"
        >
          Raw Masters Table
        </a>
        <button
          type="button"
          id="openAddPostDrawerBtn"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Add canonical post</span>
        </button>
      </div>
    </div>

    <!-- Two-Column Taxonomy Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-[320px_minmax(0,1fr)] items-start gap-6">
      <!-- Left Column: Sector List -->
      <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden lg:sticky lg:top-20 flex flex-col max-h-[calc(100vh-6rem)]">
        <div class="p-3 border-b border-zinc-100 bg-zinc-50/50 flex flex-col gap-2 shrink-0">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-700">All Sectors ({sectors.length})</span>
            <span class="text-[10px] text-zinc-400 font-mono">Taxonomy</span>
          </div>
          <!-- Dynamic Filter for Sectors -->
          <div class="relative">
            <input
              type="text"
              id="sectorFilterInput"
              placeholder="Filter sectors..."
              class="w-full pl-7 pr-2.5 py-1 text-xs rounded-lg border border-zinc-200 bg-white outline-none focus:ring-1 focus:ring-zinc-900"
            />
            <svg class="size-3 text-zinc-400 absolute left-2 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
        </div>

        <div class="divide-y divide-zinc-100 overflow-y-auto" id="sectorsList">
          {sectors.map((sec) => {
            const count = posts.filter(p => p.sectorId === sec.id).length;
            const isSelected = sec.slug === activeSector?.slug;
            const secTheme = getSectorThemeDef(sec.theme);
            const isSecActive = sec.isActive !== 0;

            return (
              <a
                href={`/admin/sectors-posts?sector=${sec.slug}`}
                data-sector-name={sec.name.toLowerCase()}
                class={`sector-item flex items-center justify-between p-3 text-xs transition-colors ${
                  isSelected
                    ? 'bg-primary text-white font-semibold'
                    : 'text-zinc-800 hover:bg-zinc-50'
                }`}
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class={`size-7 rounded-md border flex items-center justify-center shrink-0 ${
                    isSelected ? 'bg-primary border-primary text-white' : secTheme.badgeClass
                  }`}>
                    <SectorIcon name={sec.icon} class="size-3.5" />
                  </div>
                  <div class="min-w-0">
                    <div class="font-medium truncate flex items-center gap-1.5">
                      <span class="truncate">{sec.name}</span>
                      {!isSecActive && (
                        <span class="px-1 py-0.2 rounded text-[9px] font-mono uppercase bg-zinc-200 text-zinc-700 font-bold shrink-0">
                          Inactive
                        </span>
                      )}
                    </div>
                    <div class={`text-[10px] font-mono truncate ${isSelected ? 'text-zinc-400' : 'text-zinc-400'}`}>
                      /{sec.slug}
                    </div>
                  </div>
                </div>
                <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold font-mono shrink-0 ml-2 ${
                  isSelected
                    ? 'bg-primary text-white'
                    : 'bg-zinc-100 text-zinc-600'
                }`}>
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Right Column: Detail Pane for Active Sector -->
      <div class="space-y-6">
        <!-- Sector Header Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-2xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-zinc-100 pb-4">
            <div class="flex items-start gap-3.5 min-w-0">
              <div class={`size-12 rounded-xl border flex items-center justify-center shrink-0 shadow-2xs ${activeThemeDef.badgeClass}`}>
                <SectorIcon name={activeSector.icon} class="size-6" />
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 font-mono">
                    Order #{activeSector.displayOrder ?? 0}
                  </span>
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border font-mono ${
                    activeSector.isActive !== 0
                      ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                      : 'bg-zinc-100 text-zinc-600 border-zinc-200'
                  }`}>
                    {activeSector.isActive !== 0 ? 'Active on Public Portal' : 'Inactive (Hidden)'}
                  </span>
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold font-mono border ${activeThemeDef.badgeClass}`}>
                    Theme: {activeThemeDef.label}
                  </span>
                </div>
                <h2 class="text-xl font-bold text-zinc-950 font-heading mt-1">{activeSector.name}</h2>
                <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-500 mt-0.5">
                  <span>slug: /{activeSector.slug}</span>
                  <span>·</span>
                  <span>icon: {normalizeSectorIcon(activeSector.icon)}</span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                id="openEditSectorDrawerBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 bg-white hover:bg-zinc-100 text-xs font-semibold text-zinc-800 shadow-2xs transition-colors cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                <span>Edit Sector</span>
              </button>
              <form method="POST" class="inline">
                <input type="hidden" name="_action" value="toggle_sector_status" />
                <input type="hidden" name="id" value={activeSector.id} />
                <input type="hidden" name="isActive" value={activeSector.isActive !== 0 ? '0' : '1'} />
                <button
                  type="submit"
                  class={`px-3 py-1.5 rounded-lg border text-xs font-semibold shadow-2xs transition-colors cursor-pointer ${
                    activeSector.isActive !== 0
                      ? 'border-amber-200 bg-amber-50 hover:bg-amber-100 text-amber-900'
                      : 'border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-900'
                  }`}
                  title={activeSector.isActive !== 0 ? 'Hide from public discovery' : 'Publish on public discovery'}
                >
                  {activeSector.isActive !== 0 ? 'Deactivate' : 'Activate'}
                </button>
              </form>
              <a
                href={`/sectors/${activeSector.slug}`}
                target="_blank"
                class="px-3 py-1.5 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 text-xs font-semibold text-zinc-700 shadow-2xs transition-colors"
                title="View public sector hub"
              >
                Public Hub ↗
              </a>
            </div>
          </div>

          <p class="text-xs text-zinc-600 leading-relaxed">
            {activeSector.description || 'Public service domain covering canonical recruitment roles across India.'}
          </p>

          <!-- Protection Safeguard Callout -->
          <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-xs text-zinc-700 flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-zinc-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <div>
              <span class="font-bold block text-zinc-900">Taxonomy & Presentation Rule</span>
              <span class="text-[11px] text-zinc-600">
                Sector metadata directly drives the public homepage "Explore by Sector" cards and sector discovery hubs. All visual rendering remains strictly controlled by frontend code.
              </span>
            </div>
          </div>
        </div>

        <!-- Associated Canonical Posts Table -->
        <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
          <div class="p-4 border-b border-zinc-100 flex items-center justify-between">
            <div>
              <h3 class="text-sm font-bold text-zinc-950 font-heading">Associated Canonical Posts</h3>
              <p class="text-xs text-zinc-500">Standardized roles inheriting this sector's pay scale and rules ({linkedPosts.length} posts).</p>
            </div>
            <button type="button" id="addPostBtnInPane" class="text-xs font-semibold text-zinc-950 hover:underline cursor-pointer">
              + Add post to {activeSector.name}
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse" id="sectorPostsTable">
              <thead>
                <tr class="border-b border-zinc-200 bg-zinc-50/50 font-semibold uppercase text-[10px] tracking-wider text-zinc-500">
                  <th class="py-3 px-4">Canonical Post</th>
                  <th class="py-3 px-3">Qualification</th>
                  <th class="py-3 px-3">Age Range</th>
                  <th class="py-3 px-3">Pay Scale</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                {linkedPosts.length === 0 ? (
                  <tr>
                    <td colspan="5" class="py-8 text-center text-zinc-500 text-xs">
                      No canonical posts assigned to this sector yet.
                    </td>
                  </tr>
                ) : (
                  linkedPosts.map((p) => (
                    <tr class="hover:bg-zinc-50/80 transition-colors">
                      <td class="py-3.5 px-4 font-bold text-zinc-950">
                        {p.title}
                      </td>
                      <td class="py-3.5 px-3">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-zinc-100 text-zinc-800 border border-zinc-200">
                          {p.defaultQualification}
                        </span>
                      </td>
                      <td class="py-3.5 px-3 font-mono text-zinc-700">
                        {p.defaultMinAge}–{p.defaultMaxAge} yrs
                      </td>
                      <td class="py-3.5 px-3 font-mono text-zinc-500 text-[11px]">
                        {p.payScale || 'Level 4 (State)'}
                      </td>
                      <td class="py-3.5 px-4 text-right">
