---
// src/pages/admin/audit-log.astro (FlowStep Screen 30)
import AdminLayout from '../../layouts/AdminLayout.astro';

const auditEntries = [
  {
    id: 'LOG-8941',
    timestamp: '17 Sep 2026 18:32',
    user: 'Aarav Mehta',
    role: 'Super Admin',
    action: 'Updated',
    record: 'MP Police Constable Recruitment 2026',
    field: 'Application deadline',
    oldVal: '30 Sep 2026',
    newVal: '06 Oct 2026',
    reason: 'Departmental extension notice published in state gazette.',
  },
  {
    id: 'LOG-8940',
    timestamp: '17 Sep 2026 17:04',
    user: 'Priya Shah',
    role: 'Reviewer',
    action: 'Verified',
    record: 'Assistant Grade III Recruitment 2026',
    field: 'Source verification status',
    oldVal: 'Needs verification',
    newVal: 'Verified',
    reason: 'Verified official High Court notification PDF clauses.',
  },
  {
    id: 'LOG-8939',
    timestamp: '16 Sep 2026 11:20',
    user: 'Aarav Mehta',
    role: 'Super Admin',
    action: 'Published',
    record: 'Forest Guard Recruitment 2026',
    field: 'Catalog lifecycle status',
    oldVal: 'Review',
    newVal: 'Published',
    reason: 'All 4 verification checks passed with official rulebook.',
  },
  {
    id: 'LOG-8938',
    timestamp: '15 Sep 2026 14:10',
    user: 'Rohan Verma',
    role: 'Editor',
    action: 'Created',
    record: 'Lab Technician Recruitment 2026',
    field: 'Initial ingestion',
    oldVal: '—',
    newVal: 'Draft staged',
    reason: 'Initial data entry from Health Department preliminary notice.',
  },
  {
    id: 'LOG-8937',
    timestamp: '14 Sep 2026 09:45',
    user: 'Aarav Mehta',
    role: 'Super Admin',
    action: 'Updated',
    record: 'Canonical Post: Constable',
    field: 'Default maximum age bounds',
    oldVal: '30 yrs',
    newVal: '33 yrs',
    reason: 'Cabinet decision granting 3-year uniform age relaxation.',
  },
];
---

<AdminLayout
  title="Audit Log"
  currentSection="audit-log"
  breadcrumbs={[
    { label: 'Audit log' },
  ]}
>
  <div class="mx-auto max-w-6xl space-y-6">
    <!-- Header with Action (FlowStep Screen 30) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Audit log
        </h1>
        <p class="text-xs text-zinc-500 mt-0.5">
          A traceable, immutable history of changes to recruitment criteria and governance records
        </p>
      </div>

      <button
        type="button"
        id="exportCsvBtn"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Export CSV</span>
      </button>
    </div>

    <!-- Filters Toolbar (FlowStep Screen 30) -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <div class="sm:col-span-2 relative">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 size-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="search"
          placeholder="Filter audit events by actor, record, or field..."
          class="w-full pl-8 pr-3 py-1.5 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-900 placeholder:text-zinc-400 outline-none focus:ring-2 focus:ring-zinc-900 shadow-2xs"
        />
      </div>

      <div>
        <select class="w-full px-3 py-1.5 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-800 outline-none focus:ring-2 focus:ring-zinc-900">
          <option>All Actions</option>
          <option>Updated</option>
          <option>Verified</option>
          <option>Published</option>
          <option>Created</option>
        </select>
      </div>

      <div>
        <select class="w-full px-3 py-1.5 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-800 outline-none focus:ring-2 focus:ring-zinc-900">
          <option>All Staff Members</option>
          <option>Aarav Mehta</option>
          <option>Priya Shah</option>
          <option>Rohan Verma</option>
        </select>
      </div>
    </div>

    <!-- Traceable Audit Table (FlowStep Screen 30) -->
    <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/50 font-semibold uppercase text-[10px] tracking-wider text-zinc-500">
              <th class="py-3 px-4">Timestamp</th>
              <th class="py-3 px-3">Operator</th>
              <th class="py-3 px-3">Action</th>
              <th class="py-3 px-3">Record & Field Modified</th>
              <th class="py-3 px-3">Delta (Previous &rarr; New)</th>
              <th class="py-3 px-4 text-right">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {auditEntries.map((log) => (
              <tr class="hover:bg-zinc-50/80 transition-colors">
                <td class="py-3.5 px-4 font-mono text-zinc-600 text-[11px] whitespace-nowrap">
                  {log.timestamp}
                </td>
                <td class="py-3.5 px-3">
                  <div class="font-semibold text-zinc-950">{log.user}</div>
                  <div class="text-[10px] text-zinc-400 font-mono">{log.role}</div>
                </td>
                <td class="py-3.5 px-3">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${
                    log.action === 'Published' || log.action === 'Verified'
                      ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                      : log.action === 'Created'
                      ? 'bg-zinc-100 text-zinc-800 border-zinc-200'
                      : 'bg-zinc-950 text-white border-zinc-950'
                  }`}>
                    {log.action}
                  </span>
                </td>
                <td class="py-3.5 px-3">
                  <div class="font-semibold text-zinc-900">{log.record}</div>
                  <div class="text-[11px] text-zinc-500">{log.field}</div>
                </td>
                <td class="py-3.5 px-3 font-mono text-[11px]">
                  <span class="line-through text-rose-600 mr-1">{log.oldVal}</span>
                  <span class="text-zinc-400 mr-1">&rarr;</span>
                  <span class="text-emerald-700 font-bold">{log.newVal}</span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    type="button"
                    class="view-detail-btn text-xs font-semibold text-zinc-950 hover:underline cursor-pointer"
                    data-id={log.id}
                    data-user={log.user}
                    data-time={log.timestamp}
                    data-record={log.record}
                    data-field={log.field}
                    data-reason={log.reason}
                  >
                    View details
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Change Details Drawer (FlowStep Screen 30) -->
  <div id="changeDetailsDrawer" class="fixed inset-0 z-50 hidden bg-zinc-950/40 backdrop-blur-xs flex justify-end">
    <div class="w-full max-w-md bg-white h-full shadow-2xl p-6 flex flex-col justify-between overflow-y-auto">
      <div class="space-y-5">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-zinc-950 font-heading">Change Details</h2>
            <p class="text-xs text-zinc-500" id="drawerLogId">LOG-8941</p>
          </div>
          <button type="button" id="closeDetailsDrawerBtn" class="size-8 rounded-lg text-zinc-400 hover:text-zinc-950 hover:bg-zinc-100 flex items-center justify-center">
            &times;
          </button>
        </div>

        <div class="space-y-3.5 text-xs">
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Actor</span>
            <span class="font-bold text-zinc-900" id="drawerActor">Aarav Mehta (Super Admin)</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Timestamp</span>
            <span class="font-mono text-zinc-800" id="drawerTime">17 Sep 2026 18:32 IST</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Record</span>
            <span class="font-medium text-zinc-900" id="drawerRecord">MP Police Constable Recruitment 2026</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Field Modified</span>
            <span class="font-mono text-zinc-900" id="drawerField">Application deadline</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Administrative Justification</span>
            <p class="mt-1 p-3 rounded-lg border border-zinc-200 bg-zinc-50 text-zinc-700 leading-relaxed" id="drawerReason">
              Departmental extension notice published in state gazette.
            </p>
          </div>
        </div>
      </div>

      <div class="border-t border-zinc-100 pt-4">
        <button type="button" id="dismissDetailsBtn" class="w-full py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs">
          Close Details
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    const drawer = document.getElementById('changeDetailsDrawer');
    document.querySelectorAll('.view-detail-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('drawerLogId').textContent = btn.dataset.id;
        document.getElementById('drawerActor').textContent = btn.dataset.user;
        document.getElementById('drawerTime').textContent = btn.dataset.time;
        document.getElementById('drawerRecord').textContent = btn.dataset.record;
        document.getElementById('drawerField').textContent = btn.dataset.field;
        document.getElementById('drawerReason').textContent = btn.dataset.reason;
        drawer?.classList.remove('hidden');
      });
    });

    document.getElementById('closeDetailsDrawerBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));
    document.getElementById('dismissDetailsBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));
    document.getElementById('exportCsvBtn')?.addEventListener('click', () => alert('Exporting audit log to CSV...'));
  </script>
</AdminLayout>
