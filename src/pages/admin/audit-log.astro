---
// src/pages/admin/audit-log.astro (FlowStep Screen 30)
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDataTable from '../../components/admin/AdminDataTable.astro';
import { getAuditLogs } from '../../db/queries';

let auditLoadError = '';
const auditLogs = await getAuditLogs().catch(error => {
  console.error('[Audit log] Failed to load entries:', error);
  auditLoadError = 'Audit entries are temporarily unavailable. Please retry.';
  return [];
});
const auditEntries = auditLogs.map(log => ({
  id: log.id,
  timestamp: new Date(log.createdAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }),
  user: log.adminEmail,
  role: 'Admin',
  action: log.action.charAt(0) + log.action.slice(1).toLowerCase(),
  record: `${log.entity}: ${log.entityId}`,
  field: log.field || 'record',
  oldVal: log.oldValue || '—',
  newVal: log.newValue || '—',
  reason: log.reason || 'No reason recorded.',
}));

const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? true;
const wantsJson = Astro.url.searchParams.get('format') === 'json' || (!acceptsHtml && Astro.request.headers.get('accept')?.includes('application/json'));
const wantsCsv = Astro.url.searchParams.get('format') === 'csv';

if (wantsCsv) {
  const csvCell = (value: unknown) => `"${String(value ?? '').replace(/"/g, '""')}"`;
  const rows = [['Timestamp','Operator','Action','Record','Field','Previous','New','Reason'], ...auditEntries.map(log => [log.timestamp, log.user, log.action, log.record, log.field, log.oldVal, log.newVal, log.reason])];
  return new Response(rows.map(row => row.map(csvCell).join(',')).join('\r\n'), { status: 200, headers: { 'Content-Type': 'text/csv; charset=utf-8', 'Content-Disposition': 'attachment; filename="nirnay-audit-log.csv"' } });
}

if (wantsJson) {
  return new Response(JSON.stringify(auditEntries), {
    status: 200,
    headers: { 'Content-Type': 'application/json' },
  });
}
---

<AdminLayout
  title="Audit Log"
  currentSection="audit-log"
  breadcrumbs={[
    { label: 'Audit log' },
  ]}
>
  <div class="mx-auto max-w-6xl space-y-6">
    {auditLoadError && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs font-medium text-amber-900">
        {auditLoadError}
      </div>
    )}
    <!-- Header with Action (FlowStep Screen 30) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Audit log
        </h1>
        <p class="text-xs text-zinc-500 mt-0.5">
          A traceable, immutable history of changes to recruitment criteria and governance records
        </p>
      </div>

      <a
        href="/admin/audit-log?format=csv"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Export CSV</span>
      </a>
    </div>

    <!-- Traceable Audit Table (FlowStep Screen 30) -->
    <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse" id="auditLogDataTable">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/50 font-semibold uppercase text-[10px] tracking-wider text-zinc-500">
              <th class="py-3 px-4 min-w-[140px]">Timestamp</th>
              <th class="py-3 px-3 min-w-[120px]">Operator</th>
              <th class="py-3 px-3 min-w-[100px]">Action</th>
              <th class="py-3 px-3 min-w-[220px]">Record & Field Modified</th>
              <th class="py-3 px-3 min-w-[240px]">Delta (Previous &rarr; New)</th>
              <th class="py-3 px-4 text-right min-w-[90px]">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {auditEntries.map((log) => (
              <tr class="hover:bg-zinc-50/80 transition-colors">
                <td class="py-3.5 px-4 font-mono text-zinc-600 text-[11px] whitespace-nowrap">
                  {log.timestamp}
                </td>
                <td class="py-3.5 px-3">
                  <div class="font-semibold text-zinc-950">{log.user}</div>
                  <div class="text-[10px] text-zinc-400 font-mono">{log.role}</div>
                </td>
                <td class="py-3.5 px-3">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${
                    log.action === 'Published' || log.action === 'Verified'
                      ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                      : log.action === 'Created'
                      ? 'bg-zinc-100 text-zinc-800 border-zinc-200'
                      : 'bg-primary text-white border-primary'
                  }`}>
                    {log.action}
                  </span>
                </td>
                <td class="py-3.5 px-3">
                  <div class="font-semibold text-zinc-900">{log.record}</div>
                  <div class="text-[11px] text-zinc-500">{log.field}</div>
                </td>
                <td class="py-3.5 px-3 font-mono text-[11px]">
                  <span class="line-through text-rose-600 mr-1">{log.oldVal}</span>
                  <span class="text-zinc-400 mr-1">&rarr;</span>
                  <span class="text-emerald-700 font-bold">{log.newVal}</span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    type="button"
                    class="view-detail-btn text-xs font-semibold text-zinc-950 hover:underline cursor-pointer"
                    data-id={log.id}
                    data-user={log.user}
                    data-time={log.timestamp}
                    data-record={log.record}
                    data-field={log.field}
                    data-reason={log.reason}
                  >
                    View details
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Change Details Drawer (FlowStep Screen 30) -->
  <div id="changeDetailsDrawer" class="fixed inset-0 z-50 hidden bg-slate-900/30 backdrop-blur-xs flex justify-end">
    <div class="w-full max-w-md bg-white h-full shadow-2xl p-6 flex flex-col justify-between overflow-y-auto">
      <div class="space-y-5">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-zinc-950 font-heading">Change Details</h2>
            <p class="text-xs text-zinc-500" id="drawerLogId">Select an audit entry</p>
          </div>
          <button type="button" id="closeDetailsDrawerBtn" class="size-8 rounded-lg text-zinc-400 hover:text-zinc-950 hover:bg-zinc-100 flex items-center justify-center">
            &times;
          </button>
        </div>

        <div class="space-y-3.5 text-xs">
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Actor</span>
            <span class="font-bold text-zinc-900" id="drawerActor">—</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Timestamp</span>
            <span class="font-mono text-zinc-800" id="drawerTime">—</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Record</span>
            <span class="font-medium text-zinc-900" id="drawerRecord">—</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Field Modified</span>
            <span class="font-mono text-zinc-900" id="drawerField">—</span>
          </div>
          <div>
            <span class="text-zinc-400 block text-[10px] uppercase tracking-wider font-mono">Administrative Justification</span>
            <p class="mt-1 p-3 rounded-lg border border-zinc-200 bg-zinc-50 text-zinc-700 leading-relaxed" id="drawerReason">
              Select a row to inspect the recorded change.
            </p>
          </div>
        </div>
      </div>

      <div class="border-t border-zinc-100 pt-4">
        <button type="button" id="dismissDetailsBtn" class="w-full py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs">
          Close Details
        </button>
      </div>
    </div>
  </div>

  <AdminDataTable
    tableId="auditLogDataTable"
    perPage={15}
    columns={[{ select: 5, sortable: false }]}
  />

  <script is:inline>
    const drawer = document.getElementById('changeDetailsDrawer');
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.view-detail-btn');
      if (btn) {
        document.getElementById('drawerLogId').textContent = btn.dataset.id || '';
        document.getElementById('drawerActor').textContent = btn.dataset.user || '';
        document.getElementById('drawerTime').textContent = btn.dataset.time || '';
        document.getElementById('drawerRecord').textContent = btn.dataset.record || '';
        document.getElementById('drawerField').textContent = btn.dataset.field || '';
        document.getElementById('drawerReason').textContent = btn.dataset.reason || '';
        drawer?.classList.remove('hidden');
      }
    });

    document.getElementById('closeDetailsDrawerBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));
    document.getElementById('dismissDetailsBtn')?.addEventListener('click', () => drawer?.classList.add('hidden'));
  </script>
</AdminLayout>
