---
// src/pages/admin/eligibility-rules.astro (FlowStep Screen 23)
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllActiveRecruitments } from '../../db/queries';

const recruitments = await getAllActiveRecruitments(undefined, { includeUnpublished: true });
const selectedRecruitmentTitle = Astro.url.searchParams.get('recruitment') || recruitments[0]?.title || 'MP Police Constable Recruitment 2026';
const selectedRec = recruitments.find(r => r.title === selectedRecruitmentTitle) || recruitments[0];
---

<AdminLayout
  title="Eligibility Rules"
  currentSection="eligibility-rules"
  breadcrumbs={[
    { label: 'Recruitments', href: '/admin/recruitments' },
    { label: 'Eligibility rules' },
  ]}
>
  <div class="mx-auto max-w-6xl space-y-6">
    <!-- Header with Record Selector & Action (FlowStep Screen 23) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-zinc-500">
          <span>Recruitments</span>
          <span>&rarr;</span>
          <span class="font-medium text-zinc-950">Deterministic Rules Builder</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
            Eligibility rules
          </h1>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-800 border border-amber-200">
            {selectedRec?.status || 'Draft'}
          </span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <!-- Recruitment Selector -->
        <form method="GET">
          <div class="flex items-center gap-2">
            <label class="text-xs font-semibold text-zinc-600 whitespace-nowrap">Recruitment:</label>
            <select
              name="recruitment"
              onchange="this.form.submit()"
              class="px-3 py-2 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-800 font-medium focus:ring-2 focus:ring-zinc-900 outline-none shadow-2xs"
            >
              {recruitments.map((r: any) => (
                <option value={r.title} selected={r.title === selectedRecruitmentTitle}>{r.title}</option>
              ))}
            </select>
          </div>
        </form>

        <div class="flex items-center gap-2">
          <a
            href={`/admin/recruitments/${selectedRec?.id || '1'}/edit`}
            class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors"
          >
            Edit Raw Criteria
          </a>
          <button
            type="button"
            id="saveRulesBtn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Save Rules</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Target info row -->
    <div class="flex items-center gap-3 text-xs text-zinc-500 -mt-2">
      <span class="font-mono">Target:</span>
      <span class="font-medium text-zinc-800">{selectedRecruitmentTitle}</span>
      {selectedRec && (
        <a href={`/admin/recruitments/${selectedRec.id}/edit`} class="ml-auto text-zinc-400 hover:text-zinc-700 hover:underline transition-colors">
          Edit full record &rarr;
        </a>
      )}
    </div>

    <!-- Main Builder Canvas (FlowStep Screen 23) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] items-start gap-6">
      <!-- Left: Interactive Rules Flow -->
      <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-2xs space-y-6">
        <!-- Logic Operator Header -->
        <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
          <div>
            <h2 class="text-sm font-bold text-zinc-950">Condition Grouping</h2>
            <p class="text-xs text-zinc-500">How conditions are combined for candidate evaluation.</p>
          </div>

          <div class="inline-flex items-center gap-1 rounded-lg border border-zinc-200 bg-zinc-100 p-1 text-xs">
            <span class="text-[11px] font-medium text-zinc-500 px-2">Mode:</span>
            <button type="button" class="px-2.5 py-1 rounded font-bold text-xs bg-white text-zinc-950 shadow-xs">
              AND (All required)
            </button>
            <button type="button" class="px-2.5 py-1 rounded text-xs text-zinc-600 hover:text-zinc-950">
              OR (Any qualified)
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-xs text-zinc-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-zinc-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span>Use <strong>AND</strong> when every statutory condition is mandatory. Use <strong>OR</strong> when alternative qualifying standards exist.</span>
        </div>

        <!-- Rule Rows -->
        <div class="space-y-4" id="rulesContainer">
          <!-- Rule 01: Qualification -->
          <div class="rule-card rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs space-y-3">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
              <div class="flex items-center gap-2">
                <span class="text-zinc-400 cursor-grab">&#x22EE;&#x22EE;</span>
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-900 font-mono">Rule 01 · Qualification</span>
              </div>
              <span class="text-[10px] font-mono text-zinc-400">Deterministic</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Field</label>
                <select class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-white text-zinc-800 outline-none">
                  <option selected>Highest Qualification</option>
                  <option>Stream / Major</option>
                  <option>Technical Certificate</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Operator</label>
                <select class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-white text-zinc-800 outline-none">
                  <option selected>At least (&ge;)</option>
                  <option>Exactly equals (=)</option>
                  <option>One of list</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Target Value</label>
                <select class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-white text-zinc-800 font-mono outline-none">
                  <option selected>10TH (High School)</option>
                  <option>12TH (Higher Secondary)</option>
                  <option>GRADUATION (Bachelor's)</option>
                  <option>POST_GRADUATION</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Connector -->
          <div class="flex items-center justify-center">
            <span class="px-3 py-0.5 rounded-full bg-zinc-950 text-white font-mono text-[10px] font-bold tracking-widest shadow-2xs">
              AND
            </span>
          </div>

          <!-- Rule 02: Age Range -->
          <div class="rule-card rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs space-y-3">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
              <div class="flex items-center gap-2">
                <span class="text-zinc-400 cursor-grab">&#x22EE;&#x22EE;</span>
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-900 font-mono">Rule 02 · Age Limits</span>
              </div>
              <span class="text-[10px] font-mono text-zinc-400">Statutory</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Field</label>
                <input type="text" readonly value="Applicant Age (on Cutoff)" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-zinc-50 text-zinc-600" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Operator</label>
                <input type="text" readonly value="Between Range [Min, Max]" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-zinc-50 text-zinc-600" />
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1">
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Min Age</label>
                  <input type="number" value="18" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums" />
                </div>
                <span class="text-zinc-400 pt-4">—</span>
                <div class="flex-1">
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Max Age</label>
                  <input type="number" value="33" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums" />
                </div>
              </div>
            </div>
          </div>

          <!-- Connector -->
          <div class="flex items-center justify-center">
            <span class="px-3 py-0.5 rounded-full bg-zinc-950 text-white font-mono text-[10px] font-bold tracking-widest shadow-2xs">
              AND
            </span>
          </div>

          <!-- Rule 03: Domicile -->
          <div class="rule-card rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs space-y-3">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
              <div class="flex items-center gap-2">
                <span class="text-zinc-400 cursor-grab">&#x22EE;&#x22EE;</span>
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-900 font-mono">Rule 03 · State Domicile</span>
              </div>
              <span class="text-[10px] font-mono text-zinc-400">Jurisdiction</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Field</label>
                <input type="text" readonly value="Permanent Domicile" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-zinc-50 text-zinc-600" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Operator</label>
                <input type="text" readonly value="Equals (=)" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-zinc-50 text-zinc-600" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-zinc-600 mb-1">Target Value</label>
                <input type="text" readonly value="Madhya Pradesh (MP)" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-200 text-xs bg-zinc-50 text-zinc-800 font-medium" />
              </div>
            </div>
          </div>
        </div>

        <!-- Add Rule Actions -->
        <div class="flex items-center gap-3 pt-2">
          <button
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-xs font-semibold text-zinc-800 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Add rule</span>
          </button>
          <button
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-xs font-semibold text-zinc-800 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            <span>Add rule group</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Natural Language Preview (FlowStep Screen 23) -->
      <aside class="sticky top-20 space-y-4">
        <!-- Human Readable Preview Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-950">Natural Language Preview</h3>
            <span class="size-2 rounded-full bg-emerald-500"></span>
          </div>

          <p class="text-xs text-zinc-700 leading-relaxed bg-zinc-50 p-3 rounded-lg border border-zinc-200 font-sans">
            "Candidate must have at least a <strong>10th qualification</strong>, be aged <strong>18–33</strong> on closing date, and satisfy the specified <strong>Madhya Pradesh domicile</strong> condition."
          </p>

          <!-- Validation Notice Callout -->
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900 space-y-1">
            <div class="font-bold flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>Validation Warning</span>
            </div>
            <p class="text-[11px] text-amber-800">
              Physical standard requirement (height / chest) has not been verified against the official gazette rulebook.
            </p>
          </div>
        </div>

        <!-- Simulation Tester Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs space-y-3">
          <div class="text-xs font-bold text-zinc-950">Candidate Engine Test</div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1 border-b border-zinc-100">
              <span class="text-zinc-500">Test Age:</span>
              <span class="font-mono font-semibold">21 Yrs</span>
            </div>
            <div class="flex justify-between py-1 border-b border-zinc-100">
              <span class="text-zinc-500">Education:</span>
              <span class="font-mono font-semibold">12th Pass</span>
            </div>
            <div class="flex justify-between py-1 border-b border-zinc-100">
              <span class="text-zinc-500">Domicile:</span>
              <span class="font-mono font-semibold">Madhya Pradesh</span>
            </div>
            <div class="mt-2 pt-2 flex items-center justify-between font-bold">
              <span class="text-zinc-800">Deterministic Match:</span>
              <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-[11px]">ELIGIBLE</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    document.getElementById('saveRulesBtn')?.addEventListener('click', () => {
      alert('Eligibility rules synchronized with calculation engine!');
    });
  </script>
</AdminLayout>
