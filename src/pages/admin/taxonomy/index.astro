---
// src/pages/admin/taxonomy/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';

const sectorsList = [
  { name: 'Police', count: 12, active: true },
  { name: 'Forest', count: 7, active: false },
  { name: 'Education', count: 18, active: false },
  { name: 'Health', count: 14, active: false },
  { name: 'Engineering', count: 5, active: false },
  { name: 'Revenue', count: 8, active: false },
];

const policePosts = [
  'Police Constable (GD)',
  'Police Constable (Radio)',
  'Sub Inspector (SI)',
  'Subedar',
  'Assistant Sub Inspector (Clerical)',
];
---

<BaseLayout title="Taxonomy Management — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <!-- Admin Sidebar Shell -->
    <aside class="w-64 bg-sidebar border-r border-border shrink-0 hidden md:flex flex-col justify-between p-4">
      <div class="space-y-6">
        <div class="px-3 py-2 border-b border-border">
          <div class="font-bold text-xs uppercase tracking-widest text-primary">NIRNAY OPS</div>
          <div class="text-[11px] text-muted-foreground">Master Taxonomy</div>
        </div>

        <nav class="space-y-1 text-xs font-medium">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/recruitments" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/></svg>
            <span>Recruitments</span>
          </a>
          <a href="/admin/taxonomy" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-primary text-primary-foreground font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/></svg>
            <span>Sectors & posts</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-border flex items-center gap-3 px-3">
        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">AM</div>
        <div class="truncate">
          <div class="text-xs font-semibold text-foreground">Aarav Mehta</div>
          <div class="text-[10px] text-muted-foreground">Admin</div>
        </div>
      </div>
    </aside>

    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <h1 class="text-2xl font-bold text-foreground">Sectors & posts</h1>
          <p class="text-xs text-muted-foreground mt-0.5">Master classification taxonomy for state departments and canonical post designations.</p>
        </div>

        <div class="flex items-center gap-3">
          <button class="px-3.5 py-2 rounded-lg border border-border bg-card hover:bg-muted text-xs font-semibold">
            + Add sector
          </button>
          <button class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm">
            + Add post
          </button>
        </div>
      </div>

      <!-- Tabs Strip -->
      <div class="flex items-center gap-6 border-b border-border mb-8 text-xs font-semibold text-muted-foreground">
        <span class="text-primary border-b-2 border-primary pb-3 font-bold -mb-px">Sectors (Active)</span>
        <span class="hover:text-foreground cursor-pointer pb-3">Canonical Posts</span>
        <span class="hover:text-foreground cursor-pointer pb-3">Qualification Tags</span>
      </div>

      <!-- Two-Column Taxonomy Workspace -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Sector List (1 Col) -->
        <div class="space-y-2 bg-card p-3 rounded-2xl border border-border h-fit">
          <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider block px-3 py-2">
            Active Sectors
          </span>
          {sectorsList.map((s) => (
            <button
              type="button"
              class={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium transition-colors ${
                s.active ? 'bg-primary text-primary-foreground font-bold' : 'text-foreground hover:bg-muted'
              }`}
            >
              <span>{s.name}</span>
              <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full ${
                s.active ? 'bg-primary-foreground/20 text-white' : 'bg-muted text-muted-foreground'
              }`}>
                {s.count}
              </span>
            </button>
          ))}
        </div>

        <!-- Right Sector Detail Pane (2 Cols) -->
        <div class="lg:col-span-2 bg-card rounded-2xl border border-border p-6 sm:p-8 shadow-sm space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-border">
            <div>
              <span class="text-xs text-muted-foreground uppercase font-mono">Slug: police</span>
              <h2 class="text-xl font-bold text-foreground">Police Sector</h2>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <button class="px-3 py-1.5 rounded-lg border border-border hover:bg-muted font-semibold">Edit</button>
              <button class="px-3 py-1.5 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 font-semibold" disabled>Archive</button>
            </div>
          </div>

          <!-- Dependency Safeguard Alert -->
          <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Cannot archive while 12 published recruitments use this term.</span>
          </div>

          <div>
            <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider block mb-2">Linked Departments</span>
            <span class="inline-block px-3 py-1.5 rounded-lg bg-muted text-xs font-semibold text-foreground">
              MP State Police Department
            </span>
          </div>

          <div>
            <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider block mb-3">Posts Under Police</span>
            <div class="space-y-2">
              {policePosts.map((p) => (
                <div class="flex items-center justify-between p-3 rounded-xl bg-muted/40 border border-border text-xs">
                  <span class="font-medium text-foreground">{p}</span>
                  <div class="flex items-center gap-3 text-muted-foreground">
                    <button class="text-primary hover:underline font-semibold">Edit</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
