---
// src/pages/admin/documents.astro (FlowStep Screen 28)
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDataTable from '../../components/admin/AdminDataTable.astro';
import {
  getAllActiveRecruitments,
  getAllDocuments,
  createDocument,
  updateDocument,
  deleteDocument,
  type DocumentItem,
} from '../../db/queries';

let statusMessage: { type: 'success' | 'error'; text: string } | null = null;
let createdDocumentId = '';
const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = form.get('_action')?.toString();
    const adminEmail = Astro.locals.adminEmail || 'aarav@nirnay.in';

    if (action === 'create_document') {
      const title = form.get('title')?.toString().trim();
      const recruitmentId = form.get('recruitmentId')?.toString().trim();
      const sourceType = form.get('sourceType')?.toString().trim() || 'OFFICIAL_NOTIFICATION_PDF';
      const sourceUrl = form.get('sourceUrl')?.toString().trim();
      const publicationDate = form.get('publicationDate')?.toString().trim();

      if (!title || !recruitmentId || !sourceUrl) {
        throw new Error('Document title, linked recruitment, and official source URL are required.');
      }
      try {
        new URL(sourceUrl);
      } catch {
        throw new Error('Please provide a valid official document URL (e.g. https://esb.mp.gov.in/...).');
      }

      createdDocumentId = await createDocument({
        title,
        recruitmentId,
        sourceType,
        sourceUrl,
        publicationDate,
        adminEmail,
      });
      statusMessage = { type: 'success', text: `Document "${title}" successfully attached!` };
      Astro.response.headers.set('X-Document-Id', createdDocumentId);

      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          document_id: createdDocumentId,
          message: statusMessage.text,
        }), {
          status: 201,
          headers: {
            'Content-Type': 'application/json',
            'X-Document-Id': createdDocumentId,
          },
        });
      }
    } else if (action === 'update_document') {
      const id = form.get('id')?.toString().trim();
      const title = form.get('title')?.toString().trim();
      const recruitmentId = form.get('recruitmentId')?.toString().trim();
      const sourceType = form.get('sourceType')?.toString().trim();
      const sourceUrl = form.get('sourceUrl')?.toString().trim();
      const publicationDate = form.get('publicationDate')?.toString().trim();

      if (!id || !title || !recruitmentId || !sourceUrl) {
        throw new Error('Document ID, title, linked recruitment, and source URL are required.');
      }
      try {
        new URL(sourceUrl);
      } catch {
        throw new Error('Please provide a valid official document URL.');
      }

      const updated = await updateDocument({
        id,
        title,
        recruitmentId,
        sourceType,
        sourceUrl,
        publicationDate,
        adminEmail,
      });
      if (!updated) {
        Astro.response.status = 404;
        throw new Error('Document not found.');
      }
      statusMessage = { type: 'success', text: `Document "${title}" successfully updated!` };
      Astro.response.headers.set('X-Document-Id', id);

      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          document_id: id,
          updated: true,
          message: statusMessage.text,
        }), {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            'X-Document-Id': id,
          },
        });
      }
    } else if (action === 'delete_document') {
      const id = form.get('id')?.toString().trim();
      const title = form.get('title')?.toString().trim() || 'Document';

      if (!id) {
        throw new Error('Document ID is required for deletion.');
      }

      const deleted = await deleteDocument({
        id,
        adminEmail,
      });
      if (!deleted) {
        Astro.response.status = 404;
        throw new Error('Document not found.');
      }
      statusMessage = { type: 'success', text: `Document "${title}" successfully deleted!` };
      Astro.response.headers.set('X-Document-Id', id);

      if (!acceptsHtml) {
        return new Response(JSON.stringify({
          document_id: id,
          deleted: true,
          message: statusMessage.text,
        }), {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            'X-Document-Id': id,
          },
        });
      }
    } else {
      throw new Error('A supported document action is required.');
    }
  } catch (error: any) {
    statusMessage = { type: 'error', text: error.message };
    if (Astro.response.status < 400) Astro.response.status = 400;
    if (!acceptsHtml) {
      return new Response(JSON.stringify({ error: statusMessage.text }), {
        status: Astro.response.status,
        headers: { 'Content-Type': 'application/json' },
      });
    }
  }
}

const [recruitments, allDocuments] = await Promise.all([
  getAllActiveRecruitments(undefined, { includeUnpublished: true }),
  getAllDocuments(),
]);

const currentFilter = Astro.url.searchParams.get('type') || 'All';

let documents = allDocuments;
if (currentFilter === 'Notifications') {
  documents = allDocuments.filter(d => d.type.toLowerCase().includes('notification'));
} else if (currentFilter === 'Admit cards') {
  documents = allDocuments.filter(d => d.type.toLowerCase().includes('admit'));
} else if (currentFilter === 'Answer keys') {
  documents = allDocuments.filter(d => d.type.toLowerCase().includes('key') || d.type.toLowerCase().includes('answer'));
} else if (currentFilter === 'Correction notices') {
  documents = allDocuments.filter(d => d.type.toLowerCase().includes('correction') || d.type.toLowerCase().includes('corrigendum'));
}

const filterTags = [
  { label: 'All', value: 'All', count: allDocuments.length },
  { label: 'Notifications', value: 'Notifications', count: allDocuments.filter(d => d.type.toLowerCase().includes('notification')).length },
  { label: 'Admit cards', value: 'Admit cards', count: allDocuments.filter(d => d.type.toLowerCase().includes('admit')).length },
  { label: 'Answer keys', value: 'Answer keys', count: allDocuments.filter(d => d.type.toLowerCase().includes('key') || d.type.toLowerCase().includes('answer')).length },
  { label: 'Correction notices', value: 'Correction notices', count: allDocuments.filter(d => d.type.toLowerCase().includes('correction') || d.type.toLowerCase().includes('corrigendum')).length },
];
---

<AdminLayout
  title="Documents"
  currentSection="documents"
  breadcrumbs={[
    { label: 'Documents' },
  ]}
>
  <div class="mx-auto max-w-6xl space-y-6">
    {statusMessage && (
      <div class={`p-3.5 rounded-xl border text-xs flex items-center justify-between shadow-2xs ${
        statusMessage.type === 'success'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
          : 'bg-rose-50 border-rose-200 text-rose-900'
      }`}>
        <div class="flex items-center gap-2 font-medium">
          {statusMessage.type === 'success' ? (
            <svg class="size-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          ) : (
            <svg class="size-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          )}
          <span>{statusMessage.text}</span>
        </div>
      </div>
    )}
    {createdDocumentId && <input type="hidden" name="document_id" value={createdDocumentId} />}

    <!-- Header with Action (FlowStep Screen 28) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Documents
        </h1>
        <p class="text-xs text-zinc-500 mt-0.5">
          Link to official gazettes and rulebooks without storing copyrighted PDFs locally
        </p>
      </div>

      <button
        type="button"
        id="openAddDocModalBtn"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add document link</span>
      </button>
    </div>

    <!-- Filters Bar with Active Counts -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        {filterTags.map((tag) => {
          const isActive = currentFilter === tag.value;
          return (
            <a
              href={`?type=${encodeURIComponent(tag.value)}`}
              class={`px-3 py-1.5 rounded-md font-medium transition-colors cursor-pointer flex items-center gap-1.5 ${
                isActive
                  ? 'bg-zinc-950 text-white font-semibold shadow-2xs'
                  : 'text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100'
              }`}
            >
              <span>{tag.label}</span>
              <span class={`text-[10px] px-1.5 py-0.2 rounded-full font-mono ${
                isActive ? 'bg-zinc-800 text-zinc-200' : 'bg-zinc-200/80 text-zinc-700'
              }`}>
                {tag.count}
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Documents Table (FlowStep Screen 28) -->
    <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse" id="documentsDataTable">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/50 font-semibold uppercase text-[10px] tracking-wider text-zinc-500">
              <th class="py-3 px-4">Document Title</th>
              <th class="py-3 px-3">Type</th>
              <th class="py-3 px-3">Linked Opportunity</th>
              <th class="py-3 px-3">Source URL</th>
              <th class="py-3 px-3">Published</th>
              <th class="py-3 px-3">Verification</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {documents.length === 0 ? (
              <tr>
                <td colspan="7" class="py-8 text-center text-zinc-500 text-xs">
                  No documents found for the selected category.
                </td>
              </tr>
            ) : (
              documents.map((doc) => (
                <tr class="hover:bg-zinc-50/80 transition-colors">
                  <td class="py-3.5 px-4 font-bold text-zinc-950 max-w-[280px]">
                    <div class="truncate" title={doc.title}>{doc.title}</div>
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase font-mono border ${
                      doc.type.toLowerCase().includes('correction')
                        ? 'bg-amber-50 text-amber-900 border-amber-200'
                        : doc.type.toLowerCase().includes('syllabus')
                        ? 'bg-blue-50 text-blue-900 border-blue-200'
                        : doc.type.toLowerCase().includes('key')
                        ? 'bg-purple-50 text-purple-900 border-purple-200'
                        : doc.type.toLowerCase().includes('admit')
                        ? 'bg-cyan-50 text-cyan-900 border-cyan-200'
                        : 'bg-zinc-100 text-zinc-800 border-zinc-200'
                    }`}>
                      {doc.type}
                    </span>
                  </td>
                  <td class="py-3.5 px-3 text-zinc-700 max-w-[220px]">
                    <div class="truncate" title={doc.recruitment}>{doc.recruitment}</div>
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    <a
                      href={doc.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-600 hover:text-zinc-950 hover:underline"
                    >
                      <span>PDF Document</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  </td>
                  <td class="py-3.5 px-3 text-zinc-500 font-mono text-[11px] whitespace-nowrap">
                    {doc.publishedDate}
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    {doc.verification === 'Verified' ? (
                      <span class="inline-flex items-center gap-1 text-emerald-700 text-[11px] font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
                        <span>Verified</span>
                      </span>
                    ) : (
                      <a href={`/admin/sources?recruitment=${encodeURIComponent(doc.recruitment)}`} class="inline-flex items-center gap-1 text-amber-700 text-[11px] font-medium hover:underline">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>Needs review</span>
                      </a>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-2">
                      <button
                        type="button"
                        class="edit-doc-btn text-zinc-600 hover:text-zinc-950 font-semibold hover:underline cursor-pointer"
                        data-doc={JSON.stringify({
                          id: doc.id,
                          title: doc.title,
                          recruitmentId: doc.recruitmentId,
                          sourceType: doc.sourceType,
                          sourceUrl: doc.url,
                          publicationDate: doc.publicationDateRaw,
                        })}
                      >
                        Edit
                      </button>
                      <span class="text-zinc-300">·</span>
                      <a href={doc.url} target="_blank" rel="noopener noreferrer" class="text-zinc-600 hover:text-zinc-950 font-semibold hover:underline">
                        Open PDF &rarr;
                      </a>
                      <span class="text-zinc-300">·</span>
                      <button
                        type="button"
                        class="delete-doc-btn text-rose-600 hover:text-rose-800 font-semibold hover:underline cursor-pointer"
                        data-id={doc.id}
                        data-title={doc.title}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Document Modal (FlowStep Screen 28) -->
  <div id="addDocModal" class="fixed inset-0 z-50 hidden bg-zinc-950/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl p-6 space-y-5">
      <form method="POST">
        <input type="hidden" name="_action" value="create_document" />
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-zinc-950 font-heading">Add Document Link</h2>
            <p class="text-xs text-zinc-500">Attach an official notification PDF URL to an opportunity.</p>
          </div>
          <button type="button" id="closeAddDocModalBtn" class="size-8 rounded-lg text-zinc-400 hover:text-zinc-950 hover:bg-zinc-100 flex items-center justify-center cursor-pointer">
            &times;
          </button>
        </div>

        <div class="space-y-4 text-xs py-4">
          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Document Title *</label>
            <input
              type="text"
              name="title"
              required
              placeholder="e.g. Police Constable Official Rulebook 2026"
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="block font-semibold text-zinc-800">Document Type *</label>
              <select name="sourceType" required class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs bg-white focus:ring-2 focus:ring-zinc-900 outline-none">
                <option value="OFFICIAL_NOTIFICATION_PDF">Notification Gazette</option>
                <option value="CORRECTION_NOTICE">Correction Notice</option>
                <option value="ADMIT_CARD">Admit Card Link</option>
                <option value="ANSWER_KEY">Answer Key</option>
                <option value="SYLLABUS">Examination Syllabus</option>
              </select>
            </div>
            <div class="space-y-1.5">
              <label class="block font-semibold text-zinc-800">Publication Date</label>
              <input
                type="date"
                name="publicationDate"
                class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Official Direct Source URL *</label>
            <input
              type="url"
              name="sourceUrl"
              required
              placeholder="https://esb.mp.gov.in/notifications/..."
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Link to Recruitment *</label>
            <select name="recruitmentId" required class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs bg-white focus:ring-2 focus:ring-zinc-900 outline-none">
              {recruitments.map((r: any) => (
                <option value={r.id}>{r.title}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="border-t border-zinc-100 pt-4 flex items-center justify-end gap-2.5">
          <button type="button" id="cancelAddDocModalBtn" class="px-4 py-2 rounded-lg border border-zinc-200 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs cursor-pointer">
            Save Document Link
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Document Modal -->
  <div id="editDocModal" class="fixed inset-0 z-50 hidden bg-zinc-950/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl p-6 space-y-5">
      <form method="POST">
        <input type="hidden" name="_action" value="update_document" />
        <input type="hidden" name="id" id="editDocId" value="" />

        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-zinc-950 font-heading">Edit Document Link</h2>
            <p class="text-xs text-zinc-500">Update official notification PDF and recruitment linkage.</p>
          </div>
          <button type="button" id="closeEditDocModalBtn" class="size-8 rounded-lg text-zinc-400 hover:text-zinc-950 hover:bg-zinc-100 flex items-center justify-center cursor-pointer">
            &times;
          </button>
        </div>

        <div class="space-y-4 text-xs py-4">
          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Document Title *</label>
            <input
              type="text"
              id="editDocTitle"
              name="title"
              required
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="block font-semibold text-zinc-800">Document Type *</label>
              <select id="editDocSourceType" name="sourceType" required class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs bg-white focus:ring-2 focus:ring-zinc-900 outline-none">
                <option value="OFFICIAL_NOTIFICATION_PDF">Notification Gazette</option>
                <option value="CORRECTION_NOTICE">Correction Notice</option>
                <option value="ADMIT_CARD">Admit Card Link</option>
                <option value="ANSWER_KEY">Answer Key</option>
                <option value="SYLLABUS">Examination Syllabus</option>
              </select>
            </div>
            <div class="space-y-1.5">
              <label class="block font-semibold text-zinc-800">Publication Date</label>
              <input
                type="date"
                id="editDocPubDate"
                name="publicationDate"
                class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Official Direct Source URL *</label>
            <input
              type="url"
              id="editDocSourceUrl"
              name="sourceUrl"
              required
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block font-semibold text-zinc-800">Link to Recruitment *</label>
            <select id="editDocRecruitmentId" name="recruitmentId" required class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs bg-white focus:ring-2 focus:ring-zinc-900 outline-none">
              {recruitments.map((r: any) => (
                <option value={r.id}>{r.title}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="border-t border-zinc-100 pt-4 flex items-center justify-end gap-2.5">
          <button type="button" id="cancelEditDocModalBtn" class="px-4 py-2 rounded-lg border border-zinc-200 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs cursor-pointer">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Document Confirmation Modal -->
  <div id="deleteDocModal" class="fixed inset-0 z-50 hidden bg-zinc-950/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 space-y-4">
      <form method="POST">
        <input type="hidden" name="_action" value="delete_document" />
        <input type="hidden" name="id" id="deleteDocId" value="" />
        <input type="hidden" name="title" id="deleteDocTitleHidden" value="" />

        <div class="flex items-center gap-3 border-b border-zinc-100 pb-3">
          <div class="size-10 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-zinc-950 font-heading">Delete Document</h2>
            <p class="text-xs text-zinc-500">Are you sure you want to remove this official document?</p>
          </div>
        </div>

        <div class="py-2 text-xs text-zinc-600">
          <p>
            You are about to delete <strong id="deleteDocTitleDisplay" class="text-zinc-950 font-semibold"></strong>. This action cannot be undone.
          </p>
        </div>

        <div class="border-t border-zinc-100 pt-4 flex items-center justify-end gap-2.5">
          <button type="button" id="cancelDeleteDocModalBtn" class="px-4 py-2 rounded-lg border border-zinc-200 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-rose-600 text-white hover:bg-rose-700 text-xs font-semibold shadow-xs cursor-pointer">
            Confirm Delete
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    // Add Document Modal controls
    const addModal = document.getElementById('addDocModal');
    document.getElementById('openAddDocModalBtn')?.addEventListener('click', () => addModal?.classList.remove('hidden'));
    document.getElementById('closeAddDocModalBtn')?.addEventListener('click', () => addModal?.classList.add('hidden'));
    document.getElementById('cancelAddDocModalBtn')?.addEventListener('click', () => addModal?.classList.add('hidden'));

    // Edit Document Modal controls
    const editModal = document.getElementById('editDocModal');
    document.getElementById('closeEditDocModalBtn')?.addEventListener('click', () => editModal?.classList.add('hidden'));
    document.getElementById('cancelEditDocModalBtn')?.addEventListener('click', () => editModal?.classList.add('hidden'));

    document.querySelectorAll('.edit-doc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const doc = JSON.parse(btn.getAttribute('data-doc') || '{}');
          if (doc.id) {
            document.getElementById('editDocId').value = doc.id;
            document.getElementById('editDocTitle').value = doc.title || '';
            if (document.getElementById('editDocSourceType')) {
              document.getElementById('editDocSourceType').value = doc.sourceType || 'OFFICIAL_NOTIFICATION_PDF';
            }
            if (document.getElementById('editDocPubDate')) {
              document.getElementById('editDocPubDate').value = doc.publicationDate || '';
            }
            if (document.getElementById('editDocSourceUrl')) {
              document.getElementById('editDocSourceUrl').value = doc.sourceUrl || '';
            }
            if (document.getElementById('editDocRecruitmentId') && doc.recruitmentId) {
              document.getElementById('editDocRecruitmentId').value = doc.recruitmentId;
            }
            editModal?.classList.remove('hidden');
          }
        } catch (e) {
          console.error('Failed to open edit modal:', e);
        }
      });
    });

    // Delete Document Modal controls
    const deleteModal = document.getElementById('deleteDocModal');
    document.getElementById('cancelDeleteDocModalBtn')?.addEventListener('click', () => deleteModal?.classList.add('hidden'));

    document.querySelectorAll('.delete-doc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title') || 'Document';
        if (id) {
          document.getElementById('deleteDocId').value = id;
          document.getElementById('deleteDocTitleHidden').value = title;
          const displayEl = document.getElementById('deleteDocTitleDisplay');
          if (displayEl) displayEl.textContent = `"${title}"`;
          deleteModal?.classList.remove('hidden');
        }
      });
    });

    // Close on backdrop click
    [addModal, editModal, deleteModal].forEach((m) => {
      m?.addEventListener('click', (e) => {
        if (e.target === m) m.classList.add('hidden');
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        addModal?.classList.add('hidden');
        editModal?.classList.add('hidden');
        deleteModal?.classList.add('hidden');
      }
    });
  </script>

  <AdminDataTable tableId="documentsDataTable" perPage={10} columns={[{ select: 6, sortable: false }]} />
</AdminLayout>
