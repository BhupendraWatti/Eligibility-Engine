---
// src/pages/admin/pipeline.astro
// Control room for the automated data pipeline: kill switch, settings, cost, run log, items needing a person, broken links.
// The pipeline only proposes; every proposal is decided in /admin/pending-changes.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminD1 } from '../../db/queries';
import { readAdminSubmission } from '../../services/admin-integrity';
import {
  KNOWN_MODELS, dayStart, dismissItem, getSettings, listAttentionItems, listBrokenLinks, listRunItems, listRuns, listSources,
  llmCostThisMonth, llmCostToday, newDraftsToday, recordSettingAudit, setSetting, type ItemRow, type RunRow,
} from '../../services/pipeline-store';

const adminEmail = Astro.locals.adminEmail;
const d1 = getAdminD1('managing the data pipeline');
let message = '';
let messageType: 'success' | 'error' = 'success';

if (Astro.request.method === 'POST') {
  try {
    if (!adminEmail) throw new Error('Admin identity is required.');
    if (!d1) throw new Error('Database is unavailable.');
    const input = await readAdminSubmission(Astro.request);
    const action = input.text('_action');
    if (action === 'toggle_pause') {
      const pause = input.text('pause') === '1';
      await setSetting(d1, 'automation_paused', pause ? '1' : '0', adminEmail);
      await recordSettingAudit(d1, adminEmail, 'automation_paused', pause ? '1' : '0', pause ? 'Kill switch ON: all automation paused' : 'Kill switch OFF: automation resumed');
      message = pause ? 'All automation is paused.' : 'Automation resumed.';
    } else if (action === 'save_settings') {
      const num = (key: string, min: number, max: number) => {
        const v = Number(input.text(key));
        if (!Number.isFinite(v) || v < min || v > max) throw new Error(`${key} must be a number from ${min} to ${max}.`);
        return String(v);
      };
      const model = input.text('extraction_model');
      if (!(KNOWN_MODELS as readonly string[]).includes(model)) throw new Error('Unknown model.');
      const email = input.text('alert_email');
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('Alert email is not valid.');
      const autoPublish = ['on', 'true', '1'].includes(input.text('auto_publish_high_confidence').toLowerCase()) ? '1' : '0';
      const updates: Array<[Parameters<typeof setSetting>[1], string]> = [
        ['auto_publish_high_confidence', autoPublish],
        ['daily_llm_cap_usd', num('daily_llm_cap_usd', 0, 100)], ['daily_new_draft_cap', num('daily_new_draft_cap', 0, 500)],
        ['extraction_model', model], ['alert_email', email],
      ];
      const before = await getSettings(d1);
      for (const [k, v] of updates) await setSetting(d1, k, v, adminEmail);
      if ((autoPublish === '1') !== before.autoPublishHighConfidence) await recordSettingAudit(d1, adminEmail, 'auto_publish_high_confidence', autoPublish, autoPublish === '1' ? 'Auto-publish ENABLED' : 'Auto-publish disabled');
      await recordSettingAudit(d1, adminEmail, 'settings', 'saved', 'Pipeline settings saved');
      message = 'Settings saved.';
    } else if (action === 'dismiss') {
      await dismissItem(d1, input.text('itemId'));
      message = 'Dismissed.';
    } else throw new Error('Unknown action.');
  } catch (error: any) {
    message = error?.message || 'Action failed.';
    messageType = 'error';
    Astro.response.status = 400;
  }
}

let loadError = '';
const safe = async <T,>(fn: () => Promise<T>, fallback: T): Promise<T> => fn().catch(e => { console.error('[admin/pipeline]', e); loadError = 'Pipeline tables are unavailable. Has migration 0015 been applied?'; return fallback; });
const settings = d1 ? await safe(() => getSettings(d1), null) : null;
const [costToday, costMonth, draftsToday, runs, attention, broken, sources] = d1 && settings ? await Promise.all([
  safe(() => llmCostToday(d1), 0), safe(() => llmCostThisMonth(d1), 0), safe(() => newDraftsToday(d1), 0),
  safe(() => listRuns(d1, 30), [] as RunRow[]), safe(() => listAttentionItems(d1, 40), [] as ItemRow[]),
  safe(() => listBrokenLinks(d1, 30), [] as Awaited<ReturnType<typeof listBrokenLinks>>), safe(() => listSources(d1), []),
]) : [0, 0, 0, [] as RunRow[], [] as ItemRow[], [] as Awaited<ReturnType<typeof listBrokenLinks>>, []];

const selectedRun = Astro.url.searchParams.get('run');
const runItems = d1 && selectedRun ? await listRunItems(d1, selectedRun).catch(() => []) : [];
const failing = sources.filter(s => s.status === 'FAILING');
const unverified = sources.filter(s => s.status === 'NEEDS_VERIFICATION');

const when = (t: number | null) => t ? new Date(t * 1000).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) : '—';
const usd = (n: number) => `$${n.toFixed(n < 1 ? 3 : 2)}`;
// What was actually checked, not the model's own confidence: quotes found in the page text (HTML only).
const quoteCheck = (i: { validationJson: string | null }) => {
  try {
    const v = i.validationJson ? JSON.parse(i.validationJson) as { quotesVerified?: number; quotesTotal?: number; quotesChecked?: boolean } : null;
    if (!v || typeof v.quotesTotal !== 'number' || !v.quotesTotal) return '';
    if (v.quotesChecked === false) return 'quotes not checked (PDF)';
    return v.quotesChecked || v.quotesVerified ? `quotes found in page ${v.quotesVerified ?? 0}/${v.quotesTotal}` : '';
  } catch { return ''; }
};
const badge: Record<string, string> = {
  OK: 'bg-emerald-50 text-emerald-800 border-emerald-200', PROPOSED: 'bg-emerald-50 text-emerald-800 border-emerald-200', AUTO_CREATED: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  PARTIAL: 'bg-amber-50 text-amber-800 border-amber-200', CAP_REACHED: 'bg-amber-50 text-amber-800 border-amber-200', DEFERRED: 'bg-amber-50 text-amber-800 border-amber-200', AMBIGUOUS: 'bg-amber-50 text-amber-800 border-amber-200', INCOMPLETE: 'bg-amber-50 text-amber-800 border-amber-200', UNMATCHED: 'bg-amber-50 text-amber-800 border-amber-200',
  FAILED: 'bg-rose-50 text-rose-800 border-rose-200', ERROR: 'bg-rose-50 text-rose-800 border-rose-200', INVALID: 'bg-rose-50 text-rose-800 border-rose-200',
  RUNNING: 'bg-sky-50 text-sky-800 border-sky-200', DRY_RUN: 'bg-sky-50 text-sky-800 border-sky-200',
};
const chip = (s: string) => badge[s] ?? 'bg-slate-100 text-slate-700 border-slate-200';
const field = 'w-full px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs outline-none focus:ring-2 focus:ring-primary';
const label = 'block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1';
---

<AdminLayout title="Pipeline" currentSection="pipeline" breadcrumbs={[{ label: 'Pipeline' }]}>
  <div class="mx-auto max-w-6xl space-y-6">
    {message && (
      <div class={`p-3 rounded-lg border text-xs ${messageType === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-rose-50 border-rose-200 text-rose-900'}`} role="status">{message}</div>
    )}
    {loadError && <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs font-medium text-amber-900">{loadError}</div>}
    {!d1 && <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs font-medium text-amber-900">No database binding in this environment.</div>}

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 font-heading">Pipeline</h1>
        <p class="text-xs text-slate-500 mt-0.5">Automated source checks. It only proposes; you approve in <a href="/admin/pending-changes" class="text-primary underline">Pending changes</a>.</p>
      </div>
      {settings && (
        <form method="POST" onsubmit={`return confirm(${JSON.stringify(settings.automationPaused ? 'Resume all automation?' : 'Pause ALL automation (checks, extraction, link checks)?')})`}>
          <input type="hidden" name="_action" value="toggle_pause" />
          <input type="hidden" name="pause" value={settings.automationPaused ? '0' : '1'} />
          <button type="submit" class={`px-4 py-2 rounded-lg text-xs font-semibold border cursor-pointer transition-colors ${settings.automationPaused ? 'bg-emerald-600 text-white border-emerald-700 hover:bg-emerald-700' : 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100'}`}>
            {settings.automationPaused ? 'Automation PAUSED: resume' : 'Pause all automation (kill switch)'}
          </button>
        </form>
      )}
    </div>

    {settings?.automationPaused && <div class="rounded-xl border border-rose-200 bg-rose-50 p-3.5 text-xs font-semibold text-rose-900">The kill switch is on. No scheduled check, extraction or link check will run until you resume.</div>}

    {settings && (
      <section class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class={label}>LLM cost today</div>
          <div class="text-xl font-bold text-slate-950 font-mono">{usd(costToday)}</div>
          <div class="text-[11px] text-slate-500">cap {usd(settings.dailyLlmCapUsd)} · month {usd(costMonth)}</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class={label}>New drafts today</div>
          <div class="text-xl font-bold text-slate-950 font-mono">{draftsToday} / {settings.dailyNewDraftCap}</div>
          <div class="text-[11px] text-slate-500">daily flood limit</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class={label}>Sources</div>
          <div class="text-xl font-bold text-slate-950 font-mono">{sources.length - failing.length - unverified.length} active</div>
          <div class="text-[11px] text-slate-500">{failing.length} failing · {unverified.length} unverified · <a href="/admin/source-registry" class="text-primary underline">manage</a></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class={label}>Last run</div>
          {runs[0] ? (<>
            <div class="flex items-center gap-2"><span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${chip(runs[0].status)}`}>{runs[0].status}</span><span class="text-[11px] text-slate-500">{runs[0].kind}</span></div>
            <div class="text-[11px] text-slate-500 mt-1">{when(runs[0].startedAt)}</div>
          </>) : <div class="text-xs text-slate-400">No runs yet</div>}
        </div>
      </section>
    )}

    {settings && (
      <section class="rounded-xl border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-bold text-slate-950 mb-3">Settings</h2>
        <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
          onsubmit="var c=this.querySelector('[name=auto_publish_high_confidence]'); return !c.checked || c.defaultChecked || confirm('Auto-publish lets fully machine-checked NEW recruitments go live without your review. Enable it?')">
          <input type="hidden" name="_action" value="save_settings" />
          <div class="sm:col-span-2 lg:col-span-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3">
            <input id="ap" type="checkbox" name="auto_publish_high_confidence" checked={settings.autoPublishHighConfidence} class="mt-0.5 size-3.5 rounded border-slate-300" />
            <label for="ap" class="text-xs text-amber-900"><strong>Auto-publish fully machine-checked records</strong> (OFF by default). A new recruitment is published without review only when every fact was found in its quote and every quote in the page text, with no warning or duplicate. Scanned PDFs and anything needing a human read (summaries, categories) always wait for you. Changes to existing records always need review.</label>
          </div>
          <div><label class={label} for="cap">Daily LLM cap (USD)</label><input id="cap" name="daily_llm_cap_usd" value={settings.dailyLlmCapUsd} class={field} /></div>
          <div><label class={label} for="dc">Daily new-draft limit</label><input id="dc" name="daily_new_draft_cap" value={settings.dailyNewDraftCap} class={field} /></div>
          <div><label class={label} for="m">Extraction model</label>
            <select id="m" name="extraction_model" class={field}>{KNOWN_MODELS.map(m => <option value={m} selected={m === settings.extractionModel}>{m}</option>)}</select></div>
          <div class="lg:col-span-2"><label class={label} for="em">Failure alerts go to (email)</label><input id="em" name="alert_email" type="email" value={settings.alertEmail} placeholder="you@example.com" class={field} /></div>
          <div class="sm:col-span-2 lg:col-span-3"><button type="submit" class="px-3.5 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold cursor-pointer">Save settings</button></div>
        </form>
      </section>
    )}

    <section class="rounded-xl border border-slate-200 bg-white overflow-hidden">
      <h2 class="text-sm font-bold text-slate-950 p-4 border-b border-slate-100">Run log</h2>
      {runs.length === 0 ? <p class="p-6 text-xs text-slate-400 text-center">No runs yet.</p> : (
        <div class="overflow-x-auto"><table class="w-full text-xs text-left">
          <thead><tr class="text-[10px] uppercase tracking-wider text-slate-500 border-b border-slate-200">
            <th class="py-2 px-3 font-bold">Started</th><th class="py-2 px-3 font-bold">Kind</th><th class="py-2 px-3 font-bold">Status</th><th class="py-2 px-3 font-bold text-right">Sources</th><th class="py-2 px-3 font-bold text-right">Items</th><th class="py-2 px-3 font-bold text-right">Proposed</th><th class="py-2 px-3 font-bold text-right">Errors</th><th class="py-2 px-3 font-bold text-right">LLM cost</th>
          </tr></thead>
          <tbody>{runs.map(r => (
            <tr class="border-b border-slate-100 align-top hover:bg-slate-50">
              <td class="py-2 px-3 whitespace-nowrap"><a href={`/admin/pipeline?run=${r.id}`} class="text-primary underline">{when(r.startedAt)}</a></td>
              <td class="py-2 px-3 font-mono">{r.kind}{r.dryRun ? ' · dry run' : ''} <span class="text-slate-400">· {r.triggerBy}</span></td>
              <td class="py-2 px-3"><span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${chip(r.status)}`}>{r.status}</span></td>
              <td class="py-2 px-3 text-right font-mono">{r.sourcesChecked} <span class="text-slate-400">({r.sourcesChanged} changed)</span></td>
              <td class="py-2 px-3 text-right font-mono">{r.itemsFound}</td><td class="py-2 px-3 text-right font-mono">{r.proposalsCreated}</td>
              <td class={`py-2 px-3 text-right font-mono ${r.errors ? 'text-rose-700 font-semibold' : ''}`}>{r.errors}</td><td class="py-2 px-3 text-right font-mono">{usd(r.llmCostUsd)}</td>
            </tr>))}</tbody>
        </table></div>
      )}
    </section>

    {selectedRun && (
      <section class="rounded-xl border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-bold text-slate-950 mb-3">Run items <span class="font-mono text-slate-400 font-normal">{selectedRun}</span></h2>
        {runItems.length === 0 ? <p class="text-xs text-slate-400">No items recorded for this run.</p> : (
          <ul class="space-y-2">{runItems.map(i => (
            <li class="rounded-lg border border-slate-100 bg-slate-50 p-3 text-[11px]">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${chip(i.status)}`}>{i.status}</span>
                {i.dryRun ? <span class="text-sky-700 font-semibold">dry run</span> : null}
                {quoteCheck(i) && <span class="font-mono">{quoteCheck(i)}</span>}
                <a href={i.docUrl} rel="noopener noreferrer" target="_blank" class="text-primary underline break-all">{i.title || i.docUrl}</a>
              </div>
              {i.reason && <p class="mt-1 text-slate-600">{i.reason}</p>}
              {i.extractedJson && <details class="mt-1"><summary class="cursor-pointer text-slate-500">Extracted record and evidence</summary><pre class="mt-1 whitespace-pre-wrap break-words font-mono text-[10px] text-slate-700">{JSON.stringify(JSON.parse(i.extractedJson), null, 2)}</pre></details>}
            </li>))}</ul>
        )}
      </section>
    )}

    <section class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="text-sm font-bold text-slate-950 mb-1">Needs a person</h2>
      <p class="text-[11px] text-slate-500 mb-3">Documents the pipeline could not turn into a proposal. Add the missing master data, or dismiss.</p>
      {attention.length === 0 ? <p class="text-xs text-slate-400">Nothing waiting.</p> : (
        <ul class="space-y-2">{attention.map(i => (
          <li class="rounded-lg border border-slate-100 bg-slate-50 p-3 text-[11px] flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 space-y-1">
              <div class="flex flex-wrap items-center gap-2"><span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${chip(i.status)}`}>{i.status}</span><a href={i.docUrl} rel="noopener noreferrer" target="_blank" class="text-primary underline break-all">{i.title || i.docUrl}</a></div>
              <p class="text-slate-600">{i.reason}</p>
            </div>
            <form method="POST"><input type="hidden" name="_action" value="dismiss" /><input type="hidden" name="itemId" value={i.id} /><button type="submit" class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-[11px] font-semibold cursor-pointer">Dismiss</button></form>
          </li>))}</ul>
      )}
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="text-sm font-bold text-slate-950 mb-1">Broken official links</h2>
      <p class="text-[11px] text-slate-500 mb-3">Weekly check. A link is flagged after two failed weeks. Fix it in the recruitment's edit page.</p>
      {broken.length === 0 ? <p class="text-xs text-slate-400">No broken links.</p> : (
        <ul class="space-y-1.5 text-[11px]">{broken.map(l => (
          <li class="flex flex-wrap gap-x-2"><a href={`/admin/recruitments/${l.recruitmentId}/edit`} class="text-primary underline">{l.recruitmentTitle}</a><span class="font-mono text-slate-500">{l.linkType}</span><span class="font-mono text-rose-700 break-all">{l.url}</span><span class="text-slate-400">{l.failures} failed checks · {when(l.checkedAt)}</span></li>))}</ul>
      )}
    </section>
  </div>
</AdminLayout>
