---
// src/pages/admin/audit-log/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';

const logs = [
  {
    timestamp: '17 Sep 2026 18:32',
    user: 'Aarav Mehta',
    action: 'Changed Application Deadline',
    record: 'MP Police Constable 2026',
    prevVal: '30 Sep 2026',
    newVal: '06 Oct 2026',
    reason: 'Corrigendum notice gazetted by MPESB extending date by 6 days.',
  },
  {
    timestamp: '17 Sep 2026 17:04',
    user: 'Priya Shah',
    action: 'Marked Source Verified',
    record: 'Assistant Grade III 2026',
    prevVal: 'Needs verification',
    newVal: 'Verified',
    reason: 'Verified High Court gazette PDF link and CPCT qualification clause.',
  },
  {
    timestamp: '16 Sep 2026 11:20',
    user: 'Aarav Mehta',
    action: 'Published Recruitment',
    record: 'Forest Guard 2026',
    prevVal: 'Review',
    newVal: 'Published',
    reason: 'All 5 statutory criteria and official application links verified.',
  },
];
---

<BaseLayout title="Audit Trail & Change Log — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <!-- Admin Sidebar Shell -->
    <aside class="w-64 bg-sidebar border-r border-border shrink-0 hidden md:flex flex-col justify-between p-4">
      <div class="space-y-6">
        <div class="px-3 py-2 border-b border-border">
          <div class="font-bold text-xs uppercase tracking-widest text-primary">NIRNAY OPS</div>
          <div class="text-[11px] text-muted-foreground">Compliance Log</div>
        </div>

        <nav class="space-y-1 text-xs font-medium">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/audit-log" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-primary text-primary-foreground font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span>Audit log</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-border flex items-center gap-3 px-3">
        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">AM</div>
        <div class="truncate">
          <div class="text-xs font-semibold text-foreground">Aarav Mehta</div>
          <div class="text-[10px] text-muted-foreground">Admin</div>
        </div>
      </div>
    </aside>

    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <h1 class="text-2xl font-bold text-foreground">Audit log</h1>
          <p class="text-xs text-muted-foreground mt-0.5">A traceable history of changes to recruitment information and rulebooks.</p>
        </div>

        <button type="button" class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold inline-flex items-center gap-2 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Export CSV</span>
        </button>
      </div>

      <!-- Main Layout: Table (2 Cols) + Detail Drawer (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Table Area (2 Cols) -->
        <div class="lg:col-span-2 bg-card rounded-2xl border border-border overflow-hidden shadow-sm">
          <table class="w-full text-xs text-left">
            <thead class="bg-muted text-muted-foreground font-semibold uppercase text-[10px] tracking-wider border-b border-border">
              <tr>
                <th class="py-3 px-4">Timestamp</th>
                <th class="py-3 px-4">User</th>
                <th class="py-3 px-4">Action</th>
                <th class="py-3 px-4">Record</th>
                <th class="py-3 px-4">Prev &rarr; New</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {logs.map((log) => (
                <tr class="hover:bg-muted/40 transition-colors">
                  <td class="py-3.5 px-4 font-mono text-muted-foreground">{log.timestamp}</td>
                  <td class="py-3.5 px-4 font-medium text-foreground">{log.user}</td>
                  <td class="py-3.5 px-4 font-semibold text-primary">{log.action}</td>
                  <td class="py-3.5 px-4 text-foreground">{log.record}</td>
                  <td class="py-3.5 px-4 font-mono">
                    <span class="text-red-500 line-through mr-1">{log.prevVal}</span>
                    <span class="text-emerald-600 font-bold">{log.newVal}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Right Side Change Details Drawer -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm space-y-4">
          <h2 class="text-xs font-bold text-muted-foreground uppercase tracking-wider pb-2 border-b border-border">
            Change Details Drawer
          </h2>

          <div class="space-y-3 text-xs">
            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Actor</span>
              <span class="font-bold text-foreground">Aarav Mehta (Super Admin)</span>
            </div>

            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Modified Field</span>
              <span class="font-mono text-foreground font-semibold">application_end_date</span>
            </div>

            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Previous &rarr; New Value</span>
              <div class="p-2.5 rounded-lg bg-muted border border-border font-mono mt-1 text-[11px]">
                <div class="text-red-500">- 2026-09-30 23:59:59</div>
                <div class="text-emerald-600 font-bold">+ 2026-10-06 23:59:59</div>
              </div>
            </div>

            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-semibold">Reason</span>
              <p class="text-foreground leading-relaxed mt-1">
                MPESB official corrigendum notice published extending candidate application window by 6 calendar days.
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
