---
// src/pages/admin/rules/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Eligibility Rule Builder — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <!-- Admin Sidebar Shell -->
    <aside class="w-64 bg-sidebar border-r border-border shrink-0 hidden md:flex flex-col justify-between p-4">
      <div class="space-y-6">
        <div class="px-3 py-2 border-b border-border">
          <div class="font-bold text-xs uppercase tracking-widest text-primary">NIRNAY OPS</div>
          <div class="text-[11px] text-muted-foreground">Rule Logic Engine</div>
        </div>

        <nav class="space-y-1 text-xs font-medium">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/recruitments" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/></svg>
            <span>Recruitments</span>
          </a>
          <a href="/admin/rules" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-primary text-primary-foreground font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Eligibility rules</span>
          </a>
          <a href="/admin/sources/verify" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/></svg>
            <span>Sources</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-border flex items-center gap-3 px-3">
        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
          AM
        </div>
        <div class="truncate">
          <div class="text-xs font-semibold text-foreground">Aarav Mehta</div>
          <div class="text-[10px] text-muted-foreground">Admin</div>
        </div>
      </div>
    </aside>

    <!-- Rule Builder Canvas -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-primary">MP Police Constable Recruitment 2026</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200">
              Draft Rules
            </span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">
            Eligibility rules
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <button class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors">
            Preview candidate match
          </button>
          <button class="px-5 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm transition-colors">
            Save rules
          </button>
        </div>
      </div>

      <!-- Validation Warning Banner -->
      <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-center gap-2 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><strong>Verification Alert:</strong> Physical measurement requirement has not been verified against the Gazette.</span>
      </div>

      <!-- Main Two-Column Layout: Canvas (2 Cols) + Natural Language Preview (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Rules Builder Flow (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
          <!-- Rule 01 -->
          <div class="bg-card rounded-2xl border border-border p-5 shadow-2xs">
            <div class="flex items-center justify-between mb-3 text-xs font-semibold text-muted-foreground">
              <span class="text-primary font-bold">Rule 01: Education</span>
              <div class="flex items-center gap-2">
                <button class="hover:text-foreground">Duplicate</button>
                <span>·</span>
                <button class="text-red-500 hover:underline">Delete</button>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-3 text-xs">
              <div>
                <label class="block font-medium text-foreground mb-1">Field</label>
                <select class="w-full p-2 rounded-lg bg-background border border-border text-foreground">
                  <option>Qualification</option>
                  <option>Age</option>
                  <option>Domicile</option>
                </select>
              </div>
              <div>
                <label class="block font-medium text-foreground mb-1">Operator</label>
                <select class="w-full p-2 rounded-lg bg-background border border-border text-foreground">
                  <option>At least</option>
                  <option>Exact match</option>
                </select>
              </div>
              <div>
                <label class="block font-medium text-foreground mb-1">Value</label>
                <select class="w-full p-2 rounded-lg bg-background border border-border text-foreground">
                  <option>10th Pass</option>
                  <option>12th Pass</option>
                  <option>Graduation</option>
                </select>
              </div>
            </div>
          </div>

          <!-- AND Divider -->
          <div class="flex items-center justify-center my-2">
            <span class="px-3 py-1 rounded-full bg-muted border border-border text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
              AND
            </span>
          </div>

          <!-- Rule 02 -->
          <div class="bg-card rounded-2xl border border-border p-5 shadow-2xs">
            <div class="flex items-center justify-between mb-3 text-xs font-semibold text-muted-foreground">
              <span class="text-primary font-bold">Rule 02: Age Bracket</span>
              <div class="flex items-center gap-2">
                <button class="hover:text-foreground">Duplicate</button>
                <span>·</span>
                <button class="text-red-500 hover:underline">Delete</button>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-3 text-xs">
              <div>
                <label class="block font-medium text-foreground mb-1">Field</label>
                <input type="text" value="Age" disabled class="w-full p-2 rounded-lg bg-muted border border-border text-foreground" />
              </div>
              <div>
                <label class="block font-medium text-foreground mb-1">Operator</label>
                <select class="w-full p-2 rounded-lg bg-background border border-border text-foreground">
                  <option>Between</option>
                  <option>Less than or equal</option>
                </select>
              </div>
              <div class="flex items-center gap-2">
                <input type="number" value="18" class="w-1/2 p-2 rounded-lg bg-background border border-border text-foreground font-mono" />
                <span>to</span>
                <input type="number" value="33" class="w-1/2 p-2 rounded-lg bg-background border border-border text-foreground font-mono" />
              </div>
            </div>
          </div>

          <!-- AND Divider -->
          <div class="flex items-center justify-center my-2">
            <span class="px-3 py-1 rounded-full bg-muted border border-border text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
              AND
            </span>
          </div>

          <!-- Rule 03 -->
          <div class="bg-card rounded-2xl border border-border p-5 shadow-2xs">
            <div class="flex items-center justify-between mb-3 text-xs font-semibold text-muted-foreground">
              <span class="text-primary font-bold">Rule 03: Domicile</span>
              <div class="flex items-center gap-2">
                <button class="hover:text-foreground">Duplicate</button>
                <span>·</span>
                <button class="text-red-500 hover:underline">Delete</button>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-3 text-xs">
              <div>
                <label class="block font-medium text-foreground mb-1">Field</label>
                <input type="text" value="Domicile" disabled class="w-full p-2 rounded-lg bg-muted border border-border text-foreground" />
              </div>
              <div>
                <label class="block font-medium text-foreground mb-1">Operator</label>
                <select class="w-full p-2 rounded-lg bg-background border border-border text-foreground">
                  <option>Equals</option>
                </select>
              </div>
              <div>
                <label class="block font-medium text-foreground mb-1">Value</label>
                <input type="text" value="Madhya Pradesh" class="w-full p-2 rounded-lg bg-background border border-border text-foreground" />
              </div>
            </div>
          </div>

          <div class="pt-4 flex items-center gap-3">
            <button class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors">
              + Add rule
            </button>
            <button class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors">
              + Add rule group (OR)
            </button>
          </div>
        </div>

        <!-- Right Preview Rail: Natural Language Interpretation -->
        <aside class="space-y-6">
          <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
            <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-3 pb-2 border-b border-border">
              Human-Readable Preview
            </h3>
            <p class="text-xs text-foreground leading-relaxed italic bg-muted/50 p-4 rounded-xl border border-border">
              "Candidate must have at least a 10th qualification, be aged 18–33 and satisfy the specified Madhya Pradesh domicile condition."
            </p>
            <div class="mt-4 pt-3 border-t border-border text-[11px] text-muted-foreground">
              Generated automatically from AST criteria trees.
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
