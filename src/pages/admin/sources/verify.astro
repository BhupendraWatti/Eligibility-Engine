---
// src/pages/admin/sources/verify.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Verify Source Claims — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <!-- Admin Sidebar Shell -->
    <aside class="w-64 bg-sidebar border-r border-border shrink-0 hidden md:flex flex-col justify-between p-4">
      <div class="space-y-6">
        <div class="px-3 py-2 border-b border-border">
          <div class="font-bold text-xs uppercase tracking-widest text-primary">NIRNAY OPS</div>
          <div class="text-[11px] text-muted-foreground">Source Provenance Desk</div>
        </div>

        <nav class="space-y-1 text-xs font-medium">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/recruitments" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/></svg>
            <span>Recruitments</span>
          </a>
          <a href="/admin/sources/verify" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-primary text-primary-foreground font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>Sources</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-border flex items-center gap-3 px-3">
        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
          AM
        </div>
        <div class="truncate">
          <div class="text-xs font-semibold text-foreground">Aarav Mehta</div>
          <div class="text-[10px] text-muted-foreground">Verification Reviewer</div>
        </div>
      </div>
    </aside>

    <!-- Source Verification Canvas -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-primary">MP Police Constable Recruitment 2026</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200">
              Needs verification
            </span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">
            Verify source
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="https://esb.mp.gov.in"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors flex items-center gap-1.5"
          >
            <span>Open source PDF</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition-colors">
            Mark verified
          </button>
        </div>
      </div>

      <!-- Main Layout: Source Info (1 Col) + Claims Supported (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left Form Card: Source Info -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm space-y-4">
          <h2 class="text-xs font-bold text-muted-foreground uppercase tracking-wider pb-2 border-b border-border">
            Source Information
          </h2>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block font-semibold text-muted-foreground mb-1">Conducting Authority</label>
              <input type="text" value="MPESB (Madhya Pradesh Employees Selection Board)" disabled class="w-full p-2.5 rounded-lg bg-muted border border-border text-foreground font-medium" />
            </div>

            <div>
              <label class="block font-semibold text-muted-foreground mb-1">Source URL</label>
              <input type="text" value="https://esb.mp.gov.in/Rulebooks/Police_Constable_2026.pdf" disabled class="w-full p-2.5 rounded-lg bg-muted border border-border text-primary font-mono" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-semibold text-muted-foreground mb-1">Source Type</label>
                <input type="text" value="Official Notification" disabled class="w-full p-2.5 rounded-lg bg-muted border border-border text-foreground" />
              </div>
              <div>
                <label class="block font-semibold text-muted-foreground mb-1">Publication Date</label>
                <input type="text" value="15 Sep 2026" disabled class="w-full p-2.5 rounded-lg bg-muted border border-border text-foreground font-mono" />
              </div>
            </div>

            <div>
              <label class="block font-semibold text-muted-foreground mb-1">Audit Note</label>
              <textarea
                placeholder="Add reviewer notes regarding cutoff dates or clause numbers..."
                rows="3"
                class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Right Card: Claims Supported -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm space-y-4">
          <h2 class="text-xs font-bold text-muted-foreground uppercase tracking-wider pb-2 border-b border-border">
            Claims Supported By This Source
          </h2>

          <p class="text-xs text-muted-foreground">
            Verify each extracted claim against the official notification clauses:
          </p>

          <div class="space-y-3">
            {[
              { label: 'Application Deadline: 06 Oct 2026 (Clause 3.1)', checked: true },
              { label: 'Total Vacancies: 7,500 Posts (Clause 1.2)', checked: true },
              { label: 'Minimum Qualification: 10th Class Passed (Clause 4.1)', checked: true },
              { label: 'Age Limit: 18 to 33 years on 01 Jan 2026 (Clause 5.2)', checked: false },
              { label: 'MP Domicile Mandate for Category Relaxation (Clause 6.4)', checked: false },
            ].map((claim, idx) => (
              <label key={idx} class="flex items-start gap-3 p-3 rounded-xl bg-muted/40 border border-border cursor-pointer hover:bg-muted transition-colors">
                <input type="checkbox" defaultChecked={claim.checked} class="size-4 rounded text-primary focus:ring-primary mt-0.5" />
                <span class="text-xs font-medium text-foreground">{claim.label}</span>
              </label>
            ))}
          </div>

          <!-- Warning Banner -->
          <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Verify each claim against the official notification before publishing to public channels.</span>
          </div>

          <div class="pt-2 border-t border-border flex items-center justify-between text-[11px] text-muted-foreground">
            <span>Assigned: Aarav Mehta</span>
            <span class="font-mono">Timestamp: 21 Sep 2026, 18:35</span>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
