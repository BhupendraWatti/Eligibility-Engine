---
// src/pages/admin/login.astro
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in to private workspace — NIRNAY OPS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-muted/60 min-h-screen flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-md">
      <!-- Auth Card -->
      <div class="bg-card rounded-2xl border border-border p-8 shadow-sm">
        <div class="text-center mb-6">
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="font-bold text-base tracking-[0.18em] text-foreground">NIRNAY</span>
            <span class="px-2 py-0.5 rounded bg-primary text-primary-foreground font-bold text-[10px] tracking-wider uppercase">
              OPS
            </span>
          </div>
          <h1 class="text-xl font-bold text-foreground">
            Sign in to private workspace
          </h1>
          <p class="text-xs text-muted-foreground mt-1">
            Authorised staff and verification desk portal.
          </p>
        </div>

        <form action="/admin" method="get" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              Work Email
            </label>
            <input
              type="email"
              defaultValue="admin@nirnay.in"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm text-foreground focus:border-primary outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-foreground">
                Password
              </label>
              <a href="#" class="text-xs text-primary hover:underline font-medium">Forgot password?</a>
            </div>
            <input
              type="password"
              defaultValue="••••••••••••"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm text-foreground focus:border-primary outline-none"
            />
          </div>

          <div class="flex items-center justify-between py-1">
            <label class="flex items-center gap-2 cursor-pointer text-xs text-foreground">
              <input type="checkbox" defaultChecked class="size-4 rounded text-primary focus:ring-primary" />
              <span>Remember this device</span>
            </label>
          </div>

          <div class="space-y-2 pt-2">
            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs shadow-sm transition-colors"
            >
              Sign in
            </button>

            <button
              type="button"
              class="w-full py-2.5 px-4 rounded-xl border border-border bg-card hover:bg-muted text-foreground font-semibold text-xs transition-colors flex items-center justify-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
              <span>Use a security key</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Trust Note Footer -->
      <p class="text-xs text-muted-foreground text-center mt-6">
        This workspace is for authorised content and verification staff.
      </p>
    </div>
  </body>
</html>
