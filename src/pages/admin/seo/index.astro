---
// src/pages/admin/seo/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminSidebar from '../../../components/admin/AdminSidebar.astro';
---

<BaseLayout title="SEO Management Studio — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="seo" />

    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-primary">Record: MP Police Constable 2026</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200">
              Inherited Defaults
            </span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">SEO management</h1>
        </div>

        <div class="flex items-center gap-3">
          <button class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-xs font-semibold transition-colors">
            Restore defaults
          </button>
          <button class="px-5 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm transition-colors">
            Save metadata
          </button>
        </div>
      </div>

      <!-- Main Layout: Form (2 Cols) + SERP Preview (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Form Area (2 Cols) -->
        <div class="lg:col-span-2 space-y-4 bg-card rounded-2xl border border-border p-6 sm:p-8 shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-foreground">Page Title</label>
              <span class="text-[11px] text-emerald-600 font-medium">68 / 70 chars (Optimal)</span>
            </div>
            <input
              type="text"
              value="MP Police Constable Recruitment 2026 | Eligibility, Dates & Official Link"
              class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-xs sm:text-sm text-foreground focus:border-primary outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-foreground">Meta Description</label>
              <span class="text-[11px] text-emerald-600 font-medium">148 / 160 chars (Optimal)</span>
            </div>
            <textarea
              rows="3"
              class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-xs sm:text-sm text-foreground focus:border-primary outline-none"
            >Explore MP Police Constable 2026 details: 7,500 vacancies, 10th pass qualification, age limits, syllabus, and direct link to official MPESB application portal.</textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-foreground mb-1.5">Canonical URL</label>
              <input
                type="text"
                value="/jobs/mp-police-constable-recruitment-2026"
                class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-muted font-mono text-xs text-foreground"
                disabled
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-foreground mb-1.5">Robots Indexing</label>
              <select class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-xs text-foreground">
                <option>index, follow (Active)</option>
                <option>noindex, nofollow</option>
              </select>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-muted/40 border border-border text-xs text-muted-foreground">
            Defaults are generated dynamically from structured recruitment entity records. Edit only when manual override is required.
          </div>
        </div>

        <!-- Right SERP Card Preview (1 Col) -->
        <aside class="space-y-6">
          <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
            <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-4 pb-2 border-b border-border">
              Google Search Result Preview
            </h3>

            <div class="space-y-1 text-left font-sans">
              <div class="flex items-center gap-1 text-xs text-slate-700 font-mono">
                <span>https://nirnay.in › jobs › mp-police-constable</span>
              </div>
              <h4 class="text-blue-700 hover:underline text-sm font-medium leading-snug cursor-pointer">
                MP Police Constable Recruitment 2026 | Eligibility, Dates & Official Link
              </h4>
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                Explore MP Police Constable 2026 details: 7,500 vacancies, 10th pass qualification, age limits, syllabus, and direct link to official MPESB application portal.
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-border flex items-center justify-between text-xs">
              <span class="text-muted-foreground">Metadata Completeness:</span>
              <span class="font-bold font-mono text-primary">84%</span>
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
