---
// src/pages/admin/masters/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminDataTable from '../../../components/admin/AdminDataTable.astro';
import MasterSubNav from '../../../components/admin/MasterSubNav.astro';
import {
  getAllCanonicalPosts,
  getAllSectors,
  getAllDepartments,
  updateCanonicalPost,
  createCanonicalPost,
} from '../../../db/queries';

let statusMessage: { type: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');

    if (action === 'update_post') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const sectorId = formData.get('sectorId')?.toString();
      const departmentId = formData.get('departmentId')?.toString();
      const payScale = formData.get('payScale')?.toString();
      const defaultMinAge = parseInt(formData.get('defaultMinAge')?.toString() || '18', 10);
      const defaultMaxAge = parseInt(formData.get('defaultMaxAge')?.toString() || '33', 10);
      const defaultQualification = formData.get('defaultQualification')?.toString() || '10TH';
      const summary = formData.get('summary')?.toString() || '';

      if (id && title) {
        await updateCanonicalPost({
          id,
          title,
          sectorId: sectorId || undefined,
          departmentId: departmentId || undefined,
          payScale: payScale || null,
          defaultMinAge,
          defaultMaxAge,
          defaultQualification,
          summary,
        });
        statusMessage = {
          type: 'success',
          text: `Updated master post "${title}". Changes are now active across all linked recruitments and eligibility rules!`,
        };
      }
    } else if (action === 'create_post') {
      const title = formData.get('title')?.toString();
      const sectorId = formData.get('sectorId')?.toString();
      const departmentId = formData.get('departmentId')?.toString();
      const payScale = formData.get('payScale')?.toString();
      const defaultMinAge = parseInt(formData.get('defaultMinAge')?.toString() || '18', 10);
      const defaultMaxAge = parseInt(formData.get('defaultMaxAge')?.toString() || '33', 10);
      const defaultQualification = formData.get('defaultQualification')?.toString() || '10TH';
      const summary = formData.get('summary')?.toString() || '';

      if (title && sectorId && departmentId) {
        const newId = await createCanonicalPost({
          title,
          sectorId,
          departmentId,
          payScale: payScale || null,
          defaultMinAge,
          defaultMaxAge,
          defaultQualification,
          summary,
        });
        statusMessage = {
          type: 'success',
          text: `Successfully created new canonical post "${title}" with ID ${newId}!`,
        };
      }
    }
  } catch (err: any) {
    statusMessage = { type: 'error', text: `Failed to process master action: ${err.message}` };
  }
}

const posts = await getAllCanonicalPosts();
const sectors = await getAllSectors();
const departments = await getAllDepartments();

// Dynamic Standard Master Qualification Levels
const qualificationOptions = [
  { value: '7TH', label: '7th Class Pass (Middle School)', level: 'Primary' },
  { value: '8TH', label: '8th Class Pass (Primary Cadre)', level: 'Primary' },
  { value: '10TH', label: '10th Class Pass (Matriculation / Secondary)', level: 'Secondary' },
  { value: '12TH', label: '12th Class Pass (Higher Secondary / 10+2)', level: 'Higher Secondary' },
  { value: 'ITI', label: 'ITI Trade Certificate (Vocational / Technical)', level: 'Vocational' },
  { value: 'DIPLOMA', label: 'Polytechnic Engineering / Technical Diploma', level: 'Technical' },
  { value: 'GRADUATION', label: "Bachelor's Degree (Graduate - Any Discipline)", level: 'Undergraduate' },
  { value: 'POST_GRADUATION', label: "Master's Degree (Post Graduate - Any Discipline)", level: 'Postgraduate' },
];

// Standard Dynamic 7th CPC State Pay Matrix Bands
const standardPayBands = [
  { level: 'Level 1', band: 'Rs. 15,500 - 49,000/- (Pay Matrix Level 1)' },
  { level: 'Level 2', band: 'Rs. 19,500 - 62,000/- (Pay Matrix Level 2)' },
  { level: 'Level 4', band: 'Rs. 25,300 - 80,500/- (Pay Matrix Level 4)' },
  { level: 'Level 6', band: 'Rs. 28,700 - 91,300/- (Pay Matrix Level 6)' },
  { level: 'Level 7', band: 'Rs. 32,800 - 1,03,600/- (Pay Matrix Level 7)' },
  { level: 'Level 8', band: 'Rs. 36,200 - 1,14,800/- (Pay Matrix Level 8)' },
  { level: 'Level 9', band: 'Rs. 42,700 - 1,35,100/- (Pay Matrix Level 9)' },
  { level: 'Level 10', band: 'Rs. 56,100 - 1,77,500/- (Pay Matrix Level 10)' },
  { level: 'Level 12', band: 'Rs. 56,100 - 1,77,500/- (Pay Matrix Level 12)' },
  { level: 'Level J-1', band: 'Rs. 77,840 - 1,36,520/- (Pay Matrix Level J-1)' },
];
---

<AdminLayout
  title="Canonical Posts | Master Records"
  currentSection="masters"
  breadcrumbs={[
    { label: 'Master records', href: '/admin/masters' },
    { label: 'Canonical Posts' },
  ]}
>
  <div class="max-w-7xl mx-auto space-y-4 sm:space-y-6">
    <!-- Master Records Section Sub-Types Navigation Bar -->
    <MasterSubNav currentTab="masters" />

    <!-- Shared Dynamic Datalist for Pay Matrix Autocomplete -->
    <datalist id="dynamicPayBandsList">
      {standardPayBands.map((pb) => (
        <option value={pb.band}>{pb.level} - {pb.band}</option>
      ))}
    </datalist>
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Master Data & Canonical Posts
        </h1>
        <p class="text-xs text-zinc-500 mt-1 max-w-2xl">
          Central catalog for Canonical Posts, Government Sectors, and Departments. Editing any master record immediately propagates to recruitment catalogs.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/sectors-posts"
          class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors"
        >
          &larr; View Taxonomy Workspace
        </a>
        <button
          type="button"
          id="toggleCreateStudioBtn"
          onclick="toggleCreateStudio()"
          class="px-4 py-2 rounded-lg bg-primary hover:bg-primary-hover text-white font-semibold text-xs shadow-xs transition-all flex items-center gap-2 cursor-pointer"
        >
          <span id="createBtnIcon" class="text-sm font-black">+</span>
          <span id="createBtnText">Add Canonical Post</span>
        </button>
      </div>
    </div>

    {statusMessage && (
      <div class={`mb-6 p-4 rounded-2xl border text-xs font-medium flex items-center justify-between ${
        statusMessage.type === 'success'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
          : 'bg-rose-50 border-rose-200 text-rose-800'
      }`}>
        <div class="flex items-center gap-2">
          <span class="font-bold">{statusMessage.type === 'success' ? '✓ Master Synced:' : '✗ Error:'}</span>
          <span>{statusMessage.text}</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 text-sm font-bold">×</button>
      </div>
    )}

    <!-- Master Statistics Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Total Canonical Posts</span>
        <span class="text-2xl font-black text-slate-900 font-['Outfit']">{posts.length}</span>
        <span class="text-[11px] text-slate-500 block mt-1">Class 1 to Class 4 Cadres</span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Master Sectors</span>
        <span class="text-2xl font-black text-indigo-600 font-['Outfit']">{sectors.length}</span>
        <span class="text-[11px] text-slate-500 block mt-1">Police, Court, IT, Civil, etc.</span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Departments</span>
        <span class="text-2xl font-black text-slate-900 font-['Outfit']">{departments.length}</span>
        <span class="text-[11px] text-slate-500 block mt-1">State Ministries & Secretariats</span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Propagation Mode</span>
        <span class="text-2xl font-black text-emerald-600 font-['Outfit']">Relational</span>
        <span class="text-[11px] text-slate-500 block mt-1">Instant Zero-Desync FK Sync</span>
      </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="bg-white p-3.5 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm mb-6">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4">
        <div class="sm:col-span-6">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            Search Master Posts or Keywords
          </label>
          <input
            type="text"
            id="searchInput"
            placeholder="Search by post title, pay scale, or department..."
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-indigo-500 outline-none"
            oninput="filterPosts()"
          />
        </div>
        <div class="sm:col-span-3">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            Filter by Sector
          </label>
          <select
            id="sectorFilter"
            class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-indigo-500 outline-none bg-white"
            onchange="onSectorFilterChange()"
          >
            <option value="ALL">All Sectors ({posts.length} Posts)</option>
            {sectors.map(sec => (
              <option value={sec.id}>{sec.name}</option>
            ))}
          </select>
        </div>
        <div class="sm:col-span-3">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            Filter by Department
          </label>
          <select
            id="deptFilter"
            class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-indigo-500 outline-none bg-white"
            onchange="filterPosts()"
          >
            <option value="ALL">All Departments ({departments.length})</option>
            {departments.map(dept => (
              <option value={dept.id} data-sector-id={dept.sectorId || ''}>{dept.name}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Collapsible Top Staged Creation Studio (In-Place / No Modal / No Blur) -->
    <div id="createPostStudio" class="hidden mb-8 transition-all duration-300">
      <div class="rounded-3xl border-2 border-indigo-200/90 bg-gradient-to-br from-indigo-50/70 via-white to-slate-50/90 p-6 sm:p-8 shadow-xl shadow-indigo-100/50 relative overflow-hidden">
        <!-- Top Accent Bar -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-500"></div>

        <!-- Studio Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-indigo-100/80 gap-4">
          <div class="flex items-start sm:items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-xl shadow-md shadow-indigo-600/30 shrink-0">
              +
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
                  New Master Taxonomy Entry
                </span>
                <span class="text-xs text-slate-400 font-medium hidden sm:inline">&bull; Propagates immediately to all catalogs</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 font-['Outfit'] mt-1">
                Standardize New Canonical Government Post
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Define canonical post title, ministerial department, pay scale, and base educational eligibility bounds.
              </p>
            </div>
          </div>

          <button
            type="button"
            onclick="toggleCreateStudio(false)"
            class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs shadow-sm transition-all cursor-pointer self-start sm:self-auto flex items-center gap-1.5"
          >
            <span>✕ Close Studio</span>
          </button>
        </div>

        <!-- Create Form -->
        <form method="POST" class="space-y-5">
          <input type="hidden" name="_action" value="create_post" />

          <!-- Row 1: Sector, Department & Title -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Government Sector <span class="text-rose-500">*</span></span>
                <a href="/admin/sectors-posts" target="_blank" class="text-[10px] text-indigo-600 font-semibold hover:underline">+ Manage Sectors ↗</a>
              </label>
              <select
                id="create_sectorId"
                name="sectorId"
                required
                onchange="filterCreateDepartments()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              >
                <option value="" disabled selected>-- Select Government Sector --</option>
                {sectors.map(sec => (
                  <option value={sec.id}>{sec.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>State Department <span class="text-rose-500">*</span></span>
                <a href="/admin/departments" target="_blank" class="text-[10px] text-indigo-600 font-semibold hover:underline">+ Add Department ↗</a>
              </label>
              <select
                id="create_departmentId"
                name="departmentId"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              >
                <option value="" disabled selected>-- Select State Department --</option>
                {departments.map(dept => (
                  <option value={dept.id} data-sector-id={dept.sectorId || ''}>{dept.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5">
                Canonical Post Title <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                name="title"
                placeholder="e.g. Legal Officer / Public Prosecutor"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Row 2: Pay Scale, Qualification, Min Age, Max Age -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Pay Scale / Band</span>
                <span class="text-[10px] text-indigo-600 font-semibold">7th CPC Datalist</span>
              </label>
              <input
                type="text"
                name="payScale"
                list="dynamicPayBandsList"
                placeholder="e.g. Rs. 36,200 - 1,14,800/- (Pay Matrix Level 8)"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Default Qualification</span>
                <span class="text-[10px] text-indigo-600 font-semibold">Standard Dynamic</span>
              </label>
              <select
                name="defaultQualification"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              >
                {qualificationOptions.map((q) => (
                  <option value={q.value} selected={q.value === '10TH'}>
                    {q.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5">
                Default Min Age (Years)
              </label>
              <input
                type="number"
                id="create_minAge"
                name="defaultMinAge"
                value="18"
                min="14"
                max="65"
                oninput="updateCreateAgeWindowBadge()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5">
                Default Max Age (Years)
              </label>
              <input
                type="number"
                id="create_maxAge"
                name="defaultMaxAge"
                value="33"
                min="14"
                max="65"
                oninput="updateCreateAgeWindowBadge()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Row 3: Summary -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700">
                Standard Job Role Summary & Public Scope
              </label>
              <span id="createAgeSpanBadge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                Eligibility Span: 18 - 33 Years (15-Year Window)
              </span>
            </div>
            <textarea
              name="summary"
              rows="3"
              placeholder="Key responsibilities, statutory duties, and official scope of this post..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm leading-relaxed"
            ></textarea>
          </div>

          <!-- Footer Actions -->
          <div class="pt-4 border-t border-indigo-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <span class="text-[11px] text-slate-500 flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Immediately available in recruitment ingestion wizards and candidate assessment engines.</span>
            </span>

            <div class="flex items-center gap-3 self-end sm:self-auto">
              <button
                type="button"
                onclick="toggleCreateStudio(false)"
                class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-sm cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 transition-all cursor-pointer flex items-center gap-2"
              >
                <span>Create Canonical Post</span>
                <span>&rarr;</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Master Posts Directory Table -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 font-['Outfit']">
            Master Canonical Government Posts Directory
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Single source of truth for post titles, pay bands, and standard qualifications. Click any post's studio button to edit in-place.
          </p>
        </div>
        <span id="postCountBadge" class="text-xs font-bold px-3 py-1 bg-slate-100 text-slate-700 rounded-full">
          Showing {posts.length} of {posts.length} Posts
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left" id="postsTable">
          <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
            <tr>
              <th class="py-3 px-6">Post Title & Code</th>
              <th class="py-3 px-6">Sector & Department</th>
              <th class="py-3 px-6">Pay Scale / Band</th>
              <th class="py-3 px-6">Default Qualification</th>
              <th class="py-3 px-6">Age Bracket</th>
              <th class="py-3 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="postsTableBody">
            {posts.map(post => (
              <tr
                class="post-row hover:bg-slate-50/60 transition-all cursor-default"
                id={`post-row-${post.id}`}
                data-post-id={post.id}
                data-sector-id={post.sectorId}
                data-dept-id={post.departmentId}
                data-title={post.title.toLowerCase()}
                data-payscale={(post.payScale || '').toLowerCase()}
                data-dept={(post.departmentName || '').toLowerCase()}
              >
                <td class="py-4 px-6">
                  <div class="font-bold text-slate-900 text-sm post-title">{post.title}</div>
                  <div class="text-[11px] text-slate-400 font-mono mt-0.5">{post.id} &bull; {post.slug}</div>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-1">
                    {post.sectorName || 'State Government'}
                  </span>
                  <div class="text-slate-600 text-[11px] font-medium">
                    {post.departmentName || 'Department'}
                  </div>
                </td>
                <td class="py-4 px-6 font-semibold text-slate-800 post-payscale">
                  {post.payScale || 'As per Govt Rules'}
                </td>
                <td class="py-4 px-6">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-800 border border-slate-200">
                    {post.defaultQualification}
                  </span>
                </td>
                <td class="py-4 px-6 font-medium text-slate-700">
                  {post.defaultMinAge} - {post.defaultMaxAge} Years
                </td>
                <td class="py-4 px-6 text-right">
                  <button
                    type="button"
                    id={`btn-edit-${post.id}`}
                    class="action-edit-btn px-3 py-1.5 rounded-xl border border-slate-300 bg-white hover:border-indigo-500 hover:text-indigo-600 hover:bg-indigo-50/40 font-bold text-[11px] shadow-sm transition-all cursor-pointer inline-flex items-center gap-1.5"
                    onclick={`toggleInlineEdit(${JSON.stringify(post)})`}
                  >
                    <span class="btn-text">Edit Master</span>
                    <span class="btn-arrow text-slate-400 font-bold">&rarr;</span>
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Reusable Master Studio Edit Workbench (Positioned outside table for clean pagination & sorting) -->
      <div id="inlineEditWorkbenchRow" class="hidden edit-workbench-row border-t border-indigo-100 bg-gradient-to-b from-indigo-50/50 via-white to-slate-50/90 p-6 sm:p-8">
        <!-- Studio Header Ribbon -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-indigo-100/80 gap-3">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-indigo-600 text-white shadow-sm shadow-indigo-600/20">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Inline Master Studio
            </span>
            <div class="flex items-center gap-2">
              <span id="studioPostIdBadge" class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-lg border border-slate-200"></span>
              <span id="studioSectorDeptBadge" class="text-xs font-semibold text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-200/60"></span>
            </div>
          </div>

          <div class="flex items-center gap-3 self-end sm:self-auto">
            <span class="text-[11px] text-emerald-700 font-bold hidden md:inline-flex items-center gap-1.5 bg-emerald-50 px-3 py-1 rounded-lg border border-emerald-200">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              Relational cascading sync active
            </span>
            <button
              type="button"
              onclick="closeInlineEdit()"
              class="px-3.5 py-1.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs shadow-sm transition-all cursor-pointer flex items-center gap-1"
            >
              <span>✕ Collapse</span>
            </button>
          </div>
        </div>

        <!-- Studio Form -->
        <form method="POST" class="space-y-5" id="inlineEditForm">
          <input type="hidden" name="_action" value="update_post" />
          <input type="hidden" id="edit_id" name="id" />

          <!-- Dynamic Sector & Department Assignment Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Government Sector <span class="text-rose-500">*</span></span>
                <span class="text-[10px] text-indigo-600 font-semibold">Dynamic Assignment</span>
              </label>
              <select
                id="edit_sectorId"
                name="sectorId"
                required
                onchange="filterEditDepartments()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              >
                {sectors.map(sec => (
                  <option value={sec.id}>{sec.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>State Department <span class="text-rose-500">*</span></span>
                <span class="text-[10px] text-slate-400 font-normal">Filtered by sector</span>
              </label>
              <select
                id="edit_departmentId"
                name="departmentId"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              >
                {departments.map(dept => (
                  <option value={dept.id} data-sector-id={dept.sectorId || ''}>{dept.name}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Title & Pay Scale Row -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2">
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Canonical Post Title <span class="text-rose-500">*</span></span>
                <span class="text-[10px] text-slate-400 font-normal normal-case">Official gazetted cadre nomenclature</span>
              </label>
              <input
                type="text"
                id="edit_title"
                name="title"
                required
                placeholder="e.g. Naib Tehsildar (Executive Magistrate)"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Pay Scale / Band</span>
                <span class="text-[10px] text-indigo-600 font-semibold">7th CPC Datalist</span>
              </label>
              <input
                type="text"
                id="edit_payScale"
                name="payScale"
                list="dynamicPayBandsList"
                placeholder="e.g. Rs. 36,200 - 1,14,800/- (Pay Matrix Level 8)"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Qualifications & Age Bracket Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="sm:col-span-2 lg:col-span-2">
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Default Canonical Qualification <span class="text-rose-500">*</span></span>
                <span class="text-[10px] text-indigo-600 font-semibold">Standard Dynamic</span>
              </label>
              <select
                id="edit_defaultQualification"
                name="defaultQualification"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm cursor-pointer"
              >
                {qualificationOptions.map((q) => (
                  <option value={q.value}>{q.label}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5">
                Default Min Age (Years)
              </label>
              <input
                type="number"
                id="edit_defaultMinAge"
                name="defaultMinAge"
                min="14"
                max="60"
                oninput="updateAgeWindowBadge()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>

            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700 mb-1.5">
                Default Max Age (Years)
              </label>
              <input
                type="number"
                id="edit_defaultMaxAge"
                name="defaultMaxAge"
                min="14"
                max="65"
                oninput="updateAgeWindowBadge()"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs sm:text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Live Age Span Info & Summary Row -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-700">
                Standard Job Role Summary & Official Duties
              </label>
              <span id="liveAgeSpanBadge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-800 border border-indigo-200">
                Eligibility Span: 21 - 33 Years
              </span>
            </div>
            <textarea
              id="edit_summary"
              name="summary"
              rows="3"
              placeholder="Official cadre responsibilities, statutory duties, departmental authority..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all shadow-sm leading-relaxed"
            ></textarea>
          </div>

          <!-- Studio Action Footer -->
          <div class="pt-4 border-t border-indigo-100/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5">
              <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Saving immediately cascades updates to candidate eligibility calculators and notifications.</span>
            </div>

            <div class="flex items-center gap-3 self-end sm:self-auto">
              <button
                type="button"
                onclick="closeInlineEdit()"
                class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-sm cursor-pointer"
              >
                Discard Changes
              </button>
              <button
                type="submit"
                class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/25 hover:shadow-indigo-600/35 transition-all cursor-pointer flex items-center gap-2"
              >
                <span>Save Master Changes</span>
                <span>&rarr;</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <AdminDataTable tableId="postsTable" perPage={15} columns={[{ select: 5, sortable: false }]} />
</AdminLayout>

<script is:inline>
  let currentEditingPostId = null;

  function toggleCreateStudio(forceState) {
    const studio = document.getElementById('createPostStudio');
    const btnText = document.getElementById('createBtnText');
    const btnIcon = document.getElementById('createBtnIcon');
    const btn = document.getElementById('toggleCreateStudioBtn');

    const shouldOpen = forceState !== undefined ? forceState : studio.classList.contains('hidden');

    if (shouldOpen) {
      studio.classList.remove('hidden');
      btnText.textContent = 'Close Creation Studio';
      btnIcon.textContent = '✕';
      btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
      btn.classList.add('bg-slate-700', 'hover:bg-slate-800');
      updateCreateAgeWindowBadge();
      studio.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      studio.classList.add('hidden');
      btnText.textContent = 'Add Canonical Post';
      btnIcon.textContent = '+';
      btn.classList.remove('bg-slate-700', 'hover:bg-slate-800');
      btn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
    }
  }

  function filterCreateDepartments() {
    const sectorSelect = document.getElementById('create_sectorId');
    const deptSelect = document.getElementById('create_departmentId');
    if (!sectorSelect || !deptSelect) return;
    const selectedSectorId = sectorSelect.value;
    let firstMatch = null;
    Array.from(deptSelect.options).forEach((opt) => {
      const optSectorId = opt.getAttribute('data-sector-id');
      const match = !selectedSectorId || !optSectorId || optSectorId === selectedSectorId;
      opt.hidden = !match;
      if (match && !firstMatch) firstMatch = opt.value;
    });
    if (firstMatch && deptSelect.selectedOptions[0]?.hidden) {
      deptSelect.value = firstMatch;
    }
  }

  function filterEditDepartments(targetDeptId) {
    const sectorSelect = document.getElementById('edit_sectorId');
    const deptSelect = document.getElementById('edit_departmentId');
    if (!sectorSelect || !deptSelect) return;
    const selectedSectorId = sectorSelect.value;
    let firstMatch = null;
    Array.from(deptSelect.options).forEach((opt) => {
      const optSectorId = opt.getAttribute('data-sector-id');
      const match = !selectedSectorId || !optSectorId || optSectorId === selectedSectorId;
      opt.hidden = !match;
      if (match && !firstMatch) firstMatch = opt.value;
    });
    if (targetDeptId) {
      deptSelect.value = targetDeptId;
    } else if (firstMatch && deptSelect.selectedOptions[0]?.hidden) {
      deptSelect.value = firstMatch;
    }
  }

  function onSectorFilterChange() {
    const sectorVal = document.getElementById('sectorFilter')?.value || 'ALL';
    const deptFilter = document.getElementById('deptFilter');
    if (deptFilter) {
      Array.from(deptFilter.options).forEach((opt) => {
        if (opt.value === 'ALL') {
          opt.hidden = false;
          return;
        }
        const optSector = opt.getAttribute('data-sector-id');
        const match = sectorVal === 'ALL' || !optSector || optSector === sectorVal;
        opt.hidden = !match;
      });
      if (deptFilter.selectedOptions[0]?.hidden) {
        deptFilter.value = 'ALL';
      }
    }
    filterPosts();
  }

  function updateCreateAgeWindowBadge() {
    const minVal = parseInt(document.getElementById('create_minAge')?.value || '18', 10);
    const maxVal = parseInt(document.getElementById('create_maxAge')?.value || '33', 10);
    const badge = document.getElementById('createAgeSpanBadge');
    if (badge) {
      const span = maxVal >= minVal ? `${maxVal - minVal}-Year Window` : 'Invalid Age Bounds';
      badge.textContent = `Eligibility Span: ${minVal} - ${maxVal} Years (${span})`;
    }
  }

  function updateAgeWindowBadge() {
    const minVal = parseInt(document.getElementById('edit_defaultMinAge')?.value || '18', 10);
    const maxVal = parseInt(document.getElementById('edit_defaultMaxAge')?.value || '33', 10);
    const badge = document.getElementById('liveAgeSpanBadge');
    if (badge) {
      const span = maxVal >= minVal ? `${maxVal - minVal}-Year Window` : 'Invalid Range';
      badge.textContent = `Eligibility Span: ${minVal} - ${maxVal} Years (${span})`;
    }
  }

  function toggleInlineEdit(post) {
    const targetRow = document.getElementById(`post-row-${post.id}`);
    const workbenchRow = document.getElementById('inlineEditWorkbenchRow');
    if (!targetRow || !workbenchRow) return;

    // If already editing this post, toggle it closed
    if (currentEditingPostId === post.id && !workbenchRow.classList.contains('hidden')) {
      closeInlineEdit();
      return;
    }

    // Reset previous row if any was open
    if (currentEditingPostId && currentEditingPostId !== post.id) {
      resetRowStyles(currentEditingPostId);
    }

    // Populate the form fields with post data
    document.getElementById('edit_id').value = post.id;
    document.getElementById('edit_title').value = post.title;
    document.getElementById('edit_payScale').value = post.payScale || '';

    // Dynamically set sector and filter departments
    const editSector = document.getElementById('edit_sectorId');
    if (editSector && post.sectorId) {
      editSector.value = post.sectorId;
      filterEditDepartments(post.departmentId);
    } else {
      filterEditDepartments(post.departmentId);
    }

    document.getElementById('edit_defaultQualification').value = post.defaultQualification || '10TH';
    document.getElementById('edit_defaultMinAge').value = post.defaultMinAge || 18;
    document.getElementById('edit_defaultMaxAge').value = post.defaultMaxAge || 33;
    document.getElementById('edit_summary').value = post.summary || '';

    // Update studio badges
    const idBadge = document.getElementById('studioPostIdBadge');
    if (idBadge) idBadge.textContent = `${post.id} • ${post.slug}`;

    const sectorBadge = document.getElementById('studioSectorDeptBadge');
    if (sectorBadge) {
      sectorBadge.textContent = `${post.sectorName || 'State Government'} • ${post.departmentName || 'Department'}`;
    }

    updateAgeWindowBadge();

    // Reveal workbench
    workbenchRow.classList.remove('hidden');

    // Highlight target row
    targetRow.classList.add('bg-indigo-50/80', 'border-l-4', 'border-indigo-600', 'font-medium');
    const actionBtn = document.getElementById(`btn-edit-${post.id}`);
    if (actionBtn) {
      actionBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
      actionBtn.classList.add('border-indigo-600', 'bg-indigo-600', 'text-white');
      const textSpan = actionBtn.querySelector('.btn-text');
      const arrowSpan = actionBtn.querySelector('.btn-arrow');
      if (textSpan) textSpan.textContent = 'Editing';
      if (arrowSpan) {
        arrowSpan.textContent = '✕';
        arrowSpan.classList.remove('text-slate-400');
        arrowSpan.classList.add('text-white');
      }
    }

    currentEditingPostId = post.id;

    // Smoothly scroll target row into view
    targetRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function closeInlineEdit() {
    const workbenchRow = document.getElementById('inlineEditWorkbenchRow');
    if (workbenchRow) {
      workbenchRow.classList.add('hidden');
    }
    if (currentEditingPostId) {
      resetRowStyles(currentEditingPostId);
      currentEditingPostId = null;
    }
  }

  function resetRowStyles(postId) {
    const row = document.getElementById(`post-row-${postId}`);
    if (row) {
      row.classList.remove('bg-indigo-50/80', 'border-l-4', 'border-indigo-600', 'font-medium');
    }
    const btn = document.getElementById(`btn-edit-${postId}`);
    if (btn) {
      btn.classList.remove('border-indigo-600', 'bg-indigo-600', 'text-white');
      btn.classList.add('border-slate-300', 'bg-white', 'text-slate-700');
      const textSpan = btn.querySelector('.btn-text');
      const arrowSpan = btn.querySelector('.btn-arrow');
      if (textSpan) textSpan.textContent = 'Edit Master';
      if (arrowSpan) {
        arrowSpan.textContent = '→';
        arrowSpan.classList.remove('text-white');
        arrowSpan.classList.add('text-slate-400');
      }
    }
  }

  function filterPosts() {
    const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
    const sectorVal = document.getElementById('sectorFilter')?.value || 'ALL';
    const deptVal = document.getElementById('deptFilter')?.value || 'ALL';
    const rows = document.querySelectorAll('.post-row');
    let visibleCount = 0;

    rows.forEach((row) => {
      const rowSector = row.getAttribute('data-sector-id');
      const rowDept = row.getAttribute('data-dept-id');
      const title = row.getAttribute('data-title') || '';
      const payScale = row.getAttribute('data-payscale') || '';
      const deptName = row.getAttribute('data-dept') || '';

      const matchesSector = sectorVal === 'ALL' || rowSector === sectorVal;
      const matchesDept = deptVal === 'ALL' || rowDept === deptVal;
      const matchesSearch =
        !searchVal ||
        title.includes(searchVal) ||
        payScale.includes(searchVal) ||
        deptName.includes(searchVal);

      if (matchesSector && matchesDept && matchesSearch) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
        if (currentEditingPostId && row.getAttribute('data-post-id') === currentEditingPostId) {
          const workbenchRow = document.getElementById('inlineEditWorkbenchRow');
          if (workbenchRow) workbenchRow.classList.add('hidden');
        }
      }
    });

    const badge = document.getElementById('postCountBadge');
    if (badge) {
      badge.textContent = `Showing ${visibleCount} of ${rows.length} Posts`;
    }
  }

  // Initialize dynamic dropdown linking on page ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      filterCreateDepartments();
    });
  } else {
    filterCreateDepartments();
  }
</script>
