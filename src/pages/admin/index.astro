---
// src/pages/admin/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import { getAllActiveRecruitments, getAllCanonicalPosts, getAllSectors, getAdminKPIs } from '../../db/queries';

// Step 4: Diagnostic logging
console.log("[Admin Layout] admin layout rendered");

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'aarav@nirnay.in';

let recruitments: any[] = [];
let posts: any[] = [];
let sectors: any[] = [];
let kpis: any = null;

try {
  [recruitments, posts, sectors, kpis] = await Promise.all([
    getAllActiveRecruitments(undefined, { includeUnpublished: true }),
    getAllCanonicalPosts(),
    getAllSectors(),
    getAdminKPIs(),
  ]);
} catch (err) {
  console.error("[Admin D1 Query Error]:", err);
}

// Fallback KPIs if getAdminKPIs failed
if (!kpis) {
  const totalVacancies = recruitments.reduce((sum: number, r: any) => sum + (r.totalVacancies || 0), 0);
  kpis = {
    published: recruitments.filter((r: any) => r.status === 'PUBLISHED').length,
    drafts: recruitments.filter((r: any) => r.status === 'DRAFT').length,
    pendingVerification: recruitments.filter((r: any) => r.status === 'PENDING_VERIFICATION').length,
    expiringIn7Days: 0,
    needsReview: 0,
    sourceExpired: 0,
    dataConflicts: 0,
    totalVacancies,
    recentAuditLogs: [],
    conflictsList: [],
  };
}

const today = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="NIRNAY OPS — Administration Dashboard">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="dashboard" />

    <!-- Main Operations Canvas -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1 text-xs text-muted-foreground">
            <span>Operations Console</span>
            <span>·</span>
            <span>{today}</span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">
            Dashboard
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/admin/masters"
            class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors"
          >
            Master Records
          </a>
          <a
            href="/admin/recruitments/new"
            class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>Add recruitment</span>
          </a>
        </div>
      </div>

      <!-- 8 Live Operational KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="p-5 rounded-2xl bg-card border border-emerald-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Published</span>
          <span class="text-3xl font-black text-emerald-600 font-mono">{kpis.published}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Live on public portal</span>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-amber-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Pending Verification</span>
          <span class="text-3xl font-black text-amber-600 font-mono">{kpis.pendingVerification}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Awaiting source check</span>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Drafts</span>
          <span class="text-3xl font-black text-slate-500 font-mono">{kpis.drafts}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Not yet submitted</span>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-rose-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Expiring in 7 Days</span>
          <span class="text-3xl font-black text-rose-600 font-mono">{kpis.expiringIn7Days}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Application deadlines</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="p-5 rounded-2xl bg-card border border-amber-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Needs Review</span>
          <span class="text-3xl font-black text-amber-600 font-mono">{kpis.needsReview}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Conflict or flag raised</span>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-rose-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Source Expired</span>
          <span class="text-3xl font-black text-rose-600 font-mono">{kpis.sourceExpired}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Official links broken</span>
        </div>

        <div class={`p-5 rounded-2xl bg-card shadow-sm border ${kpis.dataConflicts > 0 ? 'border-red-400 bg-red-50' : 'border-border'}`}>
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Data Conflicts</span>
          <span class={`text-3xl font-black font-mono ${kpis.dataConflicts > 0 ? 'text-red-700' : 'text-foreground'}`}>{kpis.dataConflicts}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Integrity violations</span>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-indigo-200 shadow-sm">
          <span class="text-xs font-semibold text-muted-foreground block mb-1">Total Vacancies</span>
          <span class="text-3xl font-black text-indigo-600 font-mono">{kpis.totalVacancies.toLocaleString()}</span>
          <span class="text-[11px] text-muted-foreground block mt-1">Government posts in MP</span>
        </div>
      </div>

      <!-- Data Conflicts Alert -->
      {kpis.conflictsList?.length > 0 && (
        <div class="mb-6 p-5 rounded-2xl bg-red-50 border border-red-300">
          <h2 class="text-sm font-bold text-red-800 mb-3 flex items-center gap-2">
            <span>🔴</span> Data Integrity Conflicts — Immediate Action Required
          </h2>
          <div class="space-y-2">
            {kpis.conflictsList.map((c: any) => (
              <div class="flex items-start justify-between gap-3 text-xs bg-white rounded-lg p-3 border border-red-200">
                <div>
                  <span class="font-bold text-red-700 uppercase tracking-wide text-[10px]">{c.type}</span>
                  <p class="font-semibold text-foreground mt-0.5">{c.title}</p>
                  <p class="text-red-700 mt-0.5">{c.issue}</p>
                </div>
                <a href={`/admin/recruitments/${c.slug}/edit`} class="shrink-0 text-xs text-primary font-semibold hover:underline">Fix →</a>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Two Columns: Active Recruitments Feed + Quick Management Actions -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Live Recruitments Feed -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Tracked Opportunities
            </h2>
            <a href="/admin/recruitments" class="text-xs text-primary font-semibold hover:underline">
              View all ({recruitments.length}) &rarr;
            </a>
          </div>

          <div class="space-y-4 text-xs">
            {recruitments.slice(0, 4).map((rec: any) => (
              <div class="flex items-start justify-between gap-3 pb-3 border-b border-border last:border-0 last:pb-0">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                      {rec.lifecycleStatus}
                    </span>
                    <span class="text-muted-foreground font-mono">{rec.organisationShortName}</span>
                  </div>
                  <a href={`/recruitments/${rec.slug}`} class="font-bold text-foreground hover:text-primary transition-colors text-sm">
                    {rec.title}
                  </a>
                  <span class="text-[11px] text-muted-foreground block mt-0.5">
                    {rec.totalVacancies?.toLocaleString()} Vacancies · Minimum {rec.criteria?.minQualificationLevel}
                  </span>
                </div>
                <a
                  href={`/recruitments/${rec.slug}`}
                  class="shrink-0 text-xs text-primary hover:underline font-semibold"
                >
                  Preview &rarr;
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Management Workflows -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Administration Workflows
            </h2>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
              System Ready
            </span>
          </div>

          <div class="space-y-3 text-xs">
            <a
              href="/admin/recruitments/new"
              class="p-4 rounded-xl bg-muted/40 hover:bg-muted border border-border flex items-center justify-between transition-colors group block"
            >
              <div>
                <span class="font-bold text-foreground group-hover:text-primary transition-colors block text-sm">
                  + Ingest New Recruitment
                </span>
                <span class="text-[11px] text-muted-foreground">
                  Publish a new opportunity with statutory age, qualification and physical standards.
                </span>
              </div>
              <span class="text-primary font-bold text-base">&rarr;</span>
            </a>

            <a
              href="/admin/masters"
              class="p-4 rounded-xl bg-muted/40 hover:bg-muted border border-border flex items-center justify-between transition-colors group block"
            >
              <div>
                <span class="font-bold text-foreground group-hover:text-primary transition-colors block text-sm">
                  Master Records Catalog
                </span>
                <span class="text-[11px] text-muted-foreground">
                  Manage {posts.length} canonical posts, pay matrices, and default eligibility profiles.
                </span>
              </div>
              <span class="text-primary font-bold text-base">&rarr;</span>
            </a>

            <a
              href="/jobs"
              target="_blank"
              class="p-4 rounded-xl bg-muted/40 hover:bg-muted border border-border flex items-center justify-between transition-colors group block"
            >
              <div>
                <span class="font-bold text-foreground group-hover:text-primary transition-colors block text-sm">
                  Public Discovery Portal
                </span>
                <span class="text-[11px] text-muted-foreground">
                  View how opportunities, filters, and eligibility calculators appear to citizens.
                </span>
              </div>
              <span class="text-primary font-bold text-base">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Recent Audit Trail -->
      {kpis.recentAuditLogs?.length > 0 && (
        <div class="mt-6 bg-card rounded-2xl border border-border p-6 shadow-sm">
          <h2 class="text-sm font-bold text-foreground uppercase tracking-wider pb-4 border-b border-border mb-4">
            Recent Audit Trail
          </h2>
          <div class="space-y-2 text-xs">
            {kpis.recentAuditLogs.map((log: any) => (
              <div class="flex items-center justify-between gap-3 py-2 border-b border-border/50 last:border-0">
                <div class="flex items-center gap-2">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-slate-100 text-slate-600">{log.action}</span>
                  <span class="font-medium text-foreground">{log.entity} · {log.entityId}</span>
                  {log.field && <span class="text-muted-foreground">· {log.field}: <span class="line-through text-rose-500">{log.oldValue}</span> → <span class="text-emerald-600">{log.newValue}</span></span>}
                </div>
                <div class="shrink-0 text-muted-foreground text-right">
                  <span class="block">{log.adminEmail}</span>
                  <span class="block text-[10px]">{new Date(log.createdAt).toLocaleString('en-IN')}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </main>
  </div>
</BaseLayout>
