---
// src/pages/admin/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllActiveRecruitments, getAllCanonicalPosts, getAllSectors } from '../../db/queries';

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'aarav@nirnay.in';
const recruitments = await getAllActiveRecruitments();
const posts = await getAllCanonicalPosts();
const sectors = await getAllSectors();

const totalVacancies = recruitments.reduce((sum: number, r: any) => sum + (r.totalVacancies || 0), 0);
---

<BaseLayout title="NIRNAY OPS — Administration Dashboard">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <!-- Admin Sidebar Navigation (Flowstep Screen 20 & 21 Shell) -->
    <aside class="w-64 bg-sidebar border-r border-border shrink-0 hidden md:flex flex-col justify-between p-4">
      <div class="space-y-6">
        <div class="px-3 py-2 border-b border-border">
          <div class="font-bold text-xs uppercase tracking-widest text-primary">NIRNAY OPS</div>
          <div class="text-[11px] text-muted-foreground">Private Operations Shell</div>
        </div>

        <nav class="space-y-1 text-xs font-medium" aria-label="Admin Navigation">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-primary text-primary-foreground font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/recruitments" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Recruitments</span>
          </a>
          <a href="/admin/organisations" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
            <span>Organisations</span>
          </a>
          <a href="/admin/departments" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="6" height="6" x="9" y="2" rx="1"/><rect width="6" height="6" x="2" y="16" rx="1"/><rect width="6" height="6" x="16" y="16" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
            <span>Departments</span>
          </a>
          <a href="/admin/taxonomy" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            <span>Sectors & posts</span>
          </a>
          <a href="/admin/rules" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Eligibility rules</span>
          </a>
          <a href="/admin/sources/verify" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>Sources</span>
          </a>
          <a href="/admin/documents" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            <span>Documents</span>
          </a>
          <a href="/admin/seo" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m9 11 2 2 4-4"/></svg>
            <span>SEO</span>
          </a>
          <a href="/admin/audit-log" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span>Audit log</span>
          </a>
          <a href="/admin/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Team Access</span>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-border flex items-center gap-3 px-3">
        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
          AM
        </div>
        <div class="truncate">
          <div class="text-xs font-semibold text-foreground truncate">Aarav Mehta</div>
          <div class="text-[10px] text-muted-foreground truncate">{adminEmail}</div>
        </div>
      </div>
    </aside>

    <!-- Main Operations Canvas -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1 text-xs text-muted-foreground">
            <span>Operations Console</span>
            <span>·</span>
            <span>21 September 2026</span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">
            Dashboard
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/admin/masters"
            class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors"
          >
            Master Records
          </a>
          <a
            href="/admin/recruitments/new"
            class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>Add recruitment</span>
          </a>
        </div>
      </div>

      <!-- 6 Metrics Cards (Flowstep Screen 20) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Total Active</span>
          <span class="text-2xl font-bold text-foreground font-mono">{recruitments.length}</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Drives tracked</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Open Apps</span>
          <span class="text-2xl font-bold text-emerald-600 font-mono">42</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Accepting form</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Closing Today</span>
          <span class="text-2xl font-bold text-amber-600 font-mono">3</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Urgent cutoff</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Verification</span>
          <span class="text-2xl font-bold text-indigo-600 font-mono">12</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Needs review</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Draft Records</span>
          <span class="text-2xl font-bold text-slate-500 font-mono">8</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Unpublished</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Expired</span>
          <span class="text-2xl font-bold text-red-500 font-mono">2</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Cycle closed</span>
        </div>
      </div>

      <!-- Two Columns: Recent Activity + Data Quality -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Activity List -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Recent Activity
            </h2>
            <span class="text-xs text-muted-foreground">Today</span>
          </div>

          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3 pb-3 border-b border-border">
              <span class="size-2 rounded-full bg-blue-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">MP Police Constable updated</span>
                <p class="text-muted-foreground mt-0.5">Application deadline corrected to 06 Oct 2026 by Aarav Mehta</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">18:32 PM</span>
              </div>
            </div>

            <div class="flex items-start gap-3 pb-3 border-b border-border">
              <span class="size-2 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">Forest Guard published</span>
                <p class="text-muted-foreground mt-0.5">Recruitment moved from Review to Published status</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">11:20 AM</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="size-2 rounded-full bg-indigo-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">Assistant Grade III source verified</span>
                <p class="text-muted-foreground mt-0.5">Official High Court gazette verified against D1 rulebook</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">09:45 AM</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Data Quality Checklist -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Data Quality & Verification
            </h2>
            <span class="text-xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
              Needs Attention
            </span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">12 records need verification</span>
                <span class="text-[11px] text-muted-foreground">Extracted claims pending manual cross-check</span>
              </div>
              <a href="/admin/sources/verify" class="text-primary font-semibold hover:underline">Review &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">3 missing official links</span>
                <span class="text-[11px] text-muted-foreground">Notification URLs require canonical resolution</span>
              </div>
              <a href="/admin/documents" class="text-primary font-semibold hover:underline">Fix &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">4 missing eligibility rules</span>
                <span class="text-[11px] text-muted-foreground">Physical standards or CPCT status incomplete</span>
              </div>
              <a href="/admin/rules" class="text-primary font-semibold hover:underline">Builder &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">2 expired recruitments</span>
                <span class="text-[11px] text-muted-foreground">Archive or move to completed stage</span>
              </div>
              <a href="/admin/recruitments" class="text-primary font-semibold hover:underline">Archive &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
