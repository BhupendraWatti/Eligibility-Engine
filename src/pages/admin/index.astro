---
// src/pages/admin/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import { getAllActiveRecruitments, getAllCanonicalPosts, getAllSectors } from '../../db/queries';

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'aarav@nirnay.in';
const recruitments = await getAllActiveRecruitments();
const posts = await getAllCanonicalPosts();
const sectors = await getAllSectors();

const totalVacancies = recruitments.reduce((sum: number, r: any) => sum + (r.totalVacancies || 0), 0);
---

<BaseLayout title="NIRNAY OPS — Administration Dashboard">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="dashboard" />

    <!-- Main Operations Canvas -->
    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1 text-xs text-muted-foreground">
            <span>Operations Console</span>
            <span>·</span>
            <span>21 September 2026</span>
          </div>
          <h1 class="text-2xl font-bold text-foreground">
            Dashboard
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/admin/masters"
            class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold transition-colors"
          >
            Master Records
          </a>
          <a
            href="/admin/recruitments/new"
            class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>Add recruitment</span>
          </a>
        </div>
      </div>

      <!-- 6 Metrics Cards (Flowstep Screen 20) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Total Active</span>
          <span class="text-2xl font-bold text-foreground font-mono">{recruitments.length}</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Drives tracked</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Open Apps</span>
          <span class="text-2xl font-bold text-emerald-600 font-mono">42</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Accepting form</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Closing Today</span>
          <span class="text-2xl font-bold text-amber-600 font-mono">3</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Urgent cutoff</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Verification</span>
          <span class="text-2xl font-bold text-indigo-600 font-mono">12</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Needs review</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Draft Records</span>
          <span class="text-2xl font-bold text-slate-500 font-mono">8</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Unpublished</span>
        </div>

        <div class="p-4 rounded-xl bg-card border border-border">
          <span class="text-[11px] font-semibold text-muted-foreground block mb-1">Expired</span>
          <span class="text-2xl font-bold text-red-500 font-mono">2</span>
          <span class="text-[10px] text-muted-foreground block mt-1">Cycle closed</span>
        </div>
      </div>

      <!-- Two Columns: Recent Activity + Data Quality -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Activity List -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Recent Activity
            </h2>
            <span class="text-xs text-muted-foreground">Today</span>
          </div>

          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3 pb-3 border-b border-border">
              <span class="size-2 rounded-full bg-blue-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">MP Police Constable updated</span>
                <p class="text-muted-foreground mt-0.5">Application deadline corrected to 06 Oct 2026 by Aarav Mehta</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">18:32 PM</span>
              </div>
            </div>

            <div class="flex items-start gap-3 pb-3 border-b border-border">
              <span class="size-2 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">Forest Guard published</span>
                <p class="text-muted-foreground mt-0.5">Recruitment moved from Review to Published status</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">11:20 AM</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="size-2 rounded-full bg-indigo-500 mt-1.5 shrink-0"></span>
              <div class="flex-1">
                <span class="font-bold text-foreground">Assistant Grade III source verified</span>
                <p class="text-muted-foreground mt-0.5">Official High Court gazette verified against D1 rulebook</p>
                <span class="text-[10px] text-muted-foreground font-mono mt-1 block">09:45 AM</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Data Quality Checklist -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <h2 class="text-sm font-bold text-foreground uppercase tracking-wider">
              Data Quality & Verification
            </h2>
            <span class="text-xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
              Needs Attention
            </span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">12 records need verification</span>
                <span class="text-[11px] text-muted-foreground">Extracted claims pending manual cross-check</span>
              </div>
              <a href="/admin/sources/verify" class="text-primary font-semibold hover:underline">Review &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">3 missing official links</span>
                <span class="text-[11px] text-muted-foreground">Notification URLs require canonical resolution</span>
              </div>
              <a href="/admin/documents" class="text-primary font-semibold hover:underline">Fix &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">4 missing eligibility rules</span>
                <span class="text-[11px] text-muted-foreground">Physical standards or CPCT status incomplete</span>
              </div>
              <a href="/admin/rules" class="text-primary font-semibold hover:underline">Builder &rarr;</a>
            </div>

            <div class="p-3 rounded-xl bg-muted/50 border border-border flex items-center justify-between">
              <div>
                <span class="font-bold text-foreground block">2 expired recruitments</span>
                <span class="text-[11px] text-muted-foreground">Archive or move to completed stage</span>
              </div>
              <a href="/admin/recruitments" class="text-primary font-semibold hover:underline">Archive &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
