---
// src/pages/admin/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FALLBACK_RECRUITMENTS } from '../../db/queries';

// @ts-ignore
const adminEmail = Astro.locals.adminEmail || 'admin@rozgarsetu.in';
const recruitments = FALLBACK_RECRUITMENTS;
---

<BaseLayout title="Admin Control Centre">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Admin Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-8 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Zero Trust Authenticated</span>
          <span class="text-xs font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">
            {adminEmail}
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Outfit']">
          Recruitment Ingestion & Management
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/recruitments/new"
          class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center gap-2"
        >
          <span>+ Ingest New Recruitment</span>
        </a>
      </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-8">
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Published Drives</span>
        <span class="text-2xl font-black text-slate-900 font-['Outfit']">{recruitments.length}</span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Active Vacancies</span>
        <span class="text-2xl font-black text-indigo-600 font-['Outfit']">
          {recruitments.reduce((sum, r) => sum + r.totalVacancies, 0).toLocaleString()}
        </span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Canonical Posts</span>
        <span class="text-2xl font-black text-slate-900 font-['Outfit']">6 Posts</span>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Source Audits</span>
        <span class="text-2xl font-black text-emerald-600 font-['Outfit']">100% Verified</span>
      </div>
    </div>

    <!-- Managed Recruitments Table -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 font-['Outfit']">
          Active & Draft Notifications
        </h2>
        <span class="text-xs text-slate-500">{recruitments.length} Total Records</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
            <tr>
              <th class="py-3 px-6">Advertisement</th>
              <th class="py-3 px-6">Organisation</th>
              <th class="py-3 px-6">Vacancies</th>
              <th class="py-3 px-6">Lifecycle</th>
              <th class="py-3 px-6">Workflow Status</th>
              <th class="py-3 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {recruitments.map(rec => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="py-4 px-6">
                  <div class="font-bold text-slate-900">{rec.title}</div>
                  <div class="text-slate-400 text-[11px]">{rec.advtNumber}</div>
                </td>
                <td class="py-4 px-6 font-medium text-slate-600">
                  {rec.organisationShortName}
                </td>
                <td class="py-4 px-6 font-bold text-slate-900">
                  {rec.totalVacancies.toLocaleString()}
                </td>
                <td class="py-4 px-6">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    {rec.lifecycleStatus}
                  </span>
                </td>
                <td class="py-4 px-6">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    {rec.status}
                  </span>
                </td>
                <td class="py-4 px-6 text-right space-x-2">
                  <a
                    href={`/recruitments/${rec.slug}`}
                    target="_blank"
                    class="px-3 py-1.5 rounded-lg border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition-colors"
                  >
                    View
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>
