---
// src/pages/admin/index.astro (FlowStep Screen 20)
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminKPIs } from '../../db/queries';

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'local-admin@localhost';

let kpis: any = null;
let dashboardError = '';

try {
  kpis = await getAdminKPIs();
} catch (err) {
  console.error("[Admin D1 Query Error]:", err);
  dashboardError = 'Dashboard data is unavailable. Check the D1 binding and migrations.';
}

if (!kpis) {
  kpis = {
    published: 0,
    drafts: 0,
    pendingVerification: 0,
    expiringIn7Days: 0,
    needsReview: 0,
    sourceExpired: 0,
    dataConflicts: 0,
    totalVacancies: 0,
    activeDriveCount: 0,
    recentAuditLogs: [],
    conflictsList: [],
  };
}

const totalActiveRecruitments = kpis.published + kpis.drafts + kpis.pendingVerification;
const openApplicationsCount = kpis.activeDriveCount || 0;
const closingTodayCount = kpis.expiringIn7Days;
const needsVerificationCount = kpis.pendingVerification;
const draftRecordsCount = kpis.drafts;
const expiredCount = kpis.sourceExpired;

const today = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<AdminLayout title="Dashboard" currentSection="dashboard" breadcrumbs={[{ label: 'Dashboard' }]}>
  <div class="mx-auto max-w-6xl space-y-6">
    {dashboardError && <div class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-900">{dashboardError}</div>}
    <!-- Top Action Heading -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-2">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Dashboard
        </h1>
        <p class="text-xs text-zinc-500 mt-1 font-mono">{today}</p>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/admin/sources"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200 bg-white text-xs font-semibold text-zinc-800 hover:bg-zinc-100 transition-colors shadow-2xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Verify Sources</span>
        </a>

        <a
          href="/admin/recruitments/new"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold transition-all shadow-xs active:scale-[0.98] cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Add recruitment</span>
        </a>
      </div>
    </div>

    <!-- 6 FlowStep Screen 20 Metric Cards in 3 Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- 1. Total Active Recruitments -->
      <a href="/admin/recruitments" class="block rounded-xl border border-zinc-200 bg-white p-4.5 shadow-2xs hover:border-zinc-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-500">Total active recruitments</span>
          <span class="text-[10px] font-mono text-zinc-400 group-hover:text-zinc-900 transition-colors">&rarr;</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-zinc-950 font-mono tabular-nums">{totalActiveRecruitments}</span>
          <span class="text-[11px] text-zinc-500">records</span>
        </div>
      </a>

      <!-- 2. Open Applications -->
      <a href="/admin/recruitments?status=OPEN" class="block rounded-xl border border-zinc-200 bg-white p-4.5 shadow-2xs hover:border-zinc-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-500">Open applications</span>
          <span class="size-2 rounded-full bg-emerald-500"></span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-zinc-950 font-mono tabular-nums">{openApplicationsCount}</span>
          <span class="text-[11px] text-emerald-700 font-medium">accepting submissions</span>
        </div>
      </a>

      <!-- 3. Closing Today -->
      <a href="/admin/recruitments?status=CLOSING_SOON" class="block rounded-xl border border-amber-200/80 bg-amber-50/20 p-4.5 shadow-2xs hover:border-amber-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-600">Closing today</span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200">
            Urgent
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-amber-700 font-mono tabular-nums">{closingTodayCount}</span>
          <span class="text-[11px] text-zinc-500">deadlines imminent</span>
        </div>
      </a>

      <!-- 4. Needs Verification -->
      <a href="/admin/sources" class="block rounded-xl border border-amber-200/80 bg-amber-50/20 p-4.5 shadow-2xs hover:border-amber-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-600">Needs verification</span>
          <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-amber-700 font-mono tabular-nums">{needsVerificationCount}</span>
          <span class="text-[11px] text-amber-700 font-medium">source check needed</span>
        </div>
      </a>

      <!-- 5. Draft Records -->
      <a href="/admin/recruitments?status=DRAFT" class="block rounded-xl border border-zinc-200 bg-white p-4.5 shadow-2xs hover:border-zinc-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-500">Draft records</span>
          <span class="text-[10px] font-mono text-zinc-400">unpublished</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-zinc-950 font-mono tabular-nums">{draftRecordsCount}</span>
          <span class="text-[11px] text-zinc-500">in preparation</span>
        </div>
      </a>

      <!-- 6. Expired Recruitments -->
      <a href="/admin/recruitments?status=ARCHIVED" class="block rounded-xl border border-rose-200/80 bg-rose-50/20 p-4.5 shadow-2xs hover:border-rose-300 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-600">Expired recruitments</span>
          <span class="size-2 rounded-full bg-rose-500"></span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-rose-700 font-mono tabular-nums">{expiredCount}</span>
          <span class="text-[11px] text-rose-700 font-medium">needs archiving</span>
        </div>
      </a>
    </div>

    <!-- Bottom Two Columns: Recent Activity & Data Quality (FlowStep Screen 20) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Recent Activity Card -->
      <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-3">
          <div>
            <h2 class="text-sm font-bold text-zinc-950">Recent activity</h2>
            <p class="text-[11px] text-zinc-500">Latest updates across recruitment records</p>
          </div>
          <a href="/admin/audit-log" class="text-[11px] font-semibold text-zinc-950 hover:underline">
            View audit log &rarr;
          </a>
        </div>

        <div class="divide-y divide-zinc-100 text-xs">
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <span class="size-1.5 rounded-full bg-zinc-900"></span>
              <span class="font-medium text-zinc-900">MP Police Constable updated</span>
            </div>
            <span class="text-[11px] text-zinc-400 font-mono">Today</span>
          </div>

          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-zinc-900">Forest Guard published</span>
            </div>
            <span class="text-[11px] text-zinc-400 font-mono">Today</span>
          </div>

          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <span class="size-1.5 rounded-full bg-amber-500"></span>
              <span class="font-medium text-zinc-900">Assistant Grade III source verified</span>
            </div>
            <span class="text-[11px] text-zinc-400 font-mono">Yesterday</span>
          </div>

          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <span class="size-1.5 rounded-full bg-zinc-400"></span>
              <span class="font-medium text-zinc-900">Sub Inspector qualification rule added</span>
            </div>
            <span class="text-[11px] text-zinc-400 font-mono">2 days ago</span>
          </div>
        </div>
      </div>

      <!-- Data Quality Operational Card -->
      <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-3">
          <div>
            <h2 class="text-sm font-bold text-zinc-950">Data quality</h2>
            <p class="text-[11px] text-zinc-500">Records that need operational attention</p>
          </div>
          <span class="inline-flex items-center gap-1 rounded bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 text-[10px] font-bold uppercase">
            Operational alerts
          </span>
        </div>

        <div class="divide-y divide-zinc-100 text-xs">
          <!-- Item 1: Needs Verification -->
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="text-zinc-800 font-medium">12 records need verification</span>
            </div>
            <a href="/admin/sources" class="font-semibold text-zinc-950 hover:underline text-xs">
              Review &rarr;
            </a>
          </div>

          <!-- Item 2: Missing Official Links -->
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
              <span class="text-zinc-800 font-medium">3 missing official links</span>
            </div>
            <a href="/admin/sources" class="font-semibold text-zinc-950 hover:underline text-xs">
              Resolve &rarr;
            </a>
          </div>

          <!-- Item 3: Missing Eligibility Rules -->
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
              <span class="text-zinc-800 font-medium">4 missing eligibility rules</span>
            </div>
            <a href="/admin/eligibility-rules" class="font-semibold text-zinc-950 hover:underline text-xs">
              Review &rarr;
            </a>
          </div>

          <!-- Item 4: Expired Recruitments -->
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="text-zinc-800 font-medium">2 expired recruitments</span>
            </div>
            <a href="/admin/recruitments?status=ARCHIVED" class="font-semibold text-zinc-950 hover:underline text-xs">
              Review &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
