  <!-- Client-side Interactive Filter Script for Tabs -->
  <script>
    function setupDashboardTabs() {
      const tabs = document.querySelectorAll<HTMLButtonElement>('.dashboard-tab');
      const metricsContainer = document.getElementById('tab-content-metrics');
      const detailsContainer = document.getElementById('tab-content-details');
      const metricCards = document.querySelectorAll<HTMLElement>('.metric-card');

      if (!tabs.length || !metricsContainer || !detailsContainer) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const tabId = tab.getAttribute('data-tab');

          // Update active button state
          tabs.forEach((t) => {
            t.classList.remove('active-tab', 'text-zinc-900', 'bg-white', 'shadow-2xs');
            t.classList.add('text-zinc-600');
          });
          tab.classList.add('active-tab', 'text-zinc-900', 'bg-white', 'shadow-2xs');
          tab.classList.remove('text-zinc-600');

          if (tabId === 'all') {
            metricsContainer.style.display = 'block';
            detailsContainer.style.display = 'grid';
            metricCards.forEach((card) => {
              card.style.display = 'block';
            });
          } else if (tabId === 'urgent') {
            metricsContainer.style.display = 'block';
            detailsContainer.style.display = 'grid';
            metricCards.forEach((card) => {
              if (card.getAttribute('data-category') === 'urgent') {
                card.style.display = 'block';
              } else {
                card.style.display = 'none';
              }
            });
          } else if (tabId === 'activity') {
            metricsContainer.style.display = 'none';
            detailsContainer.style.display = 'grid';
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDashboardTabs);
    } else {
      setupDashboardTabs();
    }
    document.addEventListener('astro:page-load', setupDashboardTabs);
  </script>
</AdminLayout>
