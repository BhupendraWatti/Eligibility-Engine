---
// src/pages/admin/index.astro (FlowStep Screen 20 - Mobile-Responsive Ops Dashboard)
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminKPIs } from '../../db/queries';

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'Unknown';

let kpis: any = null;
let dashboardError = '';

try {
  kpis = await getAdminKPIs();
} catch (err) {
  console.error("[Admin D1 Query Error]:", err);
  dashboardError = 'Dashboard data is temporarily unavailable. Check database connection or run migrations.';
}

if (!kpis) {
  kpis = {
    published: 0,
    drafts: 0,
    pendingVerification: 0,
    expiringIn7Days: 0,
    needsReview: 0,
    sourceExpired: 0,
    dataConflicts: 0,
    totalVacancies: 0,
    activeDriveCount: 0,
    recentAuditLogs: [],
    conflictsList: [],
  };
}

const totalActiveRecruitments = kpis.published + kpis.drafts + kpis.pendingVerification;
const openApplicationsCount = kpis.activeDriveCount || 0;
const closingTodayCount = kpis.expiringIn7Days || 0;
const needsVerificationCount = kpis.pendingVerification || 0;
const draftRecordsCount = kpis.drafts || 0;
const expiredCount = kpis.sourceExpired || 0;
const totalVacancies = kpis.totalVacancies || 0;

const totalActionItems = closingTodayCount + needsVerificationCount + expiredCount;

const today = new Date().toLocaleDateString('en-IN', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});
---

<AdminLayout title="Dashboard" currentSection="dashboard" breadcrumbs={[{ label: 'Dashboard' }]}>
  <div class="mx-auto max-w-6xl space-y-4 sm:space-y-6">
    {dashboardError && (
      <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-900 flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{dashboardError}</span>
      </div>
    )}

    <!-- Top Command Heading -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-1 border-b border-zinc-200/80">
      <div class="space-y-1">
        <div class="flex items-center gap-2.5 flex-wrap">
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 font-heading">
            Operational Command
          </h1>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100/80 text-emerald-800 border border-emerald-200 font-mono">
            <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            LIVE
          </span>
        </div>
        <div class="flex items-center gap-2 text-xs text-zinc-500 flex-wrap">
          <span class="font-mono text-[11px] text-zinc-600">{today}</span>
          <span class="text-zinc-300">•</span>
          <span class="text-[11px] text-zinc-600 font-medium">
            {totalVacancies > 0 ? `${totalVacancies.toLocaleString('en-IN')} Vacancies Tracked` : 'India Recruitment Engine'}
          </span>
        </div>
      </div>

      <!-- Quick Action Buttons (Optimized for Mobile Touch) -->
      <div class="flex items-center gap-2 pt-1 sm:pt-0">
        <a
          href="/admin/sources"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:py-1.5 rounded-lg border border-zinc-200 bg-white text-xs font-semibold text-zinc-800 hover:bg-zinc-100 hover:text-zinc-950 transition-colors shadow-2xs active:scale-[0.98]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Verify Sources</span>
        </a>

        <a
          href="/admin/recruitments/new"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:py-1.5 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold transition-all shadow-xs active:scale-[0.98]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>+ Add Drive</span>
        </a>
      </div>
    </div>

    <!-- Urgent Action Alert Banner (Visible when items need operational resolution) -->
    {totalActionItems > 0 && (
      <div class="rounded-xl border border-blue-200/90 bg-blue-50/50 p-3.5 sm:p-4 shadow-2xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-start sm:items-center gap-3">
            <div class="size-8 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 mt-0.5 sm:mt-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-blue-950">
                Operational Attention Required ({totalActionItems} items)
              </div>
              <p class="text-[11px] text-blue-800/90 mt-0.5">
                {needsVerificationCount > 0 && `${needsVerificationCount} unverified source records`}
                {needsVerificationCount > 0 && closingTodayCount > 0 && ' • '}
                {closingTodayCount > 0 && `${closingTodayCount} drives closing within 7 days`}
                {expiredCount > 0 && ` • ${expiredCount} expired recruitments`}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            {needsVerificationCount > 0 && (
              <a
                href="/admin/sources"
                class="px-2.5 py-1 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-semibold transition-colors shadow-2xs"
              >
                Review Sources &rarr;
              </a>
            )}
            {closingTodayCount > 0 && (
              <a
                href="/admin/recruitments?status=CLOSING_SOON"
                class="px-2.5 py-1 rounded-md bg-white border border-blue-300 text-blue-900 hover:bg-blue-100/50 text-[11px] font-semibold transition-colors shadow-2xs"
              >
                View Closing &rarr;
              </a>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- Mobile Segmented View Switcher (Client-side interactive Tabs) -->
    <div class="flex items-center gap-1.5 p-1 bg-zinc-200/60 rounded-xl max-w-fit text-xs font-semibold">
      <button
        type="button"
        data-tab="all"
        class="dashboard-tab active-tab px-3 py-1.5 rounded-lg text-zinc-900 bg-white shadow-2xs cursor-pointer transition-all"
      >
        All Metrics
      </button>
      <button
        type="button"
        data-tab="urgent"
        class="dashboard-tab px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-950 cursor-pointer transition-all flex items-center gap-1.5"
      >
        <span>Action Needed</span>
        {totalActionItems > 0 && (
          <span class="inline-flex items-center justify-center size-4 rounded-full bg-blue-500 text-white text-[9px] font-bold">
            {totalActionItems}
          </span>
        )}
      </button>
      <button
        type="button"
        data-tab="activity"
        class="dashboard-tab px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-950 cursor-pointer transition-all"
      >
        Activity & Logs
      </button>
    </div>

    <!-- SECTION 1: Responsive KPI Cards (2 Columns on Mobile, 3 Columns on Desktop) -->
    <div id="tab-content-metrics" class="space-y-4">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
        <!-- 1. Total Active Recruitments -->
        <a
          href="/admin/recruitments"
          class="metric-card block rounded-xl border border-zinc-200 bg-white p-3.5 sm:p-4.5 shadow-2xs hover:border-zinc-400/80 transition-all hover:shadow-xs group"
          data-category="general"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-500 truncate">Active records</span>
            <span class="text-[10px] font-mono text-zinc-400 group-hover:text-zinc-950 transition-colors">&rarr;</span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 font-mono tabular-nums">
              {totalActiveRecruitments}
            </span>
            <span class="text-[10px] sm:text-[11px] text-zinc-400 font-medium">drives</span>
          </div>
          <div class="mt-2 pt-2 border-t border-zinc-100 flex items-center justify-between text-[10px] text-zinc-500">
            <span>Published + review</span>
            <span class="font-mono text-zinc-700 font-bold">{kpis.published} Live</span>
          </div>
        </a>

        <!-- 2. Open Applications -->
        <a
          href="/admin/recruitments?status=OPEN"
          class="metric-card block rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3.5 sm:p-4.5 shadow-2xs hover:border-emerald-300 transition-all hover:shadow-xs group"
          data-category="general"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-600 truncate">Open for apply</span>
            <span class="size-2 rounded-full bg-emerald-500 ring-2 ring-emerald-200"></span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-emerald-950 font-mono tabular-nums">
              {openApplicationsCount}
            </span>
            <span class="text-[10px] sm:text-[11px] text-emerald-700 font-medium">accepting</span>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-100/60 flex items-center justify-between text-[10px] text-emerald-700">
            <span>Active submission</span>
            <span class="font-mono font-bold">Live window</span>
          </div>
        </a>

        <!-- 3. Closing Today / In 7 Days -->
        <a
          href="/admin/recruitments?status=CLOSING_SOON"
          class="metric-card block rounded-xl border border-blue-200/90 bg-blue-50/30 p-3.5 sm:p-4.5 shadow-2xs hover:border-blue-300 transition-all hover:shadow-xs group"
          data-category="urgent"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-700 truncate">Closing soon</span>
            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-bold uppercase tracking-wider bg-blue-200/80 text-blue-900">
              Urgent
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-blue-700 font-mono tabular-nums">
              {closingTodayCount}
            </span>
            <span class="text-[10px] sm:text-[11px] text-blue-800 font-medium">deadlines</span>
          </div>
          <div class="mt-2 pt-2 border-t border-blue-100 flex items-center justify-between text-[10px] text-blue-800">
            <span>Next 7 days</span>
            <span class="font-mono font-bold">&le; 168h</span>
          </div>
        </a>

        <!-- 4. Needs Verification -->
        <a
          href="/admin/sources"
          class="metric-card block rounded-xl border border-blue-200/90 bg-blue-50/30 p-3.5 sm:p-4.5 shadow-2xs hover:border-blue-300 transition-all hover:shadow-xs group"
          data-category="urgent"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-700 truncate">Needs verify</span>
            <span class="size-2 rounded-full bg-blue-500 animate-pulse ring-2 ring-blue-200"></span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-blue-700 font-mono tabular-nums">
              {needsVerificationCount}
            </span>
            <span class="text-[10px] sm:text-[11px] text-blue-800 font-medium">pending</span>
          </div>
          <div class="mt-2 pt-2 border-t border-blue-100 flex items-center justify-between text-[10px] text-blue-800">
            <span>Official source check</span>
            <span class="font-mono font-bold">Action</span>
          </div>
        </a>

        <!-- 5. Draft Records -->
        <a
          href="/admin/recruitments?status=DRAFT"
          class="metric-card block rounded-xl border border-zinc-200 bg-white p-3.5 sm:p-4.5 shadow-2xs hover:border-zinc-400/80 transition-all hover:shadow-xs group"
          data-category="general"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-500 truncate">Draft records</span>
            <span class="text-[10px] font-mono text-zinc-400 group-hover:text-zinc-950 transition-colors">&rarr;</span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 font-mono tabular-nums">
              {draftRecordsCount}
            </span>
            <span class="text-[10px] sm:text-[11px] text-zinc-400 font-medium">in-prep</span>
          </div>
          <div class="mt-2 pt-2 border-t border-zinc-100 flex items-center justify-between text-[10px] text-zinc-500">
            <span>Unpublished</span>
            <span class="font-mono font-bold">Pipeline</span>
          </div>
        </a>

        <!-- 6. Expired Recruitments -->
        <a
          href="/admin/recruitments?status=ARCHIVED"
          class="metric-card block rounded-xl border border-rose-200/80 bg-rose-50/20 p-3.5 sm:p-4.5 shadow-2xs hover:border-rose-300 transition-all hover:shadow-xs group"
          data-category="urgent"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] sm:text-xs font-semibold text-zinc-600 truncate">Expired / Archive</span>
            <span class="size-2 rounded-full bg-rose-500 ring-2 ring-rose-200"></span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5 sm:gap-2">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-rose-700 font-mono tabular-nums">
              {expiredCount}
            </span>
            <span class="text-[10px] sm:text-[11px] text-rose-700 font-medium">stale</span>
          </div>
          <div class="mt-2 pt-2 border-t border-rose-100 flex items-center justify-between text-[10px] text-rose-700">
            <span>Needs archiving</span>
            <span class="font-mono font-bold">Review</span>
          </div>
        </a>
      </div>

      <!-- Quick Operations Launcher Grid (Mobile Touch Shortcuts) -->
      <div class="rounded-xl border border-zinc-200 bg-white p-3.5 sm:p-4 shadow-2xs">
        <div class="text-xs font-bold text-zinc-900 mb-2.5 flex items-center justify-between">
          <span>Quick Admin Shortcuts</span>
          <span class="text-[10px] text-zinc-400 font-mono">1-TAP ACTIONS</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <a
            href="/admin/recruitments/new"
            class="flex items-center gap-2.5 p-2.5 rounded-lg border border-zinc-200/80 bg-zinc-50/50 hover:bg-zinc-100 hover:border-zinc-300 transition-all text-xs font-medium text-zinc-800"
          >
            <div class="size-7 rounded bg-primary text-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <div class="truncate">
              <div class="font-semibold text-zinc-900 text-[11px] truncate">New Drive</div>
              <div class="text-[10px] text-zinc-400 truncate">Draft record</div>
            </div>
          </a>

          <a
            href="/admin/sources"
            class="flex items-center gap-2.5 p-2.5 rounded-lg border border-zinc-200/80 bg-zinc-50/50 hover:bg-zinc-100 hover:border-zinc-300 transition-all text-xs font-medium text-zinc-800"
          >
            <div class="size-7 rounded bg-blue-500 text-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <div class="truncate">
              <div class="font-semibold text-zinc-900 text-[11px] truncate">Sources</div>
              <div class="text-[10px] text-zinc-400 truncate">Verification</div>
            </div>
          </a>

          <a
            href="/admin/eligibility-rules"
            class="flex items-center gap-2.5 p-2.5 rounded-lg border border-zinc-200/80 bg-zinc-50/50 hover:bg-zinc-100 hover:border-zinc-300 transition-all text-xs font-medium text-zinc-800"
          >
            <div class="size-7 rounded bg-blue-600 text-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
            </div>
            <div class="truncate">
              <div class="font-semibold text-zinc-900 text-[11px] truncate">Rule Engine</div>
              <div class="text-[10px] text-zinc-400 truncate">Criteria spec</div>
            </div>
          </a>

          <a
            href="/admin/audit-log"
            class="flex items-center gap-2.5 p-2.5 rounded-lg border border-zinc-200/80 bg-zinc-50/50 hover:bg-zinc-100 hover:border-zinc-300 transition-all text-xs font-medium text-zinc-800"
          >
            <div class="size-7 rounded bg-zinc-700 text-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/></svg>
            </div>
            <div class="truncate">
              <div class="font-semibold text-zinc-900 text-[11px] truncate">Audit Trail</div>
              <div class="text-[10px] text-zinc-400 truncate">Activity logs</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Bottom Two Columns - Recent Activity & Data Quality -->
    <div id="tab-content-details" class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
      <!-- Recent Activity Card -->
      <div class="rounded-xl border border-zinc-200 bg-white p-4 sm:p-5 shadow-2xs">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-2">
          <div>
            <h2 class="text-sm font-bold text-zinc-950">Recent activity</h2>
            <p class="text-[11px] text-zinc-500">Recruitment records & audit feed</p>
          </div>
          <a
            href="/admin/audit-log"
            class="inline-flex items-center gap-1 text-[11px] font-semibold text-zinc-900 hover:underline p-1"
          >
            <span>Audit log</span>
            <span class="font-mono">&rarr;</span>
          </a>
        </div>

        <div class="divide-y divide-zinc-100 text-xs">
          {kpis.recentAuditLogs && kpis.recentAuditLogs.length > 0 ? (
            kpis.recentAuditLogs.slice(0, 4).map((log: any) => (
              <div class="flex items-center justify-between py-3 hover:bg-zinc-50/60 px-1 rounded-md transition-colors min-h-[44px]">
                <div class="flex items-center gap-2.5 min-w-0 pr-2">
                  <span class={`size-2 rounded-full shrink-0 ${
                    log.action === 'CREATE' ? 'bg-emerald-500' :
                    log.action === 'VERIFY' ? 'bg-blue-500' :
                    log.action === 'DELETE' ? 'bg-rose-500' : 'bg-primary'
                  }`}></span>
                  <span class="font-medium text-zinc-900 truncate">{log.entity}: {log.action} {log.field ? `(${log.field})` : ''}</span>
                </div>
                <span class="text-[11px] text-zinc-400 font-mono shrink-0">
                  {new Date(log.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}
                </span>
              </div>
            ))
          ) : (
            <div class="py-6 text-center text-zinc-400 text-xs">
              No recent audit activity recorded yet.
            </div>
          )}
        </div>
      </div>

      <!-- Data Quality Operational Card -->
      <div class="rounded-xl border border-zinc-200 bg-white p-4 sm:p-5 shadow-2xs">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-2">
          <div>
            <h2 class="text-sm font-bold text-zinc-950">Data quality & alerts</h2>
            <p class="text-[11px] text-zinc-500">Items requiring administrative action</p>
          </div>
          <span class={`inline-flex items-center gap-1 rounded px-2 py-0.5 text-[10px] font-bold uppercase border ${
            totalActionItems > 0
              ? 'bg-blue-50 text-blue-800 border-blue-200'
              : 'bg-emerald-50 text-emerald-800 border-emerald-200'
          }`}>
            {totalActionItems > 0 ? 'Active Attention' : 'All Clear'}
          </span>
        </div>

        <div class="divide-y divide-zinc-100 text-xs">
          <!-- Item 1: Needs Verification -->
          <div class="flex items-center justify-between py-3 hover:bg-zinc-50/60 px-1 rounded-md transition-colors min-h-[44px]">
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="text-zinc-800 font-medium truncate">
                {needsVerificationCount} records need verification
              </span>
            </div>
            <a
              href="/admin/sources"
              class="font-semibold text-zinc-950 hover:underline text-xs shrink-0 p-1"
            >
