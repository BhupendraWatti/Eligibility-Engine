---
// src/pages/admin/recruitments/new.astro (FlowStep Screen 22)
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllCanonicalPosts, getAllSectors, getAllOrganisations, getAllStates, createRecruitmentAtomic } from '../../../db/queries';
import {
  AdminValidationError,
  parseBooleanInput,
  parseIntegerInput,
  parseOptionalNumberInput,
  parseStringListInput,
  readAdminSubmission,
  resolveRequiredReference,
} from '../../../services/admin-integrity';

let errorMessage = '';
let validationErrors: string[] = [];
let created = false;
let masterDataError = '';
let posts: Awaited<ReturnType<typeof getAllCanonicalPosts>> = [];
let sectors: Awaited<ReturnType<typeof getAllSectors>> = [];
let organisations: Awaited<ReturnType<typeof getAllOrganisations>> = [];
let states: Awaited<ReturnType<typeof getAllStates>> = [];

try {
  [posts, sectors, organisations, states] = await Promise.all([
    getAllCanonicalPosts(),
    getAllSectors(),
    getAllOrganisations(),
    getAllStates(),
  ]);
} catch (error) {
  console.error('[Recruitment Intake] Failed to load master data:', error);
  masterDataError = 'Recruitment master data is unavailable. Verify the D1 binding and apply pending migrations, then retry.';
  errorMessage = masterDataError;
  Astro.response.status = 503;
}

if (Astro.request.method === 'POST' && masterDataError) {
  const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
  if (!acceptsHtml) {
    return new Response(JSON.stringify({ error: masterDataError, code: 'MASTER_DATA_UNAVAILABLE' }), {
      status: 503,
      headers: { 'Content-Type': 'application/json' },
    });
  }
} else if (Astro.request.method === 'POST') {
  try {
    const input = await readAdminSubmission(Astro.request);
    const title = input.text('title', 'name');
    let postId = input.text('postId', 'post_id');
    const organisationId = input.text('organisationId', 'organisation_id');
    const advtNumber = input.text('advtNumber', 'advt_number', 'advt');
    const totalVacancies = parseIntegerInput(input.value('totalVacancies', 'total_vacancies', 'vacancies'), 0);
    const shortSummary = input.text('shortSummary', 'short_summary', 'summary');
    const overviewMarkdown = input.text('overviewMarkdown', 'overview_markdown', 'overview');
    const payScaleOverride = input.text('payScaleOverride', 'pay_scale_override', 'payScale', 'pay_scale');
    const cadreClassification = input.text('cadreClassification', 'cadre_classification');
    const salaryDetailsMarkdown = input.text('salaryDetailsMarkdown', 'salary_details_markdown');
    const qualificationDetailsMarkdown = input.text('qualificationDetailsMarkdown', 'qualification_details_markdown');
    const minAge = parseIntegerInput(input.value('minAge', 'min_age'), 18);
    const maxAgeGeneral = parseIntegerInput(input.value('maxAgeGeneral', 'max_age_general', 'maxAge'), 33);
    const ageCutoffDate = input.text('ageCutoffDate', 'age_cutoff_date');
    const ageRelaxationScSt = parseIntegerInput(input.value('ageRelaxationScSt', 'age_relaxation_sc_st'), 0);
    const ageRelaxationObc = parseIntegerInput(input.value('ageRelaxationObc', 'age_relaxation_obc'), 0);
    const ageRelaxationFemale = parseIntegerInput(input.value('ageRelaxationFemale', 'age_relaxation_female'), 0);
    const ageRelaxationEws = parseIntegerInput(input.value('ageRelaxationEws', 'age_relaxation_ews'), 0);
    const minPercentageRequired = parseOptionalNumberInput(input.value('minPercentageRequired', 'min_percentage_required'));
    const experienceMonths = parseIntegerInput(input.value('experienceMonths', 'experience_months'), 0);
    const allowedStreams = parseStringListInput(input.value('allowedStreams', 'allowed_streams'));
    const additionalSkills = parseStringListInput(input.value('additionalSkills', 'additional_skills'));
    const requiresMpDomicile = parseBooleanInput(input.value('requiresMpDomicile', 'requires_mp_domicile'));
    const domicileStateCode = input.text('domicileStateCode', 'domicile_state_code') || null;
    const requiresMpEmploymentReg = parseBooleanInput(input.value('requiresMpEmploymentReg', 'requires_mp_employment_reg'));
    const employmentRegistrationLabel = input.text('employmentRegistrationLabel', 'employment_registration_label') || null;
    const requiresCpct = parseBooleanInput(input.value('requiresCpct', 'requires_cpct'));
    const genderAllowed = (input.text('genderAllowed', 'gender_allowed') || 'ALL').toUpperCase() as 'ALL' | 'MALE' | 'FEMALE';
    const minHeightMaleCm = parseOptionalNumberInput(input.value('minHeightMaleCm', 'min_height_male_cm'));
    const minHeightFemaleCm = parseOptionalNumberInput(input.value('minHeightFemaleCm', 'min_height_female_cm'));
    const minChestMaleCm = parseOptionalNumberInput(input.value('minChestMaleCm', 'min_chest_male_cm'));
    const minQualificationLevel = input.text('minQualificationLevel', 'min_qualification_level') || '10TH';
    const applicationStart = input.text('applicationStart', 'application_start');
    const applicationEnd = input.text('applicationEnd', 'application_end');
    const examDate = input.text('examDate', 'exam_date');
    const examStatus = input.text('examStatus', 'exam_status') || 'NOT_SCHEDULED';
    const resultStatus = input.text('resultStatus', 'result_status') || 'NOT_DECLARED';
    const sourceUrl = input.text('sourceUrl', 'source_url');
    const sourceTitle = input.text('sourceTitle', 'source_title');
    const officialApplyUrl = input.text('officialApplyUrl', 'official_apply_url');
    const admitCardUrl = input.text('admitCardUrl', 'admit_card_url');
    const answerKeyUrl = input.text('answerKeyUrl', 'answer_key_url');
    const resultUrl = input.text('resultUrl', 'result_url');
    const saveDraft = parseBooleanInput(input.value('saveDraft', 'save_draft'));
    const seoTitle = input.text('seoTitle', 'seo_title');
    const seoDescription = input.text('seoDescription', 'seo_description');
    const robotsIndex = parseBooleanInput(input.value('robotsIndex', 'robots_index'), true) ? 1 : 0;

    postId = resolveRequiredReference(postId, posts, 'canonical post').id;
    const organisation = resolveRequiredReference(organisationId, organisations, 'organisation');

    const officialLinks = [
      ...(officialApplyUrl ? [{ linkType: 'APPLY_ONLINE', title: 'Apply online', url: officialApplyUrl }] : []),
      ...(admitCardUrl ? [{ linkType: 'ADMIT_CARD', title: 'Download admit card', url: admitCardUrl }] : []),
      ...(answerKeyUrl ? [{ linkType: 'ANSWER_KEY', title: 'View answer key', url: answerKeyUrl }] : []),
      ...(resultUrl ? [{ linkType: 'RESULT', title: 'View result', url: resultUrl }] : []),
    ];
    const status = saveDraft ? 'DRAFT' : 'PUBLISHED';

    if (title && postId && organisation && advtNumber && totalVacancies >= 0) {
      const result = await createRecruitmentAtomic({
        title,
        postId,
        organisationId: organisation.id,
        organisationShortName: organisation.shortName,
        stateId: organisation.stateId,
        advtNumber,
        totalVacancies,
        shortSummary,
        overviewMarkdown,
        payScaleOverride,
        cadreClassification,
        salaryDetailsMarkdown,
        qualificationDetailsMarkdown,
        minAge,
        maxAgeGeneral,
        ageCutoffDate,
        ageRelaxationScSt,
        ageRelaxationObc,
        ageRelaxationFemale,
        ageRelaxationEws,
        minPercentageRequired,
        experienceMonths,
        allowedStreams,
        additionalSkills,
        requiresMpDomicile,
        domicileStateCode,
        requiresMpEmploymentReg,
        employmentRegistrationLabel,
        requiresCpct,
        genderAllowed,
        minHeightMaleCm,
        minHeightFemaleCm,
        minChestMaleCm,
        minQualificationLevel,
        applicationStart,
        applicationEnd,
        examDate,
        examStatus,
        resultStatus,
        sourceUrl,
        sourceTitle,
        officialApplyUrl,
        officialLinks,
        seoTitle,
        seoDescription,
        robotsIndex,
        status,
        adminEmail: Astro.locals.adminEmail,
      });

      if (result.success) {
        Astro.response.headers.set('X-Recruitment-Id', result.id);
        const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
        if (!acceptsHtml) {
          return new Response(JSON.stringify({
            recruitment_id: result.id,
            id: result.id,
            success: true,
            message: 'Recruitment workspace created successfully',
          }), {
            status: 201,
            headers: {
              'Content-Type': 'application/json',
              'X-Recruitment-Id': result.id,
            },
          });
        }
        return Astro.redirect(`/admin/recruitments?status=${status}&createdId=${result.id}`);
      } else {
        errorMessage = result.message || 'Failed to create recruitment.';
        validationErrors = result.errors || [];
        Astro.response.status = 400;
        const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
        if (!acceptsHtml) {
          return new Response(JSON.stringify({ error: errorMessage, errors: validationErrors }), {
            status: 400,
            headers: { 'Content-Type': 'application/json' },
          });
        }
      }
    } else {
      errorMessage = 'Please provide title, canonical post, advertisement number, and valid vacancy count.';
      Astro.response.status = 400;
      const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
      if (!acceptsHtml) {
        return new Response(JSON.stringify({ error: errorMessage }), {
          status: 400,
          headers: { 'Content-Type': 'application/json' },
        });
      }
    }
  } catch (err: any) {
    const isValidationError = err instanceof AdminValidationError;
    const responseStatus = isValidationError ? 400 : 500;
    if (!isValidationError) console.error('[Recruitment Intake] Creation failed:', err);
    errorMessage = isValidationError
      ? err.message
      : 'Recruitment creation failed because the database operation could not be completed. No data was saved.';
    Astro.response.status = responseStatus;
    const acceptsHtml = Astro.request.headers.get('accept')?.includes('text/html') ?? false;
    if (!acceptsHtml) {
      return new Response(JSON.stringify({
        error: errorMessage,
        code: isValidationError ? err.code : 'RECRUITMENT_CREATE_FAILED',
      }), {
        status: responseStatus,
        headers: { 'Content-Type': 'application/json' },
      });
    }
  }
}

const postsBySector = sectors.map(sec => ({
  sector: sec,
  posts: posts.filter(p => p.sectorId === sec.id),
})).filter(group => group.posts.length > 0);

const groupedPostIds = new Set(postsBySector.flatMap(g => g.posts.map(p => p.id)));
const unassignedPosts = posts.filter(p => !groupedPostIds.has(p.id));
---

<AdminLayout
  title="Create Recruitment"
  currentSection="recruitments"
  breadcrumbs={[
    { label: 'Recruitments', href: '/admin/recruitments' },
    { label: 'New recruitment' },
  ]}
>
  <form method="POST" id="recruitmentForm" class="mx-auto max-w-6xl space-y-6">
    <!-- Top Action Bar (FlowStep Screen 22) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Create recruitment
        </h1>
        <div class="flex items-center gap-2 text-xs text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
          <span class="font-mono text-[11px]">Autosave ready · All changes staged</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/admin/recruitments"
          class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors"
        >
          Cancel
        </a>
        <button
          type="submit"
          name="saveDraft"
          value="true"
          class="px-3.5 py-2 rounded-lg border border-zinc-300 bg-white hover:bg-zinc-100 text-zinc-900 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
        >
          Save draft
        </button>
        <button
          type="submit"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-zinc-950 text-white hover:bg-black text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span>Publish recruitment</span>
        </button>
      </div>
    </div>

    {errorMessage && (
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs font-medium text-rose-900">
        ⛔ {errorMessage}
      </div>
    )}

    {validationErrors.length > 0 && (
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-xs text-amber-950 space-y-1">
        <div class="font-bold">Validation Warnings:</div>
        <ul class="list-disc pl-5 space-y-0.5">
          {validationErrors.map(e => <li>{e}</li>)}
        </ul>
      </div>
    )}

    <!-- FlowStep Screen 22 Two-Column Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] items-start gap-6">
      <!-- Left Column: Form with Tabs -->
      <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
        <!-- Tab Navigation Bar -->
        <div class="flex items-center border-b border-zinc-200 bg-zinc-50/50 px-4 overflow-x-auto" id="editorTabs">
          {[
            { id: 'basic', label: 'Basic' },
            { id: 'vacancy', label: 'Vacancy' },
            { id: 'eligibility', label: 'Eligibility' },
            { id: 'dates', label: 'Dates' },
            { id: 'sources', label: 'Sources' },
            { id: 'seo', label: 'SEO' },
          ].map((tab, idx) => (
            <button
              type="button"
              data-tab={tab.id}
              class={`tab-trigger py-3 px-4 text-xs font-semibold border-b-2 transition-colors cursor-pointer whitespace-nowrap ${
                idx === 0
                  ? 'border-zinc-950 text-zinc-950'
                  : 'border-transparent text-zinc-500 hover:text-zinc-900'
              }`}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <div class="p-6 space-y-6">
          <!-- Tab 1: Basic Information -->
          <div id="tab-basic" class="tab-pane space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Basic Information</h2>
              <p class="text-xs text-zinc-500">Official title, post assignment, and recruitment overview.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Recruitment Title *</label>
                <input
                  type="text"
                  name="title"
                  required
                  placeholder="e.g. State Police Constable Recruitment 2026"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <label class="block text-xs font-semibold text-zinc-800">Organisation *</label>
                  <a href="/admin/organisations" target="_blank" class="text-[11px] text-indigo-600 hover:text-indigo-800 font-medium inline-flex items-center gap-0.5">+ Add Organisation ↗</a>
                </div>
                <select
                  name="organisationId"
                  required
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                >
                  <option value="">-- Select organisation --</option>
                  {organisations.map(org => <option value={org.id}>{org.name} ({org.shortName})</option>)}
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Advertisement Number *</label>
                <input
                  type="text"
                  name="advtNumber"
                  required
                  placeholder="e.g. ESB/2026/04"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>

              <div class="sm:col-span-2 space-y-1.5">
                <div class="flex items-center justify-between">
                  <label class="block text-xs font-semibold text-zinc-800">Canonical Post Reference *</label>
                  <a href="/admin/masters" target="_blank" class="text-[11px] text-indigo-600 hover:text-indigo-800 font-medium inline-flex items-center gap-0.5">+ Add Canonical Post ↗</a>
                </div>
                <select
                  name="postId"
                  required
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none bg-white"
                >
                  <option value="">-- Select canonical post --</option>
                  {postsBySector.map(group => (
                    <optgroup label={group.sector.name}>
                      {group.posts.map(p => (
                        <option value={p.id}>{p.title} ({p.defaultQualification})</option>
                      ))}
                    </optgroup>
                  ))}
                  {unassignedPosts.length > 0 && (
                    <optgroup label="Other Posts">
                      {unassignedPosts.map(p => (
                        <option value={p.id}>{p.title} ({p.defaultQualification})</option>
                      ))}
                    </optgroup>
                  )}
                </select>
              </div>

              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Short Summary</label>
                <textarea
                  name="shortSummary"
                  rows="2"
                  placeholder="One-line summary for cards and search snippets..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                ></textarea>
              </div>

              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Overview / Job Description</label>
                <textarea
                  name="overviewMarkdown"
                  rows="4"
                  placeholder="Detailed job overview in Markdown format..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Tab 2: Vacancy -->
          <div id="tab-vacancy" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Vacancy & Pay Scale</h2>
              <p class="text-xs text-zinc-500">Total positions and salary structure.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Total Vacancies *</label>
                <input
                  type="number"
                  name="totalVacancies"
                  min="0"
                  required
                  placeholder="e.g. 7500"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Cadre Classification</label>
                <input
                  type="text"
                  name="cadreClassification"
                  placeholder="e.g. Executive / Group C / Technical"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Pay Scale Override</label>
                <input
                  type="text"
                  name="payScaleOverride"
                  placeholder="e.g. Rs. 19,500 - 62,000 (Level 4)"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Salary Details Notes</label>
                <input
                  type="text"
                  name="salaryDetailsMarkdown"
                  placeholder="7th Pay Commission allowances, DA, HRA..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Tab 3: Eligibility -->
          <div id="tab-eligibility" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Statutory Eligibility Criteria</h2>
              <p class="text-xs text-zinc-500">Education, age limits, and state criteria used by the evaluation engine.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Minimum Qualification *</label>
                <select
                  name="minQualificationLevel"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 outline-none bg-white font-mono"
                >
                  <option value="10TH">10th Pass</option>
                  <option value="12TH">12th Pass</option>
                  <option value="ITI">ITI</option>
                  <option value="DIPLOMA">Diploma</option>
                  <option value="GRADUATION">Graduation</option>
                  <option value="POST_GRADUATION">Post Graduation</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Min Age (Years)</label>
                <input
                  type="number"
                  name="minAge"
                  defaultValue="18"
                  min="16"
                  max="45"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Max Age General (Years)</label>
                <input
                  type="number"
                  name="maxAgeGeneral"
                  defaultValue="33"
                  min="18"
                  max="50"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Age Cutoff Date *</label>
                <input
                  type="date"
                  name="ageCutoffDate"
                  required
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="sm:col-span-3 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Qualification Detailed Requirements</label>
                <textarea
                  name="qualificationDetailsMarkdown"
                  rows="3"
                  placeholder="Subject requirements, mandatory certificates, or equivalent qualifications..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                ></textarea>
              </div>
              <div class="sm:col-span-3 grid grid-cols-2 sm:grid-cols-4 gap-3">
                {[
                  ['ageRelaxationScSt', 'SC/ST relaxation'],
                  ['ageRelaxationObc', 'OBC relaxation'],
                  ['ageRelaxationFemale', 'Female relaxation'],
                  ['ageRelaxationEws', 'EWS relaxation'],
                ].map(([name, label]) => (
                  <label class="text-xs font-semibold text-zinc-800">{label}<input type="number" min="0" name={name} defaultValue="0" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200 font-mono" /></label>
                ))}
              </div>
              <div class="space-y-1.5"><label class="block text-xs font-semibold text-zinc-800">Minimum percentage</label><input type="number" min="0" max="100" step="0.01" name="minPercentageRequired" class="w-full px-3 py-2 rounded-lg border border-zinc-200" /></div>
              <div class="space-y-1.5"><label class="block text-xs font-semibold text-zinc-800">Required experience (months)</label><input type="number" min="0" name="experienceMonths" defaultValue="0" class="w-full px-3 py-2 rounded-lg border border-zinc-200" /></div>
              <div class="space-y-1.5"><label class="block text-xs font-semibold text-zinc-800">Allowed streams (comma-separated)</label><input type="text" name="allowedStreams" class="w-full px-3 py-2 rounded-lg border border-zinc-200" /></div>
              <div class="space-y-1.5"><label class="block text-xs font-semibold text-zinc-800">Required certificates (comma-separated)</label><input type="text" name="additionalSkills" class="w-full px-3 py-2 rounded-lg border border-zinc-200" /></div>
              <div class="sm:col-span-3 flex flex-wrap gap-4 text-xs">
                <label><input type="checkbox" name="requiresMpDomicile" value="1" /> State domicile required</label>
                <label><input type="checkbox" name="requiresMpEmploymentReg" value="1" /> Employment registration required</label>
                <label><input type="checkbox" name="requiresCpct" value="1" /> CPCT required</label>
              </div>
              <label class="text-xs font-semibold text-zinc-800">Required domicile jurisdiction<select name="domicileStateCode" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200 bg-white"><option value="">None / open to all India</option>{states.filter(state => state.code !== 'IN').map(state => <option value={state.code}>{state.name} ({state.code})</option>)}</select></label>
              <label class="text-xs font-semibold text-zinc-800">Employment registration key<input type="text" name="employmentRegistrationLabel" placeholder="e.g. MP_ROJGAR or UP_SEWAYOJAN" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200 font-mono" /></label>
              <label class="text-xs font-semibold text-zinc-800">Allowed gender<select name="genderAllowed" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200"><option value="ALL">All</option><option value="MALE">Male only</option><option value="FEMALE">Female only</option></select></label>
              <label class="text-xs font-semibold text-zinc-800">Male height (cm)<input type="number" step="0.1" name="minHeightMaleCm" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Female height (cm)<input type="number" step="0.1" name="minHeightFemaleCm" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Male chest (cm)<input type="number" step="0.1" name="minChestMaleCm" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
            </div>
          </div>

          <!-- Tab 4: Dates -->
          <div id="tab-dates" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Application & Exam Milestones</h2>
              <p class="text-xs text-zinc-500">Timeline dates synchronized with the state recruitment calendar.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Application Open</label>
                <input
                  type="date"
                  name="applicationStart"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Application Deadline</label>
                <input
                  type="date"
                  name="applicationEnd"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Scheduled Exam Date</label>
                <input
                  type="date"
                  name="examDate"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Tab 5: Sources -->
          <div id="tab-sources" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Provenance & Official Gazette Links</h2>
              <p class="text-xs text-zinc-500">Audit trail verifying official notification provenance.</p>
            </div>

            <div class="space-y-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Official Notification URL *</label>
                <input
                  type="url"
                  name="sourceUrl"
                  placeholder="https://official-authority.gov.in/notifications/2026/..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Source Document Title</label>
                <input
                  type="text"
                  name="seoTitle"
                  name="sourceTitle"
                  placeholder="e.g. Police Constable Rulebook 2026 (Official Notification)"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>
              {[
                ['officialApplyUrl', 'Official application URL'],
                ['admitCardUrl', 'Admit card URL'],
                ['answerKeyUrl', 'Answer key URL'],
                ['resultUrl', 'Result / merit list URL'],
              ].map(([name, label]) => (
                <div class="space-y-1.5">
                  <label class="block text-xs font-semibold text-zinc-800">{label}</label>
                  <input type="url" name={name} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none" />
                </div>
              ))}
            </div>
          </div>

          <!-- Tab 6: SEO -->
          <div id="tab-seo" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">SEO & Metadata</h2>
              <p class="text-xs text-zinc-500">Controls how this recruitment appears on search engines.</p>
            </div>

            <div class="space-y-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Custom Page Title</label>
                <input
                  type="text"
                  placeholder="Leave empty to use automatic pattern: [Title] | Eligibility & Dates"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Meta Description</label>
                <textarea
                  name="seoDescription"
                  rows="2"
                  placeholder="Search engine meta description (recommended: 150-160 characters)..."
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                ></textarea>
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-800"><input type="checkbox" name="robotsIndex" value="1" checked /> Allow search-engine indexing</label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Completeness Checklist (FlowStep Screen 22) -->
      <aside class="sticky top-20 space-y-4">
        <!-- Completeness Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-950">Completeness</h3>
            <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
              45% Ready
            </span>
          </div>

          <div class="w-full bg-zinc-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-zinc-900 h-1.5 rounded-full" style="width: 45%"></div>
          </div>

          <!-- Checklist Items with Jump Actions -->
          <div class="space-y-2.5 text-xs">
            <button type="button" data-jump="basic" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Basic information
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Active</span>
            </button>

            <button type="button" data-jump="vacancy" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Vacancies & cadre
              </span>
              <span class="text-[10px] text-amber-700 font-semibold">Required</span>
            </button>

            <button type="button" data-jump="eligibility" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Eligibility criteria
              </span>
              <span class="text-[10px] text-amber-700 font-semibold">Required</span>
            </button>

            <button type="button" data-jump="dates" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-zinc-400"></span>
                Dates & timeline
              </span>
              <span class="text-[10px] text-zinc-400">Optional</span>
            </button>

            <button type="button" data-jump="sources" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Official source link
              </span>
              <span class="text-[10px] text-amber-700 font-semibold">Required</span>
            </button>

            <button type="button" data-jump="seo" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-zinc-400"></span>
                SEO & metadata
              </span>
              <span class="text-[10px] text-zinc-400 font-mono">Auto</span>
            </button>
          </div>
        </div>

        <!-- Operational Help Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs text-xs space-y-2">
          <div class="font-bold text-zinc-900 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span>Guidance</span>
          </div>
          <p class="text-zinc-500 leading-relaxed text-[11px]">
            Statutory criteria entered here automatically calibrate the citizen eligibility calculator and match against candidate profiles.
          </p>
        </div>
      </aside>
    </div>
  </form>

  <!-- Client-side Tab Switcher Script (Zero Page Reloads) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const triggers = document.querySelectorAll('.tab-trigger');
      const panes = document.querySelectorAll('.tab-pane');
      const jumpButtons = document.querySelectorAll('.jump-btn');

      function switchTab(tabId) {
        triggers.forEach(t => {
          if (t.dataset.tab === tabId) {
            t.classList.add('border-zinc-950', 'text-zinc-950');
            t.classList.remove('border-transparent', 'text-zinc-500');
          } else {
            t.classList.remove('border-zinc-950', 'text-zinc-950');
            t.classList.add('border-transparent', 'text-zinc-500');
          }
        });

        panes.forEach(p => {
          if (p.id === `tab-${tabId}`) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      }

      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          switchTab(trigger.dataset.tab);
        });
      });

      jumpButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.dataset.jump;
          switchTab(tabId);
        });
      });
    });
  </script>
</AdminLayout>
