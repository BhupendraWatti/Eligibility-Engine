---
import { advtLabel, cleanAdvt } from '../../../../services/advt-number';
// src/pages/admin/recruitments/[id]/edit.astro (FlowStep Screen 22)
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AgeRangeGuard from '../../../../components/admin/AgeRangeGuard.astro';
import {
  getRecruitmentById,
  getAllCanonicalPosts,
  getAllSectors,
  getAllOrganisations,
  getAllStates,
  updateRecruitmentAtomic,
} from '../../../../db/queries';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/recruitments');
}

const recruitment = await getRecruitmentById(id);
if (!recruitment) {
  return Astro.redirect('/admin/recruitments');
}

const posts = await getAllCanonicalPosts();
const sectors = await getAllSectors();
const organisations = await getAllOrganisations();
const states = await getAllStates();

let errorMessage = '';
let validationErrors: string[] = [];
let successMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get('title')?.toString().trim();
    const postId = formData.get('postId')?.toString().trim();
    const organisationId = formData.get('organisationId')?.toString().trim();
    const organisation = organisations.find(o => o.id === organisationId);
    const organisationShortName = organisation?.shortName || recruitment.organisationShortName;
    const advtNumber = cleanAdvt(formData.get('advtNumber')?.toString());
    const cycleYear = parseInt(formData.get('cycleYear')?.toString() || String(recruitment.cycleYear || 2026), 10);
    const totalVacancies = parseInt(formData.get('totalVacancies')?.toString() || '0', 10);
    const lifecycleStatus = formData.get('lifecycleStatus')?.toString().trim() || 'OPEN';
    const status = formData.get('status')?.toString().trim() || 'PUBLISHED';
    const examStatus = formData.get('examStatus')?.toString().trim() || 'NOT_SCHEDULED';
    const resultStatus = formData.get('resultStatus')?.toString().trim() || 'NOT_DECLARED';
    const isFeatured = formData.get('isFeatured') === '1' ? 1 : 0;
    const shortSummary = formData.get('shortSummary')?.toString().trim();
    const overviewMarkdown = formData.get('overviewMarkdown')?.toString().trim();

    // Eligibility Criteria
    const minAge = parseInt(formData.get('minAge')?.toString() || '18', 10);
    const maxAgeGeneral = parseInt(formData.get('maxAgeGeneral')?.toString() || '33', 10);
    const ageCutoffDate = formData.get('ageCutoffDate')?.toString().trim() || '2026-01-01';
    const ageRelaxationScSt = parseInt(formData.get('ageRelaxationScSt')?.toString() || '5', 10);
    const ageRelaxationObc = parseInt(formData.get('ageRelaxationObc')?.toString() || '3', 10);
    const ageRelaxationFemale = parseInt(formData.get('ageRelaxationFemale')?.toString() || '5', 10);
    const ageRelaxationEws = parseInt(formData.get('ageRelaxationEws')?.toString() || '0', 10);

    const minQualificationLevel = formData.get('minQualificationLevel')?.toString().trim() || '10TH';
    const qualificationDetailsMarkdown = formData.get('qualificationDetailsMarkdown')?.toString().trim();
    const relaxationNotesMarkdown = formData.get('relaxationNotesMarkdown')?.toString().trim();
    const minPercentageRequired = formData.get('minPercentageRequired') ? Number(formData.get('minPercentageRequired')) : null;
    const experienceMonths = parseInt(formData.get('experienceMonths')?.toString() || '0', 10);
    const allowedStreams = formData.get('allowedStreams')?.toString().split(',').map(v => v.trim()).filter(Boolean);
    const additionalSkills = formData.get('additionalSkills')?.toString().split(',').map(v => v.trim()).filter(Boolean);

    const requiresMpDomicile = formData.get('requiresMpDomicile') === '1';
    const domicileStateCode = formData.get('domicileStateCode')?.toString().trim() || null;
    const requiresMpEmploymentReg = formData.get('requiresMpEmploymentReg') === '1';
    const employmentRegistrationLabel = formData.get('employmentRegistrationLabel')?.toString().trim() || null;
    const requiresCpct = formData.get('requiresCpct') === '1';
    const genderAllowed = (formData.get('genderAllowed')?.toString() || 'ALL') as 'ALL' | 'MALE' | 'FEMALE';

    const minHeightMaleCm = formData.get('minHeightMaleCm') ? parseFloat(formData.get('minHeightMaleCm')!.toString()) : null;
    const minHeightFemaleCm = formData.get('minHeightFemaleCm') ? parseFloat(formData.get('minHeightFemaleCm')!.toString()) : null;
    const minChestMaleCm = formData.get('minChestMaleCm') ? parseFloat(formData.get('minChestMaleCm')!.toString()) : null;

    // Vacancies Breakdown
    const vacUr = parseInt(formData.get('vac_ur')?.toString() || '0', 10);
    const vacObc = parseInt(formData.get('vac_obc')?.toString() || '0', 10);
    const vacSt = parseInt(formData.get('vac_st')?.toString() || '0', 10);
    const vacSc = parseInt(formData.get('vac_sc')?.toString() || '0', 10);
    const vacEws = parseInt(formData.get('vac_ews')?.toString() || '0', 10);
    const subPostName = formData.get('subPostName')?.toString().trim();

    const vacanciesBreakdown: Array<{ category: string; count: number; pct?: string; quotaPct?: string; subPostName?: string }> = [];
    if (vacUr > 0 || vacObc > 0 || vacSt > 0 || vacSc > 0 || vacEws > 0) {
      if (vacUr > 0) vacanciesBreakdown.push({ category: 'General / Unreserved (UR)', count: vacUr, quotaPct: '27%', subPostName });
      if (vacObc > 0) vacanciesBreakdown.push({ category: 'Other Backward Classes (OBC)', count: vacObc, quotaPct: '27%', subPostName });
      if (vacSt > 0) vacanciesBreakdown.push({ category: 'Scheduled Tribes (ST)', count: vacSt, quotaPct: '20%', subPostName });
      if (vacSc > 0) vacanciesBreakdown.push({ category: 'Scheduled Castes (SC)', count: vacSc, quotaPct: '16%', subPostName });
      if (vacEws > 0) vacanciesBreakdown.push({ category: 'Economically Weaker Section (EWS)', count: vacEws, quotaPct: '10%', subPostName });
    }

    // Important Dates
    const notificationDate = formData.get('notificationDate')?.toString().trim();
    const applicationStart = formData.get('applicationStart')?.toString().trim();
    const applicationEnd = formData.get('applicationEnd')?.toString().trim();
    const correctionEnd = formData.get('correctionEnd')?.toString().trim();
    const examDate = formData.get('examDate')?.toString().trim();

    const importantDates: Array<{ eventType: string; eventDate: string; isTentative?: number; notes?: string }> = [];
    if (notificationDate) importantDates.push({ eventType: 'NOTIFICATION', eventDate: notificationDate, notes: 'Gazette notification published' });
    if (applicationStart) importantDates.push({ eventType: 'APPLICATION_START', eventDate: applicationStart, notes: 'Online registration begins' });
    if (applicationEnd) importantDates.push({ eventType: 'APPLICATION_END', eventDate: applicationEnd, notes: 'Application deadline' });
    if (correctionEnd) importantDates.push({ eventType: 'CORRECTION_END', eventDate: correctionEnd, notes: 'Form correction window closes' });
    if (examDate) importantDates.push({ eventType: 'EXAM_DATE', eventDate: examDate, notes: 'Scheduled competitive examination' });

    // Salary & Cadre
    const payScaleOverride = formData.get('payScaleOverride')?.toString().trim();
    const cadreClassification = formData.get('cadreClassification')?.toString().trim();
    const salaryDetailsMarkdown = formData.get('salaryDetailsMarkdown')?.toString().trim();

    // Sources & Official Links
    const sourceTitle = formData.get('sourceTitle')?.toString().trim();
    const sourceUrl = formData.get('sourceUrl')?.toString().trim();
    const officialApplyUrl = formData.get('officialApplyUrl')?.toString().trim();
    const admitCardUrl = formData.get('admitCardUrl')?.toString().trim();
    const answerKeyUrl = formData.get('answerKeyUrl')?.toString().trim();
    const resultUrl = formData.get('resultUrl')?.toString().trim();
    const seoTitle = formData.get('seoTitle')?.toString().trim();
    const seoDescription = formData.get('seoDescription')?.toString().trim();
    const robotsIndex = formData.get('robotsIndex') === '1' ? 1 : 0;

    const sources: Array<{ sourceType: string; sourceTitle: string; sourceUrl: string; publicationDate?: string }> = [];
    if (sourceUrl) {
      sources.push({
        sourceType: 'OFFICIAL_NOTIFICATION_PDF',
        sourceTitle: sourceTitle || `${organisationShortName} Official Rulebook Gazette`,
        sourceUrl,
        publicationDate: notificationDate || applicationStart || undefined,
      });
    }
    const officialLinks: Array<{ linkType: string; title: string; url: string }> = [];
    if (officialApplyUrl) {
      officialLinks.push({
        linkType: 'APPLY_ONLINE',
        title: `Apply Online (${organisationShortName} Portal)`,
        url: officialApplyUrl,
      });
    }
    if (sourceUrl) {
      officialLinks.push({
        linkType: 'NOTIFICATION_PDF',
        title: 'Download Official Notification PDF',
        url: sourceUrl,
      });
    }
    if (admitCardUrl) officialLinks.push({ linkType: 'ADMIT_CARD', title: 'Download admit card', url: admitCardUrl });
    if (answerKeyUrl) officialLinks.push({ linkType: 'ANSWER_KEY', title: 'View answer key', url: answerKeyUrl });
    if (resultUrl) officialLinks.push({ linkType: 'RESULT', title: 'View result', url: resultUrl });

    if (title && postId && totalVacancies >= 0) {
      const updateResult = await updateRecruitmentAtomic(id, {
        title,
        postId,
        organisationShortName,
        organisationId: organisation?.id,
        stateId: organisation?.stateId,
        advtNumber,
        cycleYear,
        totalVacancies,
        status,
        lifecycleStatus,
        examStatus,
        resultStatus,
        isFeatured,
        shortSummary,
        overviewMarkdown,
        minAge,
        maxAgeGeneral,
        ageCutoffDate,
        ageRelaxationScSt,
        ageRelaxationObc,
        ageRelaxationFemale,
        ageRelaxationEws,
        minQualificationLevel,
        qualificationDetailsMarkdown,
        relaxationNotesMarkdown,
        minPercentageRequired,
        experienceMonths,
        allowedStreams,
        additionalSkills,
        requiresMpDomicile,
        domicileStateCode,
        requiresMpEmploymentReg,
        employmentRegistrationLabel,
        requiresCpct,
        genderAllowed,
        minHeightMaleCm,
        minHeightFemaleCm,
        minChestMaleCm,
        payScaleOverride,
        cadreClassification,
        salaryDetailsMarkdown,
        applicationStart,
        applicationEnd,
        examDate,
        vacanciesBreakdown,
        importantDates,
        sources,
        officialLinks,
        seoTitle,
        seoDescription,
        robotsIndex,
        adminEmail: Astro.locals.adminEmail,
      });

      if (updateResult.success) {
        successMessage = `Saved changes to "${title}" successfully!`;
      } else {
        errorMessage = updateResult.message || 'Update failed.';
        validationErrors = updateResult.errors || [];
      }
    } else {
      errorMessage = 'Please provide title, canonical post, and advertisement number.';
    }
  } catch (err: any) {
    errorMessage = `Update error: ${err.message}`;
  }
}

// Group posts by sector for clean optgroup dropdown rendering
const postsBySector = sectors.map(sec => ({
  sector: sec,
  posts: posts.filter(p => p.sectorId === sec.id),
})).filter(group => group.posts.length > 0);

// Pre-fill helpers
const vacMap = new Map((recruitment.vacanciesList || []).map((v: any) => [v.code || v.category, v.count]));
const vacUr = vacMap.get('UR') || 0;
const vacObc = vacMap.get('OBC') || 0;
const vacSt = vacMap.get('ST') || 0;
const vacSc = vacMap.get('SC') || 0;
const vacEws = vacMap.get('EWS') || 0;
const firstSubPost = recruitment.vacanciesList?.find((v: any) => v.subPostName)?.subPostName || '';

const datesList = recruitment.importantDatesList || [];
const notifDateObj = datesList.find((d: any) => d.eventType === 'NOTIFICATION');
const appStartDateObj = datesList.find((d: any) => d.eventType === 'APPLICATION_START');
const appEndDateObj = datesList.find((d: any) => d.eventType === 'APPLICATION_END');
const corrDateObj = datesList.find((d: any) => d.eventType === 'CORRECTION_END');
const examDateObj = datesList.find((d: any) => d.eventType === 'EXAM_DATE');

const primarySource = recruitment.sourcesList?.[0];
const primaryApplyLink = recruitment.officialLinksList?.find((l: any) => l.linkType === 'APPLY_ONLINE');
const admitCardLink = recruitment.officialLinksList?.find((l: any) => l.linkType === 'ADMIT_CARD');
const answerKeyLink = recruitment.officialLinksList?.find((l: any) => ['ANSWER_KEY', 'PROVISIONAL_ANSWER_KEY', 'FINAL_ANSWER_KEY'].includes(l.linkType));
const resultLink = recruitment.officialLinksList?.find((l: any) => ['RESULT', 'SCORECARD', 'MERIT_LIST'].includes(l.linkType));
---

<AdminLayout
  title={`Edit ${recruitment.title}`}
  currentSection="recruitments"
  breadcrumbs={[
    { label: 'Recruitments', href: '/admin/recruitments' },
    { label: `Edit: ${advtLabel(recruitment.advtNumber)}` },
  ]}
>
  <form id="recruitmentEditForm" method="POST" class="mx-auto max-w-6xl space-y-6">
    <!-- Top Action Bar (FlowStep Screen 22) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          {recruitment.title}
        </h1>
        <div class="flex items-center gap-2 text-xs text-zinc-500 font-mono">
          <span>Advt: {advtLabel(recruitment.advtNumber)}</span>
          <span>·</span>
          <a href={`/admin/recruitments/${recruitment.id}/versions`} class="text-primary underline">History</a>
          <span>·</span>
          <span>Slug: {recruitment.slug}</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href={`/recruitments/${recruitment.slug}`}
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors"
        >
          <span>Live Preview</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>

        <button
          type="submit"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Save Changes</span>
        </button>
      </div>
    </div>

    {successMessage && (
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-800">
        ✅ {successMessage}
      </div>
    )}

    {errorMessage && (
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs font-semibold text-rose-800">
        ⛔ {errorMessage}
      </div>
    )}

    {validationErrors.length > 0 && (
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-xs text-amber-950 space-y-1">
        <div class="font-bold">⚠️ Publication Warnings:</div>
        <ul class="list-disc pl-5 space-y-0.5">
          {validationErrors.map(e => <li>{e}</li>)}
        </ul>
      </div>
    )}

    <!-- FlowStep Screen 22 Two-Column Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] items-start gap-6">
      <!-- Left Column: Form with Tabs -->
      <div class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
        <!-- Tab Navigation Bar -->
        <div class="flex items-center border-b border-zinc-200 bg-zinc-50/50 px-4 overflow-x-auto" id="editorTabs">
          {[
            { id: 'basic', label: 'Basic' },
            { id: 'vacancy', label: 'Vacancy' },
            { id: 'eligibility', label: 'Eligibility' },
            { id: 'dates', label: 'Dates' },
            { id: 'sources', label: 'Sources' },
            { id: 'seo', label: 'SEO' },
          ].map((tab, idx) => (
            <button
              type="button"
              data-tab={tab.id}
              class={`tab-trigger py-3 px-4 text-xs font-semibold border-b-2 transition-colors cursor-pointer whitespace-nowrap ${
                idx === 0
                  ? 'border-primary text-zinc-950'
                  : 'border-transparent text-zinc-500 hover:text-zinc-900'
              }`}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <div class="p-6 space-y-6">
          <!-- Tab 1: Basic Information -->
          <div id="tab-basic" class="tab-pane space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Basic Information & Publication Status</h2>
              <p class="text-xs text-zinc-500">Core metadata, canonical post reference, and lifecycle states.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Recruitment Public Title *</label>
                <input
                  type="text"
                  name="title"
                  required
                  value={recruitment.title}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Canonical Post Reference *</label>
                <select
                  name="postId"
                  required
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none bg-white"
                >
                  {postsBySector.map(group => (
                    <optgroup label={group.sector.name}>
                      {group.posts.map((post: any) => (
                        <option value={post.id} selected={post.id === recruitment.postId}>{post.title}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Organisation *</label>
                <select
                  name="organisationId"
                  required
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                >
                  {organisations.map(org => <option value={org.id} selected={org.shortName === recruitment.organisationShortName}>{org.name} ({org.shortName})</option>)}
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Advertisement Number</label>
                <input
                  type="text"
                  name="advtNumber"
                  placeholder="Leave blank if the notice states none"
                  value={recruitment.advtNumber ?? ''}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Publication Status</label>
                <select
                  name="status"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none bg-white"
                >
                  {['PUBLISHED', 'PENDING_VERIFICATION', 'DRAFT', 'ARCHIVED'].map(s => (
                    <option value={s} selected={recruitment.status === s}>{s}</option>
                  ))}
                </select>
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Cycle Year</label>
                <input type="number" name="cycleYear" value={recruitment.cycleYear} min="2020" max="2035" class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono" />
              </div>
              <label class="flex items-center gap-2 text-xs font-medium text-zinc-800">
                <input type="checkbox" name="isFeatured" value="1" checked={recruitment.isFeatured === 1} /> Featured recruitment
              </label>

              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Short Summary</label>
                <input
                  type="text"
                  name="shortSummary"
                  value={recruitment.shortSummary || ''}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="sm:col-span-2 space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Detailed Overview Markdown</label>
                <textarea
                  name="overviewMarkdown"
                  rows="4"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono focus:ring-2 focus:ring-zinc-900 outline-none"
                >{recruitment.overviewMarkdown || ''}</textarea>
              </div>
            </div>
          </div>

          <!-- Tab 2: Vacancy -->
          <div id="tab-vacancy" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Vacancy Breakdown & Cadre</h2>
              <p class="text-xs text-zinc-500">Official vacancies count and reservation matrix.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Total Overall Vacancies *</label>
                <input
                  type="number"
                  name="totalVacancies"
                  required
                  value={recruitment.totalVacancies}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono font-bold tabular-nums focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Sub-Post / Stream Name</label>
                <input
                  type="text"
                  name="subPostName"
                  value={firstSubPost}
                  placeholder="e.g. Constable (GD) or Patwari"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Pay Scale Override</label>
                <input
                  type="text"
                  name="payScaleOverride"
                  value={recruitment.payScaleOverride || ''}
                  placeholder="e.g. Rs. 19,500 - 62,000"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Cadre Classification</label>
                <input
                  type="text"
                  name="cadreClassification"
                  value={recruitment.cadreClassification || ''}
                  placeholder="e.g. Group C Non-Gazetted"
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
                />
              </div>

              <!-- Reservation Quota Rows -->
              <div class="sm:col-span-2 grid grid-cols-2 sm:grid-cols-5 gap-3 pt-2">
                <div>
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">UR / General</label>
                  <input type="number" name="vac_ur" value={vacUr} class="w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">OBC</label>
                  <input type="number" name="vac_obc" value={vacObc} class="w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">SC</label>
                  <input type="number" name="vac_sc" value={vacSc} class="w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">ST</label>
                  <input type="number" name="vac_st" value={vacSt} class="w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-zinc-600 mb-1">EWS</label>
                  <input type="number" name="vac_ews" value={vacEws} class="w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
                </div>
              </div>
            </div>
          </div>

          <!-- Tab 3: Eligibility -->
          <div id="tab-eligibility" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Statutory Eligibility Criteria</h2>
              <p class="text-xs text-zinc-500">Education, age limits, relaxations, and physical criteria.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div>
                <label class="block text-xs font-semibold text-zinc-800 mb-1">Min Age</label>
                <input type="number" name="minAge" min="14" max="45" value={recruitment.criteria?.minAge ?? 18} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-800 mb-1">Max Age General</label>
                <input type="number" name="maxAgeGeneral" min="18" max="65" value={recruitment.criteria?.maxAgeGeneral ?? 33} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono tabular-nums outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-800 mb-1">Age Cutoff Date</label>
                <input type="date" name="ageCutoffDate" value={recruitment.criteria?.ageCutoffDate || '2026-01-01'} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-800 mb-1">Min Qualification</label>
                <select name="minQualificationLevel" class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs outline-none bg-white font-mono">
                  {['8TH', '10TH', '12TH', 'ITI', 'DIPLOMA', 'GRADUATION', 'POST_GRADUATION'].map(q => (
                    <option value={q} selected={recruitment.criteria?.minQualificationLevel === q}>{q}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <label class="flex items-center gap-2 text-xs font-medium text-zinc-800 cursor-pointer">
                <input type="checkbox" name="requiresMpDomicile" value="1" checked={recruitment.criteria?.requiresMpDomicile} class="size-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900" />
                <span>State Domicile Mandatory</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-medium text-zinc-800 cursor-pointer">
                <input type="checkbox" name="requiresMpEmploymentReg" value="1" checked={recruitment.criteria?.requiresMpEmploymentReg} class="size-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900" />
                <span>Employment Registration</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-medium text-zinc-800 cursor-pointer">
                <input type="checkbox" name="requiresCpct" value="1" checked={recruitment.criteria?.requiresCpct} class="size-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900" />
                <span>CPCT Scorecard</span>
              </label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <label class="text-xs font-semibold text-zinc-800">Required domicile jurisdiction<select name="domicileStateCode" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200 bg-white"><option value="">None / open to all India</option>{states.filter(state => state.code !== 'IN').map(state => <option value={state.code} selected={recruitment.criteria?.domicileStateCode === state.code}>{state.name} ({state.code})</option>)}</select></label>
              <label class="text-xs font-semibold text-zinc-800">Employment registration key<input type="text" name="employmentRegistrationLabel" value={recruitment.criteria?.employmentRegistrationLabel || ''} placeholder="e.g. MP_ROJGAR" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200 font-mono" /></label>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              {[
                ['ageRelaxationScSt', 'SC/ST relaxation', recruitment.criteria?.ageRelaxationScSt],
                ['ageRelaxationObc', 'OBC relaxation', recruitment.criteria?.ageRelaxationObc],
                ['ageRelaxationFemale', 'Female relaxation', recruitment.criteria?.ageRelaxationFemale],
                ['ageRelaxationEws', 'EWS relaxation', recruitment.criteria?.ageRelaxationEws],
              ].map(([name, label, value]) => (
                <label class="text-xs font-semibold text-zinc-800">{label}<input type="number" min="0" name={String(name)} value={Number(value ?? 0)} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              ))}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <label class="text-xs font-semibold text-zinc-800">Minimum percentage<input type="number" min="0" max="100" step="0.01" name="minPercentageRequired" value={recruitment.criteria?.minPercentageRequired ?? ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Experience months<input type="number" min="0" name="experienceMonths" value={recruitment.criteria?.experienceMonths ?? 0} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Allowed streams<input type="text" name="allowedStreams" value={recruitment.criteria?.allowedStreams?.join(', ') || ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Required certificates<input type="text" name="additionalSkills" value={recruitment.criteria?.additionalSkills?.join(', ') || ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Male height (cm)<input type="number" step="0.1" name="minHeightMaleCm" value={recruitment.criteria?.minHeightMaleCm ?? ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Female height (cm)<input type="number" step="0.1" name="minHeightFemaleCm" value={recruitment.criteria?.minHeightFemaleCm ?? ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Male chest (cm)<input type="number" step="0.1" name="minChestMaleCm" value={recruitment.criteria?.minChestMaleCm ?? ''} class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="text-xs font-semibold text-zinc-800">Allowed gender<select name="genderAllowed" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200"><option value="ALL" selected={recruitment.criteria?.genderAllowed === 'ALL'}>All</option><option value="MALE" selected={recruitment.criteria?.genderAllowed === 'MALE'}>Male only</option><option value="FEMALE" selected={recruitment.criteria?.genderAllowed === 'FEMALE'}>Female only</option></select></label>
            </div>

            <div class="space-y-1.5 pt-2">
              <label class="block text-xs font-semibold text-zinc-800">Qualification Details Markdown</label>
              <textarea
                name="qualificationDetailsMarkdown"
                rows="3"
                class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
              >{recruitment.criteria?.qualificationDetailsMarkdown || ''}</textarea>
            </div>
          </div>

          <!-- Tab 4: Dates -->
          <div id="tab-dates" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Important Dates & Calendar Milestones</h2>
              <p class="text-xs text-zinc-500">Timeline events feeding the public milestone calendar.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Gazette Notification Date</label>
                <input type="date" name="notificationDate" value={notifDateObj?.eventDate || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Application Start</label>
                <input type="date" name="applicationStart" value={appStartDateObj?.eventDate || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Application Deadline</label>
                <input type="date" name="applicationEnd" value={appEndDateObj?.eventDate || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Correction Deadline</label>
                <input type="date" name="correctionEnd" value={corrDateObj?.eventDate || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Scheduled Exam Date</label>
                <input type="date" name="examDate" value={examDateObj?.eventDate || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
            </div>
          </div>

          <!-- Tab 5: Sources -->
          <div id="tab-sources" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">Official Gazette Provenance & Application URLs</h2>
              <p class="text-xs text-zinc-500">Traceable official links and candidate application endpoint.</p>
            </div>

            <div class="space-y-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Official Notification Gazette URL</label>
                <input
                  type="url"
                  name="sourceUrl"
                  value={primarySource?.sourceUrl || ''}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Official Apply Online Portal URL</label>
                <input
                  type="url"
                  name="officialApplyUrl"
                  value={primaryApplyLink?.url || ''}
                  class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none"
                />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Admit Card URL</label>
                <input type="url" name="admitCardUrl" value={admitCardLink?.url || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Answer Key URL</label>
                <input type="url" name="answerKeyUrl" value={answerKeyLink?.url || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-zinc-800">Result / Merit List URL</label>
                <input type="url" name="resultUrl" value={resultLink?.url || ''} class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs font-mono outline-none" />
              </div>
            </div>
          </div>

          <!-- Tab 6: SEO -->
          <div id="tab-seo" class="tab-pane hidden space-y-5">
            <div class="border-b border-zinc-100 pb-2">
              <h2 class="text-sm font-bold text-zinc-950">SEO & Metadata Configuration</h2>
              <p class="text-xs text-zinc-500">Google SERP previews and social card optimization.</p>
            </div>

            <div class="space-y-4">
              <div class="p-3.5 rounded-lg border border-zinc-200 bg-zinc-50 text-xs font-mono text-zinc-600">
                Canonical URL: /recruitments/{recruitment.slug}
              </div>
              <label class="block text-xs font-semibold text-zinc-800">Page meta title<input type="text" name="seoTitle" value={recruitment.seoTitle || ''} placeholder="Leave empty to inherit the generated title" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200" /></label>
              <label class="block text-xs font-semibold text-zinc-800">Meta description<textarea name="seoDescription" rows="3" class="mt-1 w-full px-3 py-2 rounded-lg border border-zinc-200">{recruitment.seoDescription || ''}</textarea></label>
              <label class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-800"><input type="checkbox" name="robotsIndex" value="1" checked={recruitment.robotsIndex !== 0} /> Allow search-engine indexing</label>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Completeness Checklist (FlowStep Screen 22) -->
      <aside class="sticky top-20 space-y-4">
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-950">Record Quality</h3>
            <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
              88% Verified
            </span>
          </div>

          <div class="w-full bg-zinc-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-primary h-1.5 rounded-full" style="width: 88%"></div>
          </div>

          <!-- Checklist Items with Jump Actions -->
          <div class="space-y-2 text-xs">
            <button type="button" data-jump="basic" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Basic information
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Done</span>
            </button>

            <button type="button" data-jump="vacancy" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Vacancies breakdown
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Done</span>
            </button>

            <button type="button" data-jump="eligibility" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Eligibility criteria
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Done</span>
            </button>

            <button type="button" data-jump="dates" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Timeline dates
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Done</span>
            </button>

            <button type="button" data-jump="sources" class="jump-btn flex items-center justify-between w-full text-left p-1.5 rounded hover:bg-zinc-50 transition-colors">
              <span class="flex items-center gap-2 text-zinc-800">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Official source
              </span>
              <span class="text-[10px] text-emerald-700 font-semibold">Done</span>
            </button>
          </div>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs text-xs space-y-2">
          <div class="font-bold text-zinc-900">Eligibility Sync</div>
          <p class="text-zinc-500 text-[11px]">
            Changes to age or qualification immediately update candidate eligibility evaluation across the state engine.
          </p>
          <a href={`/admin/eligibility-rules?recruitment=${encodeURIComponent(recruitment.title)}`} class="inline-block text-xs font-semibold text-zinc-950 hover:underline">
            Manage Custom Rules &rarr;
          </a>
        </div>
      </aside>
    </div>
  </form>

  <!-- Client-side Tab Switcher -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const triggers = document.querySelectorAll('.tab-trigger');
      const panes = document.querySelectorAll('.tab-pane');
      const jumpButtons = document.querySelectorAll('.jump-btn');

      function switchTab(tabId) {
        triggers.forEach(t => {
          if (t.dataset.tab === tabId) {
            t.classList.add('border-primary', 'text-zinc-950');
            t.classList.remove('border-transparent', 'text-zinc-500');
          } else {
            t.classList.remove('border-primary', 'text-zinc-950');
            t.classList.add('border-transparent', 'text-zinc-500');
          }
        });

        panes.forEach(p => {
          if (p.id === `tab-${tabId}`) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      }

      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          switchTab(trigger.dataset.tab);
        });
      });

      jumpButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.dataset.jump;
          switchTab(tabId);
        });
      });
    });
  </script>
  <AgeRangeGuard />
</AdminLayout>
