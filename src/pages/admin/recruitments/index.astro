---
import { advtLabel } from '../../../services/advt-number';
// src/pages/admin/recruitments/index.astro (FlowStep Screen 21)
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminDataTable from '../../../components/admin/AdminDataTable.astro';
import { getAllActiveRecruitments, updateRecruitmentStatus } from '../../../db/queries';

let statusFeedback = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();
    const selectedIds = formData.getAll('selectedIds').map(id => id.toString());
    if (!Astro.locals.adminEmail) throw new Error('Admin identity is required.');

    if (selectedIds.length > 0) {
      if (action === 'bulk_publish') {
        for (const id of selectedIds) {
          await updateRecruitmentStatus(id, 'PUBLISHED', Astro.locals.adminEmail);
        }
        statusFeedback = `Successfully published ${selectedIds.length} recruitment record(s).`;
      } else if (action === 'bulk_archive') {
        for (const id of selectedIds) {
          await updateRecruitmentStatus(id, 'ARCHIVED', Astro.locals.adminEmail);
        }
        statusFeedback = `Successfully archived ${selectedIds.length} recruitment record(s).`;
      }
    }
  } catch (err: any) {
    statusFeedback = `Action error: ${err.message}`;
  }
}

// @ts-ignore
const allRecruitments = await getAllActiveRecruitments(undefined, { includeUnpublished: true });
const q = Astro.url.searchParams.get('q')?.toLowerCase().trim() || '';
const filterStatus = Astro.url.searchParams.get('status') || 'ALL';

let recruitments = allRecruitments;
if (q) {
  recruitments = recruitments.filter(r =>
    r.title?.toLowerCase().includes(q) ||
    r.postTitle?.toLowerCase().includes(q) ||
    r.organisationShortName?.toLowerCase().includes(q) ||
    r.advtNumber?.toLowerCase().includes(q)
  );
}

if (filterStatus !== 'ALL') {
  if (filterStatus === 'PUBLISHED') {
    recruitments = recruitments.filter(r => r.status === 'PUBLISHED');
  } else if (filterStatus === 'DRAFT') {
    recruitments = recruitments.filter(r => r.status === 'DRAFT');
  } else if (filterStatus === 'REVIEW' || filterStatus === 'NEEDS_VERIFICATION') {
    recruitments = recruitments.filter(r => r.status === 'PENDING_VERIFICATION' || r.status === 'REVIEW');
  } else if (filterStatus === 'VERIFIED') {
    recruitments = recruitments.filter(r => r.status === 'PUBLISHED' && r.sourceVerified !== false);
  } else if (filterStatus === 'ARCHIVED') {
    recruitments = recruitments.filter(r => r.status === 'ARCHIVED' || r.lifecycleStatus === 'EXPIRED');
  } else if (filterStatus === 'OPEN') {
    recruitments = recruitments.filter(r => r.resolvedLifecycle === 'APPLICATION_OPEN' || r.lifecycleStatus === 'OPEN');
  } else if (filterStatus === 'CLOSING_SOON') {
    recruitments = recruitments.filter(r => r.resolvedLifecycle === 'APPLICATION_CLOSING');
  }
}

const filterOptions = [
  { label: 'All records', value: 'ALL' },
  { label: 'Draft', value: 'DRAFT' },
  { label: 'Review', value: 'REVIEW' },
  { label: 'Verified', value: 'VERIFIED' },
  { label: 'Published', value: 'PUBLISHED' },
  { label: 'Archived', value: 'ARCHIVED' },
];
---

<AdminLayout title="Recruitments" currentSection="recruitments" breadcrumbs={[{ label: 'Recruitments' }]}>
  <div class="mx-auto max-w-7xl space-y-6">
    {statusFeedback && (
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 flex items-center justify-between">
        <span>{statusFeedback}</span>
        <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 font-bold hover:text-emerald-950">×</button>
      </div>
    )}

    <!-- Header with Action (FlowStep Screen 21) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
          Recruitments
        </h1>
        <p class="text-xs text-zinc-500 mt-0.5">
          Manage, verify and publish opportunity records
        </p>
      </div>

      <a
        href="/admin/recruitments/new"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add recruitment</span>
      </a>
    </div>

    <!-- Search & Secondary Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <form method="get" action="/admin/recruitments" class="relative max-w-sm w-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="search"
          name="q"
          defaultValue={q}
          placeholder="Search recruitments..."
          class="w-full pl-9 pr-3 py-2 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 focus:border-zinc-900 shadow-2xs"
        />
        {filterStatus !== 'ALL' && (
          <input type="hidden" name="status" value={filterStatus} />
        )}
      </form>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="toggleMoreFiltersBtn"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-medium shadow-2xs transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <span>More filters</span>
        </button>

        <button
          type="button"
          id="exportRecruitmentsBtn"
          aria-label="Export recruitments"
          title="Export recruitments to CSV"
          class="inline-flex items-center justify-center size-8 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 shadow-2xs transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>
      </div>
    </div>

    <!-- More Filters Drawer Panel -->
    <div id="moreFiltersPanel" class="hidden p-4 rounded-xl border border-zinc-200 bg-zinc-50/80 text-xs space-y-3">
      <div class="flex items-center justify-between">
        <span class="font-bold text-zinc-900">Advanced Filter Criteria</span>
        <button type="button" id="closeMoreFiltersBtn" class="text-zinc-500 hover:text-zinc-800 text-xs">Close</button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-zinc-600 font-medium mb-1">Status Mode</label>
          <select id="advFilterStatus" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-300 bg-white text-xs">
            <option value="ALL">All Records</option>
            <option value="PUBLISHED">Published Only</option>
            <option value="DRAFT">Drafts Only</option>
            <option value="OPEN">Application Open</option>
          </select>
        </div>
        <div>
          <label class="block text-zinc-600 font-medium mb-1">Verification</label>
          <select id="advFilterVerification" class="w-full px-2.5 py-1.5 rounded-lg border border-zinc-300 bg-white text-xs">
            <option value="ALL">All Verification States</option>
            <option value="VERIFIED">Verified Source Only</option>
            <option value="UNVERIFIED">Pending Verification Only</option>
          </select>
        </div>
        <div class="flex items-end gap-2">
          <button type="button" id="applyAdvFiltersBtn" class="w-full py-1.5 px-3 rounded-lg bg-primary text-white font-semibold text-xs hover:bg-primary-hover">
            Apply Filters
          </button>
        </div>
      </div>
    </div>

    <!-- Status Filter Chips (FlowStep Screen 21) -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs border-b border-zinc-200">
      {filterOptions.map((opt) => (
        <a
          href={`/admin/recruitments?status=${opt.value}${q ? `&q=${encodeURIComponent(q)}` : ''}`}
          class={`px-3 py-1.5 rounded-md font-medium transition-all whitespace-nowrap ${
            filterStatus === opt.value
              ? 'bg-primary text-white font-semibold shadow-xs'
              : 'text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100'
          }`}
        >
          {opt.label}
        </a>
      ))}
    </div>

    <!-- Dense Table with FlowStep Screen 21 Columns -->
    <form method="POST" id="bulkRecruitmentForm" class="rounded-xl border border-zinc-200 bg-white shadow-2xs overflow-hidden">
      <input type="hidden" name="_action" id="bulkFormAction" value="" />

      <!-- Bulk Toolbar -->
      <div class="flex items-center justify-between border-b border-zinc-200 bg-zinc-50/70 px-4 py-2 text-xs">
        <div class="flex items-center gap-3 text-zinc-600">
          <input
            type="checkbox"
            id="selectAll"
            class="size-3.5 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900 cursor-pointer"
          />
          <label for="selectAll" class="text-[11px] font-medium text-zinc-500 cursor-pointer">Select all records</label>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="publishSelectedBtn"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-medium text-zinc-700 hover:bg-zinc-200 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>Publish selected</span>
          </button>
          <button
            type="button"
            id="archiveSelectedBtn"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-medium text-zinc-700 hover:bg-zinc-200 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
            <span>Archive selected</span>
          </button>
        </div>
      </div>

      <!-- Scannable Table Surface -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse" id="recruitmentsDataTable">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/50 font-semibold uppercase text-[10px] tracking-wider text-zinc-500">
              <th class="w-10 py-3 px-4"></th>
              <th class="py-3 px-3 min-w-[220px]">Recruitment</th>
              <th class="py-3 px-3 min-w-[110px]">Organisation</th>
              <th class="py-3 px-3 min-w-[130px]">Department</th>
              <th class="py-3 px-3 min-w-[100px]">Status</th>
              <th class="py-3 px-3 min-w-[110px]">Applications</th>
              <th class="py-3 px-3 min-w-[110px]">Last date</th>
              <th class="py-3 px-3 min-w-[100px]">Source</th>
              <th class="py-3 px-3 min-w-[130px]">Verification</th>
              <th class="py-3 px-3 min-w-[100px]">Updated</th>
              <th class="py-3 px-4 text-right min-w-[90px]">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {recruitments.length === 0 ? (
              <tr>
                <td colspan="11" class="py-12 text-center text-zinc-500">
                  <p class="font-medium">No recruitments found matching current criteria.</p>
                  <a href="/admin/recruitments" class="mt-1 text-xs font-semibold text-zinc-950 underline inline-block">
                    Clear all filters
                  </a>
                </td>
              </tr>
            ) : (
              recruitments.map((r: any, idx: number) => {
                const isVerified = r.status === 'PUBLISHED' && r.sourceVerified !== false;
                const recId = `REC-2026-${String(idx + 1).padStart(3, '0')}`;
                return (
                  <tr class="hover:bg-zinc-50/80 transition-colors">
                    <td class="py-3 px-4">
                      <input
                        type="checkbox"
                        name="selectedIds"
                        value={r.id}
                        class="recruitment-row-checkbox size-3.5 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900 cursor-pointer"
                      />
                    </td>
                    <td class="py-3 px-3">
                      <a href={`/admin/recruitments/${r.id}/edit`} class="font-semibold text-zinc-950 hover:underline block leading-tight">
                        {r.title}
                      </a>
                      <div class="text-[10px] text-zinc-400 font-mono mt-0.5">
                        Advt: {advtLabel(r.advtNumber)} · ID {recId}
                      </div>
                    </td>
                    <td class="py-3 px-3 font-medium text-zinc-800 font-mono">
                      {r.organisationShortName || 'Government authority'}
                    </td>
                    <td class="py-3 px-3 text-zinc-600">
                      {r.postTitle || 'General Cadre'}
                    </td>
                    <td class="py-3 px-3">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${
                        r.status === 'PUBLISHED'
                          ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                          : r.status === 'DRAFT'
                          ? 'bg-zinc-100 text-zinc-800 border-zinc-200'
                          : 'bg-amber-50 text-amber-800 border-amber-200'
                      }`}>
                        {r.status || 'Draft'}
                      </span>
                    </td>
                    <td class="py-3 px-3 font-mono font-semibold text-zinc-950 tabular-nums">
                      {r.totalVacancies ? r.totalVacancies.toLocaleString() : '—'}
                    </td>
                    <td class="py-3 px-3 font-mono text-zinc-700 whitespace-nowrap">
                      {r.applicationEnd ? new Date(r.applicationEnd).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'To be gazetted'}
                    </td>
                    <td class="py-3 px-3">
                      <a
                        href={r.sourceUrl || '#'}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center gap-1 text-zinc-500 hover:text-zinc-950 text-[11px]"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        <span>Official link</span>
                      </a>
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap">
                      {isVerified ? (
                        <a href={`/admin/sources?recruitment=${encodeURIComponent(r.title)}`} class="inline-flex items-center gap-1 text-emerald-700 text-[11px] font-medium hover:underline">
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
                          <span>Verified</span>
                        </a>
                      ) : (
                        <a href={`/admin/sources?recruitment=${encodeURIComponent(r.title)}`} class="inline-flex items-center gap-1 text-amber-700 text-[11px] font-medium hover:underline">
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                          <span>Needs verification</span>
                        </a>
                      )}
                    </td>
                    <td class="py-3 px-3 text-[11px] text-zinc-500 font-mono whitespace-nowrap">
                      {r.updatedAt ? new Date(r.updatedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Recently'}
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="flex items-center justify-end gap-1">
                        <!-- Edit Button -->
                        <a
                          href={`/admin/recruitments/${r.id}/edit`}
                          title="Edit Recruitment"
                          class="p-1 rounded text-zinc-500 hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                        </a>

                        <!-- Preview Button -->
                        <a
                          href={`/recruitments/${r.slug}`}
                          target="_blank"
                          title="Public Preview"
                          class="p-1 rounded text-zinc-500 hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>

                        <!-- Eligibility Rules Link -->
                        <a
                          href={`/admin/eligibility-rules?recruitment=${encodeURIComponent(r.title)}`}
                          title="Eligibility Rules"
                          class="p-1 rounded text-zinc-500 hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                        </a>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </form>
  </div>

  <AdminDataTable tableId="recruitmentsDataTable" perPage={10} columns={[{ select: [0, 10], sortable: false }]} />

  <script is:inline>
    // 1. Select All Checkbox Handler
    const selectAllCheckbox = document.getElementById('selectAll');
    selectAllCheckbox?.addEventListener('change', (e) => {
      const isChecked = e.target.checked;
      document.querySelectorAll('.recruitment-row-checkbox').forEach((cb) => {
        cb.checked = isChecked;
      });
    });

    // 2. Bulk Publish Action
    document.getElementById('publishSelectedBtn')?.addEventListener('click', () => {
      const selected = document.querySelectorAll('.recruitment-row-checkbox:checked');
      if (selected.length === 0) {
        alert('Please select at least one recruitment record to publish.');
        return;
      }
      if (confirm(`Are you sure you want to publish ${selected.length} selected recruitment record(s)?`)) {
        const actionInput = document.getElementById('bulkFormAction');
        if (actionInput) actionInput.value = 'bulk_publish';
        document.getElementById('bulkRecruitmentForm')?.submit();
      }
    });

    // 3. Bulk Archive Action
    document.getElementById('archiveSelectedBtn')?.addEventListener('click', () => {
      const selected = document.querySelectorAll('.recruitment-row-checkbox:checked');
      if (selected.length === 0) {
        alert('Please select at least one recruitment record to archive.');
        return;
      }
      if (confirm(`Are you sure you want to archive ${selected.length} selected recruitment record(s)?`)) {
        const actionInput = document.getElementById('bulkFormAction');
        if (actionInput) actionInput.value = 'bulk_archive';
        document.getElementById('bulkRecruitmentForm')?.submit();
      }
    });

    // 4. More Filters Toggle
    const moreFiltersPanel = document.getElementById('moreFiltersPanel');
    document.getElementById('toggleMoreFiltersBtn')?.addEventListener('click', () => {
      moreFiltersPanel?.classList.toggle('hidden');
    });
    document.getElementById('closeMoreFiltersBtn')?.addEventListener('click', () => {
      moreFiltersPanel?.classList.add('hidden');
    });
    document.getElementById('applyAdvFiltersBtn')?.addEventListener('click', () => {
      const status = document.getElementById('advFilterStatus')?.value;
      const url = new URL(window.location.href);
      if (status && status !== 'ALL') {
        url.searchParams.set('status', status);
      } else {
        url.searchParams.delete('status');
      }
      window.location.href = url.toString();
    });

    // 5. CSV Export
    document.getElementById('exportRecruitmentsBtn')?.addEventListener('click', () => {
      const table = document.getElementById('recruitmentsDataTable');
      if (!table) return;
      const rows = Array.from(table.querySelectorAll('tr'));
      const csvContent = rows.map((row) => {
        const cols = Array.from(row.querySelectorAll('th, td')).slice(1, 10);
        return cols.map((c) => `"${(c.innerText || '').replace(/"/g, '""').trim()}"`).join(',');
      }).join('\n');

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `recruitments-export-${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  </script>
</AdminLayout>
