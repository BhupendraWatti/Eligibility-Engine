---
// src/pages/admin/seo.astro (FlowStep Screen 29)
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllActiveRecruitments, updateRecruitmentSeo } from '../../db/queries';
import { readAdminSubmission, parseBooleanInput } from '../../services/admin-integrity';
import { recruitmentSeo, TITLE_MAX, DESCRIPTION_MAX } from '../../services/seo';

const recruitments = await getAllActiveRecruitments(undefined, { includeUnpublished: true });
// Picked by id: two recruitments can share a title (e.g. a draft and its published copy). Title kept for old links.
const selectedParam = Astro.url.searchParams.get('recruitment') || '';
const currentRec = recruitments.find(r => r.id === selectedParam)
  || recruitments.find(r => r.title === selectedParam)
  || recruitments[0];

// The same generator the public recruitment page falls back to, so the preview matches the live page.
const generated = currentRec ? recruitmentSeo({
  title: currentRec.title,
  postTitle: currentRec.postTitle,
  organisationShortName: currentRec.organisationShortName,
  stateCode: currentRec.stateCode,
  totalVacancies: currentRec.totalVacancies,
  minQualificationLevel: currentRec.criteria.minQualificationLevel,
  cycleYear: currentRec.cycleYear,
  applicationEnd: currentRec.applicationEnd,
}) : { title: '', description: '' };
let message = '';
let messageType: 'success' | 'error' = 'success';
if (Astro.request.method === 'POST') {
  try {
    if (!Astro.locals.adminEmail || !currentRec) throw new Error('An authenticated admin and recruitment are required.');
    const input = await readAdminSubmission(Astro.request);
    const restore = input.text('_action') === 'restore';
    // A value equal to the generated one is not an override: store null so it keeps following the record.
    const override = (value: string, auto: string) => (value && value !== auto ? value : null);
    const seoTitle = restore ? null : override(input.text('seoTitle'), generated.title);
    const seoDescription = restore ? null : override(input.text('seoDescription'), generated.description);
    const robotsIndex = restore ? 1 : (parseBooleanInput(input.value('robotsIndex')) ? 1 : 0);
    await updateRecruitmentSeo({ id: currentRec.id, seoTitle, seoDescription, robotsIndex, adminEmail: Astro.locals.adminEmail });
    Object.assign(currentRec, { seoTitle, seoDescription, robotsIndex });
    message = restore ? 'Generated SEO defaults restored.' : 'SEO metadata saved.';
  } catch (error: any) {
    Astro.response.status = 400;
    messageType = 'error';
    message = error.message;
  }
}
const isOverridden = Boolean(currentRec?.seoTitle || currentRec?.seoDescription);
const defaultTitle = currentRec?.seoTitle || generated.title;
const defaultDesc = currentRec?.seoDescription || generated.description;
const canonicalSlug = `/recruitments/${currentRec?.slug || ''}`;
const indexed = currentRec?.robotsIndex !== 0;
const isPublished = currentRec?.status === 'PUBLISHED';
const checks = [
  { ok: defaultTitle.length <= TITLE_MAX, text: defaultTitle.length <= TITLE_MAX ? `Title fits in ${TITLE_MAX} characters` : `Title is ${defaultTitle.length} characters; Google shows about ${TITLE_MAX}, so the end may be cut` },
  { ok: defaultDesc.length <= DESCRIPTION_MAX, text: `Description fits in ${DESCRIPTION_MAX} characters` },
  { ok: indexed, text: indexed ? 'Search engines may index it (listed in the sitemap)' : 'Hidden from search engines and the sitemap' },
  { ok: isPublished, text: isPublished ? 'Published, so the page is public' : 'Not published, so search engines cannot see the page yet' },
];
---

<AdminLayout
  title="SEO Management"
  currentSection="seo"
  breadcrumbs={[
    { label: 'SEO' },
    { label: 'Metadata & SERP preview' },
  ]}
>
  <div class="mx-auto max-w-5xl space-y-6">
    {message && <div role="status" class={`rounded-lg border p-3 text-xs ${messageType === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-rose-200 bg-rose-50 text-rose-900'}`}>{message}</div>}
    <form method="GET" class="flex justify-end"><select name="recruitment" onchange="this.form.submit()" class="rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs">{recruitments.map(rec => <option value={rec.id} selected={rec.id === currentRec?.id}>{rec.title} ({rec.status.replace(/_/g, ' ').toLowerCase()})</option>)}</select></form>
    <!-- Header with Action (FlowStep Screen 29) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-zinc-500">
          <span>Search Engine Optimization</span>
          <span>&rarr;</span>
          <span class="font-medium text-zinc-950">SERP & Meta Management</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
            SEO management
          </h1>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-zinc-100 text-zinc-800 border border-zinc-200">
            {isOverridden ? 'Manual override' : 'Generated from the record'}
          </span>
        </div>
        <p class="text-xs text-zinc-500 font-mono">
          Target: {currentRec?.title}
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="submit"
          form="seoForm"
          name="_action"
          value="restore"
          id="restoreDefaultsBtn"
          class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
        >
          Restore defaults
        </button>
        <button
          type="submit"
          form="seoForm"
          id="saveSeoBtn"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/></svg>
          <span>Save metadata</span>
        </button>
      </div>
    </div>

    <!-- Two-Column Layout (FlowStep Screen 29) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] items-start gap-6">
      <!-- Left: Form Controls -->
      <form method="POST" id="seoForm" class="rounded-xl border border-zinc-200 bg-white p-6 shadow-2xs space-y-5">
        <div class="border-b border-zinc-100 pb-3">
          <h2 class="text-sm font-bold text-zinc-950">Page Metadata & Open Graph</h2>
          <p class="text-xs text-zinc-500">Used for the public recruitment page's browser title, Google snippet and share preview. Leave a field as generated and it keeps updating when the record changes; any edit here replaces it until you restore defaults.</p>
        </div>

        <div class="space-y-4 text-xs">
          <!-- Page Title -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="font-semibold text-zinc-800">Page Meta Title *</label>
              <span data-count-for="seoTitleInput" data-max={TITLE_MAX} class={`text-[10px] font-mono px-1.5 py-0.5 rounded border ${defaultTitle.length <= TITLE_MAX ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-amber-800 bg-amber-50 border-amber-200'}`}>
                {defaultTitle.length} / {TITLE_MAX} chars
              </span>
            </div>
            <input
              type="text"
              id="seoTitleInput"
              name="seoTitle"
              value={defaultTitle}
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <!-- Meta Description -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="font-semibold text-zinc-800">Meta Description *</label>
              <span data-count-for="seoDescInput" data-max={DESCRIPTION_MAX} class={`text-[10px] font-mono px-1.5 py-0.5 rounded border ${defaultDesc.length <= DESCRIPTION_MAX ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-amber-800 bg-amber-50 border-amber-200'}`}>
                {defaultDesc.length} / {DESCRIPTION_MAX} chars
              </span>
            </div>
            <textarea
              id="seoDescInput"
              name="seoDescription"
              rows="3"
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none leading-relaxed"
            >{defaultDesc}</textarea>
          </div>

          <!-- Canonical URL -->
          <div class="space-y-1.5">
            <label class="font-semibold text-zinc-800">Canonical Path</label>
            <input
              type="text"
              readonly
              value={canonicalSlug}
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 bg-zinc-50 text-xs font-mono text-zinc-600 outline-none"
            />
          </div>

          <!-- Indexing Toggle -->
          <div class="pt-2 border-t border-zinc-100 flex items-center justify-between">
            <div>
              <span class="font-semibold text-zinc-900 block">Robots Indexing Status</span>
              <span class="text-[11px] text-zinc-500">Allow major search crawlers (Google, Bing) to index page.</span>
            </div>
            <label class="inline-flex items-center gap-2 cursor-pointer font-semibold text-zinc-900">
              <input type="checkbox" name="robotsIndex" value="1" checked={currentRec?.robotsIndex !== 0} class="size-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900" />
              <span>index, follow</span>
            </label>
          </div>
        </div>
        <button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white">Save metadata</button>
      </form>

      <!-- Right: Live Google SERP Preview Card (FlowStep Screen 29) -->
      <aside class="sticky top-20 space-y-4">
        <!-- Live SERP Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-950">Google SERP Preview</h3>
            <span class="text-[10px] font-mono text-zinc-400">Desktop View</span>
          </div>

          <!-- Google Result Mock -->
          <div class="rounded-lg border border-zinc-100 bg-zinc-50/70 p-3 space-y-1 font-sans">
            <div class="text-[11px] text-zinc-600 flex items-center gap-1 font-mono">
              <span>govtrecruitments.com</span>
              <span>›</span>
              <span>recruitments</span>
              <span>›</span>
              <span class="truncate">{currentRec?.slug}</span>
            </div>
            <div id="serpTitle" class="text-sm font-semibold text-[#1a0dab] leading-snug">
              {defaultTitle}
            </div>
            <p id="serpDesc" class="text-xs text-zinc-600 line-clamp-2 leading-relaxed">
              {defaultDesc}
            </p>
          </div>
        </div>

        <!-- SEO Checklist: computed from the saved record -->
        <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs text-xs space-y-2.5">
          <div class="font-bold text-zinc-950">SEO checks</div>
          <div class="space-y-1.5 text-[11px]">
            {checks.map(c => (
              <div class={`flex items-center gap-2 ${c.ok ? 'text-emerald-700' : 'text-amber-800'}`}>
                <span>{c.ok ? '✓' : '!'}</span>
                <span>{c.text}</span>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    // Live character counts and SERP preview while typing.
    document.querySelectorAll('[data-count-for]').forEach((badge) => {
      const field = document.getElementById(badge.getAttribute('data-count-for'));
      const max = Number(badge.getAttribute('data-max'));
      const preview = document.getElementById(field?.id === 'seoTitleInput' ? 'serpTitle' : 'serpDesc');
      field?.addEventListener('input', () => {
        const n = field.value.length;
        badge.textContent = `${n} / ${max} chars`;
        badge.classList.toggle('text-emerald-700', n <= max);
        badge.classList.toggle('bg-emerald-50', n <= max);
        badge.classList.toggle('border-emerald-200', n <= max);
        badge.classList.toggle('text-amber-800', n > max);
        badge.classList.toggle('bg-amber-50', n > max);
        badge.classList.toggle('border-amber-200', n > max);
        if (preview) preview.textContent = field.value;
      });
    });
  </script>
</AdminLayout>
