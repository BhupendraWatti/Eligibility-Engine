---
// src/pages/admin/seo.astro (FlowStep Screen 29)
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllActiveRecruitments, updateRecruitmentSeo } from '../../db/queries';
import { readAdminSubmission, parseBooleanInput } from '../../services/admin-integrity';

const recruitments = await getAllActiveRecruitments(undefined, { includeUnpublished: true });
const selectedTitle = Astro.url.searchParams.get('recruitment') || recruitments[0]?.title || '';
const currentRec = recruitments.find(r => r.title === selectedTitle) || recruitments[0];

const generatedTitle = `${currentRec?.title || 'Government Recruitment'} | Eligibility, Dates & Official Link`;
const generatedDesc = `Explore ${currentRec?.title || 'this government recruitment'}${currentRec?.stateName ? ` in ${currentRec.stateName}` : ''}. Check eligibility, important dates, vacancies, and direct official links.`;
let message = '';
let messageType: 'success' | 'error' = 'success';
if (Astro.request.method === 'POST') {
  try {
    if (!Astro.locals.adminEmail || !currentRec) throw new Error('An authenticated admin and recruitment are required.');
    const input = await readAdminSubmission(Astro.request);
    const restore = input.text('_action') === 'restore';
    await updateRecruitmentSeo({
      id: currentRec.id,
      seoTitle: restore ? null : input.text('seoTitle') || null,
      seoDescription: restore ? null : input.text('seoDescription') || null,
      robotsIndex: restore ? 1 : (parseBooleanInput(input.value('robotsIndex')) ? 1 : 0),
      adminEmail: Astro.locals.adminEmail,
    });
    message = restore ? 'Generated SEO defaults restored.' : 'SEO metadata saved.';
  } catch (error: any) {
    Astro.response.status = 400;
    messageType = 'error';
    message = error.message;
  }
}
const defaultTitle = currentRec?.seoTitle || generatedTitle;
const defaultDesc = currentRec?.seoDescription || generatedDesc;
const canonicalSlug = `/recruitments/${currentRec?.slug || ''}`;
---

<AdminLayout
  title="SEO Management"
  currentSection="seo"
  breadcrumbs={[
    { label: 'SEO' },
    { label: 'Metadata & SERP preview' },
  ]}
>
  <div class="mx-auto max-w-5xl space-y-6">
    {message && <div role="status" class={`rounded-lg border p-3 text-xs ${messageType === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-rose-200 bg-rose-50 text-rose-900'}`}>{message}</div>}
    <form method="GET" class="flex justify-end"><select name="recruitment" onchange="this.form.submit()" class="rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs">{recruitments.map(rec => <option value={rec.title} selected={rec.id === currentRec?.id}>{rec.title}</option>)}</select></form>
    <!-- Header with Action (FlowStep Screen 29) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-zinc-500">
          <span>Search Engine Optimization</span>
          <span>&rarr;</span>
          <span class="font-medium text-zinc-950">SERP & Meta Management</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold tracking-tight text-zinc-950 font-heading">
            SEO management
          </h1>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-zinc-100 text-zinc-800 border border-zinc-200">
            Inherited defaults
          </span>
        </div>
        <p class="text-xs text-zinc-500 font-mono">
          Target: {selectedTitle}
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="submit"
          form="seoForm"
          name="_action"
          value="restore"
          id="restoreDefaultsBtn"
          class="px-3.5 py-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
        >
          Restore defaults
        </button>
        <button
          type="submit"
          form="seoForm"
          id="saveSeoBtn"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary-hover text-xs font-semibold shadow-xs active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/></svg>
          <span>Save metadata</span>
        </button>
      </div>
    </div>

    <!-- Two-Column Layout (FlowStep Screen 29) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] items-start gap-6">
      <!-- Left: Form Controls -->
      <form method="POST" id="seoForm" class="rounded-xl border border-zinc-200 bg-white p-6 shadow-2xs space-y-5">
        <div class="border-b border-zinc-100 pb-3">
          <h2 class="text-sm font-bold text-zinc-950">Page Metadata & Open Graph</h2>
          <p class="text-xs text-zinc-500">Defaults are generated automatically from structured recruitment records.</p>
        </div>

        <div class="space-y-4 text-xs">
          <!-- Page Title -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="font-semibold text-zinc-800">Page Meta Title *</label>
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
                58 / 60 chars (Optimal)
              </span>
            </div>
            <input
              type="text"
              id="seoTitleInput"
              name="seoTitle"
              value={defaultTitle}
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none"
            />
          </div>

          <!-- Meta Description -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="font-semibold text-zinc-800">Meta Description *</label>
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
                146 / 160 chars (Optimal)
              </span>
            </div>
            <textarea
              id="seoDescInput"
              name="seoDescription"
              rows="3"
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none leading-relaxed"
            >{defaultDesc}</textarea>
          </div>

          <!-- Canonical URL -->
          <div class="space-y-1.5">
            <label class="font-semibold text-zinc-800">Canonical Path</label>
            <input
              type="text"
              readonly
              value={canonicalSlug}
              class="w-full px-3 py-2 rounded-lg border border-zinc-200 bg-zinc-50 text-xs font-mono text-zinc-600 outline-none"
            />
          </div>

          <!-- Indexing Toggle -->
          <div class="pt-2 border-t border-zinc-100 flex items-center justify-between">
            <div>
              <span class="font-semibold text-zinc-900 block">Robots Indexing Status</span>
              <span class="text-[11px] text-zinc-500">Allow major search crawlers (Google, Bing) to index page.</span>
            </div>
            <label class="inline-flex items-center gap-2 cursor-pointer font-semibold text-zinc-900">
              <input type="checkbox" name="robotsIndex" value="1" checked={currentRec?.robotsIndex !== 0} class="size-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900" />
              <span>index, follow</span>
            </label>
          </div>
        </div>
        <button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white">Save metadata</button>
      </form>

      <!-- Right: Live Google SERP Preview Card (FlowStep Screen 29) -->
      <aside class="sticky top-20 space-y-4">
        <!-- Live SERP Card -->
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-950">Google SERP Preview</h3>
            <span class="text-[10px] font-mono text-zinc-400">Desktop View</span>
          </div>

          <!-- Google Result Mock -->
          <div class="rounded-lg border border-zinc-100 bg-zinc-50/70 p-3 space-y-1 font-sans">
            <div class="text-[11px] text-zinc-600 flex items-center gap-1 font-mono">
              <span>nirnay.in</span>
              <span>›</span>
              <span>jobs</span>
              <span>›</span>
              <span class="truncate">{currentRec?.slug || 'mp-police-constable-2026'}</span>
            </div>
            <div class="text-sm font-semibold text-[#1a0dab] hover:underline cursor-pointer leading-snug">
              {defaultTitle}
            </div>
            <p class="text-xs text-zinc-600 line-clamp-2 leading-relaxed">
              {defaultDesc}
            </p>
          </div>

          <div class="pt-2 border-t border-zinc-100 flex items-center justify-between text-xs">
            <span class="font-bold text-zinc-900">Completeness Score:</span>
            <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs">
              84% Complete
            </span>
          </div>
        </div>

        <!-- SEO Checklist -->
        <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-2xs text-xs space-y-2.5">
          <div class="font-bold text-zinc-950">SEO Quality Checks</div>
          <div class="space-y-1.5 text-[11px]">
            <div class="flex items-center gap-2 text-emerald-700">
              <span>✓</span>
              <span>Target authority keywords present</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-700">
              <span>✓</span>
              <span>Length within search viewport constraints</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-700">
              <span>✓</span>
              <span>Structured JSON-LD (JobPosting schema)</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-700">
              <span>✓</span>
              <span>Mobile-optimized viewport configured</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

</AdminLayout>
