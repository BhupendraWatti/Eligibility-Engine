---
// src/pages/admin/users/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminSidebar from '../../../components/admin/AdminSidebar.astro';

const users = [
  {
    name: 'Aarav Mehta',
    email: 'aarav@nirnay.in',
    role: 'Super Admin',
    roleColor: 'bg-indigo-50 text-indigo-700 border-indigo-200',
    status: 'Active',
    lastActive: 'Today, 18:32',
  },
  {
    name: 'Priya Shah',
    email: 'priya@nirnay.in',
    role: 'Reviewer',
    roleColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    status: 'Active',
    lastActive: '2 hours ago',
  },
  {
    name: 'Rohan Verma',
    email: 'rohan@nirnay.in',
    role: 'Editor',
    roleColor: 'bg-blue-50 text-blue-700 border-blue-200',
    status: 'Invited',
    lastActive: 'Never',
  },
];
---

<BaseLayout title="Team Access & Permissions — NIRNAY OPS">
  <div class="flex min-h-[calc(100vh-65px)] bg-background">
    <AdminSidebar current="users" />

    <main class="flex-1 p-6 sm:p-8 max-w-7xl mx-auto w-full">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
        <div>
          <h1 class="text-2xl font-bold text-foreground">Team access</h1>
          <p class="text-xs text-muted-foreground mt-0.5">Keep the small content team focused, segregated, and accountable.</p>
        </div>

        <button type="button" class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold shadow-sm inline-flex items-center gap-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          <span>Invite user</span>
        </button>
      </div>

      <!-- Main Layout: Table (2 Cols) + Invite & Role Legend (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Table Area (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-card rounded-2xl border border-border overflow-hidden shadow-sm">
            <table class="w-full text-xs text-left">
              <thead class="bg-muted text-muted-foreground font-semibold uppercase text-[10px] tracking-wider border-b border-border">
                <tr>
                  <th class="py-3 px-4">Member</th>
                  <th class="py-3 px-4">Role</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4">Last Active</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {users.map((u) => (
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-foreground">{u.name}</div>
                      <div class="text-[11px] text-muted-foreground font-mono">{u.email}</div>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${u.roleColor}`}>
                        {u.role}
                      </span>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="text-xs font-semibold text-emerald-700">
                        {u.status}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-muted-foreground font-mono">{u.lastActive}</td>
                    <td class="py-3.5 px-4 text-right">
                      <button class="text-red-500 hover:underline font-semibold">Remove</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Role Legend -->
          <div class="p-4 rounded-xl bg-muted/40 border border-border text-xs text-muted-foreground space-y-1.5">
            <h4 class="font-bold text-foreground uppercase tracking-wider text-[11px]">Role Permission Matrix</h4>
            <p>• <strong>Super Admin:</strong> Full access to database seeds, user invitations, and deployment configurations.</p>
            <p>• <strong>Reviewer:</strong> Statutory authority to verify official Gazette claims and publish recruitments live.</p>
            <p>• <strong>Editor:</strong> Author and draft recruitment data, syllabus details, and post metadata.</p>
          </div>
        </div>

        <!-- Invite User Drawer (1 Col) -->
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm space-y-4">
          <h2 class="text-xs font-bold text-muted-foreground uppercase tracking-wider pb-2 border-b border-border">
            Invite Team Member
          </h2>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block font-semibold text-foreground mb-1">Full Name</label>
              <input type="text" placeholder="e.g. Vikram Joshi" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs" />
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Email Address</label>
              <input type="email" placeholder="vikram@nirnay.in" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs" />
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Assigned Role</label>
              <select class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs">
                <option>Reviewer (Can verify & publish)</option>
                <option>Editor (Create & edit drafts)</option>
                <option>Super Admin (Full control)</option>
              </select>
            </div>

            <div>
              <label class="block font-semibold text-foreground mb-1">Invitation Note</label>
              <textarea placeholder="Welcome note or onboarding instructions..." rows="2" class="w-full p-2.5 rounded-lg bg-background border border-border text-foreground outline-none text-xs"></textarea>
            </div>

            <div class="pt-2">
              <button class="w-full py-2.5 px-4 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs transition-colors shadow-sm">
                Send invitation
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
