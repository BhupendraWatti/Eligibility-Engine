---
// src/pages/posts/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCanonicalPostBySlug } from '../../db/queries';

const { slug } = Astro.params;

const post = await getCanonicalPostBySlug(slug || '');
if (!post) Astro.response.status = 404;

// Derive Selection Stages and Syllabus dynamically based on post and sector
const defaultSelectionStages = post?.selectionStages || (
  post?.sectorId === 'sec_civil_services' ? [
    { name: 'Stage 1: State Services Preliminary Examination (OMR)', desc: 'General Studies Paper I & General Aptitude Paper II (200 marks each) for state-wide screening.' },
    { name: 'Stage 2: State Services Main Examination (Descriptive)', desc: 'Six descriptive papers covering General Studies, History, Geography, Economics, Hindi, and Essay writing.' },
    { name: 'Stage 3: Interview & Personality Test', desc: '175 marks viva-voce conducted by MPPSC Commission followed by cadre allocation.' },
  ] : post?.sectorId === 'sec_police' ? [
    { name: 'Stage 1: Online Computer Based Test (CBT)', desc: 'Objective examination covering General Knowledge, Reasoning, Elementary Mathematics, and Cadre Knowledge.' },
    { name: 'Stage 2: Physical Proficiency Test (PPT)', desc: 'Physical standards measurement and physical efficiency tests (running, shot put, long jump).' },
    { name: 'Stage 3: Document Verification & Medical Exam', desc: 'Scrutiny of original certificates, MP domicile certificate, and statutory medical fitness test.' },
  ] : post?.sectorId === 'sec_judiciary' ? [
    { name: 'Stage 1: Preliminary Online Examination', desc: '150 marks objective test covering Indian Penal Code, CrPC, CPC, Constitution, and MP Land Revenue Code.' },
    { name: 'Stage 2: Main Written Examination', desc: 'Four descriptive papers covering civil law, criminal law, judgment writing, and translation.' },
    { name: 'Stage 3: Viva-Voce & Interview', desc: '50 marks interview conducted by High Court judges committee.' },
  ] : [
    { name: 'Stage 1: Written Competitive Examination (CBT)', desc: '100–200 marks objective multiple-choice test on subject knowledge, reasoning, and state aptitude.' },
    { name: 'Stage 2: Document Verification & Biometrics', desc: 'Scrutiny of academic transcripts, caste certificates, and MP employment registration.' },
    { name: 'Stage 3: Final Medical & Cadre Allotment', desc: 'Medical clearance and appointment order issue by the parent department.' },
  ]
);

const defaultSyllabus = post?.syllabus || (
  post?.sectorId === 'sec_civil_services' ? [
    { subject: 'Paper I: General Studies (History, Geography, Polity, MP GK)', marks: '200 Marks' },
    { subject: 'Paper II: General Aptitude & Comprehension', marks: '200 Marks (Qualifying 33%)' },
    { subject: 'Mains: GS Papers I to IV & General Hindi/Essay', marks: '1400 Marks Total' },
    { subject: 'Personality Test / Interview', marks: '175 Marks' },
  ] : post?.sectorId === 'sec_judiciary' ? [
    { subject: 'Constitutional Law, Civil Law & Procedure (CPC)', marks: '40 Questions' },
    { subject: 'Criminal Law & Procedure (IPC, CrPC, Evidence Act)', marks: '40 Questions' },
    { subject: 'MP Specific Acts (Land Revenue, Accommodation Control)', marks: '30 Questions' },
    { subject: 'General Knowledge, Computer Knowledge & English', marks: '40 Questions' },
  ] : [
    { subject: 'General Knowledge & Current Affairs (Madhya Pradesh Focus)', marks: '30 Marks' },
    { subject: 'Logical Reasoning & Intellectual Ability', marks: '25 Marks' },
    { subject: 'General Science & Mathematics', marks: '25 Marks' },
    { subject: 'Language Competence / Trade Domain', marks: '20 Marks' },
  ]
);
---

{!post ? (
  <BaseLayout title="Canonical Post Not Found — NIRNAY MP">
    <div class="max-w-3xl mx-auto px-4 py-20 text-center" data-post-not-found>
      <div class="size-16 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 flex items-center justify-center mx-auto mb-4 font-bold text-2xl">
        !
      </div>
      <h1 class="text-2xl font-bold text-foreground mb-2">Canonical Post Not Found</h1>
      <p class="text-sm text-muted-foreground mb-6">
        No canonical post definition matches <code class="font-mono bg-muted px-1.5 py-0.5 rounded text-xs">{slug}</code>. We never substitute unrelated posts.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="/jobs" class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-blue-700 transition-colors">
          Browse All Posts
        </a>
        <a href="/" class="px-4 py-2 rounded-lg border border-border bg-card text-foreground text-xs font-semibold hover:bg-muted transition-colors">
          Home
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`${post.title} — Career, Eligibility & Pay Guide | NIRNAY MP`}
    description={`Comprehensive canonical guide to ${post.title} in Madhya Pradesh. Pay scale, statutory qualifications, age relaxation, syllabus, and active recruitment cycles.`}
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-foreground">Home</a>
        <span>&rsaquo;</span>
        <a href="/jobs" class="hover:text-foreground">Opportunities</a>
        <span>&rsaquo;</span>
        <span class="text-foreground font-semibold truncate max-w-xs sm:max-w-md">{post.title}</span>
      </nav>

      <!-- Header Box -->
      <div class="bg-card rounded-3xl p-6 sm:p-10 border border-border shadow-sm mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20 uppercase tracking-wider">
            Canonical State Cadre Guide
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border">
            {post.sectorName || 'Government of Madhya Pradesh'}
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border">
            {post.departmentName || 'State Department'}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-foreground font-['Outfit'] mb-4">
          {post.title}
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-6">
          {post.summary}
        </p>

        <!-- Active Recruitment Callout if linked -->
        {post.activeRecruitments && post.activeRecruitments.length > 0 ? (
          <div class="bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-indigo-500/10 border border-emerald-300/80 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-600 text-white uppercase tracking-wider inline-block mb-1">
                Active Recruitment Cycle {new Date().getFullYear()}
              </span>
              <h3 class="text-base font-bold text-foreground font-['Outfit']">
                {post.activeRecruitments[0].title}
              </h3>
              <p class="text-xs text-muted-foreground mt-0.5">
                {post.activeRecruitments[0].totalVacancies?.toLocaleString()} official vacancies declared in current drive.
              </p>
            </div>
            <a
              href={`/recruitments/${post.activeRecruitments[0].slug}`}
              class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm whitespace-nowrap transition-colors"
            >
              View Active Recruitment &rarr;
            </a>
          </div>
        ) : (
          <div class="bg-muted/40 border border-border rounded-2xl p-4 flex items-center justify-between gap-4 text-xs text-muted-foreground">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-slate-400"></span>
              <span>No direct recruitment drive currently active. Track notification releases on the calendar.</span>
            </div>
            <a href="/calendar" class="font-semibold text-primary hover:underline whitespace-nowrap">
              Exam Calendar &rarr;
            </a>
          </div>
        )}
      </div>

      <!-- 2-Column Guide Details -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="md:col-span-2 space-y-8">
          <!-- Statutory Qualifications -->
          <section class="bg-card rounded-3xl p-6 sm:p-8 border border-border shadow-sm">
            <h2 class="text-xl font-bold text-foreground font-['Outfit'] mb-4">
              Baseline Statutory Standards
            </h2>
            <div class="space-y-4 text-xs sm:text-sm">
              <div class="p-4 rounded-xl bg-muted/40 border border-border">
                <strong class="text-foreground block font-semibold mb-1">Statutory Educational Qualification:</strong>
                <p class="text-muted-foreground">
                  Minimum {post.defaultQualification} Pass from a recognized University or statutory Board of Education.
                </p>
              </div>
              <div class="p-4 rounded-xl bg-muted/40 border border-border">
                <strong class="text-foreground block font-semibold mb-1">Age Limits & Statutory Relaxations:</strong>
                <p class="text-muted-foreground">
                  {post.defaultMinAge} to {post.defaultMaxAge} Years (General / Unreserved). State relaxations apply: +5 years for SC/ST, +3 years for OBC, and up to +5 years for female applicants domiciled in MP.
                </p>
              </div>
              <div class="p-4 rounded-xl bg-muted/40 border border-border">
                <strong class="text-foreground block font-semibold mb-1">Cadre Pay Scale:</strong>
                <p class="text-muted-foreground font-mono font-semibold text-primary">
                  {post.payScale || 'As per Madhya Pradesh 7th Pay Matrix'}
                </p>
              </div>
            </div>
          </section>

          <!-- Selection Stages -->
          <section class="bg-card rounded-3xl p-6 sm:p-8 border border-border shadow-sm">
            <h2 class="text-xl font-bold text-foreground font-['Outfit'] mb-4">
              Selection Process Stages
            </h2>
            <div class="space-y-4">
              {defaultSelectionStages.map((stage: any, idx: number) => (
                <div class="p-4 rounded-xl bg-muted/40 border border-border flex items-start gap-3">
                  <span class="size-6 rounded-full bg-primary text-primary-foreground font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                    {idx + 1}
                  </span>
                  <div>
                    <h3 class="font-bold text-foreground text-sm">{stage.name}</h3>
                    <p class="text-xs text-muted-foreground mt-1 leading-relaxed">{stage.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Syllabus Structure -->
          <section class="bg-card rounded-3xl p-6 sm:p-8 border border-border shadow-sm">
            <h2 class="text-xl font-bold text-foreground font-['Outfit'] mb-4">
              Prescribed Exam Pattern & Syllabus
            </h2>
            <div class="divide-y divide-border">
              {defaultSyllabus.map((s: any) => (
                <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
                  <span class="font-medium text-foreground">{s.subject}</span>
                  <span class="font-mono font-bold text-primary">{s.marks}</span>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Quick Action Sidebar -->
        <div class="space-y-6">
          <div class="bg-card rounded-3xl p-6 border border-border shadow-sm">
            <h3 class="text-base font-bold text-foreground font-['Outfit'] mb-2">
              Check Your Eligibility
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4">
              Verify if your qualification, age, domicile, and category qualify for {post.title} recruitments in Madhya Pradesh.
            </p>
            <a
              href="/eligibility-checker"
              class="w-full py-2.5 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-colors"
            >
              <span>Deterministic Eligibility Engine</span> &rarr;
            </a>
          </div>

          <div class="bg-muted/40 rounded-3xl p-6 border border-border text-xs text-muted-foreground space-y-3">
            <h4 class="font-bold uppercase tracking-wider text-[11px] text-foreground">
              Cadre Provenance
            </h4>
            <div class="flex justify-between">
              <span>Department:</span>
              <span class="font-semibold text-foreground text-right">{post.departmentName || 'State Cadre'}</span>
            </div>
            <div class="flex justify-between">
              <span>Sector:</span>
              <span class="font-semibold text-foreground">{post.sectorName || 'Civil Cadre'}</span>
            </div>
            <div class="flex justify-between">
              <span>State:</span>
              <span class="font-semibold text-foreground">Madhya Pradesh</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </BaseLayout>
)}
