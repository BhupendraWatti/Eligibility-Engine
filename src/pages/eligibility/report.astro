---
// src/pages/eligibility/report.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Eligibility Assessment Report — NIRNAY MP"
  description="Official document preview of evaluated Madhya Pradesh recruitment opportunities matching your profile."
>
  <style>
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
      .print-card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
      }
    }
  </style>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Top breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-6 no-print" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <a href="/eligibility-checker" class="hover:text-foreground">Eligibility Calculator</a>
      <span>/</span>
      <span class="text-foreground font-medium">Official Report</span>
    </nav>

    <!-- Main Grid: Report Document (2 Cols) + Action Rail (1 Col) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Centered Document Card -->
      <div class="lg:col-span-2 bg-card rounded-2xl border border-border shadow-sm p-8 sm:p-12 print-card">
        <!-- Live Evaluation Banner (if loaded from session) -->
        <div id="session-banner" class="hidden mb-6 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-center justify-between no-print">
          <span class="font-medium">Evaluated from your active calculator session</span>
          <span class="text-[11px] font-mono text-emerald-700">Client-Side Verified</span>
        </div>

        <!-- Report Header -->
        <div class="flex items-start justify-between pb-6 border-b border-border mb-8">
          <div>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-bold text-xl tracking-[0.18em] text-foreground">NIRNAY</span>
              <span class="text-xs text-muted-foreground uppercase font-medium">Madhya Pradesh State Advisory</span>
            </div>
            <h1 class="text-2xl font-bold text-foreground">
              Candidate Eligibility Assessment
            </h1>
            <p class="text-xs text-muted-foreground mt-0.5">
              Deterministic Statutory Criteria Evaluation
            </p>
          </div>

          <div class="text-right text-xs">
            <span class="text-muted-foreground block">Evaluation Timestamp</span>
            <span id="report-date" class="font-mono font-bold text-foreground">21 September 2026</span>
            <span id="report-id" class="text-[10px] text-muted-foreground block mt-1">ID: NIR-2026-8842</span>
          </div>
        </div>

        <!-- Section 1: Input Criteria -->
        <div class="mb-8">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">
            1. Candidate Input Criteria
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-4 rounded-xl bg-muted/40 border border-border text-xs">
            <div>
              <span class="text-muted-foreground block">Age:</span>
              <span id="profile-age" class="font-bold text-foreground">21 years</span>
            </div>
            <div>
              <span class="text-muted-foreground block">Highest Qualification:</span>
              <span id="profile-qualification" class="font-bold text-foreground">Graduation (Degree)</span>
            </div>
            <div>
              <span class="text-muted-foreground block">Domicile:</span>
              <span id="profile-domicile" class="font-bold text-foreground">Madhya Pradesh</span>
            </div>
            <div>
              <span class="text-muted-foreground block">Social Category:</span>
              <span id="profile-category" class="font-bold text-foreground">General (UR)</span>
            </div>
            <div>
              <span class="text-muted-foreground block">MP Rojgar Panjiyan:</span>
              <span id="profile-panjiyan" class="font-bold text-emerald-700">Active</span>
            </div>
            <div>
              <span class="text-muted-foreground block">CPCT / Technical:</span>
              <span id="profile-cpct" class="font-bold text-amber-700">Self-certified</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Evaluation Summary -->
        <div class="mb-8">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">
            2. Deterministic Match Summary
          </h2>
          <div class="grid grid-cols-3 gap-3">
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50 text-center">
              <span id="count-eligible" class="text-2xl font-bold font-mono text-emerald-700 block">4</span>
              <span class="text-xs font-semibold text-emerald-800">Statutory Eligible</span>
            </div>
            <div class="p-3.5 rounded-xl border border-amber-200 bg-amber-50 text-center">
              <span id="count-verification" class="text-2xl font-bold font-mono text-amber-700 block">2</span>
              <span class="text-xs font-semibold text-amber-800">Needs Verification</span>
            </div>
            <div class="p-3.5 rounded-xl border border-border bg-muted/40 text-center">
              <span id="count-ineligible" class="text-2xl font-bold font-mono text-muted-foreground block">3</span>
              <span class="text-xs font-semibold text-muted-foreground">Ineligible</span>
            </div>
          </div>
        </div>

        <!-- Section 3: Eligible Opportunities -->
        <div class="mb-8">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">
            3. Verified Eligible Opportunities
          </h2>
          <div id="eligible-list" class="space-y-3">
            <div class="p-3.5 rounded-xl border border-border bg-card flex items-center justify-between text-xs">
              <div>
                <a href="/recruitments/mp-police-constable-recruitment-2026" class="font-bold text-foreground hover:text-primary block">
                  MP Police Constable Recruitment 2026
                </a>
                <span class="text-muted-foreground">MPESB · 7,500 Vacancies · Age 18–33</span>
              </div>
              <a href="https://esb.mp.gov.in" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline flex items-center gap-1">
                <span>Official Notice</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>

            <div class="p-3.5 rounded-xl border border-border bg-card flex items-center justify-between text-xs">
              <div>
                <a href="/recruitments/mp-assistant-grade-3-recruitment-2026" class="font-bold text-foreground hover:text-primary block">
                  Assistant Grade-III & Steno-Typist Combined Recruitment 2026
                </a>
                <span class="text-muted-foreground">MPESB · 1,420 Vacancies · Age 18–40</span>
              </div>
              <a href="https://esb.mp.gov.in" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline flex items-center gap-1">
                <span>Official Notice</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>

            <div class="p-3.5 rounded-xl border border-border bg-card flex items-center justify-between text-xs">
              <div>
                <a href="/recruitments/mppsc-state-service-2026" class="font-bold text-foreground hover:text-primary block">
                  MPPSC State Services Examination (SSE) 2026
                </a>
                <span class="text-muted-foreground">MPPSC · 356 Vacancies · Age 21–40</span>
              </div>
              <a href="https://mppsc.mp.gov.in" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline flex items-center gap-1">
                <span>Official Notice</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Section 4: Needs Verification -->
        <div class="mb-8">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">
            4. Opportunities Requiring Self-Verification
          </h2>
          <div id="verification-list" class="space-y-3">
            <div class="p-3.5 rounded-xl border border-amber-200 bg-amber-50/40 text-xs">
              <div class="flex items-center justify-between mb-1">
                <a href="/recruitments/mp-forest-guard-recruitment-2026" class="font-bold text-foreground hover:text-primary">
                  MP Forest Guard & Jail Prahari Combined Recruitment 2026
                </a>
                <span class="text-[11px] font-semibold text-amber-800">Physical Standard Required</span>
              </div>
              <p class="text-muted-foreground">Age and 10th pass qualification satisfied. Candidate must self-verify male height minimum 163 cm & 25 km endurance test.</p>
            </div>
          </div>
        </div>

        <!-- Statutory Disclaimer -->
        <div class="pt-6 border-t border-border text-center">
          <p class="text-xs text-muted-foreground italic max-w-lg mx-auto">
            "This report is generated deterministically from published state gazettes and candidate-provided inputs. Candidates are advised to independently verify all clauses against the official advertisement before submitting applications."
          </p>
        </div>
      </div>

      <!-- Right Action Rail -->
      <aside class="space-y-4 no-print">
        <div class="bg-card p-6 rounded-2xl border border-border shadow-sm space-y-3">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-2">Actions</h3>
          
          <button
            type="button"
            onclick="window.print()"
            class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs transition-colors flex items-center justify-center gap-2 shadow-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Download PDF / Print</span>
          </button>

          <a
            href="/eligibility-checker"
            class="w-full py-2.5 px-4 text-center text-xs text-primary font-medium hover:underline block"
          >
            Start a new evaluation &rarr;
          </a>
        </div>

        <div class="p-5 rounded-2xl bg-muted/60 border border-border text-xs text-muted-foreground">
          <span class="font-bold text-foreground block mb-1">Session Privacy</span>
          <p>
            NIRNAY does not track personal identifying information. This evaluation document was produced entirely in your local browser sandbox.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    // Hydrate report with candidate's actual evaluation if available
    try {
      const raw = sessionStorage.getItem('nirnay_eval_report');
      if (raw) {
        const data = JSON.parse(raw);
        if (data && data.profile) {
          const banner = document.getElementById('session-banner');
          if (banner) banner.classList.remove('hidden');

          if (data.reportId) document.getElementById('report-id').textContent = `ID: ${data.reportId}`;
          if (data.evaluatedAt) {
            const d = new Date(data.evaluatedAt);
            document.getElementById('report-date').textContent = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
          }

          if (data.profile.age) document.getElementById('profile-age').textContent = `${data.profile.age} years`;
          if (data.profile.qualificationLevel) {
            const qualText = data.profile.degree ? `${data.profile.qualificationLevel} (${data.profile.degree})` : data.profile.qualificationLevel;
            document.getElementById('profile-qualification').textContent = qualText;
          }
          if (data.profile.isMpDomicile !== undefined) {
            document.getElementById('profile-domicile').textContent = data.profile.isMpDomicile ? 'Madhya Pradesh (Resident)' : 'Other Indian State';
          }
          if (data.profile.category) document.getElementById('profile-category').textContent = `${data.profile.category} Category`;
          if (data.profile.hasMpRojgarPanjiyan !== undefined) {
            document.getElementById('profile-panjiyan').textContent = data.profile.hasMpRojgarPanjiyan ? 'Active & Registered' : 'Not Registered';
          }
          if (data.profile.hasCpct !== undefined) {
            document.getElementById('profile-cpct').textContent = data.profile.hasCpct ? 'CPCT Scorecard Available' : 'None';
          }

          if (data.counts) {
            if (data.counts.eligible !== undefined) document.getElementById('count-eligible').textContent = data.counts.eligible;
            if (data.counts.verification !== undefined) document.getElementById('count-verification').textContent = data.counts.verification;
            if (data.counts.ineligible !== undefined) document.getElementById('count-ineligible').textContent = data.counts.ineligible;
          }

          // Populate eligible list
          if (data.eligibleOpportunities && data.eligibleOpportunities.length > 0) {
            const eligibleContainer = document.getElementById('eligible-list');
            if (eligibleContainer) {
              eligibleContainer.innerHTML = data.eligibleOpportunities.map(opp => `
                <div class="p-3.5 rounded-xl border border-border bg-card flex items-center justify-between text-xs">
                  <div>
                    <a href="/recruitments/${opp.slug}" class="font-bold text-foreground hover:text-primary block">
                      ${opp.title}
                    </a>
                    <span class="text-muted-foreground">${opp.org || 'MP Authority'} · ${opp.vacancies ? opp.vacancies.toLocaleString() + ' Vacancies' : ''} · Age ${opp.minAge || 18}–${opp.maxAge || 40}</span>
                  </div>
                  <a href="${opp.url || 'https://esb.mp.gov.in'}" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline flex items-center gap-1">
                    <span>Official Notice</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
              `).join('');
            }
          }

          // Populate verification list
          if (data.verificationOpportunities && data.verificationOpportunities.length > 0) {
            const verifContainer = document.getElementById('verification-list');
            if (verifContainer) {
              verifContainer.innerHTML = data.verificationOpportunities.map(opp => `
                <div class="p-3.5 rounded-xl border border-amber-200 bg-amber-50/40 text-xs">
                  <div class="flex items-center justify-between mb-1">
                    <a href="/recruitments/${opp.slug}" class="font-bold text-foreground hover:text-primary">
                      ${opp.title}
                    </a>
                    <span class="text-[11px] font-semibold text-amber-800">Verification Required</span>
                  </div>
                  <p class="text-muted-foreground">${opp.reason || 'Candidate must self-verify eligibility clause in official notification.'}</p>
                </div>
              `).join('');
            }
          }
        }
      }
    } catch (err) {
      console.warn('Could not read evaluation report session data', err);
    }
  </script>
</BaseLayout>
