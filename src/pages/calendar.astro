---
// src/pages/calendar.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllActiveRecruitments } from '../db/queries';
import { resolveMilestonePresentation, type MilestonePresentation } from '../services/lifecycle';

const allRecruitments = await getAllActiveRecruitments();

interface CalendarMilestone {
  rawDate: string;
  formattedDate: string;
  weekday: string;
  title: string;
  org: string;
  desc: string;
  status: string;
  badgeClass: string;
  type: string;
  category: 'CLOSING_SOON' | 'OPEN_NOW' | 'UPCOMING' | 'EXAM' | 'PAST';
  isUrgent: boolean;
  isPast: boolean;
  slug: string;
}

function formatDateParts(dateStr: string): { formatted: string; weekday: string } {
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return { formatted: dateStr, weekday: '' };
    return {
      formatted: d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
      weekday: d.toLocaleDateString('en-GB', { weekday: 'short' }),
    };
  } catch {
    return { formatted: dateStr, weekday: '' };
  }
}

const milestones: CalendarMilestone[] = [];

allRecruitments.forEach((job) => {
  if (job.applicationStart) {
    const p = resolveMilestonePresentation(job.applicationStart, 'APPLICATION_START');
    const { formatted, weekday } = formatDateParts(job.applicationStart);
    milestones.push({
      rawDate: job.applicationStart,
      formattedDate: formatted,
      weekday,
      title: job.title,
      org: `${job.organisationShortName} · ${job.postTitle}`,
      desc: `Official online application registration opens on the authority portal.`,
      status: p.label,
      badgeClass: p.badgeClass,
      type: 'Applications Open',
      category: p.category,
      isUrgent: p.isUrgent,
      isPast: p.isPast,
      slug: job.slug,
    });
  }

  if (job.applicationEnd) {
    const p = resolveMilestonePresentation(job.applicationEnd, 'APPLICATION_END');
    const { formatted, weekday } = formatDateParts(job.applicationEnd);
    milestones.push({
      rawDate: job.applicationEnd,
      formattedDate: formatted,
      weekday,
      title: job.title,
      org: `${job.organisationShortName} · ${job.postTitle}`,
      desc: p.isPast
        ? `Application window has concluded. Form submission and fee payment closed.`
        : `Final deadline for submission of online application forms and fee payment.`,
      status: p.label,
      badgeClass: p.badgeClass,
      type: 'Applications Close',
      category: p.category,
      isUrgent: p.isUrgent,
      isPast: p.isPast,
      slug: job.slug,
    });
  }

  if (job.examDate) {
    const p = resolveMilestonePresentation(job.examDate, 'EXAM_DATE');
    const { formatted, weekday } = formatDateParts(job.examDate);
    milestones.push({
      rawDate: job.examDate,
      formattedDate: formatted,
      weekday,
      title: `${job.title} - Written Examination`,
      org: job.organisationShortName,
      desc: p.isPast
        ? `Examination concluded across state centers. Model answer key scrutiny underway.`
        : `Competitive examination scheduled across the authority's designated centers.`,
      status: p.label,
      badgeClass: p.badgeClass,
      type: 'Written Exam (CBT)',
      category: p.category,
      isUrgent: p.isUrgent,
      isPast: p.isPast,
      slug: job.slug,
    });
  }
});

// Sort chronological
milestones.sort((a, b) => a.rawDate.localeCompare(b.rawDate));

// Segment into candidate-focused priority groups
const closingSoonMilestones = milestones.filter(m => m.category === 'CLOSING_SOON');
const openNowMilestones = milestones.filter(m => m.category === 'OPEN_NOW');
const upcomingMilestones = milestones.filter(m => m.category === 'UPCOMING');
const examMilestones = milestones.filter(m => m.category === 'EXAM');
const pastMilestones = milestones.filter(m => m.category === 'PAST');
---

<BaseLayout
  title="Government Recruitment & Exam Calendar 2026 - NIRNAY"
  description="Chronological schedule of central and state government recruitment deadlines, registrations, and examination dates."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Recruitment Calendar</span>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-border mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 border border-blue-200/80 text-primary text-xs font-semibold tracking-wide mb-3">
          <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
          <span>Verified State Schedule</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
          Recruitment & Examination Calendar
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-2xl">
          Verified timeline of active application deadlines, upcoming opportunities, and scheduled government examinations across India.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/eligibility-checker"
          class="px-5 py-2.5 rounded-xl bg-primary hover:bg-blue-700 text-primary-foreground font-semibold text-xs sm:text-sm shadow-sm transition-colors inline-flex items-center gap-2"
        >
          <span>Check My Eligibility</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Filter Pills Rail -->
    <div class="flex flex-wrap items-center gap-2 pb-6 mb-8 border-b border-border/60" id="calendar-filter-bar">
      <button
        type="button"
        data-filter="all"
        class="filter-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all bg-primary text-primary-foreground shadow-2xs"
      >
        All Dates ({milestones.length})
      </button>
      <button
        type="button"
        data-filter="closing-soon"
        class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-card border border-border text-foreground hover:bg-muted"
      >
        Closing Soon ({closingSoonMilestones.length})
      </button>
      <button
        type="button"
        data-filter="open-now"
        class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-card border border-border text-foreground hover:bg-muted"
      >
        Applications Open ({openNowMilestones.length})
      </button>
      <button
        type="button"
        data-filter="upcoming"
        class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-card border border-border text-foreground hover:bg-muted"
      >
        Upcoming ({upcomingMilestones.length})
      </button>
      <button
        type="button"
        data-filter="exams"
        class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-card border border-border text-foreground hover:bg-muted"
      >
        Exams ({examMilestones.length})
      </button>
      <button
        type="button"
        data-filter="past"
        class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-card border border-border text-muted-foreground hover:bg-muted"
      >
        Concluded ({pastMilestones.length})
      </button>
    </div>

    <!-- Layout: Grouped Sections (2 Cols) + Helpful Sidebar (1 Col) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content Rail (2 Cols) -->
      <div class="lg:col-span-2 space-y-10" id="calendar-milestones-container">

        <!-- SECTION 1: Closing Soon (Next 7 Days) -->
        {closingSoonMilestones.length > 0 && (
          <section class="milestone-section" data-section="closing-soon">
            <div class="flex items-center gap-2 mb-4">
              <span class="size-2 rounded-full bg-amber-500 animate-ping"></span>
              <h2 class="text-sm font-bold uppercase tracking-wider text-amber-900">
                Immediate Action: Closing Soon (Next 7 Days)
              </h2>
              <span class="text-xs text-muted-foreground font-mono ml-auto font-medium">
                {closingSoonMilestones.length} {closingSoonMilestones.length === 1 ? 'event' : 'events'}
              </span>
            </div>

            <div class="space-y-4">
              {closingSoonMilestones.map((m) => (
                <div
                  class="milestone-card p-5 rounded-2xl bg-amber-50/40 border border-amber-200/80 hover:border-amber-400 hover:shadow-xs transition-all relative"
                  data-category="closing-soon"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono font-bold text-amber-900">
                        {m.formattedDate}
                      </span>
                      {m.weekday && (
                        <span class="text-[11px] font-semibold text-amber-700/80 bg-amber-100/70 px-1.5 py-0.5 rounded">
                          {m.weekday}
                        </span>
                      )}
                    </div>
                    <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${m.badgeClass}`}>
                      {m.status}
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-foreground mb-1 leading-snug">
                    <a href={`/recruitments/${m.slug}`} class="hover:text-primary transition-colors">
                      {m.title}
                    </a>
                  </h3>
                  <span class="text-xs text-muted-foreground block mb-3 font-medium">
                    {m.org} · <strong class="text-foreground">{m.type}</strong>
                  </span>
                  <p class="text-xs text-muted-foreground mb-4 leading-relaxed">
                    {m.desc}
                  </p>

                  <div class="pt-3 border-t border-amber-200/60 flex items-center justify-between">
                    <span class="text-[11px] text-amber-800 font-medium">Urgent Submission Window</span>
                    <a
                      href={`/recruitments/${m.slug}`}
                      class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
                    >
                      <span>View details & official portal</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- SECTION 2: Applications Open Now -->
        {openNowMilestones.length > 0 && (
          <section class="milestone-section" data-section="open-now">
            <div class="flex items-center gap-2 mb-4">
              <span class="size-2 rounded-full bg-emerald-500"></span>
              <h2 class="text-sm font-bold uppercase tracking-wider text-emerald-900">
                Applications Open Now
              </h2>
              <span class="text-xs text-muted-foreground font-mono ml-auto font-medium">
                {openNowMilestones.length} {openNowMilestones.length === 1 ? 'drive' : 'drives'}
              </span>
            </div>

            <div class="space-y-4">
              {openNowMilestones.map((m) => (
                <div
                  class="milestone-card p-5 rounded-2xl bg-card border border-border hover:border-border/80 hover:shadow-xs transition-all relative"
                  data-category="open-now"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono font-bold text-emerald-700">
                        {m.formattedDate}
                      </span>
                      {m.weekday && (
                        <span class="text-[11px] font-semibold text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                          {m.weekday}
                        </span>
                      )}
                    </div>
                    <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${m.badgeClass}`}>
                      {m.status}
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-foreground mb-1 leading-snug">
                    <a href={`/recruitments/${m.slug}`} class="hover:text-primary transition-colors">
                      {m.title}
                    </a>
                  </h3>
                  <span class="text-xs text-muted-foreground block mb-3">
                    {m.org} · <strong class="text-foreground">{m.type}</strong>
                  </span>
                  <p class="text-xs text-muted-foreground mb-4 leading-relaxed">
                    {m.desc}
                  </p>

                  <div class="pt-3 border-t border-border flex items-center justify-between">
                    <span class="text-[11px] text-muted-foreground">Active Portal Registration</span>
                    <a
                      href={`/recruitments/${m.slug}`}
                      class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
                    >
                      <span>Check criteria & apply</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- SECTION 3: Upcoming Applications & Scheduled Exams -->
        {(upcomingMilestones.length > 0 || examMilestones.length > 0) && (
          <section class="milestone-section" data-section="upcoming-and-exams">
            <div class="flex items-center gap-2 mb-4">
              <span class="size-2 rounded-full bg-blue-500"></span>
              <h2 class="text-sm font-bold uppercase tracking-wider text-foreground">
                Upcoming Applications & Scheduled Exams
              </h2>
              <span class="text-xs text-muted-foreground font-mono ml-auto font-medium">
                {upcomingMilestones.length + examMilestones.length} upcoming
              </span>
            </div>

            <div class="space-y-4">
              {[...upcomingMilestones, ...examMilestones]
                .sort((a, b) => a.rawDate.localeCompare(b.rawDate))
                .map((m) => (
                  <div
                    class="milestone-card p-5 rounded-2xl bg-card border border-border hover:border-border/80 hover:shadow-xs transition-all relative"
                    data-category={m.category === 'EXAM' ? 'exams' : 'upcoming'}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-mono font-bold text-primary">
                          {m.formattedDate}
                        </span>
                        {m.weekday && (
                          <span class="text-[11px] font-semibold text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                            {m.weekday}
                          </span>
                        )}
                      </div>
                      <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${m.badgeClass}`}>
                        {m.status}
                      </span>
                    </div>

                    <h3 class="text-base font-bold text-foreground mb-1 leading-snug">
                      <a href={`/recruitments/${m.slug}`} class="hover:text-primary transition-colors">
                        {m.title}
                      </a>
                    </h3>
                    <span class="text-xs text-muted-foreground block mb-3">
                      {m.org} · <strong class="text-foreground">{m.type}</strong>
                    </span>
                    <p class="text-xs text-muted-foreground mb-4 leading-relaxed">
                      {m.desc}
                    </p>

                    <div class="pt-3 border-t border-border flex items-center justify-between">
                      <span class="text-[11px] text-muted-foreground">Gazetted State Schedule</span>
                      <a
                        href={`/recruitments/${m.slug}`}
                        class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
                      >
                        <span>View recruitment notice</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                ))}
            </div>
          </section>
        )}

        <!-- SECTION 4: Concluded / Past Milestones -->
        {pastMilestones.length > 0 && (
          <section class="milestone-section" data-section="past">
            <details class="group bg-card rounded-2xl border border-border p-5">
              <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-sm text-muted-foreground group-open:text-foreground">
                <span class="flex items-center gap-2">
                  <span class="size-2 rounded-full bg-slate-400"></span>
                  <span>Concluded & Historical Milestones ({pastMilestones.length})</span>
                </span>
                <span class="text-xs font-normal text-muted-foreground group-open:rotate-180 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>

              <div class="space-y-4 pt-4 mt-4 border-t border-border">
                {pastMilestones.map((m) => (
                  <div
                    class="milestone-card p-4 rounded-xl bg-muted/40 border border-border/80"
                    data-category="past"
                  >
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                      <span class="text-xs font-mono text-muted-foreground">
                        {m.formattedDate}
                      </span>
                      <span class={`px-2 py-0.5 rounded text-[10px] font-medium border ${m.badgeClass}`}>
                        {m.status}
                      </span>
                    </div>
                    <h4 class="text-sm font-semibold text-foreground">
                      <a href={`/recruitments/${m.slug}`} class="hover:underline">
                        {m.title}
                      </a>
                    </h4>
                    <p class="text-xs text-muted-foreground mt-1">
                      {m.desc}
                    </p>
                  </div>
                ))}
              </div>
            </details>
          </section>
        )}

        <!-- Empty State Filter Feedback -->
        <div id="calendar-empty-state" class="hidden bg-card rounded-2xl border border-border p-12 text-center">
          <p class="text-sm text-muted-foreground">No events match the selected category filter.</p>
        </div>
      </div>

      <!-- Right Helpful Sidebar (1 Col) -->
      <aside class="space-y-6">
        <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
          <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-3 pb-2 border-b border-border">
            How dates are tracked
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed mb-4">
            Dates are compiled from verified government notifications and authority gazettes. Always confirm final dates with the direct official notification.
          </p>
          <div class="pt-2 border-t border-border space-y-2 text-xs">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-amber-500"></span>
              <span class="font-semibold text-foreground">Closing Soon:</span>
              <span class="text-muted-foreground">&le; 7 days remaining</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-emerald-500"></span>
              <span class="font-semibold text-foreground">Applications Open:</span>
              <span class="text-muted-foreground">Active submission window</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-purple-500"></span>
              <span class="font-semibold text-foreground">Exam Scheduled:</span>
              <span class="text-muted-foreground">Official CBT date announced</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900 text-white shadow-md relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 via-primary to-indigo-600"></div>
          <h4 class="font-bold text-sm text-white mb-2">
            Never miss an eligible vacancy
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Check your qualifications and age against official statutory criteria in seconds.
          </p>
          <a
            href="/eligibility-checker"
            class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-xs text-center block shadow-sm transition-colors"
          >
            Check My Eligibility
          </a>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    const filterButtons = document.querySelectorAll('#calendar-filter-bar .filter-btn');
    const cards = document.querySelectorAll('#calendar-milestones-container .milestone-card');
    const sections = document.querySelectorAll('#calendar-milestones-container .milestone-section');
    const emptyState = document.getElementById('calendar-empty-state');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab styles
        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-2xs');
          b.classList.add('bg-card', 'border', 'border-border', 'text-foreground');
        });
        btn.classList.remove('bg-card', 'border', 'border-border', 'text-foreground');
        btn.classList.add('bg-primary', 'text-primary-foreground', 'shadow-2xs');

        let visibleCount = 0;

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          let show = false;
          if (filter === 'all') {
            show = true;
          } else if (filter === 'closing-soon' && category === 'closing-soon') {
            show = true;
          } else if (filter === 'open-now' && category === 'open-now') {
            show = true;
          } else if (filter === 'upcoming' && category === 'upcoming') {
            show = true;
          } else if (filter === 'exams' && category === 'exams') {
            show = true;
          } else if (filter === 'past' && category === 'past') {
            show = true;
          }

          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        // Hide sections that have 0 visible cards
        sections.forEach((sec) => {
          const visibleCards = sec.querySelectorAll('.milestone-card:not([style*="display: none"])');
          sec.style.display = visibleCards.length > 0 ? '' : 'none';
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  </script>
</BaseLayout>
