---
import { advtLabel } from '../../services/advt-number';
// src/pages/organisations/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrganisationBySlug, getAllOrganisations } from '../../db/queries';
import { calculateRecruitmentMetrics, isActiveDrive } from '../../services/lifecycle';

const slug = (Astro.params.slug || '').toLowerCase();

const org = await getOrganisationBySlug(slug);
if (!org) Astro.response.status = 404;
const allOrgs = await getAllOrganisations();

const orgRecruitments = org?.recruitments || [];
const metrics = calculateRecruitmentMetrics(orgRecruitments);

function formatDate(dateStr?: string): string {
  if (!dateStr) return 'Refer Notification';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return dateStr;
  }
}
---

{!org ? (
  <BaseLayout title="Statutory Organisation Not Found">
    <div class="max-w-3xl mx-auto px-4 py-20 text-center" data-org-not-found>
      <div class="size-14 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-foreground mb-2">Recruiting Authority Not Found</h1>
      <p class="text-sm text-muted-foreground mb-6">
        No state statutory organisation matches slug <code class="font-mono bg-muted px-1.5 py-0.5 rounded text-xs">{slug}</code>. We never substitute unrelated authorities.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="/jobs" class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-blue-700 transition-colors">
          Browse All Opportunities
        </a>
        <a href="/" class="px-4 py-2 rounded-lg border border-border bg-card text-foreground text-xs font-semibold hover:bg-muted transition-colors">
          Home
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`${org.name} (${org.shortName})`}
    description={`Track all ${org.shortName} recruitment notices, examinations, admit cards and results verified from official gazettes.`}
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-foreground">Home</a>
        <span>/</span>
        <a href="/organisations" class="hover:text-foreground">Organisations</a>
        <span>/</span>
        <span class="text-foreground font-medium">{org.shortName}</span>
      </nav>

      <!-- Authority Header Card -->
      <div class="bg-card rounded-2xl border border-border p-6 sm:p-8 shadow-sm mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <!-- Logo Badge -->
          <div class="size-16 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center font-bold text-xl text-primary shrink-0 shadow-2xs font-['Outfit']">
            {org.initials || org.shortName.slice(0, 3)}
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block mb-0.5">
              Statutory Recruiting Authority Profile
            </span>
            <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
              {org.name}
            </h1>
            <div class="flex flex-wrap items-center gap-3 mt-2 text-xs font-mono">
              <span class="text-foreground font-bold">{orgRecruitments.length} Tracked Opportunities</span>
              <span class="text-muted-foreground">·</span>
              <span class="text-emerald-700 font-bold">{metrics.activeDriveCount} Active Applications</span>
              <span class="text-muted-foreground">·</span>
              <span class="text-muted-foreground">{org.domain || (org.websiteUrl ? new URL(org.websiteUrl).hostname : '')}</span>
            </div>
          </div>
        </div>

        <div class="shrink-0 flex items-center gap-3">
          <a
            href={org.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold inline-flex items-center gap-2 transition-colors"
          >
            <span>Official Portal</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <a
            href="/eligibility-checker"
            class="px-4 py-2.5 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold transition-colors"
          >
            Check Eligibility
          </a>
        </div>
      </div>

      <!-- Sections: Open Recruitments (2 Cols) + About Panel (1 Col) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Open Recruitments -->
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h2 class="text-base font-bold text-foreground uppercase tracking-wider mb-4 flex items-center justify-between">
              <span>Verified Recruitment Drives ({orgRecruitments.length})</span>
              <span class="text-xs text-muted-foreground font-mono font-normal">State Authority Verified</span>
            </h2>

            {orgRecruitments.length === 0 ? (
              <div class="p-8 rounded-2xl bg-card border border-border text-center">
                <p class="text-xs text-muted-foreground">No active drives published for {org.shortName} at this time. Check calendar for upcoming notifications.</p>
              </div>
            ) : (
              <div class="space-y-4">
                {orgRecruitments.map((job) => {
                  const statusColor = job.lifecycleStatus === 'OPEN'
                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                    : job.lifecycleStatus === 'UPCOMING'
                    ? 'bg-blue-50 text-blue-700 border-blue-200'
                    : 'bg-muted text-muted-foreground border-border';

                  return (
                    <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-xs hover:border-border/80 transition-all">
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <span class={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${job.presentation?.badgeClass || 'bg-muted text-muted-foreground border-border'}`}>
                          {job.presentation?.label || job.lifecycleStatus}
                        </span>
                        <span class="text-xs font-mono font-bold text-foreground">
                          Last date: {formatDate(job.applicationEnd)}
                        </span>
                      </div>

                      <h3 class="text-base font-bold text-foreground mb-1">
                        <a href={`/recruitments/${job.slug}`} class="hover:text-primary transition-colors">
                          {job.title}
                        </a>
                      </h3>

                      <p class="text-xs text-muted-foreground mb-3 line-clamp-2">
                        {job.shortSummary}
                      </p>

                      <div class="flex flex-wrap items-center gap-4 text-xs text-muted-foreground mb-4">
                        <span>Vacancies: <strong class="text-foreground font-mono">{job.totalVacancies.toLocaleString()}</strong></span>
                        <span>·</span>
                        <span>Min Qualification: <strong class="text-foreground">{job.criteria.minQualificationLevel}</strong></span>
                        <span>·</span>
                        <span>Age: <strong class="text-foreground">{job.criteria.minAge} to {job.criteria.maxAgeGeneral} yrs</strong></span>
                      </div>

                      <div class="pt-3 border-t border-border flex items-center justify-between">
                        <span class="text-[11px] text-muted-foreground font-mono">{advtLabel(job.advtNumber)}</span>
                        <a
                          href={`/recruitments/${job.slug}`}
                          class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
                        >
                          <span>View verified criteria</span>
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>

        <!-- About this organisation -->
        <aside class="space-y-6">
          <div class="bg-card rounded-2xl border border-border p-6 shadow-sm">
            <h3 class="font-bold text-xs uppercase tracking-wider text-muted-foreground mb-3 pb-2 border-b border-border">
              About {org.shortName}
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4">
              {org.description}
            </p>
            <div class="p-3.5 rounded-xl bg-muted/60 border border-border text-[11px] text-muted-foreground">
              <strong>Platform Transparency:</strong> NIRNAY is an independent public discovery portal and is not affiliated with {org.shortName}. All notifications are sourced directly from verified government gazettes.
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-card border border-border">
            <h4 class="font-bold text-xs uppercase tracking-wider text-foreground mb-3">
              Other Statutory Authorities
            </h4>
            <div class="space-y-2">
              {allOrgs.filter(item => item.slug !== org.slug).map((item) => (
                <a
                  href={`/organisations/${item.slug}`}
                  class="block p-3 rounded-xl border border-border hover:bg-muted/50 transition-colors"
                >
                  <span class="text-xs font-bold text-foreground block">{item.shortName}</span>
                  <span class="text-[11px] text-muted-foreground line-clamp-1">{item.name}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </BaseLayout>
)}
