---
// src/pages/search.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const query = Astro.url.searchParams.get('q') || 'Police Constable';

const categories = [
  { name: 'Jobs', count: 2, active: true },
  { name: 'Exams', count: 1, active: false },
  { name: 'Organisations', count: 1, active: false },
  { name: 'Departments', count: 1, active: false },
  { name: 'Posts', count: 1, active: false },
];

const jobResults = [
  {
    type: 'Job',
    title: 'MP Police Constable Recruitment 2026',
    slug: 'mp-police-constable-recruitment-2026',
    snippet: 'Direct recruitment for 7,500 Constables across District Police and Special Armed Force.',
    meta: '7,500 Vacancies · 10th Pass · Last Date 06 Oct 2026 · MPESB',
  },
  {
    type: 'Job',
    title: 'Police Constable Recruitment 2025 (Special Drive)',
    slug: 'mp-police-constable-recruitment-2025',
    snippet: 'Special recruitment drive for backlog vacancies across reserved districts.',
    meta: '420 Vacancies · 10th Pass · Completed · MPESB',
  },
];

const examResults = [
  {
    type: 'Exam',
    title: 'MP Police Constable Written Examination 2026',
    slug: 'mp-police-constable-exam-2026',
    snippet: 'Statewide Computer-Based Test (CBT) scheduled across 12 exam cities.',
    meta: 'Exam Date: 22 Nov 2026 · Admit Card Expected 10 Nov 2026',
  },
];

const orgResults = [
  {
    type: 'Organisation',
    title: 'Madhya Pradesh Employees Selection Board (MPESB)',
    slug: 'mpesb',
    snippet: 'Primary state agency conducting group 2, 3, and 4 recruitment tests and police hiring.',
    meta: '32 Active Drives · Official Domain: esb.mp.gov.in',
  },
];
---

<BaseLayout
  title={`Search results for "${query}" — NIRNAY MP`}
  description={`Find government jobs, exams, departments and organisations matching "${query}".`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Centered Search Field with Shortcut Hint -->
    <div class="max-w-3xl mx-auto mb-10">
      <form action="/search" method="get" class="relative">
        <label class="rounded-2xl bg-card border border-border shadow-sm flex px-4 items-center gap-3 h-14 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            type="search"
            name="q"
            defaultValue={query}
            placeholder="Search jobs, exams, departments or organisations..."
            class="bg-transparent text-foreground text-base outline-none flex-1"
          />
          <div class="hidden sm:flex items-center gap-1 px-2 py-1 rounded bg-muted border border-border text-[11px] font-mono text-muted-foreground">
            <span>⌘</span><span>K</span>
          </div>
          <button
            type="submit"
            class="px-4 py-2 bg-primary text-primary-foreground font-semibold rounded-xl text-xs hover:bg-blue-700 transition-colors"
          >
            Search
          </button>
        </label>
      </form>
    </div>

    <!-- Page Title -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
        Search results for "{query}"
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground mt-1">
        Showing the most relevant opportunities, authorities, and references.
      </p>
    </div>

    <!-- Search Layout: Category Rail (1 Col) + Grouped Results (3 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Category Rail -->
      <aside class="space-y-1 bg-card p-3 rounded-2xl border border-border h-fit">
        <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider block px-3 py-2">
          Categories
        </span>
        {categories.map(cat => (
          <button
            type="button"
            class={`w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-colors ${
              cat.active
                ? 'bg-primary text-primary-foreground font-bold'
                : 'text-foreground hover:bg-muted'
            }`}
          >
            <span>{cat.name}</span>
            <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full ${
              cat.active ? 'bg-primary-foreground/20 text-white' : 'bg-muted text-muted-foreground'
            }`}>
              {cat.count}
            </span>
          </button>
        ))}
      </aside>

      <!-- Main Grouped Results Area -->
      <div class="lg:col-span-3 space-y-8">
        <!-- Jobs Group -->
        <div>
          <h2 class="text-sm font-bold text-foreground uppercase tracking-wider mb-3 flex items-center gap-2">
            <span>Jobs</span>
            <span class="text-xs text-muted-foreground font-normal">({jobResults.length})</span>
          </h2>
          <div class="space-y-3">
            {jobResults.map(r => (
              <a
                href={`/recruitments/${r.slug}`}
                class="block p-4 rounded-xl bg-card border border-border hover:border-border/80 hover:shadow-xs transition-all group"
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-50 text-primary border border-blue-200 mb-1">
                      {r.type}
                    </span>
                    <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">
                      {r.title}
                    </h3>
                    <p class="text-xs text-muted-foreground mt-1">
                      {r.snippet}
                    </p>
                    <span class="text-[11px] font-mono text-muted-foreground block mt-2">
                      {r.meta}
                    </span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground group-hover:text-primary transition-colors mt-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Exams Group -->
        <div>
          <h2 class="text-sm font-bold text-foreground uppercase tracking-wider mb-3 flex items-center gap-2">
            <span>Exams</span>
            <span class="text-xs text-muted-foreground font-normal">({examResults.length})</span>
          </h2>
          <div class="space-y-3">
            {examResults.map(r => (
              <a
                href="/calendar"
                class="block p-4 rounded-xl bg-card border border-border hover:border-border/80 hover:shadow-xs transition-all group"
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 mb-1">
                      {r.type}
                    </span>
                    <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">
                      {r.title}
                    </h3>
                    <p class="text-xs text-muted-foreground mt-1">{r.snippet}</p>
                    <span class="text-[11px] font-mono text-muted-foreground block mt-2">{r.meta}</span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground group-hover:text-primary transition-colors mt-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Organisations Group -->
        <div>
          <h2 class="text-sm font-bold text-foreground uppercase tracking-wider mb-3 flex items-center gap-2">
            <span>Organisations</span>
            <span class="text-xs text-muted-foreground font-normal">({orgResults.length})</span>
          </h2>
          <div class="space-y-3">
            {orgResults.map(r => (
              <a
                href={`/organisations/${r.slug}`}
                class="block p-4 rounded-xl bg-card border border-border hover:border-border/80 hover:shadow-xs transition-all group"
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-300 mb-1">
                      {r.type}
                    </span>
                    <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">
                      {r.title}
                    </h3>
                    <p class="text-xs text-muted-foreground mt-1">{r.snippet}</p>
                    <span class="text-[11px] font-mono text-muted-foreground block mt-2">{r.meta}</span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground group-hover:text-primary transition-colors mt-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Can't find what you need panel -->
        <div class="p-6 rounded-2xl bg-muted/60 border border-border text-center">
          <h3 class="font-bold text-sm text-foreground mb-1">Can’t find what you need?</h3>
          <p class="text-xs text-muted-foreground mb-4">Try checking all active notifications or run an instant eligibility calculation.</p>
          <div class="flex items-center justify-center gap-3">
            <a href="/jobs" class="px-4 py-2 rounded-lg border border-border bg-card hover:bg-muted text-foreground text-xs font-semibold">
              Browse all jobs
            </a>
            <a href="/eligibility-checker" class="px-4 py-2 rounded-lg bg-primary hover:bg-blue-700 text-primary-foreground text-xs font-semibold">
              Check eligibility
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
