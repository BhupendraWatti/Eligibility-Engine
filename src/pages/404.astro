---
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="Page Not Found — NIRNAY MP"
  description="The requested NIRNAY MP page or resource could not be found."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center" data-not-found>
    <p class="text-xs font-bold uppercase tracking-wider text-primary mb-3">404 · Page not found</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-foreground mb-4">We couldn’t find that page</h1>
    <p class="text-sm text-muted-foreground mb-8">
      The page may have moved, or the sector or recruitment you requested may no longer be available.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="px-5 py-3 rounded-lg bg-primary text-primary-foreground font-semibold text-sm">
        Return home
      </a>
      <a href="/jobs" class="px-5 py-3 rounded-lg border border-border bg-card text-foreground font-semibold text-sm">
        Browse jobs
      </a>
    </div>
  </section>
</BaseLayout>
