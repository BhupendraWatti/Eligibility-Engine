---
// src/components/admin/AdminSidebar.astro
interface Props {
  current?: string;
}

const { current = 'dashboard' } = Astro.props;
const pathname = Astro.url.pathname;

const isMasterActive =
  current === 'masters' ||
  current === 'organisations' ||
  current === 'departments' ||
  current === 'sectors-posts' ||
  current === 'states' ||
  pathname.startsWith('/admin/masters') ||
  pathname.startsWith('/admin/organisations') ||
  pathname.startsWith('/admin/departments') ||
  pathname.startsWith('/admin/sectors-posts') ||
  pathname.startsWith('/admin/states');

const navSections = [
  {
    title: 'Workspace',
    items: [
      {
        name: 'Dashboard',
        href: '/admin',
        key: 'dashboard',
        active: current === 'dashboard' || pathname === '/admin' || pathname === '/admin/',
        icon: 'dashboard',
      },
      {
        name: 'Recruitments',
        href: '/admin/recruitments',
        key: 'recruitments',
        active: current === 'recruitments' || pathname.startsWith('/admin/recruitments'),
        icon: 'briefcase',
      },
    ],
  },
  {
    title: 'Master Records',
    badge: '5 Sub-types',
    isMasterGroup: true,
    items: [
      {
        name: 'States & Jurisdictions',
        href: '/admin/states',
        key: 'states',
        active: current === 'states' || pathname.startsWith('/admin/states'),
        icon: 'map-pin',
      },
      {
        name: 'Canonical Posts',
        href: '/admin/masters',
        key: 'masters',
        active: current === 'masters' || pathname.startsWith('/admin/masters'),
        icon: 'file-text',
      },
      {
        name: 'Sectors & Posts',
        href: '/admin/sectors-posts',
        key: 'sectors-posts',
        active: current === 'sectors-posts' || pathname.startsWith('/admin/sectors-posts'),
        icon: 'layers',
      },
      {
        name: 'Departments',
        href: '/admin/departments',
        key: 'departments',
        active: current === 'departments' || pathname.startsWith('/admin/departments'),
        icon: 'network',
      },
      {
        name: 'Organisations',
        href: '/admin/organisations',
        key: 'organisations',
        active: current === 'organisations' || pathname.startsWith('/admin/organisations'),
        icon: 'building',
      },
    ],
  },
  {
    title: 'Rules & Content',
    items: [
      {
        name: 'Eligibility rules',
        href: '/admin/eligibility-rules',
        key: 'eligibility-rules',
        active: current === 'eligibility-rules' || pathname.startsWith('/admin/eligibility-rules'),
        icon: 'list-checks',
      },
      {
        name: 'Sources',
        href: '/admin/sources',
        key: 'sources',
        active: current === 'sources' || pathname.startsWith('/admin/sources'),
        icon: 'link',
        hasAlert: true,
      },
      {
        name: 'Documents',
        href: '/admin/documents',
        key: 'documents',
        active: current === 'documents' || pathname.startsWith('/admin/documents'),
        icon: 'file-text',
      },
    ],
  },
  {
    title: 'Platform & Governance',
    items: [
      {
        name: 'SEO',
        href: '/admin/seo',
        key: 'seo',
        active: current === 'seo' || pathname.startsWith('/admin/seo'),
        icon: 'search-check',
      },
      {
        name: 'Audit log',
        href: '/admin/audit-log',
        key: 'audit-log',
        active: current === 'audit-log' || pathname.startsWith('/admin/audit-log'),
        icon: 'scroll-text',
      },
      {
        name: 'Settings',
        href: '/admin/settings',
        key: 'settings',
        active: current === 'settings' || pathname.startsWith('/admin/settings'),
        icon: 'settings',
      },
    ],
  },
];
---

<aside class="w-60 bg-[#09090b] text-zinc-300 border-r border-zinc-800 shrink-0 hidden md:flex flex-col justify-between p-3.5 h-screen sticky top-0 z-40 select-none overflow-y-auto">
  <div class="space-y-4">
    <!-- Brand Mark -->
    <div class="px-2 py-2 flex items-center justify-between border-b border-zinc-800/80 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="size-7 rounded bg-white text-zinc-950 font-black text-xs flex items-center justify-center font-mono">
          N
        </div>
        <div>
          <div class="font-bold text-xs uppercase tracking-wider text-white font-mono leading-none">NIRNAY OPS</div>
          <div class="text-[10px] text-zinc-400 mt-0.5">Control Center</div>
        </div>
      </div>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-zinc-800 text-zinc-300 border border-zinc-700">
        v2.6
      </span>
    </div>

    <!-- Navigation Sections -->
    <div class="space-y-3.5">
      {navSections.map((section) => (
        <div class="space-y-1">
          <div class="px-2.5 py-0.5 flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            <span>{section.title}</span>
            {section.badge && (
              <span class="text-[9px] font-mono font-medium px-1 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
                {section.badge}
              </span>
            )}
          </div>

          <nav class={`space-y-0.5 text-xs font-medium ${section.isMasterGroup ? 'pl-1 border-l-2 border-zinc-800/80 ml-2' : ''}`} aria-label={`${section.title} navigation`}>
            {section.items.map((item) => (
              <a
                href={item.href}
                class={`flex items-center gap-2.5 px-2.5 py-1.5 rounded-md transition-all ${
                  item.active
                    ? 'bg-zinc-800 text-white font-semibold shadow-xs'
                    : 'text-zinc-400 hover:text-white hover:bg-zinc-900/90'
                }`}
              >
                {item.icon === 'map-pin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {item.icon === 'dashboard' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                )}
                {item.icon === 'briefcase' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                )}
                {item.icon === 'building' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                )}
                {item.icon === 'network' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
                )}
                {item.icon === 'layers' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                )}
                {item.icon === 'list-checks' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                )}
                {item.icon === 'link' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                )}
                {item.icon === 'file-text' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                )}
                {item.icon === 'search-check' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m8 11 2 2 4-4"/></svg>
                )}
                {item.icon === 'scroll-text' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/></svg>
                )}
                {item.icon === 'settings' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                )}
                <span class="truncate flex-1">{item.name}</span>
                {item.hasAlert && (
                  <span class="size-1.5 rounded-full bg-amber-500 ring-2 ring-zinc-900"></span>
                )}
              </a>
            ))}
          </nav>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Workspace Utilities -->
  <div class="pt-3 border-t border-zinc-800/80 space-y-2">
    <!-- Public Platform External Link -->
    <a
      href="/"
      target="_blank"
      class="flex items-center justify-between px-2.5 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-900 transition-colors text-[11px]"
    >
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>Public Portal</span>
      </span>
      <span class="text-[10px] text-zinc-400 font-mono">&rarr;</span>
    </a>

    <!-- Admin Profile Pill -->
    <div class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg bg-zinc-900/60 border border-zinc-800">
      <div class="size-7 rounded-full bg-zinc-800 text-white flex items-center justify-center font-bold text-xs font-mono">
        AM
      </div>
      <div class="truncate">
        <div class="text-xs font-semibold text-white truncate">Aarav Mehta</div>
        <div class="text-[10px] text-zinc-400 truncate">Super Admin</div>
      </div>
    </div>
  </div>
</aside>
