---
// src/components/admin/AdminSidebar.astro
import { PIPELINE_ENABLED } from '../../lib/features';
interface Props {
  current?: string;
}

const { current = 'dashboard' } = Astro.props;
const pathname = Astro.url.pathname.replace(/^\/admin(?=\/|$)/, '') || '/';
// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'Unknown';

const navSections = [
  {
    title: 'Workspace',
    items: [
      {
        name: 'Dashboard',
        href: '/',
        key: 'dashboard',
        active: current === 'dashboard' || pathname === '/',
        icon: 'dashboard',
      },
      {
        name: 'Recruitments',
        href: '/recruitments',
        key: 'recruitments',
        active: current === 'recruitments' || pathname.startsWith('/recruitments'),
        icon: 'briefcase',
      },
    ],
  },
  {
    title: 'Master Records',
    badge: '5 Sub-types',
    isMasterGroup: true,
    items: [
      {
        name: 'States & Jurisdictions',
        href: '/states',
        key: 'states',
        active: current === 'states' || pathname.startsWith('/states'),
        icon: 'map-pin',
      },
      {
        name: 'Canonical Posts',
        href: '/masters',
        key: 'masters',
        active: current === 'masters' || pathname.startsWith('/masters'),
        icon: 'file-text',
      },
      {
        name: 'Sectors & Posts',
        href: '/sectors-posts',
        key: 'sectors-posts',
        active: current === 'sectors-posts' || pathname.startsWith('/sectors-posts'),
        icon: 'layers',
      },
      {
        name: 'Departments',
        href: '/departments',
        key: 'departments',
        active: current === 'departments' || pathname.startsWith('/departments'),
        icon: 'network',
      },
      {
        name: 'Organisations',
        href: '/organisations',
        key: 'organisations',
        active: current === 'organisations' || pathname.startsWith('/organisations'),
        icon: 'building',
      },
    ],
  },
  {
    title: 'Rules & Content',
    items: [
      {
        name: 'Eligibility rules',
        href: '/eligibility-rules',
        key: 'eligibility-rules',
        active: current === 'eligibility-rules' || pathname.startsWith('/eligibility-rules'),
        icon: 'list-checks',
      },
      {
        name: 'Sources',
        href: '/sources',
        key: 'sources',
        active: current === 'sources' || pathname.startsWith('/sources'),
        icon: 'link',
        hasAlert: true,
      },
      {
        name: 'Documents',
        href: '/documents',
        key: 'documents',
        active: current === 'documents' || pathname.startsWith('/documents'),
        icon: 'file-text',
      },
    ],
  },
  {
    title: 'Platform & Governance',
    items: [
      {
        name: 'SEO',
        href: '/seo',
        key: 'seo',
        active: current === 'seo' || pathname.startsWith('/seo'),
        icon: 'search-check',
      },
      {
        name: 'Pending changes',
        href: '/pending-changes',
        key: 'pending-changes',
        active: current === 'pending-changes' || pathname.startsWith('/pending-changes'),
        icon: 'inbox',
      },
      ...(PIPELINE_ENABLED ? [
        {
          name: 'Pipeline',
          href: '/pipeline',
          key: 'pipeline',
          active: current === 'pipeline' || pathname.startsWith('/pipeline'),
          icon: 'list-checks',
        },
        {
          name: 'Source registry',
          href: '/source-registry',
          key: 'source-registry',
          active: current === 'source-registry' || pathname.startsWith('/source-registry'),
          icon: 'link',
        },
      ] : []),
      {
        name: 'Audit log',
        href: '/audit-log',
        key: 'audit-log',
        active: current === 'audit-log' || pathname.startsWith('/audit-log'),
        icon: 'scroll-text',
      },
      {
        name: 'Settings',
        href: '/settings',
        key: 'settings',
        active: current === 'settings' || pathname.startsWith('/settings'),
        icon: 'settings',
      },
    ],
  },
];
---

<aside
  id="admin-desktop-sidebar"
  class="w-60 bg-white text-slate-600 border-r border-slate-200 shrink-0 hidden md:flex flex-col justify-between p-3 h-screen sticky top-0 z-40 select-none custom-scrollbar overflow-y-auto transition-[width,padding] duration-200 ease-in-out"
>
  <div class="space-y-3.5">
    <!-- Brand Mark -->
    <div class="sidebar-brand px-2 py-2 flex items-center justify-between border-b border-slate-200 pb-2.5">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="size-7 rounded bg-primary text-white font-black text-xs flex items-center justify-center font-mono shadow-xs group-hover:scale-105 transition-transform shrink-0">
          GR
        </div>
        <div class="sidebar-label">
          <div class="font-bold text-xs uppercase tracking-wider text-slate-900 font-mono leading-none">GR OPS</div>
          <div class="text-[10px] text-slate-500 mt-0.5">Control Center</div>
        </div>
      </a>
      <span class="sidebar-badge inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200">
        v2.7
      </span>
    </div>

    <!-- Navigation Sections -->
    <div class="space-y-3">
      {navSections.map((section) => (
        <div class="space-y-1">
          <div class="sidebar-section-title px-2.5 py-0.5 flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-slate-500">
            <span>{section.title}</span>
            {section.badge && (
              <span class="text-[9px] font-mono font-medium px-1 rounded bg-slate-100 text-slate-500 border border-slate-200">
                {section.badge}
              </span>
            )}
          </div>

          <nav class={`sidebar-nav-group space-y-0.5 text-xs font-medium ${section.isMasterGroup ? 'pl-1 border-l-2 border-slate-200 ml-2' : ''}`} aria-label={`${section.title} navigation`}>
            {section.items.map((item) => (
              <a
                href={item.href}
                title={item.name}
                aria-current={item.active ? 'page' : undefined}
                class={`sidebar-link relative flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg transition-all ${
                  item.active
                    ? 'bg-blue-50 text-primary font-semibold shadow-xs border border-blue-200'
                    : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100'
                }`}
              >
                {item.icon === 'map-pin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {item.icon === 'dashboard' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                )}
                {item.icon === 'briefcase' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                )}
                {item.icon === 'building' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                )}
                {item.icon === 'network' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
                )}
                {item.icon === 'layers' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                )}
                {item.icon === 'list-checks' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                )}
                {item.icon === 'inbox' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                )}
                {item.icon === 'link' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                )}
                {item.icon === 'file-text' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                )}
                {item.icon === 'search-check' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m8 11 2 2 4-4"/></svg>
                )}
                {item.icon === 'scroll-text' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/></svg>
                )}
                {item.icon === 'settings' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                )}
                <span class="sidebar-label truncate flex-1">{item.name}</span>
                {item.hasAlert && (
                  <span class="size-1.5 rounded-full bg-rose-500 ring-2 ring-white shrink-0"></span>
                )}
              </a>
            ))}
          </nav>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Workspace Utilities -->
  <div class="pt-3 border-t border-slate-200 space-y-2 shrink-0">
    <!-- Rail Collapse Toggle Button -->
    <button
      type="button"
      id="sidebar-collapse-btn"
      class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors text-xs cursor-pointer"
      title="Collapse / Expand Sidebar"
    >
      <span class="sidebar-label flex items-center gap-1.5 text-[11px] font-medium">
        <span>Collapse Sidebar</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="sidebar-collapse-icon size-3.5 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="11 17 6 12 11 7"></polyline>
        <polyline points="18 17 13 12 18 7"></polyline>
      </svg>
    </button>

    <!-- Public Platform External Link -->
    <a
      href="/"
      target="_blank"
      class="sidebar-link flex items-center justify-between px-2.5 py-1.5 rounded-md text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors text-[11px]"
      title="Open Public Discovery Portal"
    >
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span class="sidebar-label">Public Portal</span>
      </span>
      <span class="sidebar-label text-[10px] text-slate-500 font-mono">&rarr;</span>
    </a>

    <!-- Admin Profile Pill -->
    <div class="sidebar-link flex items-center gap-2.5 px-2 py-1.5 rounded-lg bg-slate-50 border border-slate-200">
      <div class="size-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs font-mono shrink-0">
        {adminEmail.slice(0, 2).toUpperCase()}
      </div>
      <div class="sidebar-user-details truncate">
        <div class="text-xs font-semibold text-slate-900 truncate">Authenticated admin</div>
        <div class="text-[10px] text-slate-500 truncate">{adminEmail}</div>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Collapsed Rail Mode Styling */
  #admin-desktop-sidebar.sidebar-collapsed {
    width: 4.25rem !important; /* ~68px */
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed .sidebar-label,
  #admin-desktop-sidebar.sidebar-collapsed .sidebar-badge,
  #admin-desktop-sidebar.sidebar-collapsed .sidebar-section-title,
  #admin-desktop-sidebar.sidebar-collapsed .sidebar-user-details {
    display: none !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed .sidebar-nav-group {
    margin-left: 0 !important;
    padding-left: 0 !important;
    border-left: none !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed .sidebar-link {
    justify-content: center !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed .sidebar-brand {
    justify-content: center !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed #sidebar-collapse-btn {
    justify-content: center !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  #admin-desktop-sidebar.sidebar-collapsed .sidebar-collapse-icon {
    transform: rotate(180deg) !important;
  }
</style>

<script>
  function setupAdminSidebar() {
    const sidebar = document.getElementById('admin-desktop-sidebar');
    const collapseBtn = document.getElementById('sidebar-collapse-btn');
    if (!sidebar) return;

    // Check saved state or auto-collapse on tablet/medium screens (768px-1024px)
    const savedState = localStorage.getItem('nirnay_sidebar_collapsed');
    const isMediumScreen = window.innerWidth >= 768 && window.innerWidth < 1024;

    if (savedState === '1' || (savedState === null && isMediumScreen)) {
      sidebar.classList.add('sidebar-collapsed');
    } else {
      sidebar.classList.remove('sidebar-collapsed');
    }

    function toggleCollapse() {
      sidebar.classList.toggle('sidebar-collapsed');
      const isCollapsed = sidebar.classList.contains('sidebar-collapsed');
      localStorage.setItem('nirnay_sidebar_collapsed', isCollapsed ? '1' : '0');
      window.dispatchEvent(new CustomEvent('nirnay:sidebar-toggled', { detail: { collapsed: isCollapsed } }));
    }

    collapseBtn?.addEventListener('click', toggleCollapse);
    window.addEventListener('nirnay:toggle-desktop-sidebar', toggleCollapse);

    // Keyboard shortcut: Ctrl+B or Cmd+B
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
        e.preventDefault();
        toggleCollapse();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminSidebar);
  } else {
    setupAdminSidebar();
  }
  document.addEventListener('astro:page-load', setupAdminSidebar);
</script>
