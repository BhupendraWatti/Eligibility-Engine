---
// src/components/admin/AdminMobileDrawer.astro
import { PIPELINE_ENABLED } from '../../lib/features';
interface Props {
  current?: string;
}

const { current = 'dashboard' } = Astro.props;
const pathname = Astro.url.pathname.replace(/^\/admin(?=\/|$)/, '') || '/';

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'Unknown';

const navGroups = [
  {
    title: 'Workspace',
    items: [
      {
        name: 'Dashboard',
        href: '/',
        key: 'dashboard',
        active: current === 'dashboard' || pathname === '/',
        icon: 'dashboard',
      },
      {
        name: 'Recruitments',
        href: '/recruitments',
        key: 'recruitments',
        active: current === 'recruitments' || pathname.startsWith('/recruitments'),
        icon: 'briefcase',
      },
    ],
  },
  {
    title: 'Master Records',
    badge: '5 Sub-types',
    isMasterGroup: true,
    items: [
      {
        name: 'States & Jurisdictions',
        href: '/states',
        key: 'states',
        active: current === 'states' || pathname.startsWith('/states'),
        icon: 'map-pin',
      },
      {
        name: 'Canonical Posts',
        href: '/masters',
        key: 'masters',
        active: current === 'masters' || pathname.startsWith('/masters'),
        icon: 'file-text',
      },
      {
        name: 'Sectors & Posts',
        href: '/sectors-posts',
        key: 'sectors-posts',
        active: current === 'sectors-posts' || pathname.startsWith('/sectors-posts'),
        icon: 'layers',
      },
      {
        name: 'Departments',
        href: '/departments',
        key: 'departments',
        active: current === 'departments' || pathname.startsWith('/departments'),
        icon: 'network',
      },
      {
        name: 'Organisations',
        href: '/organisations',
        key: 'organisations',
        active: current === 'organisations' || pathname.startsWith('/organisations'),
        icon: 'building',
      },
    ],
  },
  {
    title: 'Rules & Content',
    items: [
      {
        name: 'Eligibility rules',
        href: '/eligibility-rules',
        key: 'eligibility-rules',
        active: current === 'eligibility-rules' || pathname.startsWith('/eligibility-rules'),
        icon: 'list-checks',
      },
      {
        name: 'Sources',
        href: '/sources',
        key: 'sources',
        active: current === 'sources' || pathname.startsWith('/sources'),
        icon: 'link',
        badge: 'Alerts',
      },
      {
        name: 'Documents',
        href: '/documents',
        key: 'documents',
        active: current === 'documents' || pathname.startsWith('/documents'),
        icon: 'file-text',
      },
    ],
  },
  {
    title: 'Platform & Governance',
    items: [
      {
        name: 'SEO',
        href: '/seo',
        key: 'seo',
        active: current === 'seo' || pathname.startsWith('/seo'),
        icon: 'search-check',
      },
      {
        name: 'Pending changes',
        href: '/pending-changes',
        key: 'pending-changes',
        active: current === 'pending-changes' || pathname.startsWith('/pending-changes'),
        icon: 'inbox',
      },
      ...(PIPELINE_ENABLED ? [
        {
          name: 'Pipeline',
          href: '/pipeline',
          key: 'pipeline',
          active: current === 'pipeline' || pathname.startsWith('/pipeline'),
          icon: 'list-checks',
        },
        {
          name: 'Source registry',
          href: '/source-registry',
          key: 'source-registry',
          active: current === 'source-registry' || pathname.startsWith('/source-registry'),
          icon: 'link',
        },
      ] : []),
      {
        name: 'Audit log',
        href: '/audit-log',
        key: 'audit-log',
        active: current === 'audit-log' || pathname.startsWith('/audit-log'),
        icon: 'scroll-text',
      },
      {
        name: 'Settings',
        href: '/settings',
        key: 'settings',
        active: current === 'settings' || pathname.startsWith('/settings'),
        icon: 'settings',
      },
    ],
  },
];
---

<!-- Mobile Drawer Modal -->
<div
  id="admin-mobile-drawer"
  class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 invisible"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
>
  <!-- Backdrop -->
  <div
    id="admin-mobile-drawer-backdrop"
    class="absolute inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Off-canvas Container -->
  <div class="fixed inset-y-0 left-0 max-w-[280px] w-full flex">
    <div
      id="admin-mobile-drawer-content"
      class="relative flex-1 flex flex-col w-full bg-white text-slate-600 shadow-2xl transition-transform duration-300 -translate-x-full border-r border-slate-200"
    >
      <!-- Header with Brand & Close Button -->
      <div class="flex items-center justify-between px-4 py-3.5 border-b border-slate-200 bg-slate-50">
        <div class="flex items-center gap-2.5">
          <div class="size-7 rounded bg-primary text-white font-black text-xs flex items-center justify-center font-mono shadow-xs">
            GR
          </div>
          <div>
            <div class="font-bold text-xs uppercase tracking-wider text-slate-900 font-mono leading-none">GR OPS</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Control Center</div>
          </div>
        </div>

        <button
          type="button"
          id="admin-mobile-drawer-close"
          class="p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400 cursor-pointer"
          aria-label="Close navigation"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Navigation Links (Scrollable with custom sleek scrollbar) -->
      <div class="flex-1 overflow-y-auto custom-scrollbar px-3 py-3 space-y-4">
        {navGroups.map((group) => (
          <div>
            <div class="px-2.5 mb-1.5 flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-slate-500">
              <span>{group.title}</span>
              {group.badge && (
                <span class="text-[9px] font-mono font-medium px-1 rounded bg-slate-100 text-slate-500 border border-slate-200">
                  {group.badge}
                </span>
              )}
            </div>
            <nav class="space-y-1">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class={`flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all ${
                    item.active
                      ? 'bg-blue-50 text-primary font-semibold shadow-xs border border-blue-200'
                      : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    {item.icon === 'map-pin' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    )}
                    {item.icon === 'dashboard' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                    )}
                    {item.icon === 'briefcase' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    )}
                    {item.icon === 'building' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                    )}
                    {item.icon === 'network' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
                    )}
                    {item.icon === 'layers' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                    )}
                    {item.icon === 'list-checks' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
                    )}
                    {item.icon === 'inbox' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                    )}
                    {item.icon === 'link' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    )}
                    {item.icon === 'file-text' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                    )}
                    {item.icon === 'search-check' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m8 11 2 2 4-4"/></svg>
                    )}
                    {item.icon === 'scroll-text' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/></svg>
                    )}
                    {item.icon === 'settings' && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    )}
                    <span>{item.name}</span>
                  </div>

                  {item.badge && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-rose-500/20 text-amber-300 border border-amber-500/30">
                      {item.badge}
                    </span>
                  )}
                </a>
              ))}
            </nav>
          </div>
        ))}
      </div>

      <!-- Footer User Profile & Public Portal -->
      <div class="p-3 border-t border-slate-200 bg-slate-50 space-y-2">
        <a
          href="/"
          target="_blank"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors text-xs"
        >
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span>Public Portal View</span>
          </span>
          <span class="text-xs text-slate-500 font-mono">&rarr;</span>
        </a>

        <div class="flex items-center gap-2.5 px-3 py-2 rounded-lg bg-slate-50 border border-slate-200">
          <div class="size-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs font-mono">
            {adminEmail.slice(0, 2).toUpperCase()}
          </div>
          <div class="truncate">
            <div class="text-xs font-semibold text-slate-900 truncate">Authenticated admin</div>
            <div class="text-[10px] text-slate-500 truncate">{adminEmail}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupAdminMobileDrawer() {
    const drawer = document.getElementById('admin-mobile-drawer');
    const backdrop = document.getElementById('admin-mobile-drawer-backdrop');
    const content = document.getElementById('admin-mobile-drawer-content');
    const closeBtn = document.getElementById('admin-mobile-drawer-close');

    if (!drawer || !backdrop || !content) return;

    function openDrawer() {
      drawer.classList.remove('invisible', 'pointer-events-none');
      drawer.classList.add('pointer-events-auto', 'opacity-100');
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      content.classList.remove('-translate-x-full');
      content.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('pointer-events-auto', 'opacity-100');
      drawer.classList.add('pointer-events-none', 'opacity-0');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      content.classList.remove('translate-x-0');
      content.classList.add('-translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (drawer.classList.contains('pointer-events-none')) {
          drawer.classList.add('invisible');
        }
      }, 300);
    }

    // Attach listeners
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Global event listener for any open triggers
    window.addEventListener('nirnay:open-mobile-drawer', openDrawer);
    window.addEventListener('nirnay:close-mobile-drawer', closeDrawer);
    window.addEventListener('nirnay:toggle-mobile-drawer', () => {
      if (drawer.classList.contains('pointer-events-none')) {
        openDrawer();
      } else {
        closeDrawer();
      }
    });

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('pointer-events-none')) {
        closeDrawer();
      }
    });
  }

  // Setup on page load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminMobileDrawer);
  } else {
    setupAdminMobileDrawer();
  }
  document.addEventListener('astro:page-load', setupAdminMobileDrawer);
</script>
