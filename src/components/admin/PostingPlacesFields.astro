---
// Place-of-posting rows for the recruitment editors. Read back with postingPlacesFromForm (src/services/posting-places.ts):
// every row submits placeLocality, placeState, placePostalCode and placeStreet, and blank rows are dropped on save.
import { DOMICILE_STATES } from '../../services/domicile-scope';
import type { PostingPlace } from '../../services/posting-places';

interface Props {
  places?: PostingPlace[];
  /** The recruitment's own state; its rows show "Own state" instead of repeating it. 'IN' (central) needs a state per place. */
  ownStateCode?: string | null;
}

const { places = [], ownStateCode } = Astro.props;
const own = ownStateCode?.toUpperCase();
const rows: Array<Partial<PostingPlace>> = [...places, {}, {}];
const input = 'w-full px-2.5 py-1.5 rounded border border-zinc-200 text-xs focus:ring-2 focus:ring-zinc-900 outline-none';
---
<div class="space-y-2" data-posting-places>
  <div>
    <label class="block text-xs font-semibold text-zinc-800">Place of Posting</label>
    <p class="text-[11px] text-zinc-500">
      Only places the notice names (a district office, court or hospital). Leave empty when candidates may be posted anywhere in the state or India.
      Google shows these as the job's location.
    </p>
  </div>
  <div class="hidden sm:grid grid-cols-12 gap-2 text-[11px] font-semibold text-zinc-600">
    <span class="col-span-3">City / town *</span>
    <span class="col-span-3">State / UT</span>
    <span class="col-span-2">PIN code</span>
    <span class="col-span-4">Office / street address</span>
  </div>
  <div class="space-y-2" data-posting-rows>
    {rows.map((p, i) => (
      <div class="grid grid-cols-2 sm:grid-cols-12 gap-2" data-posting-row>
        <input type="text" name="placeLocality" value={p.locality ?? ''} maxlength="100" placeholder="e.g. Bhopal" aria-label={`Place ${i + 1} city or town`} class={`${input} sm:col-span-3`} />
        <select name="placeState" aria-label={`Place ${i + 1} state`} class={`${input} sm:col-span-3 bg-white`}>
          <option value="">{own === 'IN' ? 'Pick state' : 'Own state'}</option>
          {DOMICILE_STATES.map(s => (
            <option value={s.code} selected={!!p.stateCode && p.stateCode === s.code && p.stateCode !== own}>{s.name}</option>
          ))}
        </select>
        <input type="text" name="placePostalCode" value={p.postalCode ?? ''} inputmode="numeric" pattern="[1-9][0-9]{2} ?[0-9]{3}" maxlength="7" placeholder="462001" aria-label={`Place ${i + 1} PIN code`} class={`${input} sm:col-span-2 font-mono tabular-nums`} />
        <input type="text" name="placeStreet" value={p.streetAddress ?? ''} maxlength="200" placeholder="e.g. Office of the Collector, Jail Road" aria-label={`Place ${i + 1} address`} class={`${input} col-span-2 sm:col-span-4`} />
      </div>
    ))}
  </div>
  <button type="button" data-posting-add class="text-[11px] font-semibold text-zinc-700 hover:text-zinc-950 underline underline-offset-2">+ Add another place</button>
</div>

<script is:inline>
  (function () {
    function wire(box) {
      var add = box.querySelector('[data-posting-add]');
      if (!add || add.dataset.wired) return;
      add.dataset.wired = '1';
      add.addEventListener('click', function () {
        var rows = box.querySelector('[data-posting-rows]');
        var last = rows.lastElementChild;
        var row = last.cloneNode(true);
        row.querySelectorAll('input').forEach(function (el) { el.value = ''; });
        row.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });
        rows.appendChild(row);
        row.querySelector('input').focus();
      });
    }
    function init() { document.querySelectorAll('[data-posting-places]').forEach(wire); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
