---
// src/components/admin/MasterSubNav.astro
interface Props {
  currentTab: 'organisations' | 'departments' | 'sectors-posts' | 'masters' | 'states';
}

const { currentTab } = Astro.props;

const subTypes = [
  {
    key: 'states',
    label: 'States & Jurisdictions',
    href: '/admin/states',
    icon: 'map-pin',
    description: 'Statutory territories',
  },
  {
    key: 'masters',
    label: 'Canonical Posts',
    href: '/admin/masters',
    icon: 'posts',
    description: 'Master post definitions',
  },
  {
    key: 'sectors-posts',
    label: 'Sectors & Posts',
    href: '/admin/sectors-posts',
    icon: 'sectors',
    description: 'Cadre taxonomy',
  },
  {
    key: 'departments',
    label: 'Departments',
    href: '/admin/departments',
    icon: 'departments',
    description: 'State ministries',
  },
  {
    key: 'organisations',
    label: 'Organisations',
    href: '/admin/organisations',
    icon: 'organisations',
    description: 'Recruiting bodies',
  },
];
---

<!-- Master Records Sub-Types Navigation Bar (Mobile-Responsive Header Tabs) -->
<div class="space-y-1.5 pb-1">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-zinc-500">
      <span>Master Records Section</span>
      <span class="text-zinc-300">/</span>
      <span class="text-zinc-700">Sub-Types Catalog</span>
    </div>
    <span class="hidden sm:inline-flex text-[10px] font-mono text-zinc-400">
      5 Core Master Types
    </span>
  </div>

  <div class="flex items-center gap-1.5 p-1 bg-zinc-200/60 rounded-xl overflow-x-auto no-scrollbar text-xs font-semibold [overscroll-behavior-x:contain]">
    {subTypes.map((tab) => {
      const isActive = currentTab === tab.key;
      return (
        <a
          href={tab.href}
          class={`flex items-center gap-2 px-3 py-1.5 rounded-lg whitespace-nowrap transition-all shrink-0 ${
            isActive
              ? 'bg-white text-zinc-950 shadow-2xs font-bold'
              : 'text-zinc-600 hover:text-zinc-950 hover:bg-white/60 font-medium'
          }`}
        >
          {tab.icon === 'map-pin' && (
            <svg xmlns="http://www.w3.org/2000/svg" class={`size-3.5 ${isActive ? 'text-zinc-950' : 'text-zinc-400'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          )}
          {tab.icon === 'posts' && (
            <svg xmlns="http://www.w3.org/2000/svg" class={`size-3.5 ${isActive ? 'text-zinc-950' : 'text-zinc-400'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          )}
          {tab.icon === 'sectors' && (
            <svg xmlns="http://www.w3.org/2000/svg" class={`size-3.5 ${isActive ? 'text-zinc-950' : 'text-zinc-400'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
          )}
          {tab.icon === 'departments' && (
            <svg xmlns="http://www.w3.org/2000/svg" class={`size-3.5 ${isActive ? 'text-zinc-950' : 'text-zinc-400'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
          )}
          {tab.icon === 'organisations' && (
            <svg xmlns="http://www.w3.org/2000/svg" class={`size-3.5 ${isActive ? 'text-zinc-950' : 'text-zinc-400'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          )}
          <span>{tab.label}</span>
          {isActive && (
            <span class="size-1.5 rounded-full bg-zinc-950"></span>
          )}
        </a>
      );
    })}
  </div>
</div>
