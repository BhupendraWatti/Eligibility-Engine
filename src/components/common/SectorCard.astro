---
// src/components/common/SectorCard.astro
import SectorIcon from './SectorIcon.astro';
import { getSectorThemeDef, formatSectorOpportunity } from '../../services/sector-theme';

interface Props {
  sector: {
    id?: string;
    name: string;
    slug: string;
    description?: string | null;
    icon?: string | null;
    theme?: string | null;
  };
  activeDrivesCount?: number;
  asLink?: boolean;
  previewIdPrefix?: string;
  class?: string;
}

const {
  sector,
  activeDrivesCount = 0,
  asLink = true,
  previewIdPrefix,
  class: className = '',
} = Astro.props;

const themeDef = getSectorThemeDef(sector.theme);
const opportunity = formatSectorOpportunity(activeDrivesCount);
const descriptionText = sector.description || 'Public service domain covering canonical recruitment roles across India.';

const rootClasses = `group relative flex flex-col justify-between p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs hover:shadow-sm ${themeDef.hoverBorderClass} transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${className}`;
---

{asLink ? (
  <a
    href={`/sectors/${sector.slug}`}
    class={rootClasses}
    data-sector-card={sector.slug}
    id={previewIdPrefix ? `${previewIdPrefix}Card` : undefined}
  >
    <div>
      <div
        class={`size-10 rounded-lg border flex items-center justify-center mb-3.5 transition-colors ${themeDef.badgeClass}`}
        data-sector-icon-badge
        id={previewIdPrefix ? `${previewIdPrefix}Badge` : undefined}
      >
        <SectorIcon name={sector.icon} class="size-5" />
      </div>
      <h3
        class="font-bold text-sm sm:text-base text-zinc-950 dark:text-zinc-100 font-heading tracking-tight group-hover:text-primary transition-colors"
        data-sector-title
        id={previewIdPrefix ? `${previewIdPrefix}Title` : undefined}
      >
        {sector.name}
      </h3>
      <p
        class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 line-clamp-2 leading-relaxed"
        data-sector-desc
        id={previewIdPrefix ? `${previewIdPrefix}Desc` : undefined}
      >
        {descriptionText}
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
      <span
        class={`font-mono text-[11px] font-semibold transition-colors ${opportunity.hasDrives ? 'text-zinc-800 dark:text-zinc-200 group-hover:text-primary font-bold' : 'text-zinc-500 dark:text-zinc-400'}`}
        data-sector-metric
        id={previewIdPrefix ? `${previewIdPrefix}Metric` : undefined}
      >
        {opportunity.label}
      </span>
      <span
        class="text-zinc-400 dark:text-zinc-500 group-hover:text-primary group-hover:translate-x-0.5 transition-all text-xs"
        aria-hidden="true"
      >
        &rarr;
      </span>
    </div>
  </a>
) : (
  <div
    class={rootClasses}
    data-sector-card-preview
    id={previewIdPrefix ? `${previewIdPrefix}Card` : undefined}
  >
    <div>
      <div
        class={`size-10 rounded-lg border flex items-center justify-center mb-3.5 transition-colors ${themeDef.badgeClass}`}
        data-sector-icon-badge
        id={previewIdPrefix ? `${previewIdPrefix}Badge` : undefined}
      >
        <SectorIcon name={sector.icon} class="size-5" />
      </div>
      <h3
        class="font-bold text-sm sm:text-base text-zinc-950 dark:text-zinc-100 font-heading tracking-tight"
        data-sector-title
        id={previewIdPrefix ? `${previewIdPrefix}Title` : undefined}
      >
        {sector.name}
      </h3>
      <p
        class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 line-clamp-2 leading-relaxed"
        data-sector-desc
        id={previewIdPrefix ? `${previewIdPrefix}Desc` : undefined}
      >
        {descriptionText}
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
      <span
        class={`font-mono text-[11px] font-semibold ${opportunity.hasDrives ? 'text-zinc-800 dark:text-zinc-200 font-bold' : 'text-zinc-500 dark:text-zinc-400'}`}
        data-sector-metric
        id={previewIdPrefix ? `${previewIdPrefix}Metric` : undefined}
      >
        {opportunity.label}
      </span>
      <span
        class="text-zinc-400 dark:text-zinc-500 text-xs"
        aria-hidden="true"
      >
        &rarr;
      </span>
    </div>
  </div>
)}
