---
// src/components/common/SectorCard.astro
import SectorIcon from './SectorIcon.astro';
import { getSectorThemeDef } from '../../services/sector-theme';

interface Props {
  sector: {
    id?: string;
    name: string;
    slug: string;
    description?: string | null;
    icon?: string | null;
    theme?: string | null;
  };
  activeDrivesCount?: number;
  asLink?: boolean;
  previewIdPrefix?: string;
  class?: string;
}

const {
  sector,
  activeDrivesCount = 0,
  asLink = true,
  previewIdPrefix,
  class: className = '',
} = Astro.props;

const themeDef = getSectorThemeDef(sector.theme);
const hasDrives = activeDrivesCount > 0;
const opportunityLabel = activeDrivesCount === 1
  ? '1 active drive'
  : activeDrivesCount > 1
    ? `${activeDrivesCount} active drives`
    : 'Explore cadres';
const descriptionText = sector.description || 'Public service domain covering canonical recruitment roles across India.';
const Root = asLink ? 'a' : 'div';

const rootClasses = `group relative flex items-start gap-4 py-5 border-b border-border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 ${className}`;
---

<Root
  href={asLink ? `/sectors/${sector.slug}` : undefined}
  class={rootClasses}
  data-sector-card={asLink ? sector.slug : undefined}
  data-sector-card-preview={!asLink ? true : undefined}
  id={previewIdPrefix ? `${previewIdPrefix}Card` : undefined}
>
  <div
    class={`size-9 shrink-0 rounded-md border flex items-center justify-center mt-0.5 ${themeDef.badgeClass}`}
    data-sector-icon-badge
    id={previewIdPrefix ? `${previewIdPrefix}Badge` : undefined}
  >
    <SectorIcon name={sector.icon} class="size-[18px]" />
  </div>
  <div class="min-w-0 flex-1">
    <h3
      class={`font-bold text-base text-foreground font-heading leading-snug ${asLink ? 'group-hover:text-primary group-hover:underline underline-offset-4 decoration-1' : ''}`}
      data-sector-title
      id={previewIdPrefix ? `${previewIdPrefix}Title` : undefined}
    >
      {sector.name}
    </h3>
    <p
      class="text-sm text-muted-foreground mt-1 line-clamp-2 leading-relaxed"
      data-sector-desc
      id={previewIdPrefix ? `${previewIdPrefix}Desc` : undefined}
    >
      {descriptionText}
    </p>
  </div>
  {(hasDrives || !asLink) && (
  <span
    class={`shrink-0 text-xs mt-1 whitespace-nowrap ${hasDrives ? 'font-bold text-primary' : 'text-muted-foreground'}`}
    data-sector-metric
    id={previewIdPrefix ? `${previewIdPrefix}Metric` : undefined}
  >
    {opportunityLabel}
  </span>
  )}
</Root>
