---
// src/components/common/SectorCard.astro
import SectorIcon from './SectorIcon.astro';
import { getSectorThemeDef } from '../../services/sector-theme';

interface Props {
  sector: {
    id?: string;
    name: string;
    slug: string;
    description?: string | null;
    icon?: string | null;
    theme?: string | null;
  };
  activeDrivesCount?: number;
  asLink?: boolean;
  previewIdPrefix?: string;
  class?: string;
}

const {
  sector,
  activeDrivesCount = 0,
  asLink = true,
  previewIdPrefix,
  class: className = '',
} = Astro.props;

const themeDef = getSectorThemeDef(sector.theme);
const hasDrives = activeDrivesCount > 0;
const opportunityLabel = activeDrivesCount === 1
  ? '1 active drive'
  : activeDrivesCount > 1
    ? `${activeDrivesCount} active drives`
    : 'Explore cadres';
const descriptionText = sector.description || 'Public service domain covering canonical recruitment roles across India.';
const Root = asLink ? 'a' : 'div';

const rootClasses = `group relative flex flex-col justify-between p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs hover:shadow-sm ${themeDef.hoverBorderClass} transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${className}`;
---

<Root
  href={asLink ? `/sectors/${sector.slug}` : undefined}
  class={rootClasses}
  data-sector-card={asLink ? sector.slug : undefined}
  data-sector-card-preview={!asLink ? true : undefined}
  id={previewIdPrefix ? `${previewIdPrefix}Card` : undefined}
>
  <div>
    <div
      class={`size-10 rounded-lg border flex items-center justify-center mb-3.5 transition-colors ${themeDef.badgeClass}`}
      data-sector-icon-badge
      id={previewIdPrefix ? `${previewIdPrefix}Badge` : undefined}
    >
      <SectorIcon name={sector.icon} class="size-5" />
    </div>
    <h3
      class={`font-bold text-sm sm:text-base text-zinc-950 dark:text-zinc-100 font-heading tracking-tight transition-colors ${asLink ? 'group-hover:text-primary' : ''}`}
      data-sector-title
      id={previewIdPrefix ? `${previewIdPrefix}Title` : undefined}
    >
      {sector.name}
    </h3>
    <p
      class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 line-clamp-2 leading-relaxed"
      data-sector-desc
      id={previewIdPrefix ? `${previewIdPrefix}Desc` : undefined}
    >
      {descriptionText}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
    <span
      class={`font-mono text-[11px] font-semibold transition-colors ${hasDrives ? `text-zinc-800 dark:text-zinc-200 font-bold ${asLink ? 'group-hover:text-primary' : ''}` : 'text-zinc-500 dark:text-zinc-400'}`}
      data-sector-metric
      id={previewIdPrefix ? `${previewIdPrefix}Metric` : undefined}
    >
      {opportunityLabel}
    </span>
    <span
      class={`text-zinc-400 dark:text-zinc-500 transition-all text-xs ${asLink ? 'group-hover:text-primary group-hover:translate-x-0.5' : ''}`}
      aria-hidden="true"
    >
      &rarr;
    </span>
  </div>
</Root>
