---
// src/components/common/MobileBottomNav.astro
const pathname = Astro.url.pathname;

const items = [
  {
    href: '/',
    label: 'Home',
    active: pathname === '/',
    icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  },
  {
    href: '/jobs',
    label: 'Jobs',
    active: pathname.startsWith('/jobs') || pathname.startsWith('/recruitments') || pathname.startsWith('/posts'),
    icon: '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  },
  {
    href: '/eligibility-checker',
    label: 'Eligibility',
    active: pathname.startsWith('/eligibility'),
    primary: true,
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    href: '/calendar',
    label: 'Calendar',
    active: pathname.startsWith('/calendar'),
    icon: '<path d="M8 2v4M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  },
  {
    href: '/results',
    label: 'Results',
    active: pathname.startsWith('/results') || pathname.startsWith('/admit-cards') || pathname.startsWith('/answer-keys'),
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
  },
];
---

<nav
  aria-label="Mobile navigation dock"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-card/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden no-print"
>
  <ul class="mx-auto grid h-16 max-w-lg grid-cols-5">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={[
            'relative flex h-full flex-col items-center justify-center gap-1 text-[10px] transition-colors',
            'before:absolute before:inset-x-5 before:top-[-1px] before:h-0.5 before:rounded-full',
            item.active
              ? 'font-semibold text-primary before:bg-primary dark:text-blue-400 dark:before:bg-blue-400'
              : 'font-medium text-muted-foreground hover:text-foreground before:bg-transparent',
          ]}
        >
          {item.primary ? (
            <span class="flex size-8 items-center justify-center rounded-lg bg-primary text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            </span>
          ) : (
            <span class="flex size-8 items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2.2 : 1.9} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            </span>
          )}
          <span class="leading-none">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
