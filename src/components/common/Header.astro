---
// src/components/common/Header.astro
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/jobs', label: 'All Jobs', active: pathname.startsWith('/jobs') || pathname.startsWith('/recruitments') },
  { href: '/calendar', label: 'Exam Calendar', active: pathname.startsWith('/calendar') },
  { href: '/results', label: 'Results', active: pathname.startsWith('/results') },
  { href: '/admit-cards', label: 'Admit Cards', active: pathname.startsWith('/admit-cards') },
  { href: '/answer-keys', label: 'Answer Keys', active: pathname.startsWith('/answer-keys') },
  { href: '/#sectors', label: 'Cadre Guides', active: pathname.startsWith('/posts') || pathname.startsWith('/sectors') },
];
const eligibilityActive = pathname.startsWith('/eligibility');
const mobileItems = [...navItems, { href: '/eligibility-checker', label: 'Eligibility Checker', active: eligibilityActive }];
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-card/90 text-foreground backdrop-blur-md no-print">
  <div class="civic-tricolor-bar w-full"></div>

  <!-- Utility bar -->
  <div class="border-b border-border/70">
    <div class="mx-auto flex h-8 max-w-7xl items-center justify-between gap-4 px-4 text-[11px] text-muted-foreground sm:px-6">
      <p class="flex min-w-0 items-center gap-2">
        <span class="inline-block size-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
        <span class="truncate">Independent recruitment &amp; eligibility platform · Links to official gazettes</span>
      </p>
      <nav class="hidden shrink-0 items-center gap-4 sm:flex" aria-label="Policies">
        <a href="/disclaimer" class="transition-colors hover:text-foreground">Disclaimer</a>
        <a href="/source-policy" class="transition-colors hover:text-foreground">Verification standards</a>
        <a href="/admin" class="font-semibold text-primary transition-colors hover:text-primary-hover dark:text-blue-400">GR OPS</a>
      </nav>
    </div>
  </div>

  <!-- Main bar -->
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:gap-6">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label="GovtRecruitments home">
      <img src="/brand/light/favicon-192x192.png" alt="" width="32" height="32" class="size-8 shrink-0 dark:hidden" />
      <img src="/brand/dark/favicon-192x192.png" alt="" width="32" height="32" class="hidden size-8 shrink-0 dark:block" />
      <span class="flex flex-col">
        <span class="font-heading text-[17px] font-extrabold leading-none tracking-tight text-foreground">GovtRecruitments</span>
        <span class="mt-1 hidden text-[10px] font-medium leading-none tracking-wide text-muted-foreground sm:block lg:hidden 2xl:block">
          Recruitment &amp; eligibility discovery
        </span>
      </span>
    </a>

    <!-- Desktop nav: quiet text links, active state is a 2px rule on the header's bottom edge -->
    <nav class="hidden h-full min-w-0 flex-1 items-center gap-0.5 lg:flex" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={[
            'relative flex h-full items-center whitespace-nowrap px-2.5 text-[13px] transition-colors',
            'after:absolute after:inset-x-2.5 after:bottom-[-1px] after:h-0.5 after:rounded-full after:transition-colors',
            item.active
              ? 'font-semibold text-foreground after:bg-primary dark:after:bg-blue-400'
              : 'font-medium text-muted-foreground hover:text-foreground after:bg-transparent hover:after:bg-border',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      <!-- Desktop search (xl+) -->
      <form action="/search" method="get" class="hidden xl:block" role="search">
        <label class="flex h-9 w-48 items-center gap-2 rounded-md border border-border bg-background px-2.5 text-muted-foreground transition-colors focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/15 2xl:w-60">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            id="nirnay-header-search"
            type="search"
            name="q"
            placeholder="Search exams, posts"
            aria-label="Search opportunities"
            class="min-w-0 flex-1 bg-transparent text-[13px] text-foreground outline-none placeholder:text-muted-foreground/70"
          />
          <kbd class="hidden rounded border border-border bg-muted px-1.5 font-mono text-[10px] leading-4 text-muted-foreground 2xl:inline">/</kbd>
        </label>
      </form>

      <!-- Search icon (lg only, where the field doesn't fit) -->
      <a href="/search" class="hidden size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground lg:inline-flex xl:hidden" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>

      <button
        type="button"
        class="theme-toggle hidden size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:inline-flex"
        aria-label="Switch to dark mode"
        title="Toggle light / dark theme"
      >
        <svg class="size-[18px] dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="size-[18px] hidden dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>

      <!-- Primary CTA (below sm the mobile dock carries it) -->
      <a
        href="/eligibility-checker"
        aria-current={eligibilityActive ? 'page' : undefined}
        class="hidden h-9 items-center gap-1.5 rounded-md bg-primary px-3.5 text-[13px] font-semibold text-primary-foreground transition-[background-color,transform] hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card active:scale-[0.98] sm:inline-flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="lg:hidden xl:inline">Check Eligibility</span>
        <span class="hidden lg:inline xl:hidden">Eligibility</span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="nirnay-mobile-menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nirnay-mobile-drawer"
        class="-mr-1.5 inline-flex size-10 items-center justify-center rounded-md text-foreground transition-colors hover:bg-muted lg:hidden"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu: overlays the page instead of pushing it down -->
  <div id="nirnay-mobile-backdrop" aria-hidden="true" class="absolute inset-x-0 top-full hidden h-dvh bg-black/40 lg:hidden"></div>
  <div
    id="nirnay-mobile-drawer"
    class="absolute inset-x-0 top-full hidden max-h-[calc(100dvh-10rem-env(safe-area-inset-bottom))] overflow-y-auto overscroll-contain border-b border-border bg-card lg:hidden"
  >
    <div class="mx-auto max-w-7xl px-4 pb-5 pt-3 sm:px-6">
      <form action="/search" method="get" role="search">
        <label class="flex h-11 items-center gap-2.5 rounded-md border border-border bg-background px-3 text-muted-foreground focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/15">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" placeholder="Search jobs, exams, posts, states" aria-label="Search opportunities" class="min-w-0 flex-1 bg-transparent text-[15px] text-foreground outline-none placeholder:text-muted-foreground/70" />
        </label>
      </form>

      <nav class="mt-3" aria-label="Mobile navigation">
        <ul class="divide-y divide-border">
          {mobileItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class:list={[
                  'flex h-12 items-center justify-between text-[15px] transition-colors',
                  item.active ? 'font-semibold text-primary dark:text-blue-400' : 'font-medium text-foreground hover:text-primary',
                ]}
              >
                {item.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <button type="button" class="theme-toggle flex h-12 w-full items-center justify-between border-y border-border text-[15px] font-medium text-foreground sm:hidden" aria-label="Switch to dark mode">
        <span class="theme-toggle-label">Dark mode</span>
        <svg class="size-[18px] text-muted-foreground dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="hidden size-[18px] text-muted-foreground dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground">
        <a href="/disclaimer" class="hover:text-foreground">Disclaimer</a>
        <a href="/source-policy" class="hover:text-foreground">Verification standards</a>
        <a href="/admin" class="font-semibold text-primary dark:text-blue-400">GR OPS</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      function sync() {
        var dark = root.classList.contains('dark');
        document.querySelectorAll('.theme-toggle').forEach(function (b) {
          b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          b.setAttribute('aria-pressed', String(dark));
          var l = b.querySelector('.theme-toggle-label');
          if (l) l.textContent = dark ? 'Light mode' : 'Dark mode';
        });
      }
      document.querySelectorAll('.theme-toggle').forEach(function (b) {
        b.addEventListener('click', function () {
          var dark = root.classList.toggle('dark');
          try { localStorage.setItem('nirnay-theme', dark ? 'dark' : 'light'); } catch (e) {}
          sync();
        });
      });
      sync();

      var btn = document.getElementById('nirnay-mobile-menu-btn');
      var drawer = document.getElementById('nirnay-mobile-drawer');
      var openIcon = document.getElementById('hamburger-icon');
      var closeIcon = document.getElementById('close-icon');
      var backdrop = document.getElementById('nirnay-mobile-backdrop');
      function setOpen(open) {
        if (!btn || !drawer) return;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        drawer.classList.toggle('hidden', !open);
        if (backdrop) backdrop.classList.toggle('hidden', !open);
        // Keep the page behind the menu from scrolling while it is open
        root.style.overflow = open ? 'hidden' : '';
        if (openIcon) openIcon.classList.toggle('hidden', open);
        if (closeIcon) closeIcon.classList.toggle('hidden', !open);
      }
      if (btn && drawer) {
        btn.addEventListener('click', function () { setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
        drawer.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
        if (backdrop) backdrop.addEventListener('click', function () { setOpen(false); });
        // Drawer is lg:hidden; don't leave the page scroll-locked after rotating/resizing to desktop
        window.matchMedia('(min-width: 1024px)').addEventListener('change', function (m) { if (m.matches) setOpen(false); });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); return; }
        // "/" focuses the desktop search field unless the user is already typing somewhere
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        var t = e.target;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        var field = document.getElementById('nirnay-header-search');
        if (field && field.offsetParent !== null) { e.preventDefault(); field.focus(); }
      });
    })();
  </script>
</header>
