---
// src/components/common/Header.astro
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-amber-400 font-bold text-base shadow-sm">
        <span>म.प्र.</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-extrabold text-lg tracking-tight text-slate-900 font-['Plus_Jakarta_Sans']">
            Rozgar<span class="text-indigo-700">Setu</span>
          </span>
          <span class="text-[10px] font-bold font-mono bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded border border-slate-300">
            MP
          </span>
        </div>
        <p class="text-[10px] text-slate-500 font-medium tracking-wide">
          म.प्र. शासकीय भर्ती व पात्रता परामर्श
        </p>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600">
      <a
        href="/"
        class={`hover:text-slate-900 transition-colors py-1 ${pathname === '/' ? 'text-slate-950 font-bold border-b-2 border-slate-900' : ''}`}
      >
        भर्तियाँ (Jobs)
      </a>
      <a
        href="/posts/mp-police-constable"
        class={`hover:text-slate-900 transition-colors py-1 ${pathname.startsWith('/posts') ? 'text-slate-950 font-bold border-b-2 border-slate-900' : ''}`}
      >
        मार्गदर्शिका (Guides)
      </a>
      <a
        href="/disclaimer"
        class={`hover:text-slate-900 transition-colors py-1 ${pathname === '/disclaimer' ? 'text-slate-950 font-bold border-b-2 border-slate-900' : ''}`}
      >
        आधिकारिक पोर्टल (Portals)
      </a>
      <a
        href="/admin"
        class={`hover:text-slate-900 transition-colors py-1 ${pathname.startsWith('/admin') ? 'text-slate-950 font-bold border-b-2 border-slate-900' : ''}`}
      >
        व्यवस्थापक (Admin)
      </a>
    </nav>

    <!-- Action Button -->
    <div class="flex items-center gap-2">
      <a
        href="/eligibility-checker"
        class="min-h-[40px] px-4 py-2 rounded-lg text-xs font-bold text-slate-950 bg-amber-400 hover:bg-amber-300 transition-colors shadow-sm flex items-center gap-1.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>पात्रता जाँचें</span>
      </a>
    </div>
  </div>
</header>
