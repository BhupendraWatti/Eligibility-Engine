---
// src/components/common/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-card text-foreground border-t border-border mt-20 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 pb-10 border-b border-border">
      <!-- Brand & Mission -->
      <div class="md:col-span-2">
        <div class="flex items-baseline gap-2 mb-3">
          <span class="font-bold text-foreground text-xl tracking-[0.18em]">
            NIRNAY
          </span>
          <span class="font-medium text-muted-foreground text-xs">
            MP opportunities
          </span>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-sm mb-4">
          An independent Madhya Pradesh government opportunities discovery platform. We aggregate, structure, and verify recruitment notifications directly from official state gazettes and authority portals.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-muted border border-border text-[11px] text-muted-foreground font-medium">
          <span class="size-2 rounded-full bg-amber-500"></span>
          <span>Not a government organisation · Independent advisory service</span>
        </div>
      </div>

      <!-- Discovery -->
      <div>
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider mb-3">Discovery</h4>
        <ul class="space-y-2 text-xs text-muted-foreground">
          <li><a href="/#closing-soon" class="hover:text-foreground transition-colors">Closing Soon Jobs</a></li>
          <li><a href="/calendar" class="hover:text-foreground transition-colors">Exam Calendar 2026</a></li>
          <li><a href="/results" class="hover:text-foreground transition-colors">Recruitment Results</a></li>
          <li><a href="/admit-cards" class="hover:text-foreground transition-colors">Admit Cards</a></li>
          <li><a href="/answer-keys" class="hover:text-foreground transition-colors">Answer Keys & Objections</a></li>
        </ul>
      </div>

      <!-- Candidate Tools -->
      <div>
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider mb-3">Candidate Tools</h4>
        <ul class="space-y-2 text-xs text-muted-foreground">
          <li><a href="/eligibility-checker" class="hover:text-foreground transition-colors">Deterministic Eligibility Calculator</a></li>
          <li><a href="/posts/mp-police-constable" class="hover:text-foreground transition-colors">MP Police Constable Guide</a></li>
          <li><a href="/posts/mp-patwari" class="hover:text-foreground transition-colors">MP Patwari Rulebook Guide</a></li>
          <li><a href="/admin" class="hover:text-foreground transition-colors font-medium text-primary">NIRNAY OPS Console</a></li>
        </ul>
      </div>

      <!-- Trust & Legal -->
      <div>
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider mb-3">Trust & Policy</h4>
        <ul class="space-y-2 text-xs text-muted-foreground">
          <li><a href="/disclaimer" class="hover:text-foreground transition-colors">Source Policy & Verification</a></li>
          <li><a href="/disclaimer" class="hover:text-foreground transition-colors">Legal Disclaimer</a></li>
          <li><a href="https://esb.mp.gov.in" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors flex items-center gap-1">
            <span>MPESB Portal</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a></li>
          <li><a href="https://mppsc.mp.gov.in" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors flex items-center gap-1">
            <span>MPPSC Official</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground gap-4">
      <p>&copy; {currentYear} NIRNAY. All recruitment notifications remain property of respective government boards.</p>
      <div class="flex items-center gap-4 text-[11px]">
        <a href="/disclaimer" class="hover:underline">Disclaimer</a>
        <a href="/disclaimer" class="hover:underline">Privacy Policy</a>
        <a href="/disclaimer" class="hover:underline">Terms of Use</a>
        <a href="/disclaimer" class="hover:underline">Source Policy</a>
      </div>
    </div>
  </div>
</footer>
