---
// src/components/common/SectorIcon.astro
import { getSectorIconDef } from '../../services/sector-theme';

interface Props {
  name?: string | null;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
const iconDef = getSectorIconDef(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={iconDef.svgInner}
/>
