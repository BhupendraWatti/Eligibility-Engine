---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import MobileBottomNav from '../components/common/MobileBottomNav.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  isReportPage?: boolean;
  robotsIndex?: boolean;
}

const {
  title,
  description = 'Explore verified central and state government opportunities across India, check eligibility, track important dates, and use direct official recruitment links.',
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  isReportPage = false,
  robotsIndex = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | NIRNAY</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: Plus Jakarta Sans, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- OpenGraph / Social -->
    <meta property="og:title" content={`${title} | NIRNAY`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NIRNAY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | NIRNAY`} />
    <meta name="twitter:description" content={description} />

    <!-- SEO & Indexing -->
    <meta name="robots" content={robotsIndex ? 'index, follow' : 'noindex, follow'} />
    <meta name="author" content="NIRNAY" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary selection:text-white">
    <!-- Print Only Header for Official Assessment Reports -->
    {isReportPage && (
      <div class="print-only p-4 border-b-2 border-slate-900 mb-6 text-center">
        <h1 class="text-2xl font-bold text-slate-900">NIRNAY - Eligibility Assessment Report</h1>
        <p class="text-xs text-slate-600 mt-1">Generated for personal career assessment. Independent public advisory platform.</p>
      </div>
    )}

    <Header />

    <main class="flex-1 pb-16 lg:pb-0">
      <slot />
    </main>

    <Footer />

    <MobileBottomNav />
  </body>
</html>
