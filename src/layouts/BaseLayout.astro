---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import DisclaimerBanner from '../components/common/DisclaimerBanner.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
}

const {
  title,
  description = 'Discover Madhya Pradesh government job recruitments, exam dates, eligibility criteria, syllabus, and official links. Free, deterministic eligibility calculator.',
  canonicalUrl = Astro.url.href,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | RozgarSetu MP</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: Plus Jakarta Sans, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph / Social -->
    <meta property="og:title" content={`${title} | RozgarSetu MP`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="RozgarSetu MP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | RozgarSetu MP`} />
    <meta name="twitter:description" content={description} />

    <!-- SEO & Performance -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="RozgarSetu MP" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 selection:bg-indigo-500 selection:text-white">
    <!-- Print Only Header -->
    <div class="print-only p-4 border-b-2 border-slate-900 mb-6 text-center">
      <h1 class="text-2xl font-bold text-slate-900">RozgarSetu MP — Eligibility Assessment Report</h1>
      <p class="text-xs text-slate-600 mt-1">Generated for personal career assessment. Independent public advisory service.</p>
    </div>

    <DisclaimerBanner />
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
