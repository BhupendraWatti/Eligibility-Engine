---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import MobileBottomNav from '../components/common/MobileBottomNav.astro';
import { SITE_NAME } from '../services/seo';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  isReportPage?: boolean;
  robotsIndex?: boolean;
  /** Search keywords for this page (see src/services/seo.ts). */
  keywords?: string[];
  /** Add " | GovtRecruitments" to the title. Off when the title is already a full search title. */
  appendSiteName?: boolean;
  /** Structured data (schema.org) objects, written as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Explore verified central and state government opportunities across India, check eligibility, track important dates, and use direct official recruitment links.',
  // Path only: query strings (?from=results, ?q=, filters) and a trailing slash must not make a new canonical.
  canonicalUrl = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.url.origin).href,
  ogType = 'website',
  isReportPage = false,
  robotsIndex = true,
  keywords = [],
  appendSiteName = true,
  jsonLd = [],
} = Astro.props;

const fullTitle = appendSiteName ? `${title} | ${SITE_NAME}` : title;
// No social banner exists yet: the square logo works with the "summary" card.
const ogImage = new URL('/brand/light/favicon-512x512.png', Astro.url.origin).href;
// "<" is escaped so a title or description can never close the script tag.
const jsonLdText = jsonLd.map(item => JSON.stringify({ '@context': 'https://schema.org', ...item }).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js): public site only; admin pages use AdminLayout and stay untracked. Skipped in dev. -->
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QH35M9NYTY"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-QH35M9NYTY');
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <!-- Apply saved (or OS-preferred) theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('nirnay-theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/brand/light/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/brand/dark/favicon.svg" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Fonts: Plus Jakarta Sans, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- OpenGraph / Social -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={`${SITE_NAME} logo`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SEO & Indexing -->
    <meta name="robots" content={robotsIndex ? 'index, follow' : 'noindex, follow'} />
    <meta name="author" content={SITE_NAME} />
    {jsonLdText.map(text => <script is:inline type="application/ld+json" set:html={text} />)}
  </head>
  <body class="min-h-screen flex flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0 print:pb-0 bg-background text-foreground selection:bg-primary selection:text-white">
    <!-- Print Only Header for Official Assessment Reports -->
    {isReportPage && (
      <div class="print-only p-4 border-b-2 border-slate-900 mb-6 text-center">
        <h1 class="text-2xl font-bold text-slate-900">GovtRecruitments - Eligibility Assessment Report</h1>
        <p class="text-xs text-slate-600 mt-1">Generated for personal career assessment. Independent public advisory platform.</p>
      </div>
    )}

    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <MobileBottomNav />
  </body>
</html>
