---
// src/layouts/AdminLayout.astro
import '../styles/global.css';
import '../styles/admin-datatable.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminMobileDrawer from '../components/admin/AdminMobileDrawer.astro';
import AdminMobileBottomNav from '../components/admin/AdminMobileBottomNav.astro';

interface Props {
  title: string;
  currentSection?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  currentSection = 'dashboard',
  breadcrumbs = [],
} = Astro.props;

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'aarav@nirnay.in';
---

<!doctype html>
<html lang="en" class="min-h-full bg-zinc-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | NIRNAY OPS</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-zinc-50 font-sans text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white flex flex-col">
    <div class="flex min-h-screen w-full">
      <!-- High-Contrast Desktop Sidebar (Hidden on mobile < md) -->
      <AdminSidebar current={currentSection} />

      <!-- Off-Canvas Mobile Drawer (< md) -->
      <AdminMobileDrawer current={currentSection} />

      <!-- Main Operational Viewport -->
      <div class="flex min-w-0 flex-1 flex-col bg-zinc-50">
        <!-- Top Operations Bar -->
        <header class="sticky top-0 z-30 flex h-14 shrink-0 items-center justify-between border-b border-zinc-200 bg-white/95 px-3.5 sm:px-6 backdrop-blur-md">
          <!-- Left: Mobile Menu Button & Workspace Breadcrumbs -->
          <div class="flex items-center gap-2 sm:gap-3 min-w-0">
            <!-- Mobile Hamburger Button (< md) -->
            <button
              type="button"
              id="admin-header-menu-btn"
              class="md:hidden inline-flex size-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 transition-colors cursor-pointer shrink-0"
              aria-label="Open navigation menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>

            <!-- Brand Pill -->
            <a href="/admin" class="flex items-center gap-1.5 font-bold text-xs tracking-wider uppercase text-zinc-900 shrink-0">
              <span class="flex size-6 items-center justify-center rounded bg-zinc-950 text-[11px] font-black text-white font-mono shadow-2xs">N</span>
              <span class="font-mono text-xs hidden xs:inline">NIRNAY OPS</span>
            </a>

            <span class="text-zinc-300 hidden sm:inline">/</span>

            <!-- Breadcrumbs / Section Title -->
            <div class="flex items-center gap-1.5 text-xs text-zinc-600 truncate">
              <span class="hidden sm:inline-flex items-center gap-1 rounded border border-zinc-200 bg-zinc-100 px-2 py-0.5 text-[10px] font-semibold text-zinc-700 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Private
              </span>

              {breadcrumbs.length > 0 ? (
                <nav class="flex items-center gap-1 text-xs truncate" aria-label="Breadcrumb">
                  <span class="text-zinc-300 sm:hidden">/</span>
                  {breadcrumbs.map((crumb, idx) => (
                    <div class="flex items-center gap-1 truncate">
                      {idx > 0 && <span class="text-zinc-300">/</span>}
                      {crumb.href ? (
                        <a href={crumb.href} class="text-zinc-500 hover:text-zinc-950 transition-colors font-medium truncate">
                          {crumb.label}
                        </a>
                      ) : (
                        <span class="text-zinc-950 font-semibold truncate">{crumb.label}</span>
                      )}
                    </div>
                  ))}
                </nav>
              ) : (
                <span class="text-zinc-950 font-semibold sm:hidden truncate">{title}</span>
              )}
            </div>
          </div>

          <!-- Right: Status Badge, Notifications & Profile -->
          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- Live Health Badge -->
            <div class="hidden lg:inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/70 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-800 font-mono">
              <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>LIVE SYNC</span>
            </div>

            <span class="hidden sm:inline-flex rounded border border-zinc-200 bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-800">
              Admin
            </span>

            <!-- Notifications Bell -->
            <button
              type="button"
              aria-label="View system notifications"
              class="relative inline-flex size-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 transition-colors cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-amber-500 ring-2 ring-white"></span>
            </button>

            <!-- Admin Profile Badge -->
            <div class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-white py-1 px-1.5 sm:px-2">
              <span class="flex size-6 items-center justify-center rounded-full bg-zinc-950 text-[10px] font-bold text-white font-mono">
                AM
              </span>
              <div class="hidden sm:flex flex-col text-left">
                <span class="text-xs font-semibold leading-tight text-zinc-950">Aarav Mehta</span>
                <span class="text-[10px] text-zinc-500 leading-none truncate max-w-[120px]">{adminEmail}</span>
              </div>
            </div>
          </div>
        </header>

        <!-- Main Workspace Surface with safe padding for Mobile Bottom Dock -->
        <main class="flex-1 bg-zinc-50/60 p-3.5 pb-24 sm:p-6 sm:pb-12 lg:p-8 lg:pb-12">
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Bottom Navigation Dock (< md screens) -->
    <AdminMobileBottomNav current={currentSection} />

    <!-- Script to wire header hamburger button -->
    <script>
      function setupHeaderMenuBtn() {
        const btn = document.getElementById('admin-header-menu-btn');
        if (btn) {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('nirnay:toggle-mobile-drawer'));
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupHeaderMenuBtn);
      } else {
        setupHeaderMenuBtn();
      }
      document.addEventListener('astro:page-load', setupHeaderMenuBtn);
    </script>
  </body>
</html>
