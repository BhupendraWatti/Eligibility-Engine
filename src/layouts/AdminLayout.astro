---
// src/layouts/AdminLayout.astro
import '../styles/global.css';
import '../styles/admin-datatable.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';

interface Props {
  title: string;
  currentSection?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  currentSection = 'dashboard',
  breadcrumbs = [],
} = Astro.props;

// @ts-ignore
const adminEmail = Astro.locals?.adminEmail || 'aarav@nirnay.in';
---

<!doctype html>
<html lang="en" class="min-h-full bg-zinc-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | NIRNAY OPS</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-zinc-50 font-sans text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white flex flex-col">
    <div class="flex min-h-screen w-full">
      <!-- High-Contrast Black Sidebar -->
      <AdminSidebar current={currentSection} />

      <!-- Main Operational Viewport -->
      <div class="flex min-w-0 flex-1 flex-col bg-zinc-50">
        <!-- Top Operations Bar -->
        <header class="sticky top-0 z-30 flex h-14 shrink-0 items-center justify-between border-b border-zinc-200 bg-white/95 px-4 sm:px-6 backdrop-blur-md">
          <!-- Left: Workspace Breadcrumbs -->
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 font-bold text-xs tracking-wider uppercase text-zinc-900">
              <span class="flex size-6 items-center justify-center rounded bg-zinc-950 text-[11px] font-black text-white">N</span>
              <span class="hidden sm:inline font-mono">NIRNAY OPS</span>
            </div>

            <span class="hidden sm:inline text-zinc-300">/</span>

            <div class="flex items-center gap-1.5 text-xs text-zinc-600">
              <span class="inline-flex items-center gap-1 rounded border border-zinc-200 bg-zinc-100 px-2 py-0.5 text-[10px] font-semibold text-zinc-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Private workspace
              </span>

              {breadcrumbs.length > 0 && (
                <nav class="hidden md:flex items-center gap-1.5 ml-2" aria-label="Breadcrumb">
                  {breadcrumbs.map((crumb) => (
                    <div class="flex items-center gap-1.5">
                      <span class="text-zinc-300">/</span>
                      {crumb.href ? (
                        <a href={crumb.href} class="text-zinc-600 hover:text-zinc-950 transition-colors font-medium">
                          {crumb.label}
                        </a>
                      ) : (
                        <span class="text-zinc-950 font-semibold">{crumb.label}</span>
                      )}
                    </div>
                  ))}
                </nav>
              )}
            </div>
          </div>

          <!-- Right: Security, Notifications & Identity -->
          <div class="flex items-center gap-3">
            <span class="hidden sm:inline-flex rounded border border-zinc-200 bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-800">
              Administrator
            </span>

            <!-- Notifications Bell -->
            <button
              type="button"
              aria-label="View system notifications"
              class="relative inline-flex size-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 transition-colors cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              <span class="absolute top-1.5 right-1.5 size-1.5 rounded-full bg-amber-500 ring-2 ring-white"></span>
            </button>

            <!-- Admin Profile Badge -->
            <div class="flex items-center gap-2.5 rounded-lg border border-zinc-200 bg-white py-1 px-2">
              <span class="flex size-6 items-center justify-center rounded-full bg-zinc-950 text-[10px] font-bold text-white font-mono">
                AM
              </span>
              <div class="hidden sm:flex flex-col text-left">
                <span class="text-xs font-semibold leading-tight text-zinc-950">Aarav Mehta</span>
                <span class="text-[10px] text-zinc-500 leading-none">{adminEmail}</span>
              </div>
            </div>
          </div>
        </header>

        <!-- Main Workspace Surface -->
        <main class="flex-1 bg-zinc-50/60 p-4 sm:p-6 lg:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
