    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "astro": "^7.3.3",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-datatables": "^10.3.0",
    "tailwindcss": "^4.3.3",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
