{
  "name": "eligibility-engine",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:vinext": "vinext dev --port 3001",
